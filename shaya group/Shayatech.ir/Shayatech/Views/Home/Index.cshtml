@{
    List<string> myList = ViewBag.GalleryList;
    string myPath = Server.MapPath("~/images/gallery/");
    string filename = "";


    ViewBag.hotnews = (Shayatech.Models.Blog)Session[Shayatech.Helper.GeneralModule.m_HotNewsItem];

    ViewBag.menuhomeclass = "current";
    ViewBag.menuadminclass = "";
    ViewBag.menuserviceclass = "";
    ViewBag.menuoverlookclass = "";
    ViewBag.menuaboutclass = "";
    ViewBag.menucontactclass = "";
}

@section featured {
    <section class="featured">

        <div class="banner_style">
            <!-- start slider -->
            <div class="TB_Wrapper">
                <div class="Slides">
                    <div class="Slide">
                        <img alt="img1" src="~/images/pic/banner01.png" />
                        <div style="text-align: center;"> BI. </div>
                    </div>
                    <div class="Slide">
                        <img alt="img2" src="~/images/pic/banner02.png" />
                        <div style="text-align: center;"> Ecommerce. </div>
                    </div>
                    <div class="Slide">
                        <img alt="img3" src="~/images/pic/banner03.png" />
                        <div style="text-align: center;"> CRM </div>
                    </div>
                    <div class="Slide">
                        <img alt="img4" src="~/images/pic/banner04.png" />
                        <div style="text-align: center;">  </div>
                    </div>
                </div>
            </div>
            <!-- end slider -->
        </div>

        <div class="home_page">
            <div class="skin_width">
                <div class="skin_main">
                    <div class="row-fluid">
                        <!-- start icon hover effect -->
                        <div class="main_top">
                            <div class="icon_hover span3">
                                <a href="#" target="_blank">
                                    <div class="service-bg">
                                        <img alt="" src="~/images/icons/icon_01.png" />
                                    </div>
                                </a>
                                <h3 style="font-family:'B Titr'">مدیریت ارتباط با مشتریان(CRM)</h3>
                                <p>
                                    تیم تخصصی CRM در این شرکت با درک تفاوتهای میان صنایع و کسب و کارهای مختلف و برخورداری از تجارب موفق و ارزشمند در حوزه پیاده‌سازی این سامانه‌ها با استفاده از Microsoft Dynamic CRM در سازمانهای مختلف اعم از مراکز تماس، بانک‌ها و شرکت‌های خدماتی، می‌تواند همراهی مطمئن و کارآزموده در ایجاد و توسعه سامانه‌های CRM باشد.
                                    <a class="more_icon" href="~/home/crm">ادامه...</a>
                                </p>
                            </div>
                            <div class="icon_hover span3">
                                <a href="#" target="_blank">
                                    <div class="service-bg">
                                        <img alt="" src="~/images/icons/icon_02.png" />
                                    </div>
                                </a>
                                <h3 style="font-family:'B Titr'">کسب و کار هوشمند (BI)</h3>
                                <p>
                                    تیم هوش تجاری این شرکت متشکل از تعدادی از بهترین دانش آموختگان دانشگاه های داخلی و خارجی با تجارت ملی و بین المللی در این حوزه می تواند ضمن ارایه بهترین راهکارها متناسب با نیازهای بخش های مختلف صنایع، راه پرفراز و نشیب ایجاد و بهره برداری از چنین سامانه هایی را به تجربه ای ارزشمند، کارآمد و ارزش افزار برای مشتریان شرکت تبدیل نماید.
                                    <a class="more_icon" href="~/home/bi">ادامه</a>
                                </p>
                            </div>
                            <div class="icon_hover span3">
                                <a href="#" target="_blank">
                                    <div class="service-bg">
                                        <img alt="" src="~/images/icons/icon_03.png" />
                                    </div>
                                </a>
                                <h3 style="font-family:'B Titr'">تجارت الکترونیکی (ECOMMERCE)</h3>
                                <p>
                                    شرکت شایا با برخورداری از شرکای تجاری استراتژیک و امکانات انسانی، سخت افزاری و نرم‌افزاری گسترده در این حوزه، طرحی دقیق و بلند مدت را دنبال می‌کند
                                    <a class="more_icon" href="~/home/ecommerce">ادامه</a>
                                </p>
                            </div>
                            <div class="icon_hover span3">
                                <a href="#" target="_blank">
                                    <div class="service-bg">
                                        <img alt="" src="~/images/icons/icon_04.png" />
                                    </div>
                                </a>
                                <h3 style="font-family:'B Titr'">پردازش مالی</h3>
                                <p>
                                    پردازش اطلاعات مالی به عنوان یک نهاد مالی مستقل فرایند جمع‌آوری ،پردازش اطلاعات مالی ،گزارش‌سازی و کمک به فرایند تصمیم‌گیری را برعهده دارد.
                                    <a class="more_icon" href="~/home/fipi">ادامه</a>
                                </p>
                            </div>
                        </div>
                        <!-- end icon hover effect -->
                    </div>
                    <div class="pe-spacer size20"></div>

                    <div class="pe-spacer size20"></div>
                    <div class="row-fluid">
                        <div class="span9">
                            @*<div class="main_content_title ">
                                <h3 style="font-family:Tahoma;">مطالب</h3>
                            </div>
                            <div class="pe-spacer size10"></div>*@
                            <!-- start horizontal tab -->
                            <ul id="myTab" class="nav nav-tabs" style="font-family:Tahoma;">
                                <li class="active" style="font-family:Tahoma;">
                                    <a href="#tab1" data-toggle="tab" style="font-family:Tahoma;">اخبار</a>
                                </li>
                                <li>
                                    <a href="#tab2" data-toggle="tab" style="font-family:Tahoma;">بلاگ</a>
                                </li>
                                @*<li>
                        <a href="#tab3" data-toggle="tab">SZZT E09</a>
                    </li>*@
                            </ul>
                            <div id="myTabContent" class="tab-content" style="height:250px">
                                <div class="tab-pane fade in active" id="tab1">
                                    <div class="row-fluid">
                                        <div class="shake">

                                            @foreach (Shayatech.Models.Blog item in (List<Shayatech.Models.Blog>)Session[Shayatech.Helper.GeneralModule.m_NewsList])
                                            {
                                                string strBody = item.Body;
                                                if (strBody.Length > 300)
                                                {
                                                    strBody = strBody.Substring(0, 300);
                                                }

                                                <div class="lblog-date right" style="font-family:Tahoma;font-size:8px; color:darkseagreen">@item.PublishDate &nbsp;</div>
                                                <a href="#">
                                                    <div class="lblog-content right" style="font-family:Tahoma;font-size:12px;font-weight:bold">@item.Title</div>
                                                </a>
                                                    <div class="lblog-content right" style="font-family:Tahoma;font-size:12px">@strBody...</div>
                                                    <div class="pe-spacer size10"></div>
                                                    <br />
                                            }

                                        </div>

                                        <div >
                                            <a href="~/cms/BlogList?isNews=true" class="btn-danger" style="float:left;font-family:Tahoma;bottom:0px ">همه اخبار</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="tab2">
                                    <div class="row-fluid">
                                        <div class="shake">
                                            @foreach (Shayatech.Models.Blog item in (List<Shayatech.Models.Blog>)Session[Shayatech.Helper.GeneralModule.m_BlogList])
                                            {
                                                string strBody = item.Body;
                                                if (strBody.Length > 600)
                                                {
                                                    strBody = strBody.Substring(0, 600);
                                                }

                                                <div class="lblog-date right">@item.PublishDate &nbsp;</div>
                                                <div class="lblog-content right" style="font-family:Tahoma;font-size:12px;font-weight:bold">@item.Title</div>
                                                <div class="lblog-content right" style="font-family:Tahoma;font-size:12px">@strBody...</div>
                                                    <div class="pe-spacer size10"></div>
                                            }
                                        </div>
                                        <a href="~/cms/BlogList?isNews=false" class="btn-danger" style="float:left;font-family:Tahoma;">همه وبلاگها</a>
                                    </div>
                                </div>
                                @*<div class="tab-pane fade" id="tab3">
                        <div class="row-fluid">
                            <div class="shake">
                                <img alt="Shake Image" src="~/images/pic/tab_shake3.jpg" />
                            </div>

                        </div>
                    </div>*@
                            </div>
                            <!-- end horizontal tab -->
                        </div>
                        <div class="span3">
                            <!-- start accordion -->
                            <div class="accordion" id="accordion2">
                                @*<div class="main_content_title ">
                                    <h3 style="font-family:Tahoma;">مطالب برگزیده</h3>
                                </div>*@
                                @*<div class="pe-spacer size10"></div>*@
                                <div class="accordion-group">
                                    <div class="accordion-heading">
                                        <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseOne" style="font-family:Tahoma;">پیوند داغ</a>
                                    </div>
                                    <div id="collapseOne" class="accordion-body collapse in">
                                        <div class="thumbnail" style="height:300px;">

                                                    <a href="#"  class="fancybox" rel="group">
                                                        <img src="~/Images/pic/slider02.jpg" style="height:300px;" />
                                                    </a>

                                                    <a href="#" class="fancybox" rel="group">
                                                        <img src="~/Images/pic/slider03.jpg" style="height:300px;" />
                                                    </a>
                                            </div>
                                      

                                        @*<a class="more_icon" href="#" style="font-family:Tahoma;">بیشتر...</a>*@
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-group">
                                <div class="accordion-heading">
                                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseTwo" style="font-family:Tahoma;">محبوبترین مطلب</a>
                                </div>
                                <div id="collapseTwo" class="accordion-body collapse">
                                    <div class="accordion-inner" style="font-family:Tahoma;">
                                        ارایه راهکارهای سیستمی و تولید نرم افزاری های تخصصی صنعت بانکداری، ارایه مشاوره و تامین سخت افزار قابل استفاده در راهکارهای، پشتیبانی از سیستم های عرضه شده
                                        <a class="more_icon" href="#">بیشتر...</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- end accordion -->
                    </div>

                    
                    <div class="pe-spacer size30"></div>
                    <div class="row-fluid">
                        <div class="span12">
                            <div class="main_content_title" dir="ltr">
                                <h3 dir="rtl" style="font-family:Tahoma;">گالری</h3>
                            </div>
                            <!-- start lightbox & carousel -->
                            <div class="carouFredSel_style clearafter">

                                <ul id="carouFredSel">
                                    @foreach (string item in myList)
                                    {
                                        filename = @item.Replace(myPath, "");

                                        <li>
                                            <a href="~/images/gallery/@filename" title=@filename class="fancybox" rel="group">
                                                <img alt="" src="~/Images/gallery/@filename" />

                                            </a>
                                        </li>
                                    }

                                </ul>
                                <div class="carouFredSel_nav" dir="ltr" style="float:left">
                                    <a id="caroul_prev" class="caroul_prev" href="#"></a>
                                    <a id="caroul_next" class="caroul_next" href="#"></a>
                                </div>

                            </div>
                            <!-- end lightbox & carousel -->
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        


    </section>
}

