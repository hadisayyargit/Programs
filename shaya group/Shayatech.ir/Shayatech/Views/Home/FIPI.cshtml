@{
    ViewBag.menuhomeclass = "";
    ViewBag.menuadminclass = "";
    ViewBag.menuserviceclass = "current";
    ViewBag.menuoverlookclass = "";
    ViewBag.menuaboutclass = "";
    ViewBag.menucontactclass = "";
}

@section featured {
    <section class="featured">

        <div class="pagename_style">
            <div class="skin_width">
                <div class="row-fluid">
                    <div class="top_title span12">
                        <h1 dir="rtl" style="font-family:Tahoma">پردازش اطلاعات مالی</h1>
                    </div>
                </div>
            </div>
        </div>
        <div class="skin_width">
            <div class="blog_page">
                <div class="skin_main ">
                    <div class="pe-spacer size20"></div>
                    <div class="row-fluid">
                        <div class="span9">
                            <div class="blog_post_list">

                                <div class="standard_content">
                                    <article>
                                        <p dir="rtl" style="font-family:'B Nazanin';font-size:16px">
                                            <img src="~/Images/fip.png" />
                                            <br />
                                            هر ساله شرکت ها اطلاعات مالی زیادی را تهیه و افشا می کنند که در بسیاری از موارد نیاز به پردازش دارد. پردازش اطلاعات مالی فرایند پردازش اطلاعات مالی را به عهده دارند و سرمایه گذاران از این اطلاعات پردازش شده در تحلیل های خود استفاده می کنند. ارائه اطلاعات پردازش شده به سرمایه گذاران باعث سرعت در تصمیم گیری می شود. در دسترس بودن اطلاعات پردازش شده برای تحلیل گران و سرمایه گذاران بسیار حائز اهمیت بوده و به تخصصی شدن فرایند سرمایه گذاری کمک شایانی می کند.پردازش اطلاعات مالی به عنوان یک نهاد مالی مستقل فرایند جمع آوری ،پردازش اطلاعات مالی ،گزارش سازی و کمک به فرایند تصمیم گیری را بر عهده دارد.
                                            پردازش اطلاعات مالی بنا بر نیازهای زیر راه اندازی می گردد:
                                            <br />
                                            •	پراکندگی اطلاعات مالی شرکت ها بصورت یکپارچه و تاریخچه ای
                                            <br />
                                            •	نبود منبع جامع در مورد صورت های مالی شرکت ها و نسبت های مالی و اطلاعات مالی شرکت ها
                                            <br />
                                            •	رشد بازار سرمایه و توسعه دانش تحلیل و ورود سرمایه گذاران نیازمند به تحلیل مالی
                                            <br />
                                            •	رشد صندوق های سرمایه گذاری و تلاش برای جذب سرمایه گذار در این حوزه و نیاز به مدیریت ریسک در صندوق ها
                                            <br />
                                            •	رشد تئوری های مالی و مدل های مالی و عقب بودن بازار واقعی از آن
                                            <br />
                                            •	ادغام و تملیک شرکت ها و نیاز به بررسی مالی شرکت ها و ارزش گذاری شرکت ها

                                            <br />
                                            <br />

                                            <b>لیست سرویس ها وخدمات به مراکز پردازش اطلاعات مالی</b>
                                            <br />
                                            1-راه اندازی سرویس های کدال :
                                            <br />•	دریافت صورت های مالی ترازنامه ای و صورت سود و زیان و پیش بینی درآمد هر سهم
                                            <br />•	اقلام ترازنامه شامل:وجه نقد،حسابهای دریافتنی،سرمایه گذاری کوتاه مدت و بلند مدت،موجودی کالا،دارایی جاری،دارایی ثابت،دارایی مشهود و نا مشهود،دارایی،حساب های پرداختنی،بدهی جاری،بدهی،سرمایه،سود انباشته،حقوق صاحبان سهام
                                            <br />•	اقلام صورت سود و زیان:فروش،سود ناخالص،سود عملیاتی،هزینه مالی،سود قبل مالیات ، سود خالص و سود هر سهم
                                            <br />•	در صورت پیش بینی درآمد هر سهم اطلاعات پیش بینی Eps
                                            اطلاعات ارایه شده شامل صورت های مالی بانک ها و بیمه ها نمی باشد.(چون سرویس ان ها توسط کدال ارائه نمی شود.)
                                            <br />•	راه اندازی موتور دریافت اطلاعات کدال(Codal Service Engine) و فرایند مکانیزه و خودکار دریافت اطلاعات سایت کدال
                                            
                                            <br />
                                            
                                            <bdi style="color:indianred ;font-weight:bold" >
                                                برای راه اندازی سرویس فوق شرکت خدمات پذیر باید مجوز های لازم برای دریافت سرویس های کدال را دارا باشد.
                                            </bdi>

                                            <br />
                                            <br />2-راه اندازی بانک اطلاعاتی :
                                            اطلاعات تاریخچه ای صورت های مالی بالا به تفکیک سال و دوره در بانک اطلاعاتی Sql Server  نگهداری می شود
                                            
                                            <br />3-اطلاعات معاملات:
                                            شامل قیمت سهام در بازارهای مختلف و تاریخچه قیمت سهام
                                            
                                            <br />4-اطلاعات شاخص ها:
                                            شامل اطلاعات انواع شاخص ها و تاریخچه آن
                                            
                                            <br />5-اطلاعات بازار ها:
                                            اطلاعات بازار بورس و فرابورس و تاریخچه آن
                                            
                                            <br />6-راه اندازی موتور دریافت اطلاعات معاملات و فرایند های مکانیزه و منظم آن
                                            <br />
                                            <bdi style="color:indianred ;font-weight:bold">
                                                برای بند 3 و 4و5 باید مجوز های لازم از سازمان بورس توسط شرکت خدمات پذیر اخذ شده باشد.
                                                </bdi>

                                                <br />7-محاسبه نسبت های مالی و قابلیت تعریف و محاسبه نسبت های مالی جدید بر اساس نیاز کاربر  برای تمام نماد های بورسی در تمام سال ها و دوره ها

                                                <br />8-محاسبه قیمت تعدیل شده بر اساس افزایش سرمایه و سود تقسیمی

                                                <br />9-راه اندازی سایت پردازش اطلاعات مالی با قابلیت گزارش سازی

                                                <br />10-تعریف مدل های مالی و تولید گزارشات مبتنی بر مدل (مانند مدل کشف سهام Canslim)

                                                <br />11- نگهداری و پشتیبانی

</p>


                                    </article>
                                    
                                </div>
                                <div class="pe-spacer size20"></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

</section>
}


