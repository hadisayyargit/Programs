@using pharmacy.Helper;

@{

    pharmacy.Helper.GeneralModule.SetTopBlogs();

    ViewBag.CopyRight = ((System.Reflection.AssemblyCopyrightAttribute)(System.Reflection.Assembly.GetAssembly(typeof(pharmacy.MvcApplication)).GetCustomAttributes(typeof(System.Reflection.AssemblyCopyrightAttribute), false)).First()).Copyright.ToString();
    ViewBag.Version = System.Reflection.Assembly.GetAssembly(typeof(pharmacy.MvcApplication)).GetName().Version.ToString();

    ViewBag.userdes = (((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).UserDs != null) ? ((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).UserDs : "ورود";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>داروخانه دکتر شهبازی</title>
    <meta name="author" content="Idea4Theme">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <link rel="shortcut icon" href="~/assets/images/icons/favicon.png" />
    <!--[if lt IE 9]>
        <script src="https://html5shim.googlecode.com/svn/trunk/html5.js"></script>
        <![endif]-->

    <link href="~/Content/bootstrap-rtl/css/bootstrap-rtl.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-rtl/css/bootstrap-responsive-rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Content/fancybox.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/base.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/style.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/trans-banner.css" />
    <link rel="stylesheet" type="text/css" href="~/Scripts/colorpicker/css/colorpicker.css" />

</head>
<body>
    <div id="skin_wrapper">
        <div class="skin_top_bg"> </div>
        <div class="header_area">
            <div class="dropdown">
                @*<div class="pull-right dropdown">*@
                <a href="#" class="user_info dropdown-toggle" title=@ViewBag.userdes data-toggle="dropdown">
                    @if (((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).ThumbnailPhoto == null)
                    {
                        <img src="~/assets/images/gallery/avatar2.png" alt="" />

                    }
                    else
                    {
                        if (((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).ThumbnailPhoto != null)
                        {
                            string s = "";
                            try
                            {
                                s = Convert.ToBase64String(((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).ThumbnailPhoto);
                            }
                            catch
                            {
                            }
                            var imgsrc = string.Format("data:image/jpeg;base64,{0}", s);

                            //<img src=@Url.Content(((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).UserImage) width="32" height="32" alt="" />
                            <img src=@imgsrc width="32" height="32" alt="" />
                        }
                    }
                    <span class="caret"></span>
                </a>
                <ul class="dropdown-menu">

                    @if (((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).LoginName.ToLower() == "guest")
                    {
                        <li>
                            <a href="~/Account/LogIn" style="font-family:Tahoma">ورود به سیستم</a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a href="javascript:void(0)" style="font-family:Tahoma">پروفایل کاربر</a>
                        </li>
                        <li class="divider"></li>
                            <li>
                                <a href="~/Account/LogOff" style="font-family:Tahoma">خروج</a>
                            </li>

                    }
                </ul>
            </div>


            <div class="skin_width">
                <header class="skin_header clearafter">
                    <!--site logo-->
                    <div class="logo_style">
                        <a href="~/Home/Index" title="خانه"><img src="~/assets/images/icons/logo_pharmacy.png" alt="logo" /></a>

                    </div>
                    <!--mobile menu button -->
                    <div class="mobile_nav">
                        <a href="#" class="menuclick"><img alt="menu click" class="click_img" src="~/assets/images/skin/blank.gif" /></a>
                    </div>




                    <nav class="menu_box">


                        <!--start main nav-->
                        <div id="standardMenu">
                            <ul class="rootMenu">
                                <li class="item first @ViewBag.menuhomeclass">
                                    <a href="~/"><span style="font-family:'B Yekan',Tahoma;font-size:16px;font-weight:normal">خانه</span></a>
                                </li>

                                <li class="item haschild @ViewBag.menuadminclass">
                                    <a href="#"><span style="font-family:B Yekan,Tahoma;font-size:16px;font-weight:normal">راهبری</span></a>
                                    <div class="subMenu">
                                        <ul>
                                           @if (((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).LoginName.ToLower() == "guest")
                                           {

                                                <li class="item">
                                                    <a href="~/Account/LogIn"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">ورود به سیستم</span></a>
                                                </li>
                                              
                                            }
                                            else
                                            {
                                                <li class="item">
                                                    <a href="#"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">تغییر گذرواژه</span></a>
                                                </li>
                                                <li class="item">
                                                    <a href="~/Account/LogOff"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">خروج</span></a>
                                                </li>


                                               if (((pharmacy.Models.AppUser)Session[GeneralModule.m_CurrentUser]).LoginName.ToLower() == "admin")
                                               {
                                                    <li class="item">
                                                        <a href="#"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">مدیریت کاربران</span></a>
                                                    </li>
                                                    <li class="item">
                                                        <a href="~/cms/BlogList?showdiactive=true"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">پستهای غیرفعال</span></a>
                                                    </li>

                                                    <li class="item">
                                                        <a href="~/cms/BlogList?showdiactive=true"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">گزارشات</span></a>
                                                    </li>

                                                }
                                            }
                                        </ul>
                                    </div>
                                </li>

                                <li class="item haschild @ViewBag.menuserviceclass">
                                    <a href="#"><span style="font-family:B Yekan,Tahoma;font-size:16px;font-weight:normal">راهکارها و خدمات</span></a>
                                    <!--second level nav-->
                                    <div class="subMenu">
                                        <ul>
                                            <li class="item first">
                                                <a href="~/Home/CRM"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">داروها</span></a>
                                                <!--Third level nav-->

                                            </li>
                                            <li class="item">
                                                <a href="~/Home/Ecommerce"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">محصولات آرایشی بهداشتی</span></a>
                                            </li>
                                            <li class="item">
                                                <a href="~/Home/BI"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">تجهیزات</span></a>
                                            </li>
                                            <li class="item">
                                                <a href="~/Home/DocEM"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">نسخه‌ها</span></a>
                                            </li>


                                            <li class="divider"></li>
                                            <li class="item first">
                                                <a href="~/cms/BlogList?isNews=true"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">اخبار</span></a>
                                            </li>
                                            <li class="item">
                                                <a href="~/cms/GalleryList"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">گالری محصولات</span></a>
                                            </li>
                                            <li class="item">
                                                <a href="~/cms/BlogList?isNews=false"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">مطالب دانستنی</span></a>
                                            </li>
                                            <li class="item">
                                                <a href="#"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal"></span></a>
                                            </li>
                                        </ul>
                                    </div>

                                </li>

                                <li class="item haschild @ViewBag.menuoverlookclass">
                                    <a href="#"><span style="font-family:B Yekan,Tahoma;font-size:16px;font-weight:normal">باشگاه مشتریان </span></a>
                                    <div class="subMenu">
                                        <ul>
                                            <li class="item first">
                                                <a href="~/Home/FIPI"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">خرید آنلاین محصولات</span></a>
                                            </li>
                                            <li class="item">
                                                <a href="~/Home/Overlook"><span style="font-family:B Yekan,Tahoma;font-size:12px;font-weight:normal">پیگیری نسخه</span></a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>

                                <li class="item about_us_page @ViewBag.menuaboutclass">
                                    <a href="~/Home/About"><span style="font-family:B Yekan,Tahoma;font-size:16px;font-weight:normal">درباره ما </span></a>
                                </li>

                                <li class="item last @ViewBag.menucontactclass">
                                    <a href="~/Home/Contact"><span style="font-family:B Yekan,Tahoma;font-size:16px;font-weight:normal">تماس با ما</span></a>
                                </li>

                            </ul>
                        </div>
                    </nav>
                    <!--end main nav-->
                    <div class="banner_shadow"></div>
                </header>
            </div>
        </div>

        <div id="maincontent">
            @RenderSection("featured", required: false)
            <section class="skin-wrapper">
                @RenderBody()
            </section>

        </div>

        <div class="skin_footer">
            <div class="skin_width">
                <div class="home_page footer_main">
                    <div class="pe-spacer size10"></div>
                    <div class="row-fluid">


                        <div class="span3">
                            <h3 style="font-family:'B Titr';">دانستنیها </h3>
                            <!-- start footer post -->
                            <div class="footer_post">
                                <ul>
                                    @if (Session[pharmacy.Helper.GeneralModule.m_BlogList] != null)
                                    {
                                        foreach (pharmacy.Models.Cms item in (List<pharmacy.Models.Cms>)Session[pharmacy.Helper.GeneralModule.m_BlogList])
                                        {
                                            <li>
                                                <span><img alt="" src="~/assets/images/gallery/avatar2.png" height="32" width="32" /></span>
                                                <div style="max-height:100px;font-family:Tahoma;">
                                                    @item.Title
                                                </div>
                                                <div class="post_clear"></div>
                                            </li>
                                            <div class="footer_post_line"></div>
                                        }
                                    }

                                </ul>
                            </div>
                            <!-- end footer post -->
                        </div>
                        @*<div class="span3">
                                <h3></h3>
                                <div class="footer_tag">
                                        <ul>
                                            <li>
                                                <a href="~/" target="_blank"><span>خانه</span></a>
                                            </li>
                                            <li>
                                                <a href="~/home/overlook" target="_blank"><span>چشم‌انداز</span></a>
                                            </li>
                                            <li>
                                                <a href="~/home/about" target="_blank"><span>درباره ما</span></a>
                                            </li>
                                            <li>
                                            </li>
                                        </ul>
                                    </div>
                            </div>*@
                        <div class="span3">
                            <h3 style="font-family:B Titr;">محصولات برگزیده </h3>
                            <!-- start image lightbox -->
                            <div class="fancybox_style">
                                <ul>

                                    <li>
                                        <a rel="photo" class="fancybox" title="ویژه.." href="~/assets/images/drugstore/hot/fancy-img1.PNG"><img alt="" src="~/assets/images/drugstore/hot/fancy-img1-s.png" /><span class="img-overlay"></span></a>
                                    </li>

                                    <li>
                                        <a rel="photo" class="fancybox" title="ویژه" href="~/assets/images/drugstore/hot/fancy-img2.png"><img alt="" src="~/assets/images/drugstore/hot/fancy-img2-s.png" /><span class="img-overlay"></span></a>
                                    </li>

                                    <li>
                                        <a rel="photo" class="fancybox" title="ویژه..." href="~/assets/images/drugstore/hot/fancy-img3.png"><img alt="" src="~/assets/images/drugstore/hot/fancy-img3-s.png" /><span class="img-overlay"></span></a>
                                    </li>

                                    <li>
                                        <a rel="photo" class="fancybox" title="عالی.." href="~/assets/images/drugstore/hot/fancy-img4.png"><img alt="" src="~/assets/images/drugstore/hot/fancy-img4-s.png" /><span class="img-overlay"></span></a>
                                    </li>

                                    <li>
                                        <a rel="photo" class="fancybox" title="عالی.." href="~/assets/images/drugstore/hot/fancy-img5.png"><img alt="" src="~/assets/images/drugstore/hot/fancy-img5-s.png" /><span class="img-overlay"></span></a>
                                    </li>

                                    <li>
                                        <a rel="photo" class="fancybox" title="عالی.." href="~/assets/images/drugstore/hot/fancy-img6.png"><img alt="" src="~/assets/images/drugstore/hot/fancy-img6-s.png" /><span class="img-overlay"></span></a>
                                    </li>
                                </ul>
                            </div>
                            <!-- end image lightbox -->
                        </div>
                        <div class="span3">
                            <h3 style="font-family:B Titr;">آخرین اخبار</h3>
                            <!-- start testimonials -->
                            <ul id="quovolver_style" class="quovolve clearafter">
                                @if (Session[pharmacy.Helper.GeneralModule.m_NewsList] != null)
                                {
                                    foreach (pharmacy.Models.Cms item in (List<pharmacy.Models.Cms>)Session[pharmacy.Helper.GeneralModule.m_NewsList])
                                    {
                                        <li>
                                            <p style="font-family:Tahoma;">
                                                @item.Title
                                                <cite>@item.PublishDate</cite>
                                            </p>
                                        </li>
                                    }
                                }

                            </ul>
                            <!-- end testimonials -->
                        </div>
                        <div class="span3 left">
                            <h3 style="font-family:B Titr;">اطلاعات تماس</h3>
                            <ul>
                                <li style="font-family:Tahoma;">نشانی داروخانه: جیرفت ، نارنجستان 7، پلاک 113 </li>
                                <li style="font-family:Tahoma;">Email: info@mshahbazi.ir</li>
                                <li style="font-family:Tahoma;">Tel: (+98) 021-82806655 ext: 5265</li>
                                <li>
                                    <a href="~/home/contact" class="email" style="font-family:Tahoma;">نظرات خود را با ما در میان بگذارید</a>
                                </li>
                            </ul>
                        </div>

                    </div>
                    <div class="pe-spacer size10"></div>
                </div>
            </div>
        </div>

        <footer>
            <div class="footer_bottom" style="font-family:Tahoma;font-size:10px">
                <div class="skin_width">
                    <div class="row-fluid ">
                        <div class="span6 copyright_left">
                            <!-- copyright info -->
                            <p style="font-family:Tahoma">
                                &nbsp;&copy; کلیه حقوق این سایت متعلق به داروخانه دکتر شهبازی است
                                -
                                پیاده‌سازی و اجرا توسط:
                                گروه پردازشگران خرداد
                                <a href="http://www.khordadnet.ir" target="_blank"><img src="~/assets/images/icons/khordadlogoTransparent.png" width="10%" height="10%" /></a>
                            </p>
                        </div>
                        <div class="span6 copyright_right">
                            <!--Social Icons-->
                            <div class="Social-Links">
                                <a href="https://www.facebook.com/shahbazipharmacy?ref=hl" title="Facebook" class="iconFacebook" rel="tooltip" target="_blank"></a>
                                <a href="https://www.twitter.com/shahbazipharmacy" title="Twitter" class="iconTwitter" rel="tooltip" target="_blank"></a>
                                <a href="#" title="Youtube" class="iconYouTube" rel="tooltip" target="_blank"></a>
                                <a href="shahbazipharmacy@gmail.com" title="Google+" class="iconGoogle" rel="tooltip" target="_blank"></a>
                                <a href="#" title="RSS" class="iconRss" rel="tooltip" target="_blank"></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

        <a href="#" id="top-link" title="اول صفحه"></a>
    </div>

</body>


</html>

<script src='~/Scripts/jquery-1.10.2.min.js'></script>


<script src='~/Scripts/jquery-migrate.min.js'></script>
<script src='~/Scripts/jquery.scrollTo.min.js'></script>
