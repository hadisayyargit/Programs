                                <h3 style="font-family:Tahoma;">مطالب</h3>
                            </div>
                            <div class="pe-spacer size10"></div>*@
                            <!-- start horizontal tab -->
                            <ul id="myTab" class="nav nav-tabs" style="font-family:Tahoma;">
                                <li class="active" style="font-family:Tahoma;">
                                    <a href="#tab1" data-toggle="tab" style="font-family:Tahoma;">اخبار</a>
                                </li>
                                <li>
                                    <a href="#tab2" data-toggle="tab" style="font-family:Tahoma;">دانستنیها</a>
                                </li>
                                @*<li>
                        <a href="#tab3" data-toggle="tab">SZZT E09</a>
                    </li>*@
                            </ul>
                            <div id="myTabContent" class="tab-content" style="height:250px">
                                <div class="tab-pane fade in active" id="tab1">
                                    <div class="row-fluid">
                                        <div class="shake">
                                            @if (Session[pharmacy.Helper.GeneralModule.m_NewsList] != null)
                                            {
                                                foreach (pharmacy.Models.Cms item in (List<pharmacy.Models.Cms>)Session[pharmacy.Helper.GeneralModule.m_NewsList])
                                                {
                                                    string strBody = item.Body;
                                                    if (strBody.Length > 300)
                                                    {
                                                        strBody = strBody.Substring(0, 300);
                                                    }

                                                <div class="lblog-date right" style="font-family:Tahoma;font-size:8px; color:darkseagreen">@item.PublishDate &nbsp;</div>
                                                <a href="#">
                                                    <div class="lblog-content right" style="font-family:Tahoma;font-size:12px;font-weight:bold">@item.Title</div>
                                                </a>
                                                    <div class="lblog-content right" style="font-family:Tahoma;font-size:12px">@strBody...</div>
                                                    <div class="pe-spacer size10"></div>
                                                    <br />
                                                }
                                            }
                                        </div>

                                        <div >
                                            <a href="~/cms/BlogList?isNews=true" class="btn-danger" style="float:left;font-family:Tahoma;bottom:0px ">همه اخبار</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="tab2">
                                    <div class="row-fluid">
                                        <div class="shake">
@if (Session[pharmacy.Helper.GeneralModule.m_BlogList] != null)
{
    foreach (pharmacy.Models.Cms item in (List<pharmacy.Models.Cms>)Session[pharmacy.Helper.GeneralModule.m_BlogList])
    {
        string strBody = item.Body;
        if (strBody.Length > 600)
        {
            strBody = strBody.Substring(0, 600);
        }

                                                <div class="lblog-date right">@item.PublishDate &nbsp;</div>
                                                <div class="lblog-content right" style="font-family:Tahoma;font-size:12px;font-weight:bold">@item.Title</div>
                                                <div class="lblog-content right" style="font-family:Tahoma;font-size:12px">@strBody...</div>
                                                    <div class="pe-spacer size10"></div>
    }
}
                                        </div>
                                        <a href="~/cms/BlogList?isNews=false" class="btn-danger" style="float:left;font-family:Tahoma;">همه</a>
                                    </div>
                                </div>
                                @*<div class="tab-pane fade" id="tab3">
                        <div class="row-fluid">
                            <div class="shake">
                                <img alt="Shake Image" src="~/assets/images/gallery/tab_shake3.jpg" />
                            </div>

                        </div>
                    </div>*@
                            </div>
                            <!-- end horizontal tab -->
                        </div>
                        <div class="span3">
                            <!-- start accordion -->
                            <div class="accordion" id="accordion2">
                                @*<div class="main_content_title ">
                                    <h3 style="font-family:Tahoma;">مطالب برگزیده</h3>
                                </div>*@
                                @*<div class="pe-spacer size10"></div>*@
                                <div class="accordion-group">
                                    <div class="accordion-heading">
                                        <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseOne" style="font-family:Tahoma;">پیوند داغ</a>
                                    </div>
                                    <div id="collapseOne" class="accordion-body collapse in">
