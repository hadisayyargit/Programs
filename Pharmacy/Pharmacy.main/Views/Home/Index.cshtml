                                <h3 dir="rtl" style="font-family:Tahoma;">گالری محصولات</h3>
                            </div>
                            <!-- start lightbox & carousel -->
                            <div class="carouFredSel_style clearafter">

                                <ul id="carouFredSel">
                                    @foreach (string item in myList)
                                    {
                                        filename = @item.Replace(myPath, "");

                                        <li>
                                            <a href="~/assets/images/drugstore/@filename" title=@filename class="fancybox" rel="group">
                                                <img alt="" src="~/assets/images/drugstore/@filename" />

                                            </a>
                                        </li>
                                    }

                                </ul>
                                <div class="carouFredSel_nav" dir="ltr" style="float:left">
                                    <a id="caroul_prev" class="caroul_prev" href="#"></a>
                                    <a id="caroul_next" class="caroul_next" href="#"></a>
                                </div>

                            </div>
                            <!-- end lightbox & carousel -->
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        


    </section>
}

