                                                    @*<a href="http://www.dici.ir/"  class="fancybox" rel="group">
                                                        <img src="~/assets/images/gallery/dici.gif" style="height:300px;" />
                                                    </a>*@

                                                    <a href="http://daroo118.com/" class="fancybox" rel="group" target="_blank">
                                                        <img src="~/assets/images/gallery/daroo118.png" style="height:300px;" />
                                                    </a>
                                            </div>
                                      

                                        @*<a class="more_icon" href="#" style="font-family:Tahoma;">بیشتر...</a>*@
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-group">
                                <div class="accordion-heading">
                                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseTwo" style="font-family:Tahoma;">محبوبترین مطلب</a>
                                </div>
                                <div id="collapseTwo" class="accordion-body collapse">
                                    <div class="accordion-inner" style="font-family:Tahoma;">
                                        ارایه راهکارهای سیستمی و تولید نرم افزاری های تخصصی صنعت بانکداری، ارایه مشاوره و تامین سخت افزار قابل استفاده در راهکارهای، پشتیبانی از سیستم های عرضه شده
                                        <a class="more_icon" href="#">بیشتر...</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- end accordion -->
                    </div>

                    
                    <div class="pe-spacer size30"></div>
                    <div class="row-fluid">
