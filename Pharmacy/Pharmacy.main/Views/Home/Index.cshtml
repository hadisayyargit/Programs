@{
    List<string> myList = ViewBag.DrugstoreList;
    string myPath = Server.MapPath("~/assets/images/drugstore/");
    string filename = "";


    ViewBag.hotnews = (pharmacy.Models.Cms)Session[pharmacy.Helper.GeneralModule.m_HotNewsItem];

