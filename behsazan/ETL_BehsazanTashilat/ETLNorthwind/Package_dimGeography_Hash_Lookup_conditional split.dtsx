                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
      ct.province as [StateProvinceCode]
      ,pr.[name] as [StateProvinceName]
      ,ct.id as [CityCode]
      ,ct.[name] as [CityName]
      ,ct.Latitude
      ,ct.Longitude
	  ,k.cod2 as CountryCode
	  , k.pname as CountryName
  FROM city ct
  inner join Province pr on pr.id=ct.province
  inner join country k on k.id=pr.country</property>
                <property
