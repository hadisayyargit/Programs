            <component
              refId="Package\Data Flow Task_Northwind\OLE DB Source_northwind"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source_northwind"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct s.Country [CountryCode]
      ,s.Country [CountryName]
	  ,0 [stateprovincecode]
	  ,'' stateprovincename
      ,0  [CityCode]
      ,s.City [CityName]
	  ,0 [latitude]
	  ,0 [longitude]
from Suppliers  s
union 
select distinct 
 c.Country [CountryCode]
      ,c.Country [CountryName]    
	  ,0 [stateprovincecode]
	  ,'' stateprovincename	  
      ,0  [CityCode]
      ,c.City [CityName]
	  ,0 [latitude]
	  ,0 [longitude]
 from Customers  c
union 
select e.Country [CountryCode]
      ,e.Country [CountryName]
	  ,0 [stateprovincecode]
	  ,'' stateprovincename	  
	  ,0  [CityCode]
      ,e.City [CityName]
	  ,0 [latitude]
	  ,0 [longitude]
	  from Employees  e 
union  
select distinct 
 o.ShipCountry [CountryCode]
      ,o.ShipCountry [CountryName]
	  ,0 [stateprovincecode]
	  ,'' stateprovincename
      ,0  [CityCode]
      ,o.ShipCity [CityName]
	  ,0 [latitude]
	  ,0 [longitude]

  from orders  o</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
