      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select CST.CSTMRID, cst.INTCSTMRID , cst.CSTMRNAID, cst.CSTMRACCNO, cst.CSTMRBIRTHDT   , cst.GENDERCD ,cst.CSTMRTYPCD, cst.CSTMRGRPCD ,CAST(CST.CSTMRNAME AS VARCHAR(200) CCSID 1252) as CSTMRNAME, CAST(CST.NAME AS VARCHAR(100) CCSID 1252) AS FIRSTNAME , CAST(CST.FAMILY AS VARCHAR(100) CCSID 1252) AS LASTNAME ,cst.TIMEZ from TASSHMA.CTFCSTMR CST where  (CST.timez&gt; '&quot;+ (DT_WSTR,100) @[User::v_StartTimestamp] + &quot;' ) with ur;&quot;"
