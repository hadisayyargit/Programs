    <DTS:Executable
      DTS:refId="Package\Execute SQL Task_update GeographyKey"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5276818D-4405-41D4-82FE-89E0F54953C0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task_update GeographyKey"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5396C769-EA4B-4C43-AB53-318B29EE5414}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="&#xA;UPDATE       dimRegion&#xA;SET                GeographyKey =g.GeographyKey&#xA;FROM            dimRegion INNER JOIN&#xA;                             (SELECT        GeographyKey, StateProvinceName&#xA;                                FROM            dimGeography&#xA;                                WHERE        (CityCode IS NULL) AND (GeographyKey &lt;&gt; 1)) AS g ON g.StateProvinceName = dimRegion.RGNDESC" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
