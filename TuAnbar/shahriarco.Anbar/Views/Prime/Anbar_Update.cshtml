    ViewBag.tab5class = "";
    ViewBag.tab6class = "";
    ViewBag.tab7class = "";
    ViewBag.tab8class = "";

    ViewBag.menuAnbarclass = "current";
    ViewBag.menuAboutclass = "";

    string strAnbarTypeLabel = "label-success";
}


<div class='row-fluid'>
    <div class='span12 box'>
        <div class='box-header blue-background'>
            <div class='title'>
                <div class='icon-edit'></div>
                انبار
            </div>
            <div class='actions'>
                <a href="#" class="btn box-remove btn-mini btn-link">
                    <i class='icon-remove'></i>
                </a>
                <a href="#" class="btn box-collapse btn-mini btn-link">
                    <i></i>
                </a>
            </div>
        </div>
        <div class='box-content'>
@using (Html.BeginForm())
            {
            



            <div style="margin:0;padding:0;display:inline"><input name="utf8" type="hidden" value="&#x2713;" /><input name="authenticity_token" type="hidden" value="CFC7d00LWKQsSahRqsfD+e/mHLqbaVIXBvlBGe/KP+I=" /></div>
            
                <div class='control-group'>
                <label class='control-label' for='disabledInput1'>کد انبار</label>
                <div class='controls'>
                    <span class='input-xlarge uneditable-input' style="width:100px">
                        @Html.DisplayFor(m => m.AnbarCode)
                        @Html.HiddenFor(m => m.SalMali)
                    </span>
                </div>

            </div>

            <div class='control-group'>
                <label class='control-label' for='inputText1' >نام انبار</label>
                <div class='controls'>
                    @Html.TextBoxFor(m => m.AnbarName, htmlAttributes: new { @id = "inputText1", @placeholder = "نام انبار", @style = "width:300px" })
                    @Html.ValidationMessageFor(m => m.AnbarName)
                </div>
            </div>

            <div class='control-group'>
                <label class='control-label' for='inputSelect'>روش محاسبه</label>
                <div class='controls'>
                    @Html.DropDownListFor(model => model.AnbarType, new SelectList(new List<string> { "FREE", "AVERAGE", "LIFO", "FIFO" }, "", ""), htmlAttributes: new { @id = "cboAnbarType" })
    
                    @*@Html.DropDownListFor(model => model.AnbarType, new SelectList(new List<string> { "FREE", "AVERAGE", "LIFO", "FIFO" }, "AnbarType", "AnbarType"), "نوع انبار", htmlAttributes: new { @id = "cboAnbarType" })*@
    @*<select id='select2-icon' style="width:300px;left:30px">
                        @*<option value='FREE' />icon-heart
                        
                        <option value='FREE' />FREE
                        <option value='AVERAGE' />AVERAGE
                        <option value='icon-signin' />LIFO
                        <option value="sss" />FIFO

                    </select>*@
                </div>
            </div>
                


            <div class='form-actions'>
                <button class='btn btn-primary' type='submit'>
                    <i class='icon-save'></i>
                    ثبت
                </button>
                <input type="button" class="btn btn-danger" style="font-family:Tahoma" value="حذف" onclick="location.href = '/prime/Anbar_Delete?anbarcode=@Model.AnbarCode'" />
                <input type="button" class="btn btn-info" style="font-family:Tahoma" value="انصراف" onclick="location.href = '/prime/Anbar'" />
            </div>
            
}
        </div>
    </div>
</div>
