                                            <div class='lead'>
                                                <i class='icon-signin text-contrast'></i>
                                                کالا
                                            </div>
                                            <div class='box'>
                                                <img alt="230x230&amp;text=photo" src="~/assets/images/23.jpg" style="background-size:contain;width:200px;height:200px" />

                                            </div>
                                        </div>
                                        <div class='span7 offset1'>
                                            <div class='control-group'>
                                                <label class='control-label'>کد کالا</label>
                                                <div class='controls'>
                                                    @*<input class='span12' id='txtKalacode' placeholder='کد کالا' type='text' />*@
                                                    @Html.TextBoxFor(m => m.KalaCode, htmlAttributes: new { @class = "span12", @id = "txtKalacode", @placeholder = "کد کالا", style = "color:blue" })
                                                </div>
                                                <label class='control-label'>نام کالا</label>
                                                <div class='controls'>
                                                    @Html.TextBoxFor(m => m.KalaName, htmlAttributes: new { @class = "span12", @id = "txtKalaName", @placeholder = "نام کالا", style = "color:blue" })
                                                </div>
                                                <label class='control-label'>محل استقرار</label>
                                                <div class='controls'>
                                                    @Html.TextBoxFor(m => m.KalaEsteghrar, htmlAttributes: new { @class = "span12", @id = "txtKalaEsteghrar", @placeholder = "محل استقرار", style = "color:blue" })
                                                </div>
                                                <label class='control-label'>مشخصات فنی</label>
                                                <div class='controls'>
                                                    @Html.TextBoxFor(m => m.KalaProperty, htmlAttributes: new { @class = "span12", @id = "txtKalaProperty", @placeholder = "مشخصات فنی", style = "color:blue" })
                                                </div>
                                                @*<div class='controls'>
                                                        <label class='checkbox'>
                                                            <input data-target='#change-password' data-toggle='collapse' id='changepasswordcheck' type='checkbox' value='option1' />
                                                            وضعیت
