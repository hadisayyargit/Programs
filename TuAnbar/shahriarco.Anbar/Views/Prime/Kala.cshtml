</div>

<script>
    function cboAnbar_Change() {
        
        var anbarcode = $("#cboAnbar").val();
        alert(anbarcode);
        var url = "Kala?kalacode=0&anbarcode=" + anbarcode; //Append Id To URL
        window.location.replace(url);
    }
</script>

<script>
    function kala_change(kalacode) {

        var n = kalacode;

        //alert(n);


        $.ajax({
            cache: false,
            type: "GET",
            url: "@(Url.Action("GetKala", "Prime"))",
            data: { "kalacode": n },
            success: function (data) {

                if (data != null) {
                    //alert(data.SalMali);

                    $("#txtKalacode").val(data.KalaCode);
                    $("#txtKalaName").val(data.KalaName);
                    $("#txtKalaEsteghrar").val(data.KalaEsteghrar);
                    $("#txtKalaProperty").val(data.KalaProperty);
                    $("#txtKalaShomareh").val(data.KalaShomareh);
                    $("#cboVahed").val(data.KalaVahedCode);
                    $("#txtPoint").val(data.KalaMomaiez);
                    $("#txtSalMali").val(data.SalMali);

                    $("#txtKalaMin").val(data.KalaMin);
                    $("#txtKalaSefPoint").val(data.KalaSefPoint);
                    $("#txtKalaMax").val(data.KalaMax);
                    $("#txtKalaArzType").val(data.KalaArzType);
                    $("#txtKalaZaribVahed").val(data.KalaZaribVahed);
                    $("#txtKalaGhesmat").val(data.KalaGhesmat);
                    $("#barcode").val("*" + data.AnbarCode + data.KalaCode + "*");
                }
                else {
                    alert("fail");
                }
            }
            , error: function (data) {
                if (data != null) {
                    alert("data is ok with error");
                }
                else {
                    alert(data);
                }
            }

        });



    }

</script>

