                                </ul>
                            </div>
                        </div>*@

                    <div class='row-fluid'>

                        <div class='span5 box bordered-box orange-border' style='margin-bottom:0;'>


                            <div class="box">
                                @*<label class='control-label'>انبار</label>*@
                                <div class='controls'>
                                    @*@Html.DropDownListFor(m => m.AnbarCode, new SelectList(myAnbarList, "AnbarCode", "AnbarName", "0"), "انبار را انتخاب کنید:", htmlAttributes: new { @id = "cboAnbar", @onchange = "cboAnbar_Change()", @class = "select2 input-block-level" })*@
                                    @Html.DropDownList("cboAnbar", new SelectList(myAnbarList, "AnbarCode", "AnbarName", "0"), "انبار را انتخاب کنید:", htmlAttributes: new { @id = "cboAnbar", @onchange = "cboAnbar_Change()", @class = "select2 input-block-level" })

                                </div>
                            </div>

                            <div class='box-header orange-background'>
                                <div class='title'>فهرست کالاها</div>
                                <div class='actions'>
                                    <a href="#" class="btn box-remove btn-mini btn-link">
                                        <i class='icon-remove'></i>
                                    </a>
                                    <a href="#" class="btn box-collapse btn-mini btn-link">
                                        <i></i>
                                    </a>
                                </div>
                            </div>


                            <div class='box-content box-no-padding'>


                                @(Html.Kendo().Grid(myKalaList).Name("MyGrid")
        .Resizable(resize => resize.Columns(true))
        .Columns(columns =>
        {
        columns.Bound("KalaCode").Title("کد کالا").Width(50).HtmlAttributes(new { style = "font-family:B yekan,Tahoma" });
        columns.Bound("KalaName").Title("نام کالا")
             .Template(@<text>
                <a onclick="kala_change(@item.KalaCode)" style="cursor:pointer">@item.KalaName</a>
            </text>);

        })
                                .DataSource(d => d.Server().PageSize(20))

                            .Sortable()


                            .Filterable(filterable => filterable
                                            .Messages(str => str
                                            .And("و")
                                            .Cancel("لغو")
                                            .Clear("پاک")
                                            .Filter("فیلتر")
                                            .Info("فیلتر کردن گزینه ها")
                                            )
                                            .Operators(operators => operators
                                            .ForNumber(n => n.Clear()
                                                .IsEqualTo("=")
                                                .IsGreaterThan(">")
                                                .IsGreaterThanOrEqualTo(">=")
                                                .IsLessThan("<")
                                                .IsLessThanOrEqualTo("<=")
                                                .IsNotEqualTo("<>")
                                                )
                                            .ForString(str => str.Clear()
                                                .StartsWith("شروع شود با ")
                                                .IsEqualTo("برابر با")
                                                .Contains("شامل")
                                                .DoesNotContain("شامل نباشد")
                                                .StartsWith("شروع شود با")
                                                .EndsWith("تمام شود به")
                                                .IsNotEqualTo("نابرابر با")))
                                   )

                            .Pageable(pageable => pageable
                                //.PageSizes(true)
                                .PageSizes(new int[] { 10, 20, 30, 40 })
                                .ButtonCount(5).Numeric(true).Refresh(true)
                                .Messages(str => str.ItemsPerPage("تعداد سطر در صفحه").First("اولین").Last("آخرین").Next("بعدی").Previous("قبلی").Page("صفحه").Of("از").MorePages("صفحات بیشتر").Empty("خالی").Refresh("تازه سازی"))
                                    )


                                )


                            </div>

                        </div>

                        <div class='span7 box'>
                            @using (Html.BeginForm("kala_update", "prime", FormMethod.Post))
                            {
                                @Html.HiddenFor(m => m.AnbarCode)
