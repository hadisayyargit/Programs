                                                </div>

                                                <label class='control-label'>واحد کالا</label>
                                                <div class='controls'>
                                                    @*@Html.DropDownListFor(m => m.KalaVahedCode, new SelectList(myVahedList, "VahedCode", "VahedName", "0"), "واحد کالا را انتخاب کنید:", htmlAttributes: new { @id = "cboVahed", @class = "select2 input-block-level", style = "color:blue" })*@
                                                    @Html.DropDownListFor(m => m.KalaVahedCode, new SelectList(myVahedList, "VahedCode", "VahedName", "0"), "واحد کالا را انتخاب کنید:", htmlAttributes: new { @id = "cboVahed", @class = "input-block-level", style = "color:blue" })
                                                </div>

                                                <label class='control-label'>تعداد ممیز</label>
