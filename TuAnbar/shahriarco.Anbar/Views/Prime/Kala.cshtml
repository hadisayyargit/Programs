</head>

<div id='wrapper'>

    <section id='content'>
        <div class='container-fluid'>
            <div class='row-fluid' id='content-wrapper'>
                <div class='span12'>
                    @*<div class='page-header'>
                            <h1 class='pull-left'>
                                <i class='icon-user'></i>
                                <span>کالا</span>
                            </h1>
                            <div class='pull-right'>
                                <ul class='breadcrumb'>
                                    <li>
                                        <a href="index.html">
                                            <i class='icon-table'></i>
                                        </a>
                                    </li>
                                    <li class='separator'>
                                        <i class='icon-angle-right'></i>
                                    </li>
