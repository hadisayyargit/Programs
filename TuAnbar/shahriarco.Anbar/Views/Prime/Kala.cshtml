                                            @*<input type="button" class="btn btn-danger" style="font-family:Tahoma" value="حذف" onclick="kala_change($('#txtKalacode').val())" />*@

                                        </div>
                                    </div>

                                </div>
                            }
                        </div>

                    </div>
