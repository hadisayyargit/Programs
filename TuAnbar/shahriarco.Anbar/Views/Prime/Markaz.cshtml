<!DOCTYPE html>
@using Kendo.Mvc.UI

@{
    ViewBag.Title = "";
    ViewBag.tab1class = "active";
    ViewBag.tab2class = "";
    ViewBag.tab3class = "";
    ViewBag.tab4class = "";
    ViewBag.tab5class = "";
    ViewBag.tab6class = "";
    ViewBag.tab7class = "";
    ViewBag.tab8class = "";

    ViewBag.menuAnbarclass = "";
    ViewBag.menuKalaclass = "";
    ViewBag.menuMarkazclass = "current";
    ViewBag.menuAboutclass = "";

    List<shahriarco.Anbar.Models.TMar> myMarkazList = ViewBag.MarkazList;
}



<head>

    <link href="~/Content/kendo/2014.1.318/style/kendo.common.min.css" rel="stylesheet" />
    <link href="~/Content/kendo/2014.1.318/style/kendo.default.min.css" rel="stylesheet" />
    <link href="~/Content/kendo/2014.1.318/style/kendo.dataviz.min.css" rel="stylesheet" />
    <link href="~/Content/kendo/2014.1.318/style/kendo.dataviz.default.min.css" rel="stylesheet" />
    <link href="~/Content/kendo/2014.1.318/style/kendo.rtl.min.css" rel="stylesheet" />
    <link href="~/Content/kendo/2014.1.318/style/kendo.blueopal.min.css" rel="stylesheet" />
    <link href="~/Content/kendo/2014.1.318/style/kendo.blueopal.mobile.min.css" rel="stylesheet" />
    <script src="~/Content/kendo/2014.1.318/js/kendo.all.min.js"></script>
    <script src="~/Content/kendo/2014.1.318/js/kendo.aspnetmvc.min.js"></script>

</head>

<div id='wrapper'>

    <section id='content'>

        <div class='span8 box bordered-box orange-border' style='margin-bottom:0;'>

            <div class='box-header sea-blue-background'>
                <div class='title'>مراکز</div>
                <div class='actions'>
                    <a href="#" class="btn box-remove btn-mini btn-link">
                        <i class='icon-remove'></i>
                    </a>
                    <a href="#" class="btn box-collapse btn-mini btn-link">
                        <i></i>
                    </a>
                </div>
            </div>

            <div class='box-content box-no-padding'>


                <input type="button" class="btn btn-info" style="font-family:Tahoma; float:left" value="+" onclick="location.href = '/prime/markaz_Update?markazcode=0'" />

                <br />
                <br />

                @(Html.Kendo().Grid(myMarkazList).Name("MyGrid")
        .Resizable(resize => resize.Columns(true))
        .Columns(columns =>
        {
        columns.Bound("MarkazCode").Title("کد مرکز").Width(200).HtmlAttributes(new { style = "font-family:B yekan,Tahoma" });
        columns.Bound("MarkazName").Title("نام مرکز")
             .Template(@<text>
                @Html.ActionLink(@item.MarkazName, "Markaz_Update", new { markazcode = @item.MarkazCode })
            </text>);

        })


                            .Sortable()


                            .Filterable(filterable => filterable
                                            .Messages(str => str
                                            .And("و")
                                            .Cancel("لغو")
                                            .Clear("پاک")
                                            .Filter("فیلتر")
                                            .Info("فیلتر کردن گزینه ها")
                                            )
                                            .Operators(operators => operators
                                            .ForNumber(n => n.Clear()
                                                .IsEqualTo("=")
                                                .IsGreaterThan(">")
                                                .IsGreaterThanOrEqualTo(">=")
                                                .IsLessThan("<")
                                                .IsLessThanOrEqualTo("<=")
                                                .IsNotEqualTo("<>")
                                                )
                                            .ForString(str => str.Clear()
                                                .StartsWith("شروع شود با ")
                                                .IsEqualTo("برابر با")
                                                .Contains("شامل")
                                                .DoesNotContain("شامل نباشد")
                                                .StartsWith("شروع شود با")
                                                .EndsWith("تمام شود به")
                                                .IsNotEqualTo("نابرابر با")))
                                   )

                            .Pageable(pageable => pageable
                                //.PageSizes(true)
                                .PageSizes(new int[] { 10, 20, 30, 40 })
                                .ButtonCount(5).Numeric(true).Refresh(true)
                                .Messages(str => str.ItemsPerPage("تعداد سطر در صفحه").First("اولین").Last("آخرین").Next("بعدی").Previous("قبلی").Page("صفحه").Of("از").MorePages("صفحات بیشتر").Empty("خالی").Refresh("تازه سازی"))
                                    )

                //.ToolBar(toolBar => toolBar.Custom().Text("خروجی به اکسل").HtmlAttributes(new { id = "export" }).Url(Url.Action("ExportToExcel", "Reports")))
                //.ToolBar(toolBar => toolBar.Custom().Text("چاپ").HtmlAttributes(new { id = "print", onclick = "printGrid()" }))


                )


            </div>

        </div>

    </section>

</div>


