    <script src='~/Scripts/plugins/bootstrap_switch/bootstrapSwitch.min.js' type='text/javascript'></script>
    <script src='~/Scripts/plugins/common/bootstrap-wysihtml5.js' type='text/javascript'></script>
    <!-- / select2 -->
