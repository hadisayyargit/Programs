<body class='contrast-banana sign-in contrast-background'>
    <div id='wrapper'>
        <div class='application'>
            <div class='application-content'>
                <a href="sign_in.html">
                    <div class='icon-heart'></div>
                    <span>Anbar</span>
                </a>
            </div>
        </div>

        <div class='controls'>
            <div class='caret'></div>
            <div class='form-wrapper'>
                <h1 class='text-center'>ورود</h1>
                @*using (Html.BeginForm("Authenticate", "Account"))    {*@

                <form action="~/Account/Authenticate" id="login_form" method="post" class='form validate-form'>
                    <div class='row-fluid control-group'>
                        <div class='span12 icon-over-input'>
                            @Html.TextBoxFor(m => m.UserName, htmlAttributes: new { @class = "span12", @id = "username", @name = "username", @placeholder = "شناسه کاربری", @Value = "hadi" })
                            <i class='icon-user muted'></i>
                            @Html.ValidationMessageFor(m => m.UserName)
                        </div>
                    </div>


                    <div class='row-fluid control-group'>
                        <div class='span12 icon-over-input'>
                            @Html.PasswordFor(m => m.Password, htmlAttributes: new { @class = "span12", @id = "password", @name = "password", @placeholder = "گذرواژه", @style = "padding-right:28px", @value = "123" , @data_rule_minlength = "3" ,@data_ng_required = "true" })
                            <i class='icon-lock muted'></i>
                            @Html.ValidationMessageFor(m => m.Password)

                        </div>
                    </div>


                    @*<div class='row-fluid control-group'>
                        <div class='span12 icon-over-input controls'>
                            <input data-rule-minlength='6' data-ng-required="true" placeholder='Password' type='password' class="span12"/>
                        </div>
                    </div>*@


                    @*<div class='row-fluid control-group'>
                        <div class='span12 icon-over-input controls'>
                            <input data-rule-email='true' placeholder='E-mail' type='text' class="span12" />
                            <i class='icon-lock muted'></i>
                        </div>
                    </div>*@

                    <button class="btn btn-block" name="button" type="submit">ورود</button>
                </form>

            </div>
        </div>




    </div>

    <!-- / jquery -->
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src='~/Scripts/plugins/mobile_events/jquery.mobile-events.min.js' type='text/javascript'></script>
    <script src="~/Scripts/jquery-ui.min.js"></script>
    <!-- / bootstrap -->
