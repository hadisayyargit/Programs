<body class='contrast-red @ViewBag.BodyClass'>

    <header>
        <div class='navbar'>
            <div class='navbar-inner'>
                <div class='container-fluid'>
                    <a class='brand' href='~/'>
                        @*<i class='icon-heart-empty'></i>*@
                        <img src="~/assets/images/cup/cup2.png" width="32" height="32" />
                        <span class='hidden-phone'>@(((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).LName)</span>
                    </a>

                    <a class='toggle-nav btn pull-left' href='#'>
                        <i class='icon-reorder'></i>
                    </a>

                    <ul class='nav pull-right'>
                        <li class='dropdown light only-icon'>
                            <a class='dropdown-toggle' data-toggle='dropdown' href='#'>
                                <i class='icon-adjust'></i>
                            </a>
                            <ul class='dropdown-menu color-settings'>

                                <li class='divider'></li>
                                <li class='color-settings-contrast-color'>
                                    <div class='color-title'>Contrast color</div>
                                    <a href="#" data-change-to="contrast-red">
                                        <i class='icon-adjust text-red'></i>
                                        Red
                                        <small>(default)</small>
                                    </a>
                                    <a href="#" data-change-to="contrast-blue">
                                        <i class='icon-adjust text-blue'></i>
                                        Blue
                                    </a>
                                    <a href="#" data-change-to="contrast-orange">
                                        <i class='icon-adjust text-orange'></i>
                                        Orange
                                    </a>
                                    <a href="#" data-change-to="contrast-purple">
                                        <i class='icon-adjust text-purple'></i>
                                        Purple
                                    </a>
                                    <a href="#" data-change-to="contrast-green">
                                        <i class='icon-adjust text-green'></i>
                                        Green
                                    </a>
                                    <a href="#" data-change-to="contrast-muted">
                                        <i class='icon-adjust text-muted'></i>
                                        Muted
                                    </a>
                                    <a href="#" data-change-to="contrast-fb">
                                        <i class='icon-adjust text-fb'></i>
                                        Facebook
                                    </a>
                                    <a href="#" data-change-to="contrast-dark">
                                        <i class='icon-adjust text-dark'></i>
                                        Dark
                                    </a>
                                    <a href="#" data-change-to="contrast-pink">
                                        <i class='icon-adjust text-pink'></i>
                                        Pink
                                    </a>
                                    <a href="#" data-change-to="contrast-grass-green">
                                        <i class='icon-adjust text-grass-green'></i>
                                        Grass green
                                    </a>
                                    <a href="#" data-change-to="contrast-sea-blue">
                                        <i class='icon-adjust text-sea-blue'></i>
                                        Sea blue
                                    </a>
                                    <a href="#" data-change-to="contrast-banana">
                                        <i class='icon-adjust text-banana'></i>
                                        Banana
                                    </a>
                                    <a href="#" data-change-to="contrast-dark-orange">
                                        <i class='icon-adjust text-dark-orange'></i>
                                        Dark orange
                                    </a>
                                    <a href="#" data-change-to="contrast-brown">
                                        <i class='icon-adjust text-brown'></i>
                                        Brown
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class='dropdown medium only-icon widget'>
                            <a class='dropdown-toggle' data-toggle='dropdown' href='#'>
                                <i class='icon-rss'></i>
                                <div class='label'>۳</div>
                            </a>
                            <ul class='dropdown-menu'>
                                <li>
                                    <a href='#'>
                                        <div class='widget-body'>
                                            <div class='pull-left icon'>
                                                <i class='icon-user text-success'></i>
                                            </div>
                                            <div class='pull-left text'>
                                                خوش آمدید
                                                <small class='muted'>امروز</small>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li class='divider'></li>
                                <li>
                                    <a href='#'>
                                        <div class='widget-body'>
                                            <div class='pull-left icon'>
                                                <i class='icon-inbox text-error'></i>
                                            </div>
                                            <div class='pull-left text'>
                                                پیغام از طرف راهبر سیستم
                                                <small class='muted'>1 روز پیش</small>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li class='divider'></li>
                                <li>
                                    <a href='#'>
                                        <div class='widget-body'>
                                            <div class='pull-left icon'>
                                                <i class='icon-comment text-warning'></i>
                                            </div>
                                            <div class='pull-left text'>
                                                پیام جدید
                                                <small class='muted'>2روز پیش</small>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li class='divider'></li>

                                <li class='widget-footer'>
                                    <a href='#'>تمام اطلاعها</a>
                                </li>
                            </ul>
                        </li>

                        <li class='dropdown dark user-menu'>
                            <a class='dropdown-toggle' data-toggle='dropdown' href='#'>
                                @if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhotoFileName == null)
                                {
                                    string s = "";
                                    try
                                    {
                                        s = Convert.ToBase64String(((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhoto);
                                    }
                                    catch
                                    {
                                    }
                                    var imgsrc = string.Format("data:image/jpeg;base64,{0}", s);
                                    @*<img src="@string.Format("data:image/jpeg;base64,{0}", Convert.ToBase64String(((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhoto))" width='23' height='23' alt="-" />*@
                                    <img src="@imgsrc" width='23' height='23' alt="-" />
                                }
                                else
                                {
                                    <img height='23' alt="-" src="~/@(((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhotoFileName)" width='23' />
                                }
                                <span class='user-name hidden-phone'>@(((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserDs)</span>
                                <b class='caret'></b>
                            </a>
                            <ul class='dropdown-menu'>
                                @if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole != (int)footballcup.Models.UserRoleEnum.GUEST)
                                {
                                    <li>
                                        <a href='~/account/userprofile'>
                                            <i class='icon-user'></i>
                                            پروفایل
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#">
                                            <i class='icon-cog'></i>
                                            تنظیمات
                                        </a>
                                    </li>
                                    <li class='divider'></li>

                                    <li>
                                        <a href='~/Account/LogOff'>
                                            <i class='icon-signout'></i>
                                            میرم بیرون
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href='~/Account/SignIn'>
                                            <i class='icon-signin'></i>
                                            ورود به سامانه
                                        </a>
                                    </li>

                                    <li class='divider'></li>

                                    <li>
                                        <a href='~/Account/SignUp'>
                                            <i class='icon-chevron-sign-up'></i>
                                            ثبت‌نام
                                        </a>
                                    </li>
                                }

                            </ul>
                        </li>
                    </ul>

                    <form accept-charset="UTF-8" action="search_results.html" class="navbar-search pull-right hidden-phone" method="get">
                        <div style="margin:0;padding:0;display:inline">
                            <input name="utf8" type="hidden" value="&#x2713;" />
                        </div>
                        <button class="btn btn-link icon-search" name="button" type="submit"></button>
                        <input autocomplete="off" class="search-query span2" id="q_header" name="q" placeholder="Search..." type="text" value="" />
                    </form>
                </div>
            </div>

        </div>
    </header>

    <nav class='' id='main-nav'>
        <div class='navigation'>

            <div class=''>
                <a href="#" target="_blank">
                    <img alt="" src="~/assets/images/arj.jpg" width="70%" />
                </a>
            </div>

            <div class=''>
                <a href="http://www.khordadnet.ir" target="_blank">
                    <img alt="" src="~/assets/images/khordadnet.png" width="70%" />
                </a>
            </div>

            <div class=''>
                <a href="#" target="_blank">
                    @*<img alt="minoo" src="~/assets/images/minoo.jpg" width="40%"  />*@
                    <img alt="" src="~/assets/images/abangroup.png" width="70%" height="50%" />
                </a>
            </div>

        </div>
    </nav>

    <section id='content'>
        <div class='container-fluid'>
            <div class='row-fluid' id='content-wrapper'>
                <div class='span12'>
                    @{
                        string strVisibility = "hidden";
                        if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole == (int)footballcup.Models.UserRoleEnum.ADMIN || ((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole == (int)footballcup.Models.UserRoleEnum.MANAGER)
                        {
                            strVisibility = "visible";
                        }

                    }
                    <div class='page-header'>
                        <h1 class='pull-left'>
                            @*<i class='icon-dashboard'></i>*@
                            @*<img src="~/assets/images/cup/UEFA_Euro_2016.png" width="64" height="64" />*@
                            <img src="~/assets/images/cup/@(((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).PhotoFileName)" width="64" height="64" />
                            <span>@(((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).PName)</span>
                        </h1>

                        <div class='pull-right btn-group' style="visibility:@strVisibility">
                            <a href="~/Administration/cup" class="btn btn-white hidden-phone">
                                تعریف جام
                                <img src="~/assets/images/cup/cup1.png" width="16" height="16" />
                            </a>
                            <a href="~/Administration/Team" class="btn btn-white">تیم</a>
                            <a href="~/Administration/CupTeam" class="btn btn-white">تیمهای جام</a>
                            <a href="~/game/Match" class="btn btn-white ">بازیهای جام</a>
                            <a href="~/Administration/CupUser" class="btn btn-white">شرکت‌کننده‌های جام</a>

                            @*<a href="#" class="btn btn-white" id="daterange">
                                    <i class='icon-calendar'></i>
                                    <span class='hidden-phone'>راهبری</span>
                                    <b class='caret'></b>
                                </a>*@

                            <a class='btn btn-white' data-toggle='dropdown' href='#'>
                                <i class='icon-calendar'></i>
                                <span class='hidden-phone'>راهبری</span>
                                <b class='caret'></b>

                            </a>

                            <ul class='dropdown-menu' style="left: 0;right: auto;">
                                <li>
                                    <a href="~/game/Point">بازشماری امتیاز</a>
                                </li>
                                <li>
                                    <a href="~/game/Point">سازماندهی گپها</a>
                                </li>

                                <li class='divider'></li>
                                <li class='nav-header'>رسانه‌</li>
                                <li>
                                    <a href="~/Administration/cms">مدیریت محتوا</a>
                                </li>
                            </ul>

                        </div>

                    </div>

                    <div class='row-fluid'>
                        <div class='span12 box box-transparent'>

                            <div class='span2 box-quick-link blue-background'>
                                <a href="~/">
                                    <div class='header'>
                                        <div class='icon-home'></div>
                                    </div>
                                    <div class='content'>خانه</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link green-background'>
                                <a href='~/Administration/cupteam'>
                                    <div class='header'>
                                        <div class='icon-star'></div>
                                    </div>
                                    <div class='content'>تیمها</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link purple-background'>
                                <a href='~/game/match'>
                                    <div class='header'>
                                        <div class='icon-eye-open'></div>
                                    </div>
                                    <div class='content'>بازیها</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link orange-background'>
                                <a href='~/game/prediction'>
                                    <div class='header'>
                                        <div class='icon-magic'></div>
                                    </div>
                                    <div class='content'>پیش‌بینی</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link red-background'>
                                <a href='~/game/PredictionTable'>
                                    <div class='header'>
                                        <div class='icon-inbox'></div>
                                    </div>
                                    <div class='content'>جدول</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link muted-background'>
                                <a href='~/Report/ReportMaster?reportname=rptParticipant'>
                                    <div class='header'>
                                        <div class='icon-refresh'></div>
                                    </div>
                                    <div class='content'>شرکت کننده‌ها</div>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </div>

        @RenderSection("featured", required: false)
        @RenderBody()


    </section>

    <footer>
        <div class="footer">
            <a href="http://www.khordadnet.ir" target="_blank">پیاده‌سازی: <img src="~/assets/images/khordadnet.png" width="5%" height="5%" /></a>
        </div>
    </footer>

</body>

</html>
<script src="~/Scripts/jquery-1.10.2.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src='~/Scripts/jquery-migrate.min.js' type='text/javascript'></script>
