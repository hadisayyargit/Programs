							<xs:element name="Rws_Fld_fk_ChastiseReason" type="xs:int" minOccurs="0" />
							<xs:element name="Rws_Fld_ChastiseReasonDescribe" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Rws_Sp_Sel_IsEx_Eulogy">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Rws_Fld_UniqueCode" type="xs:int" />
							<xs:element name="Rws_Fld_Row" type="xs:unsignedByte" />
							<xs:element name="Rws_Fld_Describe" type="xs:string" />
							<xs:element name="Rws_Fld_Date" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_Reference" type="xs:string" minOccurs="0" />
