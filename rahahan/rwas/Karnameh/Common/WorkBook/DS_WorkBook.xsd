							<xs:element name="Rws_Fld_AbsentDay" type="xs:unsignedByte" />
							<xs:element name="Rws_Fld_PositiveScore" type="xs:double" />
							<xs:element name="Rws_Fld_NegativeScore" type="xs:double" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
