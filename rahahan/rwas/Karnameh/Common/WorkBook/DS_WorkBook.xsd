					</xs:complexType>
				</xs:element>
				<xs:element name="Rws_Sp_Sel_IsEx_PersonelAccident">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Rws_Fld_UniqueCode" type="xs:int" />
							<xs:element name="Rws_Fld_Row" type="xs:unsignedByte" />
							<xs:element name="Rws_Fld_Describe" type="xs:string" />
							<xs:element name="Rws_Fld_AccidentDate" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_AccidentLocation" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_DamageAmount" msdata:ReadOnly="true" type="xs:long" minOccurs="0" />
							<xs:element name="Rws_Fld_fk_ForfeitKind" type="xs:unsignedByte" minOccurs="0" />
							<xs:element name="Rws_Fld_ForfeitKindDescribe" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_NegativeScore" type="xs:double" />
