						<xs:sequence>
							<xs:element name="Rws_Fld_UniqueCode" type="xs:int" />
							<xs:element name="Rws_Fld_Row" type="xs:unsignedByte" />
							<xs:element name="Rws_Fld_CheckupDate" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_BodilyStatus" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_MentalStatus" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Rws_Sp_Sel_IsEx_Chastise">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Rws_Fld_UniqueCode" type="xs:int" />
							<xs:element name="Rws_Fld_Row" type="xs:unsignedByte" />
							<xs:element name="Rws_Fld_Describe" type="xs:string" />
