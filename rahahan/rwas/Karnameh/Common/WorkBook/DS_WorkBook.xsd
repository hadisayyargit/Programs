		<xs:unique name="DS_WorkBookKey3" msdata:PrimaryKey="true">
			<xs:selector xpath=".//mstns:Rws_Sp_Sel_IsEx_PersonelTraining" />
			<xs:field xpath="mstns:Rws_Fld_UniqueCode" />
			<xs:field xpath="mstns:Rws_Fld_Row" />
		</xs:unique>
		<xs:unique name="DS_WorkBookKey4" msdata:PrimaryKey="true">
			<xs:selector xpath=".//mstns:Rws_Sp_Sel_IsEx_Score" />
			<xs:field xpath="mstns:Rws_Fld_UniqueCode" />
			<xs:field xpath="mstns:Rws_Fld_Row" />
		</xs:unique>
		<xs:unique name="DS_WorkBookKey5" msdata:PrimaryKey="true">
			<xs:selector xpath=".//mstns:Rws_Sp_Sel_IsEx_Operation" />
			<xs:field xpath="mstns:Rws_Fld_UniqueCode" />
			<xs:field xpath="mstns:Rws_Fld_MonthYear" />
		</xs:unique>
