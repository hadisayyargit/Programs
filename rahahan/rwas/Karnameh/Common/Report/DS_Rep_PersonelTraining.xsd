<?xml version="1.0" encoding="utf-8" ?>
<xs:schema id="DS_Rep_PersonelTraining" targetNamespace="http://tempuri.org/DS_Rep_PersonelTraining.xsd"
	elementFormDefault="qualified" attributeFormDefault="qualified" xmlns="http://tempuri.org/DS_Rep_PersonelTraining.xsd"
	xmlns:mstns="http://tempuri.org/DS_Rep_PersonelTraining.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
	<xs:element name="DS_Rep_PersonelTraining" msdata:IsDataSet="true">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="Rws_Sp_Rep_PersonelTraining">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Prs_Fld_UniqueCode" type="xs:int" />
							<xs:element name="Prs_Fld_FirstName" type="xs:string" minOccurs="0" />
							<xs:element name="Prs_Fld_LastName" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_Row" type="xs:unsignedByte" />
							<xs:element name="Rws_Fld_TrainingTitle" type="xs:string" />
							<xs:element name="Rws_Fld_TrainingLocation" type="xs:string" />
							<xs:element name="Rws_Fld_Amount" type="xs:short" minOccurs="0" />
							<xs:element name="Rws_Fld_FromDate" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_ToDate" type="xs:string" minOccurs="0" />
							<xs:element name="Rws_Fld_Degree" type="xs:short" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>