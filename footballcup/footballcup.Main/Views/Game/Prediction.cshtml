                    alert("تاریخ مجاز پیش‌بینی گذشته و یا بازی بسته شده است");
                }


                @*var url = '@Url.Content("~/game/Prediction_Update")'+"?backurl="+ '@Url.Content("~/game/prediction")'+"&predictid=" + predictid + "&matchid=" + matchid + "&competitorid=" + competitorid + "&matchtime=" + matchtime + "&team1guess=" + $("#cboTeam1Guess" + rowno).val() + "&team2guess=" + $("#cboTeam2Guess" + rowno).val() + "&ShowPrediction=" + $("#chkShowPrediction" + rowno).prop("checked");

                window.location.replace(url);*@

            }

    function deleterow(predictid) {
        if (predictid > 0) {
            var r = confirm("آیا اطلاعات حذف شود؟");
            if (r == true) {
                var url = '@Url.Content("~/game/Prediction_delete")' + '/?predictid=' + predictid;

                window.location.replace(url);
            }
        }
            }

    function chkSelected_click(row) {
       // alert(row);
        var chk1 = document.getElementById('cboTeam1Guess' + row);
        var chk2 = document.getElementById('cboTeam2Guess' + row);

        if ($("#chkSelected" + row).prop("checked") == true)
        {
            chk1.disabled = false;
            chk2.disabled = false;
        }
        else {
              chk1.disabled = true;
              chk2.disabled = true;
        }

    }



</script>
