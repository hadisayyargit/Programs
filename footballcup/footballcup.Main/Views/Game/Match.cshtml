<script>
    $("#txtJalaliDate").datetimepicker();
    $("#cboCup").click();
    $('#txtCupId').attr('value', $("#cboCup").val());
    clearteamcombo();

</script>

<script>
    function clearteamcombo() {
        $("#cboTeam1").val(0);
        $("#cboTeam2").val(0);

        $('#flagtag1').attr('class', "")
        $('#flagtag2').attr('class', "")
    }
</script>

<script>

    $("#cboCup").click(function () {

        ///not ajax
        clearteamcombo();
        var url ='@Url.Content("~/game")'+ "/Match?cupid=" + $("#cboCup").val();
        $('#txtCupId').attr('value', $("#cboCup").val());
        $('#txtMatchId').attr('value', "0");

        window.location.replace(url);

    });


    function cboTeam1_change() {

        var con;

        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.TeamList));

        for (var i = 0; i < x.length; i++) {
            if (x[i].TeamId == $("#cboTeam1").val())
                con = x[i].con;
        }

        $('#flagtag1').attr('class', "flag flag-" + con);
    }

    function cboTeam2_change() {
        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.TeamList));

        for (var i = 0; i < x.length; i++) {
            if (x[i].TeamId == $("#cboTeam2").val())
                con = x[i].con;
        }

        $('#flagtag2').attr('class', "flag flag-" + con);
    }


    $("#btnNew").click(function () {
        var d = new Date();
        // alert(d.getFullYear() + "/" + (d.getMonth() + 1).toString() + "/" + d.getDate().toString());
        $('#txtMatchId').attr('value', "0");

        $('#txtMiladi').attr('value', d.getFullYear() + "/" + (d.getMonth() + 1).toString() + "/" + d.getDate().toString());
        $('#txtJalaliDate').attr('value', d.toLocaleDateString("fa-IR") + " ۰۰:۰۰:۰۰");

        $('#txtGroup').attr('value', "");
        $('#txtMatchNo').attr('value', "");

        $('#cboTeam1Score').val("");
        $('#cboTeam2Score').val("");

        $('#rdoMatchState0').attr('checked', true);
        $('#txtMatchCoefficient').attr('value', "1");

        clearteamcombo();
        // alert("2");
    });



    function btnSelectMatch(matchid, matchtime, groupname, matchno, team1id, team1con, team1score, team2id, team2con, team2score, matchstate, matchcoefficient) {
        clearteamcombo();

        var d = new Date(matchtime);
        $('#txtMatchId').attr('value', matchid);


        $('#txtMiladi').attr('value', matchtime);
        $('#txtJalaliDate').attr('value', d.toLocaleDateString("fa-IR") + " " + d.toLocaleTimeString("fa-IR"));

        $('#cboTeam1').val(team1id).change();
        $('#cboTeam2').val(team2id).change();
        $('#txtGroup').attr('value', groupname);
        $('#txtMatchNo').attr('value', matchno);

        $('#cboTeam1Score').val(team1score);
        $('#cboTeam2Score').val(team2score);

/*
        if (matchstate == 0) $('#rdoMatchState0').attr('checked', true);
        if (matchstate == 1) $('#rdoMatchState1').attr('checked', true);
        if (matchstate == 2) $('#rdoMatchState2').attr('checked', true);
        */

        if (matchstate == 0) $('#rdoMatchState0').prop('checked', true);
        if (matchstate == 1) $('#rdoMatchState1').prop('checked', true);
        if (matchstate == 2) $('#rdoMatchState2').prop('checked', true);


        $('#txtMatchCoefficient').attr('value', matchcoefficient);

        $('#flagtag1').attr('class', "flag flag-" + team1con);
        $('#flagtag2').attr('class', "flag flag-" + team2con);
    }

    function deleterow(matchid) {
        var r = confirm("آیا اطلاعات حذف شود؟");
        if (r == true) {
            var url = '@Url.Content("~/game")'+"/Match_Delete?matchid=" + matchid;
            window.location.replace(url);
        }
        else {
        }


        //var r2=prompt("delete?","lala");

        /*var mywindow=window.open("hi");
        mywindow.document.write("bye");*/
    }


</script>


<script>
    $("#txtJalaliDate").change(function () {

        var greg, myDate, splt1, splt2, splt, y, m, d;

        splt = $('#txtJalaliDate').val().split(" ");
        splt1 = splt[0].split("/");

        //alert($('#txtJalaliDate').val().toLocaleDateString("fa-IR"));
        //alert(splt[1]);

        y = Number(splt1[0]);
        m = Number(splt1[1]);
        d = Number(splt1[2]);

        greg = jd_to_gregorian(persian_to_jd(y, m, d));

        myDate = greg[0].toString() + "/" + greg[1].toString() + "/" + greg[2].toString() + " " + splt[1];
        $('#txtMiladi').attr('value', myDate);

    });

</script>














