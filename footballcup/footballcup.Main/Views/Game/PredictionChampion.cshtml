<script>

    $("#cboCup").click(function () {

        ///not ajax

        var url = '@Url.Content("~/game")'+"/PredictionChampion?cupid=" + $("#cboCup").val();
        $('#txtCupId').attr('value', $("#cboCup").val());
        //$('#txtId').attr('value', "0");

        window.location.replace(url);

    });


    function cboTeam1_change(rowno) {

        var con;

        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.TeamList));

        var teamid = $("#cboTeam1_" + rowno).val();

        for (var i = 0; i < x.length; i++) {
            if (x[i].TeamId == teamid)
                con = x[i].con;
        }

        $('#flagtag1_' + rowno).attr('class', "flag flag-" + con);

    }

    function cboTeam2_change(rowno) {

                var con;

        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.TeamList));

        var teamid = $("#cboTeam2_" + rowno).val();

        for (var i = 0; i < x.length; i++) {
            if (x[i].TeamId == teamid)
                con = x[i].con;
        }

        $('#flagtag2_' + rowno).attr('class', "flag flag-" + con);

    }

    function cboTeam3_change(rowno) {

                var con;

        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.TeamList));

        var teamid = $("#cboTeam3_" + rowno).val();

        for (var i = 0; i < x.length; i++) {
            if (x[i].TeamId == teamid)
                con = x[i].con;
        }

        $('#flagtag3_' + rowno).attr('class', "flag flag-" + con);

    }


</script>

