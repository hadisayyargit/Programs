
@{
    List<footballcup.Models.PredictionView> PredictionList = ViewBag.PredictionList;
    int totalpages = ViewBag.TotalPages;
    int pageno = ViewBag.PageNo;
    int pagesize = ViewBag.PageSize;
    int allmatch = ViewBag.AllMatch;

    string strOptionClass5 = "", strOptionClass10 = "", strOptionClass25 = "", strOptionClass50 = "", strOptionClass100 = "";

    int nFrom = 0, nTo = 0, nTotalrows = 0 ;

    nTotalrows = ViewBag.TotalRows;
    nFrom = (pageno-1) * pagesize+1;
    nTo = nFrom + PredictionList.Count-1;
}

<link href="~/Content/plugins/datatables/bootstrap-datatable.css" rel="stylesheet" />

<link href='~/Content/plugins/flags/flags.css' media='all' rel='stylesheet' type='text/css' />

<div class='container-fluid'>
    <div class='row-fluid' id='content-wrapper'>



        <div class='span11 offset1'>

            <div class='box-content box-no-padding'>
                <div class='responsive-table'>
                    <div class='scrollable-area'>


                        <div class="dataTables_wrapper form-inline" id="DataTables_Table_0_wrapper" role="grid">

                            <div class="">
                                <label>@Html.RadioButton("ABC", 1, (allmatch == 1), htmlAttributes: new { @id = "rdoMatchOption1" })نمایش همه بازیها</label>
                                <label>@Html.RadioButton("ABC", 0, (allmatch == 0), htmlAttributes: new { @id = "rdoMatchOption0" })نمایش بازیهای پیش رو</label>
                            </div>

                            <div class="row-fluid">
                                @{
                                    if (pagesize == 5)
                                    {
                                        strOptionClass5 = "selected='selected'";
                                    }
                                    if (pagesize == 10)
                                    {
                                        strOptionClass10 = "selected='selected'";
                                    }
                                    if (pagesize == 25)
                                    {
                                        strOptionClass25 = "selected='selected'";
                                    }
                                    if (pagesize == 50)
                                    {
                                        strOptionClass50 = "selected='selected'";
                                    }
                                    if (pagesize == 100)
                                    {
                                        strOptionClass100 = "selected='selected'";
                                    }
                                }


                                <div class="span6">
                                    <div class="dataTables_length" id="DataTables_Table_0_length">
                                        <label>
                                            <select name="DataTables_Table_0_length" aria-controls="DataTables_Table_0" size="1" >
                                                <option value="5" @strOptionClass5 onclick="godatapage(@allmatch,1,5)">5</option>
                                                <option value="10" @strOptionClass10 onclick="godatapage(@allmatch,1,10)">10</option>
                                                <option value="25" @strOptionClass25 onclick="godatapage(@allmatch,1,25)">25</option>
                                                <option value="50" @strOptionClass50 onclick="godatapage(@allmatch,1,50)" >50</option>
                                                <option value="100" @strOptionClass100 onclick="godatapage(@allmatch,1,100)">100</option>
                                            </select> records per page
                                        </label>
                                    </div>
                                </div>
                                <div class="span6 text-right">
                                    <div class="dataTables_filter" id="DataTables_Table_0_filter">
                                        <label>Search: <input aria-controls="DataTables_Table_0" id="txtSearch" type="text"></label>
                                    </div>
                                </div>
                            </div>

                            <table class='table table-bordered ' style='margin-bottom:0;' id="myTable">
                                @*<table class='data-table-column-filter table table-bordered ' style='margin-bottom:0;'>*@
                                <thead>
                                    <tr>
                                        <th width="100px">شماره بازی </th>
                                        <th width="200px">بازی</th>
                                        <th style="min-width:200px">شرکت کننده</th>
                                        <th width="200px">پیش‌بینی </th>
                                        <th width="50px">امتیاز</th>
                                        <th width="50px">زمان پیش‌بینی </th>
                                        <th width="20px">وضعیت بازی</th>
                                        <th width="20px">نام جام</th>
                                        @*<th width="100px" >زمان ثبت</th>*@
                                    </tr>
                                </thead>
                                <tbody>

                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>شماره بازی </th>
                                        <th>نام تیم</th>
                                        <th colspan="6"  placeholder="شرکت کننده" >
                                            شرکت کننده
                                            
                                        </th>

                                    </tr>
                                </tfoot>

                            </table>

                            <div class="row-fluid" style="" >
                                <div class="span6">
                                    <div class="dataTables_info" id="DataTables_Table_0_info">Showing @pageno to @nTo of @nTotalrows entries</div>
                                </div>
                                <div class="span6 text-right">
                                    <div class="dataTables_paginate paging_bootstrap pagination pagination-small">
                                        <ul id="pagestring">
                
                                        </ul>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/Scripts/plugins/datatables/jquery.dataTables.columnFilter.js"></script>


<script>
    (function () {
        $(document).ready(function () {

           // setDataTable($(".data-table"));
            //setDataTable($(".data-table-column-filter")).columnFilter();            
            godatapage(0, 1, 10);
             
        });
    }).call(this);

</script>

<script>
    function godatapage(allmatch, pageno, pagesize,searchkey) {

        
        //alert(pageno);
        //alert(pagesize);
        //alert(searchkey);

        $.ajax({
            cache: false,
            type: "GET",
            url: "@(Url.Action("gopageajax", "game"))",
            data: { "allmatch": allmatch, "pageno": pageno, "pagesize": pagesize, "searchkey": searchkey},
        success: function (data) {



            if (data != null) {

               

                
                //var value2 = $("#myTable tbody").children('tr:first').children('th:first').text();
                //var value3 = $("#pagestring").text();
                //var data1 = table.row($("#myTable").parents('tr')).data();
                //alert(data1[0]);
                //$(row).addClass('selected');

                $("#myTable tbody").text("");



                for (var i = 0; i < data.predictionlist.length; i++) {



                    var matchpoint = 0;
                    var strCellStyle = "", strMatchStateLabel = "", strMatchStateClass = "";

                    matchpoint = data.predictionlist[i].CompetitorMatchPoint;


                    if (data.predictionlist[i].MatchCoefficient > 1) {
                        strCellStyle = "background: violet;font-style:italic;font-weight:bold";
                        if (matchpoint > 8)
                            //strCellStyle = "label-success";
                            strCellStyle = "background-color:slateblue";
                    }
                    else
                    {
                        if (matchpoint = 0) strCellStyle = "";

                        if (matchpoint >= 1) strCellStyle = "background-color:#f89406";

                        if (matchpoint >= 3) strCellStyle = "background-color:lightskyblue";


                        if (matchpoint == 8)                         //strCellStyle = "label-success";
                            strCellStyle = "background-color:seagreen";
                    }
               


                    if (data.predictionlist[i].MatchState == 1) {
                        strMatchStateLabel = "پایان یافته(بسته)";
                        strMatchStateClass = "background-color:gray";
                    }
                    else if (data.predictionlist[i].MatchState == 2) {
                        strMatchStateLabel = "در حال بازی...";
                        strMatchStateClass = "background-color:lightgreen";
                    }
                    else {
                        strMatchStateLabel = " شروع نشده(باز)";

                    }

                    var strInner = "<tr>"
                        + "<td style= 'background-color:blanchedalmond; cursor:pointer;' class='la' > " + data.predictionlist[i].MatchNo + "</td>"
                        + "<td>"
                        + "<div class=''>"
                        + "<i class='flag flag-" + data.predictionlist[i].con1 + "'></i>"
                        + data.predictionlist[i].Team1PName
                        + "<text class='text-red' style='font-size:30px'>" + data.predictionlist[i].Team1Score + "</text>-"
                        + "<text class='text-red' style='font-size:30px'>" + data.predictionlist[i].Team2Score + "</text>"
                        + " <i class='flag flag-" + data.predictionlist[i].con2 + "'></i>"
                        + data.predictionlist[i].Team2PName
                        + "</div>"
                        + "</td>"

                        + "<td>";

                    
                    strInner +=
                        " <a href=" + data.predictionlist[i].imgsrc + " target='_blank'>"
                        + " <img alt='' height='64' src='" + data.predictionlist[i].imgsrc + "'  />"
                        + "  </a>"

                    if (data.predictionlist[i].ParticipantType == 0) {
                        strInner += " <text style=background-color:rosybrown>" + data.predictionlist[i].CompetitorName + "</text>";
                    }
                    else {
                        strInner +=  " <text>" + data.predictionlist[i].CompetitorName + "</text>";
                    }

                        + "</td>";


                    if ((data.predictionlist[i].MatchState == 0) && (data.predictionlist[i].ShowPrediction == false)) {
                        strInner += "<td><span class='label' style='background-color: #3c3c3c;color: #3c3c3c;'>" + data.predictionlist[i].Team1PName + " " + data.predictionlist[i].Team1Guess + "-" + data.predictionlist[i].Team2PName + " " + data.predictionlist[i].Team2Guess + "</span> </td>";
                    }
                    else {
                        strInner += "<td style='" + strCellStyle+"'>" + data.predictionlist[i].Team1PName + " " + data.predictionlist[i].Team1Guess + "-" + data.predictionlist[i].Team2PName + " " + data.predictionlist[i].Team2Guess + " </td>";
                    }

                    strInner += "<td><span style='" + strCellStyle + "'>" + data.predictionlist[i].CompetitorMatchPoint + "</span ></td>"
                        + "<td style='visibility:visible'>" + data.predictionlist[i].strJalali + "</td>"
                        + "<td style=" + strMatchStateClass + ">" + strMatchStateLabel + " </td>"
                        + " <td>" + data.predictionlist[i].CupName + "</td>"
                        + "</tr>";


                    $("#myTable tbody").append(strInner);

                }


                $("#pagestring").text("");

                var strInner1 = "<li class='prev'> <a href='#' onclick='godatapage(" + allmatch + ",1," + pagesize + ")'>« First</a>  </li>";


                if (pageno == 1) {
                    strInner1 += "<li class='prev disabled'> <a href='#' >← Previous</a>  </li>";
                }
                else {
                    strInner1 += "<li class='prev'> <a href='#' onclick='godatapage(" + allmatch + "," + (pageno - 1) + "," + pagesize + ")'>← Previous</a>  </li>";
                }

                strInner1 += "<li class='active'> <a href='#' onclick='godatapage(" + allmatch + "," + pageno + "," + pagesize + ")'>" + (pageno) + "</a>  </li>";

                if (data.totalpages > 1 && pageno < data.totalpages) {
                    strInner1 += "<li class=''> <a href='#' onclick='godatapage(" + allmatch + "," + (pageno + 1) + "," + pagesize + ")'>" + (pageno + 1) + "</a> </li>";
                }

                if (data.totalpages > 2 && pageno < data.totalpages - 1) {
                    strInner1 += " <li class=''> <a href='#' onclick='godatapage(" + allmatch + "," + (pageno + 2) + "," + pagesize + ")'>" + (pageno + 2) + "</a> </li>";
                }

                if (pageno == data.totalpages) {
                    strInner1 += "<li class='next disabled'> <a href='#' >Next →</a> </li>";
                }
                else {
                    strInner1 += "<li class='next'> <a href='#' onclick='godatapage(" + allmatch + "," + (pageno + 1) + "," + pagesize + ")'>Next →</a> </li>";

                }


                strInner1 += "<li class=''> <a href='#' onclick='godatapage(" + allmatch + "," + data.totalpages + "," + pagesize + ")'>Last » </a> </li>";

                $("#pagestring").append(strInner1);

                $("#DataTables_Table_0_info").text("");
                $("#DataTables_Table_0_info").append(" نمایش رکورد " + ((pageno - 1) * pagesize + 1) + " تا " + pageno * pagesize + " از " + @nTotalrows  );
                //Showing @pageno to @nTo of @nTotalrows entries

            }

            else {
                alert("خطا در بازیابی");

            }
        }
        , error: function (data) {
            if (data != null) {
                alert("data is ok with error");
            }
            else {
                alert(data);
            }
        }

    });

        }
</script>

<script>

    $("#txtSearch").keyup(function () {
        // alert($("#txtSearch").val());
        //alert($("#rdoMatchOption0").val());
        if ($("#rdoMatchOption0").attr("checked") == "checked")
           godatapage(0, 1, 100, $("#txtSearch").val());
        else
            godatapage(1, 1, 100, $("#txtSearch").val());

    });


</script>

<script>

    $("#rdoMatchOption0").click(function () {
       // alert($("#rdoMatchOption0").attr("checked"));
            var url = '@Url.Content("~/game")'+'/PredictionTable?allmatch=0';
            window.location.replace(url);

            // alert("1");
        });

    $("#rdoMatchOption1").click(function () {           
           // alert($("#rdoMatchOption0").attr("checked"));
            var url = '@Url.Content("~/game")'+'/PredictionTable?allmatch=1';
            window.location.replace(url);           
        });
</script>
