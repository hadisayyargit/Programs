                        <br />
                        <br />
                        <img id="img7" alt='Avatar' src='~/assets/images/Help/fc7.png' />
                        <br />
                        <br />
                        <img id="img7_1" alt='Avatar' src='~/assets/images/Help/fc7_1.png' />

                    </div>

                </div>
