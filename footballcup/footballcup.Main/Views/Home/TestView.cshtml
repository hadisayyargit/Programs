

@{
    //index view
    string cupPname = "";
    int cupid = 0;
    string sendbuttonstyle = "";
    string struserid = "", username = "";
    string imagesrc1 = "";

    try
    {
        struserid = ((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserId.ToString();
        username = ((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserDs;


        string s = "";
        byte[] tp = ((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhoto;
        s = Convert.ToBase64String(tp);
        imagesrc1 = string.Format("data:image/jpeg;base64,{0}", s);

    }
    catch
    {
    }

    try
    {
        cupid = ((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).CupId;
        cupPname = ((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).PName;
    }
    catch
    {

    }

    List<footballcup.Models.CmsView> myCmsList = new List<footballcup.Models.CmsView>();
    if (ViewBag.CmsList != null) { myCmsList = ViewBag.CmsList; }
    List<footballcup.Models.CmsView> myGalleryList = new List<footballcup.Models.CmsView>();

    if (ViewBag.CmsList != null)
    {
        myGalleryList = ViewBag.CmsList;
        myGalleryList = myCmsList.Where(m => m.IsChat == false && m.IsSlider == true && m.CupId == cupid).ToList();
    }


    List<footballcup.Models.CmsView> myNewsList = new List<footballcup.Models.CmsView>();
    try
    {
        myNewsList = myCmsList.Where(m => m.IsChat == false && m.IsHotNews == true && m.CupId == cupid).ToList().OrderByDescending(m => m.PublishDate).ToList();
    }
    catch
    { }

    ///گرفتن 100 رکورد آخر
    List<footballcup.Models.CmsView> myChatList = new List<footballcup.Models.CmsView>();
    try
    {
        myChatList = myCmsList.Where(m => m.IsChat == true).Reverse().Take(100).Reverse().ToList();
    }
    catch { }

    List<footballcup.Models.CompetitorView> myTopCompetitorList = new List<footballcup.Models.CompetitorView>();
    if ((List<footballcup.Models.CompetitorView>)Session[CommonUnit.GlobalModule.m_CompetitorList] != null)
    {
        myTopCompetitorList = (List<footballcup.Models.CompetitorView>)Session[CommonUnit.GlobalModule.m_CompetitorList];
        myTopCompetitorList = myTopCompetitorList.OrderByDescending(m => m.TotalPredictionsPoint + m.InitialPoint + m.SpecialPoint).Take(4).ToList();
    }

    string myPath = Server.MapPath("~/assets/images/gallery/");
    string filename = "";


    List<footballcup.Models.MatchView> myEndedMatchList = ViewBag.MatchList_4Ended;

    List<footballcup.Models.PredictionView> myNextMatchList = ViewBag.MatchList_4Upcoming;

    /*

    List<footballcup.Models.PredictionView> myEndedMatchList = new List<footballcup.Models.PredictionView>();
    try
    {
        // myEndedMatchList = myMatchList.Where(m => m.MatchState == 1).Reverse().Take(4).Reverse().ToList();
        myEndedMatchList = myMatchList.Where(m => m.MatchState == 1).OrderByDescending(m => m.MatchNo).Take(4).ToList();
    }

    catch
    {

    }


    List<footballcup.Models.PredictionView> myNextMatchList = new List<footballcup.Models.PredictionView>();

    try
    {
        myNextMatchList = myMatchList.Where(m=> (m.CompetitorId==int.Parse(struserid) || m.CompetitorId==0) &&  (m.MatchState == 0 || m.MatchState == 2)).OrderBy(m => m.MatchTime).ToList().Take(4).ToList();
    }
    catch
    {

    }

    */



    if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole == (int)footballcup.Models.UserRoleEnum.GUEST)
    {
        sendbuttonstyle = "visibility:hidden";
    }

}



