    <section id='content' style=" border:double;width:90%">

        <div class='container-fluid' style="height:300px">
            <div class='row-fluid' id='content-wrapper'>
                <div class='span12'>
                    @{
                        string strVisibility = "hidden";
                        if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole == (int)footballcup.Models.UserRoleEnum.ADMIN)
                        {
                            strVisibility = "visible";
                        }

                    }
                    <div class='page-header' style="margin-right:0px">
                        <h1 class='pull-left'>
                            @*<i class='icon-dashboard'></i>*@
                            <img src="~/assets/images/cup/@(((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).PhotoFileName)" width="64" height="64" />
                            <span style="font-family:myfont_nastaliq; color:teal">@(((footballcup.Models.Cup)Session[CommonUnit.GlobalModule.m_CurrentCup]).PName)</span>
                        </h1>

                        <div class='pull-right btn-group' id="adminbar">

                            @if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole == (int)footballcup.Models.UserRoleEnum.ADMIN)
                            {
                                <a class="btn btn-white" href="~/Administration/cup" style="visibility:@strVisibility">
                                    <img src="~/assets/images/cup/cup1.png" width="16" height="16" />
                                    <span class='hidden-phone'>جام</span>
                                </a>

                                <a href="~/Administration/CupTeam" class="btn btn-white" style="visibility:@strVisibility">تیمهای جام</a>
                                <a href="~/Administration/Competitor" class="btn btn-white" style="visibility:@strVisibility">شرکت‌کننده‌ها</a>
                            }
                            <a href="~/Account/AppUserList" class="btn btn-white">دوستان</a>
                            @if (((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).UserRole == (int)footballcup.Models.UserRoleEnum.ADMIN)
                            {
                                <a class='btn btn-white' data-toggle='dropdown' href='#' style="visibility:@strVisibility">
                                    <i class='icon-calendar'></i>
                                    <span class='hidden-phone'>راهبری</span>
                                    <b class='caret'></b>

                                </a>

                                <ul class='dropdown-menu' style="left: 0;right: auto;visibility:@strVisibility">
                                    <li>
                                        <a href="~/game/UpdateTotalPoints">بازشماری امتیاز</a>
                                    </li>
                                    <li>
                                        <a href="~/administration/notification">سازماندهی پیامها</a>

                                    </li>

                                    <li class='divider'></li>
                                    <li class='nav-header'>رسانه‌</li>
                                    <li>
                                        <a href="~/Administration/cms">مدیریت محتوا</a>
                                    </li>
                                </ul>

                            }
                        </div>

                    </div>

                    <div class='row-fluid'>
                        <div class='span12 box box-transparent'>

                            <div class='span2 box-quick-link blue-background'>
                                <a href="~/">
                                    <div class='header'>
                                        <div class='icon-home'></div>
                                    </div>
                                    <div class='content'>خانه</div>
                                </a>
                            </div>



                            <div class='span2 box-quick-link purple-background'>
                                <a href='~/game/match'>
                                    <div class='header'>
                                        <div class='icon-eye-open'></div>
                                    </div>
                                    <div class='content'>بازیها</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link orange-background'>
                                <a href='~/game/prediction'>
                                    <div class='header'>
                                        <div class='icon-magic'></div>
                                    </div>
                                    <div class='content'>پیش‌بینی</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link green-background'>
                                <a href='~/game/predictionchampion'>
                                    <div class='header'>
                                        <div class='icon-star'></div>
                                    </div>
                                    <div class='content'>پیش‌بینی ویژه</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link red-background'>
                                <a href='~/game/PredictionTable'>
                                    <div class='header'>
                                        <div class='icon-inbox'></div>
                                    </div>
                                    <div class='content'>جدول پیش‌بینیها</div>
                                </a>
                            </div>

                            <div class='span2 box-quick-link brown-background'>
                                <a href='~/Report/ReportMaster?reportname=rptParticipant'>
                                    <div class='header'>
                                        <div class='icon-refresh'></div>
                                    </div>
                                    <div class='content'>امتیازات</div>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </div>

        @RenderSection("featured", required: false)

        @RenderSection("scripts", required: false)

        @RenderBody()


    </section>


    <footer>
        <div class="footer">
            <a href="http://www.khordadnet.ir" target="_blank" style="font-family:myfont_nastaliq">پیاده‌سازی: <img src="~/assets/images/khordadnet.png" width="5%" height="5%" /></a>
        </div>
    </footer>

</body>




