<script>
    function makenotificationmenu() {

        var innerhtml = "";
        //alert(3);
        var mylist = @Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(MessageList));
        var messagecount = @Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(MessageCount));

            if (mylist != null) {

                    innerhtml = "<a class='dropdown-toggle' data-toggle='dropdown' href='#'>"
                        + "<i class='icon-comment'></i>&nbsp;"
                        + "<div class='label'> " + messagecount + "</div>"
                        + "</a>"
                    + "<ul class='dropdown-menu'>";


                for (var i = 0; i < mylist.length; i++)
                {
                    var item = mylist[i];

                        innerhtml = innerhtml + " <li class='divider'></li>"

                            + "<li class='divider'></li>"
                            + "<li>"
                            + "<a href='@Url.Content("~/Administration/notification")'?cmsid=" + item.CmsId + "'>"
                            + "<div class='widget-body'>"
                            + "<div class='pull-left icon'>";


                        if (item.AuthorId == 1)
                        {
                            innerhtml = innerhtml + " <i class='icon-inbox text-error'></i>";
                        }
                        else
                        {
                            innerhtml = innerhtml + "<i class='icon-comment text-warning'></i>";
                        }

                        innerhtml = innerhtml + " </div>"
                                + "<small class='date pull-right muted'>"
                                + "  <span class='timeago fade has-tooltip' data-placement='top' title='"+item.PublishDate+"'"+item.Body+"</span>"
                                + "</small>"
                            + "<div class='pull-left text '>"
                            + item.CmsId

                            + "<img  src=data:image/jpeg;base64," + btoa(String.fromCharCode.apply(null, item.AuthorThumbnail)) + " height='23' />"
                        + " &nbsp; " + item.Title
                                + "</div>"
                                + "</div>"
                                + "</a>"
                                + "</li>"
                                + "<li class='divider'></li>";

                    }



                    innerhtml = innerhtml + " <li class='widget-footer' >"
                        + "<a href='@Url.Content("~/Administration/notification")'>همه اطلاعها</a>"
                            + "</li>"
                            + "</ul>";


                            }



            $('#notificationmenu').empty();

            $('#notificationmenu').append(innerhtml);

                        }


</script>


<script>

    function showpopup(message) {
        // alert(message);
        $("#myPopup").text(message);
        //$("#myPopup").classList.toggle("show");
        var popup = document.getElementById("myPopup");
        popup.classList.toggle("show");
        popup.style.visibility = "visible";

        // alert("m");
    }
</script>

<script>

    if ("serviceWorker" in navigator) {
        //  alert("service worker is ok");

        navigator.serviceWorker
            .register("~/serviceWorker.js")
            .then(reg => {
                console.log("Service worker registred successfully", reg);
            })
            .catch(err => {
                console.log("service worker not registred !!", err);
            });
    }
    else {
        alert("service worker has not supported");
    }
</script>


