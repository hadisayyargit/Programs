                                    string s = "";
                                    try
                                    {
                                        s = Convert.ToBase64String(((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhoto);
                                    }
                                    catch
                                    {
                                    }
                                    var imgsrc = string.Format("data:image/jpeg;base64,{0}", s);
                                    <img src="@imgsrc" width='23' height='23' alt="-" />
                                }
                                else
                                {
                                    <img height='23' alt="-" src="~/@(((footballcup.Models.AppUserView)Session[CommonUnit.GlobalModule.m_CurrentUser]).ThumbnailPhotoFileName)" width='23' />
