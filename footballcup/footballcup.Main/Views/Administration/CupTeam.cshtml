@*@model footballcup.Models.Cup*@
@model List<footballcup.Models.CupTeamView>

<link href="~/Content/bootstrap-rtl/bootstrap-rtl.min.css" rel="stylesheet" />
<link href="~/Content/plugins/datatables/bootstrap-datatable.css" rel="stylesheet" />
<link href='~/Content/plugins/flags/flags.css' media='all' rel='stylesheet' type='text/css' />


<div class='container-fluid'>
    <div class='row-fluid' id='content-wrapper'>
        <div class='span12'>

            <div class='page-header'>
                <h1 class='pull-right'>
                    <i class='icon-user'></i>
                    <span>تیمهای جام</span>
                </h1>

            </div>

            <div class='row-fluid'>

                <div class='span3 box'>
                    <div class='box row-fluid' style="">
                        @*@Html.DropDownListFor(m => m.CupId, new SelectList(ViewBag.CupList, "CupId", "PName", "0"), htmlAttributes: new { @class = "select2 input-block-level", @id = "cboCup", @data_placeholder = "جام را انتخاب کنید" })*@
                        @Html.DropDownList("cboCup", new SelectList(ViewBag.CupList, "CupId", "PName", ViewBag.Cup.CupId), htmlAttributes: new { @class = " input-block-level", @id = "cboCup", @data_placeholder = "جام را انتخاب کنید" })
                    </div>

                    <div class='box-content'>

                        <img id="img1" alt="کاپ" src="~/assets/images/cup/@ViewBag.Cup.PhotoFileName" width="100%" height='100%' />

                    </div>

                </div>

                <div class='span9 box'>
                    <div class='box-content box-double-padding'>
                        @using (Html.BeginForm("CupTeam_Update", "administration", new { cupid = ViewBag.Cup.CupId }, FormMethod.Post))
                        {

                            @*<fieldset>*@
                            <div class='offset1'>

                                <div class='box-content box-no-padding' style="width:auto">
                                    <div class='responsive-table'>
                                        <div class='scrollable-area'>
                                            <table class=' table  table-bordered table-striped  table-hover' id='inplaceediting-user' style='margin-bottom:0;'>
                                                <thead>
                                                    <tr>

                                                        <th class='only-checkbox' style="width:10px">
                                                            <input id='check-all' type='checkbox' />
                                                        </th>
                                                        <th style="width:10px"> شناسه</th>
                                                        <th></th>
                                                        <th>
                                                            نام تیم
                                                        </th>
                                                        <th style="width:10px">
                                                            نام لاتین
                                                        </th>
                                                        <th style="width:10px">
                                                            حروف اختصاری
                                                        </th>
                                                        <th>رده  </th>
                                                        <th></th>

                                                    </tr>
                                                </thead>
                                                <tbody>


                                                    @for (int i = 0; i < Model.Count; i++)
                                                    {
                                                        var team = Model[i];
                                                        bool bSelected = false;
                                                        if (team.CupId != 0)
                                                        {
                                                            bSelected = true;
                                                        }

                                                        <tr>

                                                            <td class='only-checkbox'>
                                                                @*@if (team.CupId != 0)
                                                    {
                                                        <input type='checkbox' checked="checked" />
                                                    }
                                                    else
                                                    {
                                                        <input type='checkbox' />
                                                    }*@

                                                                @Html.CheckBoxFor(m => m[i].selected, htmlAttributes: new { @id = "chkSelected", @class = "", @style = "", @enabled = "enabled" })
                                                            </td>
                                                            <td style="background-color:blanchedalmond; cursor:pointer" onclick='SelectTeam("@team.TeamId","@team.TeamPName", "@team.TeamRank", " @team.con")'>
                                                                @Html.TextBoxFor(m => m[i].Id, htmlAttributes: new { style = "width:50px;background-color:blanchedalmond", @readonly = "true" })
                                                            </td>
                                                            <td>
                                                                @Html.HiddenFor(m => m[i].CupId)
                                                                @Html.HiddenFor(m => m[i].TeamId)
                                                            </td>


                                                            <td>
                                                                <i class='flag flag-@team.con.ToLower()'></i>
                                                                @team.TeamPName
                                                            </td>
                                                            <td>@team.TeamLName</td>
                                                            <td class="">
                                                                <div class='text-right'>@team.con</div>
                                                            </td>
                                                            <td>
                                                                @Html.TextBoxFor(m => m[i].TeamRank, htmlAttributes: new { style = "width:50px;color:blue" })
                                                            </td>
                                                            <td>
                                                                <a class='btn btn-danger btn-mini' href='~/Administration/CupTeam_Delete?cupid=@team.CupId&teamid=@team.TeamId'>
                                                                    <i class='icon-remove'></i>
                                                                </a>
                                                            </td>

                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            @*</fieldset>*@

                            <hr class='hr-normal' />

                            <fieldset>
                                <div class='span4 box'>
                                    <div class='lead'>
                                        <i class='icon-ambulance contrast'></i>
                                        عملیات
                                    </div>
                                    <small class='muted'>تیمهای جام را انتخاب کرده و دگمه بروزرسانی را بزنید</small>
                                </div>

                            </fieldset>
                            @*<div class='span4 box'>

                </div>*@

                            <button class='btn btn-primary btn-large' id="btnUpdate" type="submit">
                                <i class='icon-save'></i>
                                بروزرسانی
                            </button>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src='~/Scripts/jquery_ui/jquery-ui.min.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/datatables/jquery.dataTables.min.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/datatables/jquery.dataTables.columnFilter.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/common/bootstrap-wysihtml5.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/charCount/charCount.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/naked_password/naked_password-0.2.4.min.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/nestable/jquery.nestable.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/tabdrop/bootstrap-tabdrop.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/bootstrap_datetimepicker/bootstrap-datetimepicker.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/bootstrap_maxlength/bootstrap-maxlength.min.js' type='text/javascript'></script>



<script src='~/Scripts/tables.js' type='text/javascript'></script>
<script src='~/Scripts/theme.js' type='text/javascript'></script>


