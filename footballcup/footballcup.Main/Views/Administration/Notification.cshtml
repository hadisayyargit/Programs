<script>

    $("#btnNew").click(function () {

        $('#txtCmsId').attr('value', "0");

        $('#txtTitle').val("");
        $('#txtBody').val("");

        $('#cboTarget').val("");

        $('#cboAuthor').val(@uid);
        $('#txtAuthorId').val(@uid);

        $("#chkIsActive").prop("checked", true);

    });



    function btnSelectCms(cmsid, authorid, targetid, title, body, publishdate, isactive) {
       // alert(publishdate);

        $('#txtCmsId').attr('value', cmsid);
        $('#txtTitle').attr('value', title);
        $('#txtBody').val(body);

        $('#cboAuthor').val(authorid);
        $('#txtAuthorId').val(authorid);
        $('#cboTarget').val(targetid).change();

        if (targetid == 0)
            $('#cboTarget').val("");

        $('#chkIsActive').prop('checked', (isactive == "true"));

        $('#txtPublishDate').val(publishdate);

    }

    $("#btnDelete").click(function () {
        var r = confirm("آیا پیام حذف شود؟");
        if (r == true) {
            if ($('#cboAuthor').val() != @uid)
            {
                //mywindow.document.write("شما اجازه حذف پیام دیگران را ندارید");
                alert("شما اجازه حذف پیام دیگران را ندارید");
            }
            else {
                var cmsid = $('#txtCmsId').val();
                var url = '@Url.Content("~/Administration")'+'/Notification_Delete?cmsid=' + cmsid;
                
                window.location.replace(url);
            }
        }

         // var mywindow=window.open("HH");
        //var r2=prompt("delete?","lala");


    });

    function btnChangeReadstatus(cmsid, authorid, targetid) {
        var url ='@Url.Content("~/Administration")'+'/Notification_UpdateReadStatus?cmsid=' + cmsid + '&authorid=' + authorid + '&targetid=' + targetid;

 
        //alert(url);
        window.location.replace(url);
    }



</script>

