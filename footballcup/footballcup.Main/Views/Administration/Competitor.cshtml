@model List<footballcup.Models.CompetitorView>

<link href="~/Content/plugins/datatables/bootstrap-datatable.css" rel="stylesheet" />

<div class='container-fluid'>
    <div class='row-fluid' id='content-wrapper'>
        <div class='span12'>

            <div class='page-header'>
                <h1 class='pull-right'>
                    <i class='icon-user'></i>
                    <span>شرکت کنندگان جام</span>
                </h1>

            </div>

            <div class='row-fluid'>

                <div class='span3 box'>
                    <div class='box row-fluid' style="">
                        @Html.DropDownList("cboCup", new SelectList(ViewBag.CupList, "CupId", "PName", ViewBag.Cup.CupId), htmlAttributes: new { @class = " input-block-level", @id = "cboCup", @data_placeholder = "جام را انتخاب کنید" })
                    </div>

                    <div class='box-content'>

                        <img id="img1" alt="کاپ" src="~/assets/images/cup/@ViewBag.Cup.PhotoFileName" width="100%" height='100%' />

                    </div>

                </div>

                <div class='span9 box '>
                    <div class='box-content box-double-padding '>
                        @using (Html.BeginForm("Competitor_Update", "administration", new { cupid = ViewBag.Cup.CupId }, FormMethod.Post))
                        {
                            <div class='offset1'>

                                <div class='box-content box-no-padding '>
                                    <div class='responsive-table'>
                                        <div class='scrollable-area'>
                                            @*<table class='table table-hover table-bordered'>*@
                                            <table class='data-table table table-bordered table-striped' style='margin-bottom:0;width:auto'>
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th class='only-checkbox'></th>
                                                        <th>
                                                            شرکت کننده
                                                        </th>
                                                        <th>
                                                            شناسه کاربری
                                                        </th>
                                                        <th>
                                                            وضعیت
                                                        </th>
                                                        <th>
                                                            امتیاز اولیه
                                                        </th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @for (int i = 0; i < Model.Count; i++)
                                                    {
                                                        var item = Model[i];

                                                        string s = "";
                                                        try
                                                        {
                                                            s = Convert.ToBase64String(item.ThumbnailPhoto);
                                                        }
                                                        catch
                                                        {
                                                        }
                                                        var imgsrc = string.Format("data:image/jpeg;base64,{0}", s);

                                                        bool bSelected = false;
                                                        if (item.CupId != 0)
                                                        {
                                                            bSelected = true;
                                                        }

                                                        <tr>
                                                            <td>                                                                
                                                                @Html.HiddenFor(m => m[i].CupId)
                                                                @Html.HiddenFor(m => m[i].CompetitorId)
                                                                @Html.HiddenFor(m => m[i].UserRole)

                                                                @Html.HiddenFor(m => m[i].PredictDate)
                                                                @Html.HiddenFor(m => m[i].Team1)
                                                                @Html.HiddenFor(m => m[i].Team2)
                                                                @Html.HiddenFor(m => m[i].Team3)
                                                                
                                                                @Html.HiddenFor(m => m[i].SpecialPoint)
                                                                @Html.HiddenFor(m => m[i].TotalPredictionsPoint)
                                                                @Html.HiddenFor(m => m[i].ModifyTime)
                                                            </td>

                                                            <td>
                                                                @*@Html.CheckBox("chkSelected", bSelected, htmlAttributes: new { @id = "chkSelected", @class = "", @style = "", @disabled = "disabled" })*@
                                                                @Html.CheckBoxFor(m => m[i].selected, htmlAttributes: new { @id = "chkSelected", @class = "", @style = "", @enabled = "enabled" })
                                                            </td>
                                                            <td>
                                                                @item.CompetitorName
                                                                <img src="@imgsrc" width='23' height='23' alt="" />
                                                            </td>

                                                            <td>@item.LoginName</td>
                                                            <td>
                                                                <span class='label label-important'>@item.RegStatus</span>
                                                            </td>
                                                            <td>@Html.TextBoxFor(m => m[i].InitialPoint)</td>

                                                            @*<td>
                                                                @Html.DropDownListFor(m => m[i].ParticipantType, new SelectList(ViewBag.ParticipantTypeList, "Id", "Title", item.ParticipantType), htmlAttributes: new { @class = "select2 input-block-level", @id = "cboParticipantType", @enabled = "enabled" })

                                                            </td>*@
                                                        </tr>

                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <hr class='hr-normal' />
                                    <button type="submit" class='btn btn-primary btn-large'>
                                        <i class='icon-save'></i>
                                        بروزرسانی
                                    </button>
                                </div>
                            </div>


                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src='~/Scripts/jquery-1.10.2.min.js'></script>

<script src='~/Scripts/jquery_ui/jquery-ui.min.js' type='text/javascript'></script>

<script src="~/Scripts/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/Scripts/plugins/datatables/jquery.dataTables.columnFilter.js"></script>


<script src='~/Scripts/plugins/common/bootstrap-wysihtml5.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/charCount/charCount.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/naked_password/naked_password-0.2.4.min.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/nestable/jquery.nestable.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/tabdrop/bootstrap-tabdrop.js' type='text/javascript'></script>
<script src='~/Scripts/plugins/bootstrap_maxlength/bootstrap-maxlength.min.js' type='text/javascript'></script>

<script src='~/Scripts/tables.js' type='text/javascript'></script>
<script src="~/Scripts/theme.js"></script>

<script>
    $("#cboCup").click();
    $('#txtCupId').attr('value', $("#cboCup").val());


</script>

<script>

    $("#cboCup").click(function () {

        ///not ajax
       // alert( $("#cboCup").val());
        var url ='@Url.Content("~/Administration")'+ "/Competitor?cupid=" + $("#cboCup").val();

        window.location.replace(url);


    });



</script>