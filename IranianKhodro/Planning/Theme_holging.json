{
  "name": "Indigo Dashboard",
  "dataColors": [
    "#4F46E5",
    "#06B6D4",
    "#F59E0B",
    "#10B981",
    "#EF4444",
    "#8B5CF6",
    "#EC4899",
    "#14B8A6"
  ],
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#4F46E5",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "null": "#D1D5DB",
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#6B7280",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F2F1",
  "tableAccent": "#4F46E5",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5E7EB" } },
            "radius": 8
          }
        ],
        "dropShadow": [ { "show": false } ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      },
      "page": {
        "background": [
          {
            "color": { "solid": { "color": "#F3F2F1" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F3F2F1" } },
            "transparency": 0
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI",
      "color": "#4F46E5"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#6B7280"
    }
  }
}