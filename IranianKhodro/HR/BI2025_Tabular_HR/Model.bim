        "measures": [
          {
            "name": "TotalPermitOffHours",
            "expression": [
              "",
              "VAR _StartDate = [SelectedFromDate]   -- یا اسلایسر تاریخ شروع",
              "VAR _EndDate   = [SelectedToDate]     -- یا اسلایسر تاریخ پایان",
              "",
              "RETURN",
              "CALCULATE (",
              "    SUMX (",
              "        'factEmployeeAttendancePermit',",
              "        DIVIDE(",
              "            DATEDIFF(",
              "                'factEmployeeAttendancePermit'[FromDateTime],",
              "                'factEmployeeAttendancePermit'[ToDateTime],",
              "                MINUTE",
              "            ),",
              "            60",
              "        )",
              "    ),",
              "    FILTER (",
              "        'factEmployeeAttendancePermit',",
              "        'factEmployeeAttendancePermit'[FromDateKey] >= _StartDate &&",
              "        'factEmployeeAttendancePermit'[FromDateKey] <= _EndDate &&",
              "        'factEmployeeAttendancePermit'[RequestType] = \"مرخصی\"",
              "    )",
              ")"
            ]
          },
          {
            "name": "TotalPermitMissionHours",
            "expression": [
              "",
              "VAR _StartDate = [SelectedFromDate]   -- یا اسلایسر تاریخ شروع",
              "VAR _EndDate   = [SelectedToDate]     -- یا اسلایسر تاریخ پایان",
