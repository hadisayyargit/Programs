              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "            )",
              "        ),",
              "    HasSeason,",
              "        CALCULATE(",
              "            MIN('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliSeason] = SelectedSeason",
              "            )",
              "        ),",
              "    -- اگر فقط سال انتخاب شده یا هیچ‌چیز انتخاب نشده",
              "    CALCULATE(",
              "        MIN('dimDate'[DateKey]),",
              "        FILTER(ALL('dimDate'), 'dimDate'[JalaliYear] = SelectedYear)",
              "    )",
              ")",
              "",
              "VAR MaxDate =",
              "SWITCH(",
              "    TRUE(),",
              "    HasDay,",
              "        CALCULATE(",
              "            MAX('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "                    && 'dimDate'[JalaliDate] = SelectedDay",
              "            )",
              "        ),",
              "    HasMonth,",
              "        CALCULATE(",
              "            MAX('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "            )",
              "        ),",
              "    HasSeason,",
              "        CALCULATE(",
              "            MAX('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliSeason] = SelectedSeason",
              "            )",
              "        ),",
              "    CALCULATE(",
              "        MAX('dimDate'[DateKey]),",
              "        FILTER(ALL('dimDate'), 'dimDate'[JalaliYear] = SelectedYear)",
              "    )",
              ")",
              "*/  ",
              "",
              "RETURN",
              "MaxDate"
            ]
          },
          {
            "name": "CountOfActive4JobEducation",
            "expression": [
              "",
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _SelectedDept = SELECTEDVALUE ( 'dimDepartment'[DepartmentId] )",
              "VAR _SelectedJob = SELECTEDVALUE ( 'dimJob'[JobPositionId] )",
              "VAR _SelectedEdu = SELECTEDVALUE ( 'dimEducationLevel'[codevalue] )   -- ممکنه عدد یا متن باشه",
              "",
              "RETURN",
              "SUMX (",
              "    DISTINCT ( 'factEmployeeOrder'[PersonnelId] ),",
              "",
              "    VAR _pid = 'factEmployeeOrder'[PersonnelId]",
              "",
              "    VAR _LastOrderDateKey =",
              "        CALCULATE (",
              "            MAX ( 'factEmployeeOrder'[OrderDateKey] ),",
              "            FILTER (",
              "                ALL ( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = _pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "            )",
              "        )",
              "",
              "    VAR _LastRow =",
              "        CALCULATETABLE (",
              "            FILTER (",
              "                ALL ( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = _pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = _LastOrderDateKey",
              "            )",
              "        )",
              "",
              "    VAR _DeptId = MINX ( _LastRow, 'factEmployeeOrder'[DepartmentId] )",
              "    VAR _JobId = MINX ( _LastRow, 'factEmployeeOrder'[JobPositionId] )",
              "    VAR _OrderType = MINX ( _LastRow, 'factEmployeeOrder'[OrderTypeId] )",
              "",
              "    /* دریافت سطح تحصیلات از جدول PersonnelInfo */",
              "    VAR _EduLevel =",
              "        CALCULATE(",
              "            MIN( dimEducationLevel[CodeValue] ),",
              "            FILTER( ALL('dimPersonnelInfo'), 'dimPersonnelInfo'[PersonnelId] = _pid )",
              "        )",
              "",
              "    RETURN",
              "        IF (",
              "            NOT ISBLANK ( _LastOrderDateKey )",
              "                && _OrderType <> 10",
              "                && ( ISBLANK ( _SelectedDept ) || _DeptId = _SelectedDept )",
              "                && ( ISBLANK ( _SelectedJob ) || _JobId = _SelectedJob )",
              "                && ( ISBLANK ( _SelectedEdu ) || ( _EduLevel & \"\" ) = ( _SelectedEdu & \"\" ) ),  -- <-- تبدیل به متن قبل از مقایسه",
              "            1,",
              "            0",
              "        )",
              ")"
            ]
          },
          {
            "name": "Target_Attrition",
            "expression": [
              "VAR CurrentYear = SELECTEDVALUE('dimDate'[JalaliYear])",
              "VAR CurrentSeason = SELECTEDVALUE('dimDate'[JalaliSeason])",
              "RETURN",
              "CALCULATE(COALESCE(",
              "   MAX( 'dimKPITarget'[TargetValue]),0),",
              "    FILTER(",
              "        'dimKPITarget',",
              "        dimKPITarget[TargetCode]=\"G_Attrition\"",
              "        && 'dimKPITarget'[JalaliYear] = CurrentYear ",
              "        && 'dimKPITarget'[JalaliSeason] = CurrentSeason",
              "    )",
              ")",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "TargetOfResignation",
            "expression": [
              "VAR CurrentYear = SELECTEDVALUE('dimDate'[JalaliYear])",
              "VAR CurrentSeason = SELECTEDVALUE('dimDate'[JalaliSeason])",
              "RETURN",
              "CALCULATE(COALESCE(",
              "   MAX( 'dimKPITarget'[TargetValue]),0),",
              "    FILTER(",
              "        'dimKPITarget',",
              "        dimKPITarget[TargetCode]=\"G_Resignation\"",
              "        && 'dimKPITarget'[JalaliYear] = CurrentYear ",
              "        && 'dimKPITarget'[JalaliSeason] = CurrentSeason",
              "    )",
              ")",
              ""
            ],
            "formatString": "0.00"
          },
          {
            "name": "TargetOfFired",
            "expression": [
              "VAR CurrentYear = SELECTEDVALUE('dimDate'[JalaliYear])",
              "VAR CurrentSeason = SELECTEDVALUE('dimDate'[JalaliSeason])",
              "RETURN",
              "CALCULATE(",
              "100*  COALESCE( MAX( 'dimKPITarget'[TargetValue]),0),",
              "    FILTER(",
              "        'dimKPITarget',",
              "        dimKPITarget[TargetCode]=\"G_Fired\"",
              "        && 'dimKPITarget'[JalaliYear] = CurrentYear ",
              "        && 'dimKPITarget'[JalaliSeason] = CurrentSeason",
              "    )",
              ")"
            ]
          },
          {
            "name": "TargetOfRetentionRatio",
            "expression": [
              "VAR CurrentYear = SELECTEDVALUE('dimDate'[JalaliYear])",
              "VAR CurrentSeason = SELECTEDVALUE('dimDate'[JalaliSeason])",
              "RETURN",
              "CALCULATE(COALESCE(",
              "   MAX( 'dimKPITarget'[TargetValue]),0),",
              "    FILTER(",
              "        'dimKPITarget',",
              "        dimKPITarget[TargetCode]=\"G_RetentionRatio\"",
              "        && 'dimKPITarget'[JalaliYear] = CurrentYear ",
              "        && 'dimKPITarget'[JalaliSeason] = CurrentSeason",
              "    )",
              ")"
            ]
          },
          {
            "name": "AvgOfAttrition",
            "expression": [
              "",
              "var CountOfActive_MaxDate= [CountOfActive_MinDate]-[CountOfAttrition]+[CountOfHired]",
              "var v2= ( [CountOfActive_MinDate]+CountOfActive_MaxDate) *0.5",
              "",
              "",
              "return  COALESCE(DIVIDE([CountOfAttrition], v2, 0),0)",
              ""
            ]
          },
          {
            "name": "AvgOfResignation",
            "expression": "COALESCE(DIVIDE([CountOfResignation], [CountOfPersonnel]),0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "AvgOfFired",
            "expression": "COALESCE(DIVIDE([CountOfFired], [CountOfPersonnel]),0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "AvgOfHired",
            "expression": "COALESCE(DIVIDE([CountOfHired_old], [CountOfPersonnel]),0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "TargetOfHired",
            "expression": "0.1",
            "formatString": "0.00"
          },
          {
            "name": "AvgOfActive",
            "expression": "DIVIDE([CountOfActive], [CountOfPersonnel])",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "TargetOfActive",
            "expression": "0.9"
          },
          {
            "name": "CountOfMaleActivePersonnel",
            "expression": "CALCULATE([CountOfActive], dimPersonnelInfo[Gender]=TRUE())"
          },
          {
            "name": "CountOfFemaleActivePersonnel",
            "expression": "CALCULATE([CountOfActive], dimPersonnelInfo[Gender]=FALSE())"
          },
          {
            "name": "EmployeeRetentionRate",
            "expression": "divide([CountOfPersonnel]-[CountOfAttrition], [CountOfPersonnel],0)"
          },
          {
            "name": "CountOfOthersAttrition",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ('dimDepartment'[DepartmentId] )",
              "",
              "RETURN",
              "SUMX(",
              "    DISTINCT( ALL( 'factEmployeeOrder'[PersonnelId] ) ),  -- همه‌ی PersonnelId (بدون فیلتر ویژوال)",
              "    VAR pid = [PersonnelId] ",
              "",
              "    VAR LastKey =",
              "        CALCULATE(",
              "            MAX('factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] >= _MinDateKey",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "                    && (  ISBLANK ( SelectedDepartment ) || 'factEmployeeOrder'[DepartmentId] = SelectedDepartment )",
              "            )",
              "        )",
              "",
              "    VAR LastReason =",
              "        CALCULATE(",
              "            MIN( 'factEmployeeOrder'[LeavingReasonId] ),  -- MIN برای جلوگیری از خطای multiple value",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = LastKey",
              "            )",
              "        )",
              "",
              "    RETURN",
              "        IF( NOT( ISBLANK( LastReason ) ) && NOT( ISBLANK( LastReason ) ) && (LastReason  =1 || LastReason  =5 || LastReason  =6  ), 1, 0 )",
              ")"
            ]
          },
          {
            "name": "CountOfHired_before14040911",
            "expression": [
              "",
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "RETURN",
              "SUMX(",
              "    DISTINCT( ALL( 'factEmployeeOrder'[PersonnelId] ) ),  -- همه‌ی PersonnelId (بدون فیلتر ویژوال)",
              "    VAR pid = [PersonnelId]",
              "",
              "    VAR LastKey =",
              "        CALCULATE(",
              "            MAX( 'factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] >= _MinDateKey",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "                    && (  ISBLANK ( SelectedDepartment ) || 'factEmployeeOrder'[DepartmentId] = SelectedDepartment )",
              "            )",
              "        )",
              "",
              "    VAR LastType =",
              "        CALCULATE(",
              "            MIN( 'factEmployeeOrder'[OrderTypeId] ),  -- MIN برای جلوگیری از خطای multiple value",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = LastKey",
              "            )",
              "        )",
              "",
              "    RETURN",
              "        IF( NOT( ISBLANK( LastKey ) ) && NOT( ISBLANK( LastType ) ) && LastType = 3, 1, 0 )",
              ")"
            ]
          },
          {
            "name": "CountOfAttrition_before",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ('dimDepartment'[DepartmentId] )",
              "",
              "RETURN",
              "SUMX(",
              "    DISTINCT( ALL( 'factEmployeeOrder'[PersonnelId] ) ),  -- همه‌ی PersonnelId (بدون فیلتر ویژوال)",
              "    VAR pid = [PersonnelId]",
              "",
              "    VAR LastKey =",
              "        CALCULATE(",
              "            MAX( 'factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] >= _MinDateKey",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "                    && (  ISBLANK ( SelectedDepartment ) || 'factEmployeeOrder'[DepartmentId] = SelectedDepartment )",
              "            )",
              "        )",
              "",
              "    VAR LastType =",
              "        CALCULATE(",
              "            MIN( 'factEmployeeOrder'[OrderTypeId] ),  -- MIN برای جلوگیری از خطای multiple value",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = LastKey",
              "            )",
              "        )",
              "",
              "    RETURN",
              "        IF( NOT( ISBLANK( LastKey ) ) && NOT( ISBLANK( LastType ) ) && LastType = 10, 1, 0 )",
              ")"
            ]
          },
          {
            "name": "CountOfPersonnelId",
            "expression": " COUNT(factEmployeeOrder[PersonnelId])"
          },
          {
            "name": "CountOfActive_LastYear",
            "expression": [
              "",
              "",
              "VAR maxDate =[SelectedToDate_LastYear]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES('factEmployeeOrder'[PersonnelId]),",
              "        VAR lastKey =",
              "            CALCULATE (",
              "                MAX('factEmployeeOrder'[OrderDateKey]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] <= maxDate),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastType =",
              "            CALCULATE (",
              "                MIN('factEmployeeOrder'[OrderTypeId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastDept =",
              "            CALCULATE (",
              "                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        RETURN",
              "            NOT ISBLANK(lastType) &&",
              "            lastType <> 10 &&",
              "            ( ISBLANK(dept) || lastDept = dept )",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "SelectedToDate_LastYear",
            "expression": [
              "",
              "VAR d = [SelectedToDate]",
              "VAR y = INT ( d / 10000 )                     -- استخراج سال",
              "VAR m = INT ( MOD ( d, 10000 ) / 100 )        -- استخراج ماه",
              "VAR day = MOD ( d, 100 )                      -- استخراج روز",
              "VAR LastYear = y - 1                          -- یک سال قبل",
              "RETURN",
              "    LastYear * 10000 + m * 100 + day   "
            ]
          },
          {
            "name": "CountOfAttrition_LastYear",
            "expression": [
              "",
              "VAR minDate = [SelectedFromDate_LastYear]",
              "VAR maxDate = [SelectedToDate_LastYear]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES('factEmployeeOrder'[PersonnelId]),",
              "        VAR lastKey =",
              "            CALCULATE (",
              "                MAX('factEmployeeOrder'[OrderDateKey]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] >= minDate && 'factEmployeeOrder'[OrderDateKey] <= maxDate), ",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastType =",
              "            CALCULATE (",
              "                MIN('factEmployeeOrder'[OrderTypeId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastDept =",
              "            CALCULATE (",
              "                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        RETURN",
              "            NOT ISBLANK(lastType) &&",
              "            lastType =10 &&",
              "            ( ISBLANK(dept) || lastDept = dept )",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "SelectedFromDate_LastYear",
            "expression": [
              "",
              "VAR d = [SelectedFromDate]",
              "VAR y = INT ( d / 10000 )                     -- استخراج سال",
              "VAR m = INT ( MOD ( d, 10000 ) / 100 )        -- استخراج ماه",
              "VAR day = MOD ( d, 100 )                      -- استخراج روز",
              "VAR LastYear = y - 1                          -- یک سال قبل",
              "RETURN",
              "    LastYear * 10000 + m * 100 + day   "
            ]
          },
          {
            "name": "measure_date",
            "expression": [
              "",
              "",
              "VAR minDate = [SelectedFromDate]",
              "VAR maxDate = [SelectedToDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "    minDate",
              "        & \" - \"",
              "        & maxDate",
              "",
              "//COUNTROWS (",
              "//    FILTER (",
              "//        VALUES('factEmployeeOrder'[PersonnelId]),",
              "//        VAR lastKey =",
              "//            CALCULATE (",
              "//                MAX('factEmployeeOrder'[OrderDateKey]),",
              "//                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] >= minDate && 'factEmployeeOrder'[OrderDateKey] <= maxDate), ",
              "//                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
