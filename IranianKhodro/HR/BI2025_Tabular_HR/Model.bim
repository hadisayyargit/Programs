        "measures": [
          {
            "name": "TotalAbsentHours",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN ",
              "CALCULATE (COALESCE(   SUM(factEmployeeAttendanceRow[RowTotalHour]),0), ",
              " Filter(factEmployeeAttendanceRow, ",
              "    factEmployeeAttendanceRow[FactorOrder]=0 ",
              "    && factEmployeeAttendanceRow[AttendanceFactorRef]=5",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ") ",
              ""
            ],
            "formatString": "0.00000"
          },
          {
            "name": "TotalUndertimeHours",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN",
              "CALCULATE ( COALESCE(   SUM(factEmployeeAttendanceRow[RowTotalHour]), 0),",
              " Filter(factEmployeeAttendanceRow, ",
              "    factEmployeeAttendanceRow[FactorOrder]=2 ",
              "    && factEmployeeAttendanceRow[AttendanceFactorRef]=21",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ")  ",
              ""
            ],
            "formatString": "0.00000"
          },
          {
            "name": "TotalPresentHours",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN",
              "CALCULATE ( COALESCE(   SUM(factEmployeeAttendanceRow[RowTotalHour]), 0),",
              " Filter(factEmployeeAttendanceRow, ",
              "    factEmployeeAttendanceRow[FactorTitle]=\"pair\"",
              "    && (factEmployeeAttendanceRow[AttendanceStatus]=\"حضور\" || factEmployeeAttendanceRow[AttendanceStatus]=\"ماموریت ساعتی -درون شهری\")",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ")  ",
              ""
            ]
          },
          {
            "name": "TotalOffHours",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "",
              "",
              "",
              "RETURN",
              "CALCULATE ( COALESCE(   SUMX(factEmployeeAttendanceRow, ",
              "IF(factEmployeeAttendanceRow[RowTotalHour]>factEmployeeAttendanceRow[ShiftHours], factEmployeeAttendanceRow[ShiftHours], factEmployeeAttendanceRow[RowTotalHour])),0),",
              "",
              "",
              "",
              " ",
              " Filter(factEmployeeAttendanceRow,  ",
              "         CONTAINSSTRING (factEmployeeAttendanceRow[AttendanceStatus], \"مرخص\" )    ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ")  ",
              ""
            ]
          },
          {
            "name": "TotalMissionHours",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN",
              "CALCULATE ( COALESCE(   SUM(factEmployeeAttendanceRow[RowTotalHour]),0), ",
              " Filter(factEmployeeAttendanceRow, ",
              "         CONTAINSSTRING (factEmployeeAttendanceRow[AttendanceStatus], \"ماموریت\" )    ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ")  ",
              ""
            ]
          },
          {
            "name": "TotalOverTimeHours",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN",
              "CALCULATE ( COALESCE(   SUM(factEmployeeAttendanceRow[RowTotalHour]), 0),",
              " Filter(factEmployeeAttendanceRow, ",
              "    --CONTAINSSTRING (factEmployeeAttendanceRow[FactorTitle], \"اضافه\" )    ",
              "     (factEmployeeAttendanceRow[AttendanceStatus]=\"حضور قبل از شیفت\" || factEmployeeAttendanceRow[AttendanceStatus]=\"حضور بعد از شیفت\") ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ")  ",
              ""
            ]
          },
          {
            "name": "CountOfPresentPersonnels",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN ",
              "CALCULATE (",
              "   count(factEmployeeAttendanceRow[PersonnelId]), ",
              " Filter(factEmployeeAttendanceRow, ",
              "    factEmployeeAttendanceRow[FactorTitle]=\"pair\"",
              "    && factEmployeeAttendanceRow[AttendanceStatus]=\"حضور\"",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ")  ",
              ""
            ]
          },
          {
            "name": "CountOfAbsentPersonnels",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "RETURN ",
              "CALCULATE (",
              "   COUNT(factEmployeeAttendanceRow[PersonnelId]), ",
              " Filter(factEmployeeAttendanceRow, ",
              "    factEmployeeAttendanceRow[FactorOrder]=0 ",
              "    && factEmployeeAttendanceRow[AttendanceFactorRef]=5",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] >= _MinDateKey ",
              "    && 'factEmployeeAttendanceRow'[AttendanceDateKey] <=  _MaxDateKey ",
              "    && (ISBLANK ( SelectedDepartment ) || 'factEmployeeAttendanceRow'[DepartmentId] = SelectedDepartment) ",
              "    ",
              ")",
              ") ",
              ""
            ]
          },
          {
            "name": "measure_version",
            "expression": "\"نگارش: ۱.۰\""
          },
          {
            "name": "Color_TotalOverTime",
            "expression": " \"#FFD54F\""
          },
          {
            "name": "TotalOverTimePerPersonnel",
            "expression": "DIVIDE([TotalOverTimeHours], [CountOfActive],0)"
          },
          {
            "name": "TotalOverTimePerPresent",
            "expression": "DIVIDE([TotalOverTimeHours], [CountOfPresentPersonnels],0)"
          },
          {
            "name": "TotalOffTimePerPersonnel",
            "expression": "DIVIDE([TotalOffHours], [CountOfActive],0)"
          },
          {
            "name": "TotalOffTimePerPresent",
            "expression": "DIVIDE([TotalOffHours], [CountOfPresentPersonnels],0)"
          },
          {
            "name": "TotalMissionTimePerPersonnel",
            "expression": "DIVIDE([TotalMissionHours], [CountOfActive],0)"
          },
          {
            "name": "TotalMissionTimePerPresent",
            "expression": "DIVIDE([TotalMissionHours], [CountOfPresentPersonnels],0)"
          },
          {
            "name": "TotalPresentPerPersonnel",
            "expression": "DIVIDE([TotalPresentHours], [CountOfActive],0)"
          }
        ],
