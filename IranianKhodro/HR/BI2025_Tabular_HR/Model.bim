        "measures": [
          {
            "name": "SumOfCourseHour",
            "expression": [
              "",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ( dimDepartment[DepartmentId] )",
              "",
              "return ",
              "CALCULATE(",
              "COALESCE(",
              "SUM(dimTrainingCourse[CourseDurationHour]),0)",
              ", filter(dimTrainingCourse,((dimTrainingCourse[CourseBeginDateKey] >= _MinDateKey && dimTrainingCourse[CourseBeginDateKey] <= _MaxDateKey)",
              "|| ( dimTrainingCourse[CourseEndDateKey] >= _MinDateKey && dimTrainingCourse[CourseEndDateKey] <= _MaxDateKey)))",
              "  ",
              "//,   FILTER (",
              "//        TrainingCoursePersonnel,",
              "//        TrainingCoursePersonnel[DepartmentId] = SelectedDepartment ",
              "//) ",
              "",
              ")"
            ]
          },
          {
            "name": "TrainingPerCapita",
            "expression": " DIVIDE([SumOfCourseHour], [CountOfPersonnel])"
          },
          {
            "name": "CountOfCourses",
            "expression": [
              "",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR _MaxDateKey = [SelectedToDate]",
              "",
              "return ",
              "CALCULATE(",
              "COALESCE(",
              "COUNT(dimTrainingCourse[CourseId]),0)",
              ", ((dimTrainingCourse[CourseBeginDateKey] >= _MinDateKey && dimTrainingCourse[CourseBeginDateKey] <= _MaxDateKey)",
              "|| ( dimTrainingCourse[CourseEndDateKey] >= _MinDateKey && dimTrainingCourse[CourseEndDateKey] <= _MaxDateKey))",
              "",
              ") "
            ]
          }
        ],
