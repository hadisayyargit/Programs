          {
            "type": "calculated",
            "name": "Age",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "VAR BirthDate =",
              "    DATE (",
              "        int(DIVIDE ( 'dimPersonnelInfo'[BirthDateKey], 10000, 0 )),",
              "        int(DIVIDE ( MOD ( 'dimPersonnelInfo'[BirthDateKey], 10000 ) , 100, 0 )),",
              "        int(MOD ( 'dimPersonnelInfo'[BirthDateKey], 100 ))",
              "    )",
              "",
              "VAR TodayDate = TODAY() ",
              "",
              "VAR AgeYears =",
              "    DATEDIFF ( BirthDate, TodayDate, YEAR )",
              "",
              "-- اصلاح برای اینکه اگر ماه/روز تولد هنوز نرسیده، یک سال کم بشود",
              "",
              "",
              "RETURN",
              "  AgeYears",
              "",
              "/*",
              "-- اصلاح برای اینکه اگر ماه/روز تولد هنوز نرسیده، یک سال کم بشود",
              "RETURN",
              "IF (",
              "    DATE ( YEAR(TodayDate), MONTH(BirthDate), DAY(BirthDate) ) > TodayDate,",
              "    AgeYears - 1,",
              "    AgeYears",
              ")*/"
            ]
          },
          {
            "type": "calculated",
            "name": "AgeRange",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR age = 'dimPersonnelInfo'[Age]",
              "RETURN",
              "    IF(",
              "        ISBLANK(age),",
              "        BLANK(),",
              "        SWITCH(",
              "            TRUE(),",
              "            age < 30, \"زیر ۳۰ سال\",",
              "            age >= 30 && age < 40, \"۳۰ تا ۴۰ سال\",",
              "            age >= 40 && age < 50, \"۴۰ تا ۵۰ سال\",",
              "            age >= 50 && age < 60, \"۵۰ تا ۶۰ سال\",",
              "            age >= 60, \"بالای ۶۰ سال\",",
              "            BLANK()",
              "        )",
              "    )"
            ]
          },
          {
            "type": "calculated",
            "name": "GenderTitle",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " IF(dimPersonnelInfo[Gender]=FALSE(),\"زن\",\"مرد\")"
          },
          {
            "type": "calculated",
            "name": "FullName",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "dimPersonnelInfo[FirstName]&\" \"&dimPersonnelInfo[LastName]"
          },
          {
            "type": "calculated",
            "name": "LastSentenceJalaliDate",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              " ",
              "LOOKUPVALUE(",
              "    dimDate[JalaliDate],    ",
              "    dimDate[DateKey],     ",
              "    dimPersonnelInfo[LastSentenceDateKey]",
              "",
              "",
              ")"
            ]
          }
        ],
