              "//            CALCULATE (",
              "//                MIN('factEmployeeOrder'[OrderTypeId]),",
              "//                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "//                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "//            )",
              "//        VAR lastDept =",
              "//            CALCULATE (",
              "//                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "//                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "//                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "//            )",
              "//        RETURN",
              "//            NOT ISBLANK(lastType) &&",
              "//            lastType =3 &&",
              "//            ( ISBLANK(dept) || lastDept = dept )",
              "//    )",
              "//)",
              ""
            ]
          },
          {
            "name": "CountOfHired",
            "expression": [
              "",
              "",
              "VAR minDate = [SelectedFromDate]",
              "VAR maxDate = [SelectedToDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "",
              "",
              "",
              "RETURN",
              "",
              "            CALCULATE (COALESCE(                COUNT(factEmployeeOrder[PersonnelId]),0)",
              "             ,USERELATIONSHIP(factEmployeeOrder[OrderDateKey], dimDate[DateKey])",
              "            , filter(factEmployeeOrder,  ",
              "                factEmployeeOrder[OrderTypeId]=3 ",
              "                 &&  ('factEmployeeOrder'[OrderDateKey] >=minDate && 'factEmployeeOrder'[OrderDateKey] <=maxDate ) ",
              "              &&    ( ISBLANK(dept) || 'factEmployeeOrder'[DepartmentId] = dept ) ",
              "            ) ",
              ")",
              "",
              "",
              ""
            ]
          },
          {
            "name": "CountOfAttrition",
            "expression": [
              "",
              "",
              "VAR minDate = [SelectedFromDate]",
              "VAR maxDate = [SelectedToDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "",
              "",
              "",
              "RETURN",
              "",
              "            CALCULATE (COALESCE(                COUNT(factEmployeeOrder[PersonnelId]),0)",
              "             ,USERELATIONSHIP(factEmployeeOrder[OrderDateKey], dimDate[DateKey])",
              "            , filter(factEmployeeOrder,  ",
              "                factEmployeeOrder[OrderTypeId]=10 ",
              "                 &&  ('factEmployeeOrder'[OrderDateKey] >=minDate && 'factEmployeeOrder'[OrderDateKey] <=maxDate ) ",
              "              &&    ( ISBLANK(dept) || 'factEmployeeOrder'[DepartmentId] = dept ) ",
              "            ) ",
              ")",
              "",
              "",
              ""
            ]
          },
          {
            "name": "CountOfActive_MinDate",
            "expression": [
              "",
              "",
              "VAR minDate = [SelectedFromDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES('factEmployeeOrder'[PersonnelId]),",
              "        VAR lastKey =",
              "            CALCULATE (",
              "                MAX('factEmployeeOrder'[OrderDateKey]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] <= minDate),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastType =",
              "            CALCULATE (",
              "                MIN('factEmployeeOrder'[OrderTypeId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastDept =",
              "            CALCULATE (",
              "                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        RETURN",
              "            NOT ISBLANK(lastType) &&",
              "            lastType <> 10 &&",
              "            ( ISBLANK(dept) || lastDept = dept )",
              "    )",
              ")",
              ""
            ]
          }
        ],
        "annotations": [
          {
