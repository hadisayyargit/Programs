          {
            "name": "measure1",
            "expression": "1"
          },
          {
            "name": "measure_Test",
            "expression": [
              "",
              "VAR SelectedYear = SELECTEDVALUE('dimDate'[JalaliYear])",
              "",
              "VAR HasDay = HASONEVALUE('dimDate'[JalaliDate])",
              "VAR HasMonth = HASONEVALUE('dimDate'[JalaliMonth])",
              "VAR HasSeason = HASONEVALUE('dimDate'[JalaliSeason])",
              "",
              "VAR SelectedDay = IF(HasDay, SELECTEDVALUE('dimDate'[JalaliDate]), BLANK())",
              "VAR SelectedMonth = IF(HasMonth, SELECTEDVALUE('dimDate'[JalaliMonth]), BLANK())",
              "VAR SelectedSeason = IF(HasSeason, SELECTEDVALUE('dimDate'[JalaliSeason]), BLANK())",
              "",
              "",
              "-- VAR MinDate = SELECTEDVALUE('dimDate'[JalaliDate])",
              "",
              "VAR MinDate = min('dimDate'[JalaliDate])",
              "",
              "",
              "",
              "/*",
              "VAR MinDate =",
              "SWITCH(",
              "    TRUE(),",
              "    HasDay,",
              "        CALCULATE(",
              "            MIN('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "                     && 'dimDate'[JalaliDate] = SelectedDay",
              "             )",
              "         ),",
              "     HasMonth,",
              "         CALCULATE(",
              "             MIN('dimDate'[DateKey]),",
              "             FILTER(",
              "                 ALL('dimDate'),",
              "                 'dimDate'[JalaliYear] = SelectedYear",
              "                     && 'dimDate'[JalaliMonth] = SelectedMonth",
              "             )",
              "         ),",
              "     HasSeason,",
              "         CALCULATE(",
              "             MIN('dimDate'[DateKey]),",
              "             FILTER(",
              "                 ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliSeason] = SelectedSeason",
              "            )",
              "        ),",
              "    -- اگر فقط سال انتخاب شده یا هیچ‌چیز انتخاب نشده",
              "    CALCULATE(",
              "        MIN('dimDate'[DateKey]),",
              "        FILTER(ALL('dimDate'), 'dimDate'[JalaliYear] = SelectedYear)",
              "    )",
              ")",
              "",
              "*/ ",
              "",
              "RETURN",
              "MinDate"
            ]
          },
          {
            "name": "CountOfActive",
            "expression": [
              "",
              "",
              "VAR maxDate = [SelectedToDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "COALESCE(",
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES('factEmployeeOrder'[PersonnelId]),",
              "        VAR lastKey =",
              "            CALCULATE (",
              "                MAX('factEmployeeOrder'[OrderDateKey]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] <= maxDate),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastType =",
              "            CALCULATE (",
              "                MIN('factEmployeeOrder'[OrderTypeId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastDept =",
              "            CALCULATE (",
              "                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        RETURN",
              "            NOT ISBLANK(lastType) &&",
              "            lastType <> 10 &&",
              "            ( ISBLANK(dept) || lastDept = dept )",
              "    )",
              "),0)",
              "",
              ""
            ]
          },
          {
            "name": "CountOfPersonnel",
            "expression": " [CountOfActive]"
          },
          {
            "name": "CountOfHired_old",
            "expression": [
              "",
              "VAR minDate = [SelectedFromDate]",
              "VAR maxDate = [SelectedToDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES('factEmployeeOrder'[PersonnelId]),",
              "        VAR lastKey =",
              "            CALCULATE (",
              "                MAX('factEmployeeOrder'[OrderDateKey]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] >= minDate && 'factEmployeeOrder'[OrderDateKey] <= maxDate), ",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastType =",
              "            CALCULATE (",
              "                MIN('factEmployeeOrder'[OrderTypeId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastDept =",
              "            CALCULATE (",
              "                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        RETURN",
              "            NOT ISBLANK(lastType) &&",
              "            lastType =3 &&",
              "            ( ISBLANK(dept) || lastDept = dept )",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "CountOfAttrition_old",
            "expression": [
              "",
              "VAR minDate = [SelectedFromDate]",
              "VAR maxDate = [SelectedToDate]",
              "VAR dept    = SELECTEDVALUE('dimDepartment'[DepartmentId])",
              "RETURN",
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES('factEmployeeOrder'[PersonnelId]),",
              "        VAR lastKey =",
              "            CALCULATE (",
              "                MAX('factEmployeeOrder'[OrderDateKey]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] >= minDate && 'factEmployeeOrder'[OrderDateKey] <= maxDate), ",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastType =",
              "            CALCULATE (",
              "                MIN('factEmployeeOrder'[OrderTypeId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        VAR lastDept =",
              "            CALCULATE (",
              "                SELECTEDVALUE('factEmployeeOrder'[DepartmentId]),",
              "                KEEPFILTERS('factEmployeeOrder'[OrderDateKey] = lastKey),",
              "                ALLEXCEPT('factEmployeeOrder','factEmployeeOrder'[PersonnelId])",
              "            )",
              "        RETURN",
              "            NOT ISBLANK(lastType) &&",
              "            lastType =10 &&",
              "            ( ISBLANK(dept) || lastDept = dept )",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "CountOfResignation",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ('dimDepartment'[DepartmentId] )",
              "",
              "RETURN",
              "SUMX(",
              "    DISTINCT( ALL( 'factEmployeeOrder'[PersonnelId] ) ),  -- همه‌ی PersonnelId (بدون فیلتر ویژوال)",
              "    VAR pid = [PersonnelId]",
              "",
              "    VAR LastKey =",
              "        CALCULATE(",
              "            MAX('factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] >= _MinDateKey",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "                    && (  ISBLANK ( SelectedDepartment ) || 'factEmployeeOrder'[DepartmentId] = SelectedDepartment )",
              "            )",
              "        )",
              "",
              "    VAR LastReason =",
              "        CALCULATE(",
              "            MIN( 'factEmployeeOrder'[LeavingReason] ),  -- MIN برای جلوگیری از خطای multiple value",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = LastKey",
              "            )",
              "        )",
              "",
              "    RETURN",
              "        IF( NOT( ISBLANK( LastReason ) ) && NOT( ISBLANK( LastReason ) ) && (LastReason = \"استعفا\" || LastReason=\"ترک کار\"   ), 1, 0 )",
              ")"
            ]
          },
          {
            "name": "CountOfFired",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _MinDateKey = [SelectedFromDate]",
              "VAR SelectedDepartment =    SELECTEDVALUE ('dimDepartment'[DepartmentId] )",
              "",
              "RETURN",
              "SUMX(",
              "    DISTINCT( ALL( 'factEmployeeOrder'[PersonnelId] ) ),  -- همه‌ی PersonnelId (بدون فیلتر ویژوال)",
              "    VAR pid = [PersonnelId]",
              "",
              "    VAR LastKey =",
              "        CALCULATE(",
              "            MAX('factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] >= _MinDateKey",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "                    && (  ISBLANK ( SelectedDepartment ) || 'factEmployeeOrder'[DepartmentId] = SelectedDepartment )",
              "            )",
              "        )",
              "",
              "    VAR LastReason =",
              "        CALCULATE(",
              "            MIN( 'factEmployeeOrder'[LeavingReason] ),  -- MIN برای جلوگیری از خطای multiple value",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = LastKey",
              "            )",
              "        )",
              "",
              "    RETURN",
              "        IF( NOT( ISBLANK( LastReason ) ) && NOT( ISBLANK( LastReason ) ) && (LastReason = \"پایان قرارداد\"   ), 1, 0 )",
              ")"
            ]
          },
          {
            "name": "CountOfStaffPersonnel",
            "expression": [
              "",
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _SelectedDept = SELECTEDVALUE( 'dimDepartment'[DepartmentId] )",
              "",
              "RETURN",
              "COALESCE(",
              "SUMX(",
              "    DISTINCT( 'factEmployeeOrder'[PersonnelId] ),",
              "    VAR _pid = [PersonnelId]",
              "",
              "    VAR _LastSentenceDateKey =",
              "        CALCULATE(",
              "            MAX( 'factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = _pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "            )",
              "        )",
              "",
              "    VAR _LastRow =",
              "        CALCULATETABLE(",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = _pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = _LastSentenceDateKey",
              "            ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE )",
              "        )",
              "",
              "    VAR _LastType = MINX( _LastRow, 'factEmployeeOrder'[OrderTypeId] )",
              "    VAR _LastDept = MINX( _LastRow, 'factEmployeeOrder'[DepartmentId] )",
              "",
              "    VAR _DeptType =",
              "        LOOKUPVALUE(",
              "            'dimDepartment'[DepartmentType],",
              "            'dimDepartment'[DepartmentId], _LastDept",
              "        )",
              "",
              "    RETURN",
              "        IF(",
              "            NOT ISBLANK( _LastSentenceDateKey )",
              "                && _LastType <> 10",
              "                && (",
              "                    ISBLANK( _SelectedDept )",
              "                    || _LastDept = _SelectedDept",
              "                )",
              "                && _DeptType = \"ستاد\",   -- 🔹 شرط جدید",
              "            1,",
              "            0",
              "        )",
              "),0)",
              "",
              ""
            ]
          },
          {
            "name": "CountOfLinePersonnel",
            "expression": [
              "VAR _MaxDateKey = [SelectedToDate]",
              "VAR _SelectedDept = SELECTEDVALUE( 'dimDepartment'[DepartmentId] )",
              "",
              "RETURN",
              "COALESCE(",
              "SUMX(",
              "    DISTINCT( 'factEmployeeOrder'[PersonnelId] ),",
              "    VAR _pid = [PersonnelId]",
              "",
              "    VAR _LastSentenceDateKey =",
              "        CALCULATE(",
              "            MAX( 'factEmployeeOrder'[OrderDateKey] ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE ),",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = _pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] <= _MaxDateKey",
              "            )",
              "        )",
              "",
              "    VAR _LastRow =",
              "        CALCULATETABLE(",
              "            FILTER(",
              "                ALL( 'factEmployeeOrder' ),",
              "                'factEmployeeOrder'[PersonnelId] = _pid",
              "                    && 'factEmployeeOrder'[OrderDateKey] = _LastSentenceDateKey",
              "            ),",
              "            CROSSFILTER( 'dimDate'[DateKey], 'factEmployeeOrder'[OrderDateKey], NONE )",
              "        )",
              "",
              "    VAR _LastType = MINX( _LastRow, 'factEmployeeOrder'[OrderTypeId] )",
              "    VAR _LastDept = MINX( _LastRow, 'factEmployeeOrder'[DepartmentId] )",
              "",
              "    VAR _DeptType =",
              "        LOOKUPVALUE(",
              "            'dimDepartment'[DepartmentType],",
              "            'dimDepartment'[DepartmentId], _LastDept",
              "        )",
              "",
              "    RETURN",
              "        IF(",
              "            NOT ISBLANK( _LastSentenceDateKey )",
              "                && _LastType <> 10",
              "                && (",
              "                    ISBLANK( _SelectedDept )",
              "                    || _LastDept = _SelectedDept",
              "                )",
              "                && _DeptType = \"صف\",   -- 🔹 شرط جدید",
              "            1,",
              "            0",
              "        )",
              "),0)",
              "",
              ""
            ]
          },
          {
            "name": "LineToTotalRatio",
            "expression": "DIVIDE( [CountOfLinePersonnel], [CountOfActive], 0)"
          },
          {
            "name": "StaffToTotalRatio",
            "expression": "DIVIDE([CountOfStaffPersonnel], [CountOfActive],0)"
          },
          {
            "name": "LineToStaffRatio",
            "expression": "divide([CountOfLinePersonnel], [CountOfStaffPersonnel],0)"
          },
          {
            "name": "CountOfRetired",
            "expression": "0"
          },
          {
            "name": "SelectedFromDate",
            "expression": [
              "",
              "",
              "VAR MinDate = min('dimDate'[DateKey])",
              "/*",
              "",
              "-- بازگرداندن Min و Max بر اساس سال + (فصل یا ماه یا روز) از یک hierarchy",
              "VAR SelectedYear = SELECTEDVALUE('dimDate'[JalaliYear])",
              "",
              "VAR HasDay = HASONEVALUE('dimDate'[JalaliDate])",
              "VAR HasMonth = HASONEVALUE('dimDate'[JalaliMonth])",
              "VAR HasSeason = HASONEVALUE('dimDate'[JalaliSeason])",
              "",
              "VAR SelectedDay = IF(HasDay, SELECTEDVALUE('dimDate'[JalaliDate]), BLANK())",
              "VAR SelectedMonth = IF(HasMonth, SELECTEDVALUE('dimDate'[JalaliMonth]), BLANK())",
              "VAR SelectedSeason = IF(HasSeason, SELECTEDVALUE('dimDate'[JalaliSeason]), BLANK())",
              "",
              "VAR MinDate =",
              "SWITCH(",
              "    TRUE(),",
              "    HasDay,",
              "        CALCULATE(",
              "            MIN('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "                    && 'dimDate'[JalaliDate] = SelectedDay",
              "            )",
              "        ),",
              "    HasMonth,",
              "        CALCULATE(",
              "            MIN('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "            )",
              "        ),",
              "    HasSeason,",
              "        CALCULATE(",
              "            MIN('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliSeason] = SelectedSeason",
              "            )",
              "        ),",
              "    -- اگر فقط سال انتخاب شده یا هیچ‌چیز انتخاب نشده",
              "    CALCULATE(",
              "        MIN('dimDate'[DateKey]),",
              "        FILTER(ALL('dimDate'), 'dimDate'[JalaliYear] = SelectedYear)",
              "    )",
              ")",
              "",
              "VAR MaxDate =",
              "SWITCH(",
              "    TRUE(),",
              "    HasDay,",
              "        CALCULATE(",
              "            MAX('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "                    && 'dimDate'[JalaliDate] = SelectedDay",
              "            )",
              "        ),",
              "    HasMonth,",
              "        CALCULATE(",
              "            MAX('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliMonth] = SelectedMonth",
              "            )",
              "        ),",
              "    HasSeason,",
              "        CALCULATE(",
              "            MAX('dimDate'[DateKey]),",
              "            FILTER(",
              "                ALL('dimDate'),",
              "                'dimDate'[JalaliYear] = SelectedYear",
              "                    && 'dimDate'[JalaliSeason] = SelectedSeason",
              "            )",
              "        ),",
              "    CALCULATE(",
              "        MAX('dimDate'[DateKey]),",
              "        FILTER(ALL('dimDate'), 'dimDate'[JalaliYear] = SelectedYear)",
              "    )",
              ")",
              "*/",
              "RETURN",
              "MinDate",
              "",
              ""
            ]
          },
          {
            "name": "SelectedToDate",
            "expression": [
              "",
              "VAR MaxDate = MAX('dimDate'[DateKey])",
              "/*",
              "-- بازگرداندن Min و Max بر اساس سال + (فصل یا ماه یا روز) از یک hierarchy",
              "VAR SelectedYear = SELECTEDVALUE('dimDate'[JalaliYear])",
