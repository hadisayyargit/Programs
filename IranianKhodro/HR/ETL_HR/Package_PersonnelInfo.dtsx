                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select p.* , d1.DateKey as BirthDateKey,d2.DateKey as EmployeeDateKey,d3.DateKey as SentenceDateKey 
, iif(Gender=N'مرد', 1,0) as gendercode 
, N'http://10.10.11.178/images/hr/unknown.png' as imageurl
 from HR.stagePersonnelInfo p 
 left join StagingOnline.bi.dimDate d1 on d1.GregorianDate=p.JalaliBirthDate 
 left join StagingOnline.bi.dimDate d2 on d2.JalaliDate=p.JalaliEmployeeDate 
 left join StagingOnline.bi.dimDate d3 on d3.JalaliDate=p.JalaliSentenceDate 
Where try_cast(p.PersonnelId as int) is not null</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
