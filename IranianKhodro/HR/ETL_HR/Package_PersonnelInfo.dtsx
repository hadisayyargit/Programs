                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select *
, cast(left(isnull(presenthours, '00'),2) as int)+ (cast(right(isnull(presenthours, '00'),2) as int)/60.0) as presenthours_new
, cast(left(isnull(OvertimeHours, '00'),2) as int)+ (cast(right(isnull(OvertimeHours, '00'),2) as int)/60.0) as OvertimeHours_new
, cast(left(isnull(OffHours, '00'),2) as int)+ (cast(right(isnull(OffHours, '00'),2) as int)/60.0) as OffHours_new
, cast(left(isnull(MissionHours, '00'),2) as int)+ (cast(right(isnull(MissionHours, '00'),2) as int)/60.0) as MissionHours_new
, cast(left(isnull(AbsentHours, '00'),2) as int)+ (cast(right(isnull(AbsentHours, '00'),2) as int)/60.0) as AbsentHours_new
, REPLACE(attendancedate,'-','') as attendancedatekey
from [HR].[stageEmployeeAttendance]</property>
