                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select p.* , d3.DateKey as OrderDateKey
, ISNULL(p.DepartmentId ,0) as DepartmentId2
, ISNULL(p.JobPositionId ,0) as JobPositionId2
, ISNULL(p.LeavingReasonId ,0) as leavingResonId2
