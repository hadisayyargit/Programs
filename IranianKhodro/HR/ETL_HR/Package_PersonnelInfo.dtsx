                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[Employee_Information]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select cl.id as CalendarId, cl.Calandar, cl.Title as calendartitle, cl.IsDelete, cl.DepartmentId
, cl.Year, EC.ID as EducationCourseId, EC.StartDate, EC.EndDate, EC.Duration
, CR.PersonId, CR.State
from Education.EducationCalandar cl
left join Education.EducationCourse ec on ec.CalendarId=cl.Id
left join Education.CourseRegister cr on cr.EducationCourseId=ec.Id
where 
Isnull(CL.IsDelete,0)&lt;&gt;1
AND isnull(EC.IsDelete,0)&lt;&gt;1 
and cr.PersonId is not null</property>
