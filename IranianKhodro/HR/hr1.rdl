                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>Model</From>
              <Filter>
                <FilterItems>
                  <FilterItem>
                    <HierarchyUniqueName>[dimDate].[JalaliYearMonth]</HierarchyUniqueName>
                    <Condition xsi:type="EqualTo">
                      <Members>
                        <Member>
                          <MemberUniqueName>[dimDate].[JalaliYearMonth].&amp;[140502]</MemberUniqueName>
                        </Member>
                      </Members>
                    </Condition>
                  </FilterItem>
                </FilterItems>
              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties>
                <IncludeMemberValue>true</IncludeMemberValue>
              </QueryProperties>
            </QuerySpecification>
            <Query>
              <Statement>EVALUATE SUMMARIZECOLUMNS('HorizentalMergedSales'[ContractId], FILTER(VALUES('dimDate'[JalaliYearMonth]), ('dimDate'[JalaliYearMonth] = VALUE("140502"))), "TotalSalesLast", [TotalSalesLast])</Statement>
              <ParameterDefinitions />
            </Query>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>EVALUATE SUMMARIZECOLUMNS('HorizentalMergedSales'[ContractId], FILTER(VALUES('dimDate'[JalaliYearMonth]), ('dimDate'[JalaliYearMonth] = VALUE("140502"))), "TotalSalesLast", [TotalSalesLast])</CommandText>
