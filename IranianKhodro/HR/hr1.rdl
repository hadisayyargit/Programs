            <CommandType>DAX</CommandType>
            <QuerySpecification xsi:type="MDXQuerySpecification">
              <Select>
                <Items>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>HorizentalMergedSales</DimensionName>
                      <HierarchyName>ContractId</HierarchyName>
                      <HierarchyUniqueName>[HorizentalMergedSales].[ContractId]</HierarchyUniqueName>
                      <LevelName>ContractId</LevelName>
                      <UniqueName>[HorizentalMergedSales].[ContractId].[ContractId]</UniqueName>
                    </ID>
                    <ItemCaption>ContractId</ItemCaption>
                    <UniqueName>true</UniqueName>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>TotalSalesLast</MeasureName>
                      <UniqueName>[Measures].[TotalSalesLast]</UniqueName>
                    </ID>
                    <ItemCaption>TotalSalesLast</ItemCaption>
                    <BackColor>true</BackColor>
