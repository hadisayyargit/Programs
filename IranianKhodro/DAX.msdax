CancelledRatio:= 
VAR TotalContracts = 
CALCULATE(
    COUNT('Sales HorizentalMergedSales'[ContractId]),
    'Sales HorizentalMergedSales'[DealerCode] = 777
)

VAR CancelledContracts = 
CALCULATE(
    COUNT('Sales HorizentalMergedSales'[ContractId]),
    'sales HorizentalMergedSales'[DealerCode] = 777,
    'sales HorizentalMergedSales'[CancellationDate] <> DATE(2000,1,1)
)

Return Divide(CancelledContracts,TotalContracts,0)

