    TRUE(),
    'Sales HorizentalMergedSales'[SaleType] IN { "نقدي", "فروش فوري نقدي", "پيش فروش نقدي" }, "نقدی",
    'Sales HorizentalMergedSales'[SaleType] IN { "اقساطي", "فروش فوري اعتباري" }, "اقساطي",
