MaxJalaliModifiedDate:=
VAR _maxDateTime =CALCULATE(
    MAX ( 'Sales HorizentalMergedSales'[ModifiedDate]), ALL('Sales HorizentalMergedSales'))

VAR _maxDateOnly =
    DATE ( YEAR ( _maxDateTime ), MONTH ( _maxDateTime ), DAY ( _maxDateTime ) )
VAR _jalaliDate =
    CALCULATE (
        MAX ( 'BI dimDate'[JalaliDate] ),
        TREATAS ( {_maxDateOnly}, 'BI dimDate'[GregorianDate] ),ALL('Sales HorizentalMergedSales'))

    
VAR _timeText =
    FORMAT ( _maxDateTime, "HH:mm" )
RETURN
    _jalaliDate & " " & _timeText
	-------------




    dimJalaliCalendarTable = 
VAR _StartYear = 1400
VAR _EndYear = 1499 

-- ایجاد لیست سال‌ها با نام ستون مشخص
VAR _Years = SELECTCOLUMNS(GENERATESERIES(_StartYear, _EndYear, 1), "YearVal", [Value])

-- ایجاد لیست ماه‌ها با نام ستون مشخص
VAR _Months = SELECTCOLUMNS(GENERATESERIES(1, 12, 1), "MonthVal", [Value])

-- ترکیب سال و ماه
VAR _BaseTable = CROSSJOIN(_Years, _Months)

RETURN
SELECTCOLUMNS(
    _BaseTable,
    "JalaliYear", [YearVal],                         -- استفاده از نام ستون مشخص شده در متغیر اول
    "JalaliMonth", [MonthVal],                 -- استفاده از نام ستون مشخص شده در متغیر دوم
    
    "JalaliMonthName", 
        SWITCH([MonthVal], 
            1, "فروردین", 2, "اردیبهشت", 3, "خرداد", 
            4, "تیر", 5, "مرداد", 6, "شهریور", 
            7, "مهر", 8, "آبان", 9, "آذر", 
            10, "دی", 11, "بهمن", 12, "اسفند"
        ),

    "JalaliYearMonth", 
        [YearVal] * 100 + [MonthVal],            -- محاسبات روی ستون‌های مشخص شده

    "JalaliYearMonthString", 
        FORMAT([YearVal], "####") & "/" & FORMAT([MonthVal], "00")
)

