-- حاصل تجمعی فروش (Running Total)
CumulativeMonthlySales:=
VAR CurrentYear = SELECTEDVALUE('BI dimDate'[JalaliYear])
VAR CurrentMonth = SELECTEDVALUE('BI dimDate'[JalaliMonth])
VAR SelectedOption = SELECTEDVALUE(tableSaleType[FilterOption])

RETURN
SWITCH(
    SelectedOption,
    "عادی", CALCULATE(    [cashSalesCount],
    FILTER(
        ALL('BI dimDate'),
       'BI dimDate'[JalaliYear] = CurrentYear &&
        (
          'BI dimDate'[JalaliMonth]<= CurrentMonth
        )
    )
),
    "جایگزین", CALCULATE(    [cashSalesSecondHandCount],
    FILTER(
        ALL('BI dimDate'),
       'BI dimDate'[JalaliYear] = CurrentYear &&
        (
          'BI dimDate'[JalaliMonth]<= CurrentMonth
        )
    )
),
    "سازمانی", CALCULATE(    [cashSalesOrganizationalCount],
    FILTER(
        ALL('BI dimDate'),
       'BI dimDate'[JalaliYear] = CurrentYear &&
        (
          'BI dimDate'[JalaliMonth]<= CurrentMonth
        )
    )
),
    blank()
)


