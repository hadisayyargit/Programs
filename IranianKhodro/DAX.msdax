-- حاصل تجمعی هدف فروش
CumulativeTargetThisYear :=
VAR CurrentYear = SELECTEDVALUE('BI dimDate'[JalaliYear])
VAR CurrentSeason = SELECTEDVALUE('BI dimDate'[JalaliSeason])
RETURN
CALCULATE(
    SUM('BI dimKPITarget'[TargetValue]),
    FILTER(
        'BI dimKPITarget',
        'BI dimKPITarget'[JalaliYear] = CurrentYear &&
        'BI dimKPITarget'[JalaliSeason] <= CurrentSeason
    )
)
