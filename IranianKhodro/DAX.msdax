measureTest:=

VAR MinDate = MIN('bi dimDate'[GregorianDate])
VAR MaxDate = MAX('bi dimDate'[GregorianDate])
VAR FilteredTable =
    FILTER(
        ALL(qryLeasings),
        qryLeasings[DealerCode] = "777"
            && qryLeasings[LeasingName] <> "بانک شهر ویژه پرسنل"
            && qryLeasings[LeasingName] <> "بانک صادرات ویژه پرسنل"
            && qryLeasings[LeasingName] <> "بانک گردشکري پرسنل"
            && qryLeasings[LeasingType] <> "سایر"
            && ISBLANK(qryLeasings[MiladiCancelDate])
            && ISBLANK(qryLeasings[ChangeSalesPolicyDate])
            && NOT( ISBLANK(qryLeasings[CreditAmount]) )
            && NOT( ISBLANK(qryLeasings[LeasingConfirmDate]) )
            && qryLeasings[MiladiLeasingConfirmDate] >= MinDate
            && qryLeasings[MiladiLeasingConfirmDate] <= MaxDate
&& qryLeasings[ContractNo]=2157873

    )


RETURN
  MAXX(FilteredTable, qryLeasings[ContractNo])

  ----------------
  measureTest:=
VAR MinDate = MIN('bi dimDate'[GregorianDate])
VAR MaxDate =MAX('bi dimDate'[GregorianDate])
VAR FilteredTable =
    FILTER(
        ALL(qryLeasings),
        qryLeasings[DealerCode] = "777"
            && qryLeasings[LeasingName] <> "بانک شهر ویژه پرسنل"
            && qryLeasings[LeasingName] <> "بانک صادرات ویژه پرسنل"
            && qryLeasings[LeasingName] <> "بانک گردشکري پرسنل"
            && ISBLANK(qryLeasings[MiladiCancelDate])
            && ISBLANK(qryLeasings[ChangeSalesPolicyDate])
            && NOT( ISBLANK(qryLeasings[CreditAmount]) )
            && qryLeasings[MiladiLeasingConfirmDate] >= MinDate
            && qryLeasings[MiladiLeasingConfirmDate] <= MaxDate
    )
RETURN
CALCULATE(
    COUNTROWS(FilteredTable),
,    USERELATIONSHIP(        qryLeasings[MiladiLeasingConfirmDate],        'bi dimDate'[GregorianDate]    )
)

