--- انتخاب محدوده تاریخ برگزیده
SelectedDateRange :=
VAR CurrentStartDate =
    CALCULATE(
        MIN('RPR DimDate Receptions'[date_id]),
        ALLSELECTED('RPR DimDate Receptions')
    )
VAR CurrentEndDate =
    CALCULATE(
        MAX('RPR DimDate Receptions'[date_id]),
        ALLSELECTED('RPR DimDate Receptions')
    )
RETURN
    FORMAT(CurrentStartDate, "YYYYMMDD")
        & " - "
        & FORMAT(CurrentEndDate, "YYYYMMDD")



---------------------------
--  شبیه سازی cte
ChassisReceptionTable :=
=
VAR StartDate = DATE(2025,3,21)
VAR EndDate   = DATE(2025,4,20)

-- 1) پذیرش‌هایی که داخل بازه هستند
VAR CTE1 =
    FILTER(
        'RPR Receptions',
        'RPR Receptions'[RepDate] >= StartDate
            && 'RPR Receptions'[RepDate] <= EndDate
    )

-- 2) لیست یکتای شاسی‌هایی که حداقل یک پذیرش در بازه داشته‌اند
VAR ChassisList =
    DISTINCT(
        SELECTCOLUMNS( CTE1, "Ch", 'RPR Receptions'[ChassisNumber] )
    )

-- 3) برای هر شاسی محاسبات تجمعی را انجام بده
RETURN
ADDCOLUMNS(
    ChassisList,
    "ChassisReceptionCount",
        VAR _ch = [Ch]
        RETURN
            CALCULATE(
                COUNTROWS('RPR Receptions'),
                FILTER( ALL('RPR Receptions'), 'RPR Receptions'[ChassisNumber] = _ch )
            ),

    "FirstReceptionDate",
        VAR _ch2 = [Ch]
        RETURN
            CALCULATE(
                MIN('RPR Receptions'[RepDate]),
                FILTER( ALL('RPR Receptions'), 'RPR Receptions'[ChassisNumber] = _ch2 )
            ),

    "LastReceptionDate",
        VAR _ch3 = [Ch]
        RETURN
            CALCULATE(
                MAX('RPR Receptions'[RepDate]),
                FILTER( ALL('RPR Receptions'), 'RPR Receptions'[ChassisNumber] = _ch3 )
            )
)
