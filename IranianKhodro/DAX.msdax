con:=
CALCULATE(
    COUNT(qryLeasings[LeasingConfirmDate]),   
    qryLeasings[LeasingName] <> "بانک شهر ویژه پرسنل",
    qryLeasings[LeasingName] <> "بانک صادرات ویژه پرسنل",
    qryLeasings[LeasingName] <> "بانک گردشکري پرسنل",
    qryLeasings[leasingtype] <> "سایر",
    qryLeasings[MiladiContractDate] = BLANK(), 
    qryLeasings[ChangeSalesPolicyDate] = BLANK(),
    qryLeasings[CreditAmount]<> BLANK(),
     TREATAS(
         VALUES('bi dimDate'[GregorianDate]) ,
        qryLeasings[MiladiLeasingConfirmDate]
    )
)

