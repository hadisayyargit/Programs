    COUNTROWS('Sales'[HorizentalMergedSales]),
    FILTER(
        'Sales'[HorizentalMergedSales],
        NOT CONTAINSSTRING('Sales'[HorizentalMergedSales][ServicePackDescription], "گروه") &&
