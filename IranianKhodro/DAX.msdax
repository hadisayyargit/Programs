AvgOfOrderToDelivery:=
AVERAGEX(
    FILTER(
        'Sales HorizentalMergedSales',
        'Sales HorizentalMergedSales'[DealerCode] = 777 &&
        'Sales HorizentalMergedSales'[ContractId] <> 0 &&
        ISBLANK(RELATED('BI IranianContracts'[ContractId])) &&
        'Sales HorizentalMergedSales'[DeliverToCustomerDate] <> DATE(2000, 1, 1) &&
        'Sales HorizentalMergedSales'[DeliverToCustomerDate] <> BLANK() &&
        'Sales HorizentalMergedSales'[OrderDate] <> DATE(2000, 1, 1)
        &&  'Sales HorizentalMergedSales'[OrderDate] <> BLANK()
    ),
    DATEDIFF(
        'Sales HorizentalMergedSales'[OrderDate],
        'Sales HorizentalMergedSales'[DeliverToCustomerDate],
        DAY
    )
)

CountofOrderToDelivery:=
COUNTROWS(
    FILTER(
        'Sales HorizentalMergedSales',
        'Sales HorizentalMergedSales'[DealerCode] = 777 &&
        'Sales HorizentalMergedSales'[ContractId] <> 0 &&
        ISBLANK(RELATED('BI IranianContracts'[ContractId])) &&
        'Sales HorizentalMergedSales'[DeliverToCustomerDate] <> DATE(2000, 1, 1) &&
        'Sales HorizentalMergedSales'[DeliverToCustomerDate] <> BLANK() &&
        'Sales HorizentalMergedSales'[OrderDate] <> DATE(2000, 1, 1)
        &&  'Sales HorizentalMergedSales'[OrderDate] <> BLANK()
    )
    )
