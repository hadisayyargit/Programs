-- calculated column
partnaturetitle=
VAR _PartID =
    LOOKUPVALUE (
        'com factPartRequestItem'[PartId],
        'com factPartRequestItem'[PartRequestItemID],
        'com factPurchaseRequestItem'[ReferenceId]
    )

VAR _PartNature =
    LOOKUPVALUE (
        'com dimParts'[PartNature],
        'com dimParts'[PartID],
        _PartID
    )


RETURN 
    SWITCH ( 
        TRUE (),
        _PartNature = 1, "ماده اولیه",
        _PartNature = 2, "محصول",
        _PartNature = 3, "نیمه ساخته",
        _PartNature = 4, "دارایی ثابت",
        _PartNature = 5, "سایر",
        BLANK () 
    ) 
