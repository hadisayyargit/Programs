LeaveRatio:=	VAR TotalContracts = CALCULATE( COUNT('Sales HorizentalMergedSales'[ContractId]),    'Sales HorizentalMergedSales'[DealerCode] = 777,'Sales HorizentalMergedSales'[orderid] = 0)  
	VAR leads = 'Crm Leads'[LeadCount]
	Return COALESCE( Divide(TotalContracts,leads,0),0)


