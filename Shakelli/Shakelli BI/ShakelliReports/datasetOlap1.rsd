<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition">
  <DataSet Name="">
    <Query>
      <DataSourceReference>datasourceOlapvw</DataSourceReference>
      <CommandText> SELECT NON EMPTY { [Measures].[Payable Amount], [Measures].[Weight] } ON COLUMNS, NON EMPTY { ([تاریخ].[Hierarchy].[روز].ALLMEMBERS * [شعبه].[شعبه].[شعبه].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM [فروش و توزیع] CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</CommandText>
      <rd:DesignerState><QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition"><CommandType>MDX</CommandType><QuerySpecification xsi:type="MDXQuerySpecification"><Select><Items><Item><ID xsi:type="Level"><DimensionName>تاریخ</DimensionName><HierarchyName>Hierarchy</HierarchyName><HierarchyUniqueName>[تاریخ].[Hierarchy]</HierarchyUniqueName><LevelName>سال</LevelName><UniqueName>[تاریخ].[Hierarchy].[سال]</UniqueName></ID><ItemCaption>سال</ItemCaption><UniqueName>true</UniqueName></Item><Item><ID xsi:type="Level"><DimensionName>تاریخ</DimensionName><HierarchyName>Hierarchy</HierarchyName><HierarchyUniqueName>[تاریخ].[Hierarchy]</HierarchyUniqueName><LevelName>فصل</LevelName><UniqueName>[تاریخ].[Hierarchy].[فصل]</UniqueName></ID><ItemCaption>فصل</ItemCaption><UniqueName>true</UniqueName></Item><Item><ID xsi:type="Level"><DimensionName>تاریخ</DimensionName><HierarchyName>Hierarchy</HierarchyName><HierarchyUniqueName>[تاریخ].[Hierarchy]</HierarchyUniqueName><LevelName>ماه</LevelName><UniqueName>[تاریخ].[Hierarchy].[ماه]</UniqueName></ID><ItemCaption>ماه</ItemCaption><UniqueName>true</UniqueName></Item><Item><ID xsi:type="Level"><DimensionName>تاریخ</DimensionName><HierarchyName>Hierarchy</HierarchyName><HierarchyUniqueName>[تاریخ].[Hierarchy]</HierarchyUniqueName><LevelName>روز</LevelName><UniqueName>[تاریخ].[Hierarchy].[روز]</UniqueName></ID><ItemCaption>روز</ItemCaption><UniqueName>true</UniqueName></Item><Item><ID xsi:type="Level"><DimensionName>شعبه</DimensionName><HierarchyName>شعبه</HierarchyName><HierarchyUniqueName>[شعبه].[شعبه]</HierarchyUniqueName><LevelName>شعبه</LevelName><UniqueName>[شعبه].[شعبه].[شعبه]</UniqueName></ID><ItemCaption>شعبه</ItemCaption><UniqueName>true</UniqueName></Item><Item><ID xsi:type="Measure"><MeasureName>Payable Amount</MeasureName><UniqueName>[Measures].[Payable Amount]</UniqueName></ID><ItemCaption>Payable Amount</ItemCaption><BackColor>true</BackColor><ForeColor>true</ForeColor><FontFamily>true</FontFamily><FontSize>true</FontSize><FontWeight>true</FontWeight><FontStyle>true</FontStyle><FontDecoration>true</FontDecoration><FormattedValue>true</FormattedValue><FormatString>true</FormatString></Item><Item><ID xsi:type="Measure"><MeasureName>Weight</MeasureName><UniqueName>[Measures].[Weight]</UniqueName></ID><ItemCaption>Weight</ItemCaption><BackColor>true</BackColor><ForeColor>true</ForeColor><FontFamily>true</FontFamily><FontSize>true</FontSize><FontWeight>true</FontWeight><FontStyle>true</FontStyle><FontDecoration>true</FontDecoration><FormattedValue>true</FormattedValue><FormatString>true</FormatString></Item></Items></Select><From>فروش و توزیع</From><Filter><FilterItems /></Filter><Calculations /><Aggregates /><QueryProperties /></QuerySpecification><Query><Statement> SELECT NON EMPTY { [Measures].[Payable Amount], [Measures].[Weight] } ON COLUMNS, NON EMPTY { ([تاریخ].[Hierarchy].[روز].ALLMEMBERS * [شعبه].[شعبه].[شعبه].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM [فروش و توزیع] CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</Statement><ParameterDefinitions /></Query></QueryDefinition></rd:DesignerState>
