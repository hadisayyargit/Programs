  <Code>Public Shared Function Test(ByVal rowcount As Decimal) As String
        Dim st As String
        If rowcount &lt;=5 Then
          	st =Convert.ToString(rowcount )
        ElseIf rowcount &gt;= 10 Then
           st =Convert.ToString(rowcount )

        Else
           	st =Convert.ToString(rowcount )
        End If
        Return st
   End Function

