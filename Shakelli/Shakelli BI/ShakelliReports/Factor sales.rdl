  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=172.20.4.2;Initial Catalog=Tiger_GL</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>42ece3c8-6dd5-4c6e-8536-2ff3a5f05cac</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        detailesfactor.STOCKREF, item.CODE AS MaterialCode, item.NAME AS MaterialName, detailesfactor.TRCODE, headerfactor.FICHENO, 
                         persiandate.Shamsi2 AS PersianDate, client.CODE AS CustomerCode, client.DEFINITION_ AS CustomerName, client.ADDR1 AS CustomerAddress, 
                         client.TELNRS1 AS CustomerTel, client.CITY AS CustomerCity, client.TAXNR, 
                         CASE WHEN detailesfactor.TRCODE = 3 THEN - (detailesfactor.AMOUNT * detailesfactor.UINFO2) ELSE (detailesfactor.AMOUNT * detailesfactor.UINFO2) 
                         END AS AmountInMainUnit, us.NAME AS MainUnitName, detailesfactor.PRICE AS UnitPrice, 
                         CASE WHEN detailesfactor.TRCODE = 3 THEN - detailesfactor.LINENET ELSE detailesfactor.LINENET END AS LineNet, 
                         ROUND(detailesfactor.LINENET - detailesfactor.TOTAL, 3) AS Rounding, 
                         CASE WHEN detailesfactor.TRCODE = 8 THEN detailesfactor.DISTDISC ELSE - (detailesfactor.DISTDISC) END AS Discount, 
                         CASE WHEN detailesfactor.LINETYPE &lt;&gt; 0 AND detailesfactor.TRCODE = 8 THEN detailesfactor.LINENET WHEN detailesfactor.LINETYPE &lt;&gt; 0 AND 
                         detailesfactor.TRCODE = 3 THEN - detailesfactor.LINENET ELSE 0 END AS Campaign, 
                         (CASE WHEN detailesfactor.TRCODE = 3 THEN - detailesfactor.LINENET ELSE detailesfactor.LINENET END) 
                         - ((CASE WHEN detailesfactor.TRCODE = 8 THEN detailesfactor.DISTDISC ELSE - (detailesfactor.DISTDISC) END) 
                         + (CASE WHEN detailesfactor.LINETYPE &lt;&gt; 0 AND detailesfactor.TRCODE = 8 THEN detailesfactor.LINENET WHEN detailesfactor.LINETYPE &lt;&gt; 0 AND 
                         detailesfactor.TRCODE = 3 THEN - detailesfactor.LINENET ELSE 0 END)) AS AfterDiscounts, detailesfactor.VAT AS VATPercent, 
                         CASE WHEN detailesfactor.LINETYPE = 1 THEN 0 ELSE (CASE WHEN detailesfactor.TRCODE = 3 THEN - detailesfactor.VATAMNT ELSE detailesfactor.VATAMNT
                          END) END AS VATAmount, (CASE WHEN detailesfactor.TRCODE = 3 THEN - detailesfactor.LINENET ELSE detailesfactor.LINENET END) 
                         - ((CASE WHEN detailesfactor.TRCODE = 8 THEN detailesfactor.DISTDISC ELSE - (detailesfactor.DISTDISC) END) 
                         + (CASE WHEN detailesfactor.LINETYPE &lt;&gt; 0 AND detailesfactor.TRCODE = 8 THEN detailesfactor.LINENET WHEN detailesfactor.LINETYPE &lt;&gt; 0 AND 
                         detailesfactor.TRCODE = 3 THEN - detailesfactor.LINENET ELSE 0 END)) 
                         + (CASE WHEN detailesfactor.TRCODE = 3 THEN - detailesfactor.VATAMNT ELSE detailesfactor.VATAMNT END) AS PayableAmount, 
                         CASE WHEN detailesfactor.TRCODE = 3 THEN (CASE WHEN ua.WEIGHTREF = 18 THEN ua.WEIGHT * 1000 * detailesfactor.AMOUNT * detailesfactor.UINFO2 *
                          (- 1) WHEN ua.WEIGHTREF = 19 THEN ua.WEIGHT * detailesfactor.AMOUNT * detailesfactor.UINFO2 * (- 1) END) 
                         ELSE (CASE WHEN ua.WEIGHTREF = 18 THEN ua.WEIGHT * 1000 * detailesfactor.AMOUNT * detailesfactor.UINFO2 WHEN ua.WEIGHTREF = 19 THEN ua.WEIGHT
                          * detailesfactor.AMOUNT * detailesfactor.UINFO2 END) END / 1000 AS Weight, detailesfactor.DATE_, detailesfactor.AMOUNT, detailesfactor.TOTAL, 
                         client.POSTCODE, client.FAXNR, client.TAXOFFICE, headerfactor.PAYDEFREF
FROM            LG_001_03_STLINE AS detailesfactor INNER JOIN
                         LG_001_ITEMS AS item ON detailesfactor.STOCKREF = item.LOGICALREF INNER JOIN
                         LG_001_CLCARD AS client ON detailesfactor.CLIENTREF = client.LOGICALREF INNER JOIN
                         L_CAPIWHOUSE AS a ON detailesfactor.SOURCEINDEX = a.NR LEFT OUTER JOIN
                         LG_001_03_INVOICE AS headerfactor ON detailesfactor.INVOICEREF = headerfactor.LOGICALREF LEFT OUTER JOIN
                         BARG_DateConverter AS persiandate ON persiandate.MILADI = detailesfactor.DATE_ LEFT OUTER JOIN
                         LG_001_ITMUNITA AS ua ON item.LOGICALREF = ua.ITEMREF LEFT OUTER JOIN
                         LG_001_UNITSETL AS us ON ua.UNITLINEREF = us.LOGICALREF
WHERE        (ua.LINENR = 1) AND (detailesfactor.CANCELLED = 0) AND (detailesfactor.TRCODE IN (3, 8)) AND (detailesfactor.STOCKREF &lt;&gt; 0) AND 
                         (persiandate.Shamsi2 BETWEEN @StartDate AND @EndDate) AND (detailesfactor.LINETYPE NOT IN (1, 2)) AND (detailesfactor.LINETYPE = 0)</CommandText>
      </Query>
