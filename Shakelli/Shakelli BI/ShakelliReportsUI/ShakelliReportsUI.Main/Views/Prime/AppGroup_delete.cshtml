@model ShakelliReportsUI.DataLayer.Models.AppGroup

@{
    ViewBag.Title = "گروه کاربران";
    ViewBag.activemenu_prime = "active";
    ViewBag.activemenu_prime_usermanagement = "active";
}


@section pagetitle
{
    <h3 class="page-title">
        اطلاعات پایه
        <small>گروه کاربران</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a><span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">اطلاعات پایه</a> <span class="divider">&nbsp;</span>
        </li>
        <li><a href="#">گروه کاربران</a><span class="divider-last">&nbsp;</span></li>

    </ul>
}

<div class="widget-body">
    <div class="alert alert-block alert-warning fade in">
        <button type="button" class="close" data-dismiss="alert">×</button>
        <h4 class="alert-heading">هشدار!</h4>
        <p>
            اطلاعات فعلی حذف می شود!
            آیا ادامه می دهید؟
        </p>

        <div>
            <br />
            <div class="control-group">
                <label class="control-label">کد گروه</label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.GroupId)
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">عنوان </label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.GroupName, htmlAttributes: new { @class = "span6  tooltips", @id = "txtGroupName", data_trigger = "hover", data_original_title = "عنوان" })
                </div>
            </div>

            <button type="button" class="btn" onclick="location.href='@Url.Action("AppGroup_delete_confirm", "Prime", new { groupid = Model.GroupId })'">خب</button>
            <button type="button" class="btn" onclick="location.href='@Url.Action("AppGroup_edit", "Prime", new { groupid = Model.GroupId })'">لغو</button>

        </div>


    </div>
</div>



<script>
    jQuery(document).ready(function () {
        // initiate layout and plugins
        App.init();
    });
</script>


