@model ShakelliReportsUI.DataLayer.Models.Organization

@{
    ViewBag.Title = "سازمان";
    ViewBag.activemenu_prime = "active";
    ViewBag.activemenu_prime_organizationchart = "active";
}


@section pagetitle
{
    <h3 class="page-title">
        اطلاعات پایه
        <small>سازمان</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a><span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">اطلاعات پایه</a> <span class="divider">&nbsp;</span>
        </li>
        <li><a href="#">سازمان</a><span class="divider-last">&nbsp;</span></li>

    </ul>
}

<div class="widget-body">
    <div class="alert alert-block alert-warning fade in">
        <button type="button" class="close" data-dismiss="alert">×</button>
        <h4 class="alert-heading">هشدار!</h4>
        <p>
            اطلاعات فعلی حذف می شود!
            آیا ادامه می دهید؟
        </p>

        <div>
            <br />
            <div class="control-group">
                <label class="control-label">شناسه سازمان</label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.OrganizationId)
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">نام سازمان </label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.Title, htmlAttributes: new { @class = "span6  tooltips", @id = "txtOrganizationDs", data_trigger = "hover", data_original_title = "نام سازمان" })
                </div>
            </div>

            <button type="button" class="btn" onclick="location.href='@Url.Action("Organization_delete_confirm", "Prime", new { organizationId = Model.OrganizationId })'">خب</button>
            <button type="button" class="btn" onclick="location.href='@Url.Action("Organization_edit", "Prime", new { organizationId = Model.OrganizationId })'">لغو</button>

        </div>


    </div>
</div>



<script>
    jQuery(document).ready(function () {
        // initiate layout and plugins
        App.init();
    });
</script>


