@model ShakelliReportsUI.DataLayer.Models.AppGroupUserObject

@{
    ViewBag.Title = "دسترسی موضوعات";
    ViewBag.activemenu_prime = "active";
    ViewBag.activemenu_prime_usermanagement = "active";
}


@section pagetitle
{
    <h3 class="page-title">
        اطلاعات پایه
        <small>دسترسی موضوعات</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a><span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">اطلاعات پایه</a> <span class="divider">&nbsp;</span>
        </li>
        <li><a href="#">دسترسی موضوعات</a><span class="divider-last">&nbsp;</span></li>

    </ul>
}

<div class="widget-body">
    <div class="alert alert-block alert-warning fade in">
        <button type="button" class="close" data-dismiss="alert">×</button>
        <h4 class="alert-heading">هشدار!</h4>
        <p>
            اطلاعات فعلی حذف می شود!
            آیا ادامه می دهید؟
        </p>

        <div>
            <br />
            <div class="control-group">
                <label class="control-label">کد دسترسی</label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.Id)
                </div>
            </div>

            <button type="button" class="btn" onclick="location.href='@Url.Action("AppGroupUserObject_delete_confirm", "Prime", new ShakelliReportsUI.DataLayer.Models.AppGroupUser() { Id = Model.Id })'">خب</button>
            <button type="button" class="btn" onclick="location.href='@Url.Action("AppGroupUserObject_edit", "Prime", new { id = Model.Id })'">لغو</button>

        </div>


    </div>
</div>



<script>
    jQuery(document).ready(function () {
        // initiate layout and plugins
        App.init();
    });
</script>


