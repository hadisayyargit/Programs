@model List<ShakelliReportsUI.DataLayer.Models.AppGroupUserObjectView>


@{
    ViewBag.Title = "دسترسی موضوعات";
    ViewBag.activemenu_prime = "active";
    ViewBag.activemenu_prime_usermanagement = "active";
}

@section pagetitle
{
    <h3 class="page-title">
        اطلاعات پایه
        <small>دسترسی موضوعات</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a><span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">اطلاعات پایه</a> <span class="divider">&nbsp;</span>
        </li>
        <li><a href="#">دسترسی موضوعات</a><span class="divider-last">&nbsp;</span></li>

    </ul>
}


<div class="widget">
    
    <div class="span9">
        <div class="widget">
            <div class="widget-title">

                    <h4><i class="icon-reorder"></i>ویرایش</h4>
                    <span class="tools">
                        <a href="javascript:;" class="icon-chevron-down"></a>
                        <a href="javascript:;" class="icon-remove"></a>
                    </span>
                
                </div>

            <p style="color:blue">@ViewBag.SubTitle</p>

            <div class="widget-body form">
                @using (Html.BeginForm())
                {
                   <form action="#" class="form-horizontal">
           
                        @Html.ValidationSummary(true)
                       
                       <table class="table table-striped table-bordered table-advance table-hover" id="sample_5">
                           <thead>
                               <tr>
                                   <th class="">شناسه</th>
                                   <th class="">نام موضوع</th>
                                   <th class="">نام گروه</th>
                                   <th class="">نام کاربر</th>
                                   <th class="">دسترسی ایجاد</th>
                                   <th class="">دسترسی خواندن/دیدن</th>
                                   <th class="">دسترسی اصلاح</th>
                                   <th class="">دسترسی حذف</th>

                                   <th class="hidden">شناسه</th>
                                   <th class="hidden">شناسه موضوع</th>
                                   <th class="hidden">شناسه گروه</th>
                                   <th class="hidden">شناسه کاربر</th>
                               </tr>
                           </thead>
                           <tbody>
                                    @for (int i = 0; i < Model.Count; i++)    
                                        {
                                       <tr class="odd gradeX" >
                                           <td class="hidden-phone">@Model[i].Id</td>
                                           @if(Model[i].ParentObjectDs.Split(new char[]{'.'}).Count()==1)
                                           {                                       
                                                <td class="hidden-phone" style="color:blueviolet">@Html.DisplayFor(m => m.ToList()[i].ObjectDs)</td>
                                           }
                                           else if(Model[i].ParentObjectDs.Split(new char[]{'.'}).Count()==2)
                                           { 
                                                <td class="hidden-phone" style="color:seagreen">@Html.DisplayFor(m => m.ToList()[i].ObjectDs)</td>
                                           }
                                           else
                                           {
                                               <td class="hidden-phone" style="color:rosybrown">@Html.DisplayFor(m => m.ToList()[i].ObjectDs)</td>
                                           }

                                           <td class="hidden-phone">@Html.DisplayFor(m => m.ToList()[i].GroupName)</td>
                                           <td class="hidden-phone">@Html.DisplayFor(m => m.ToList()[i].UserName)</td>
                                           
                                           <td class="">
                                               @Html.CheckBoxFor(m => m.ToList()[i].CreateRight)
                                           </td>

                                           <td class="">
                                               @Html.CheckBoxFor(m => m.ToList()[i].ReadRight)
                                           </td>

                                           <td>
                                               @Html.CheckBoxFor(m => m.ToList()[i].UpdateRight)
                                           </td>

                                           <td>
                                               @Html.CheckBoxFor(m => m.ToList()[i].DeleteRight)
                                           </td>

                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].Id)</td>
                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].ObjectId)</td>
                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].GroupId)</td>
                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].UserId)</td>
                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].ObjectDs)</td>
                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].GroupName)</td>
                                           <td class="hidden">@Html.HiddenFor(m => m.ToList()[i].UserName)</td>
                                       </tr>
                                   }

                            </tbody>
                       </table>

                       <div class="form-actions">
                                <button type="submit" class="btn btn-success">بروزرسانی</button>
                                <button type="button" class="btn" onclick="location.href='@Url.Action("AppGroupUserObject_cancel", "Prime")'">بازگشت</button>
                            </div>

                        </form>
                }
                
               </div>
            
            </div>
            
        </div>

    
</div>



<script src="~/Scripts/jquery-1.8.3.min.js"></script>
<script src="@Url.Content("~/Content/assets/uniform/jquery.uniform.min.js")"></script>
<script src="~/Scripts/scripts.js"></script>


<script>
    jQuery(document).ready(function () {
        App.init();
    });
</script>

@Scripts.Render("~/bundles/jqueryval")
