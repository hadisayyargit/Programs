@{
    Layout = null;
}

<!DOCTYPE html>
<!--
Template Name: Admin Lab Dashboard build with Bootstrap v2.3.1
Template Version: 1.2
Author: Mosaddek Hossain
Website: http://thevectorlab.net/
-->
<!--[if IE 8]> <html lang="en" class="ie8"> <![endif]-->
<!--[if IE 9]> <html lang="en" class="ie9"> <![endif]-->
<!--[if !IE]><!-->
<html lang="en">
<!--<![endif]-->
<!-- BEGIN HEAD -->
<head>
    <meta charset="utf-8" />
    <title>Lock page</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />
    <link href="~/Content/assets/bootstrap-rtl/css/bootstrap-responsive-rtl.min.css" rel="stylesheet" />
    <link href="~/Content/assets/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/style_responsive.css" rel="stylesheet" />
    <link href="~/Content/style_default.css" rel="stylesheet" id="style_color" />
</head>
<!-- END HEAD -->
<!-- BEGIN BODY -->
<body id="lock-body">
    <div class="lock-header">
        <!-- BEGIN LOGO -->
        <a href="index.html" id="logo" class="center">
            <img src="~/images/logo_shakelli.png" alt="logo" class="center" />
        </a>
        <!-- END LOGO -->
    </div>

    <!-- BEGIN LOCK -->
    <div id="lock">
        <!-- BEGIN LOCK FORM -->
        @using(Html.BeginForm())
        {
        @*<form id="lockform" class="form-vertical no-padding no-margin" action="index.html">*@
        <div class="lock-title">
            <i class="icon-lock"></i>
            <h3>برنامه قفل شده است!</h3>
        </div>
        <div class="lock-avatar-row">
            <img src="~/images/photo.jpg" alt="">
        </div>
        <div class="control-wrap lock-identity">
            <h3>@HttpContext.Current.Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_CurrentUserName]</h3>
            <span>info@shakelli.ir</span>
            <div class="lock-form-row">
                @*<form action="index.html" class="form-search">*@
                <div class="input-append">
                    <input type="password" placeholder="گذرواژه" class="m-wrap">
                    <button class="btn tarquoise" type="submit"><i class=" icon-arrow-left"></i></button>
                </div>
                <div class="relogin">
                    <a href="~/Account/Login">@HttpContext.Current.Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_CurrentUserName] نیستی؟</a>
                </div>
                @*</form>*@
            </div>
        </div>

        @*</form>*@
        <!-- END LOCK FORM -->
        }
    </div>
    <!-- END LOCK -->
    <!-- BEGIN COPYRIGHT -->
    <footer>
        <div id="login-copyright">
            <address>
                <p>
                    2013 &copy; صنایع غذایی شکلی
                </p>
            </address>
        </div>

    </footer>
    <!-- END COPYRIGHT -->
    <!-- BEGIN JAVASCRIPTS -->
    <script src="~/scripts/jquery-1.8.3.min.js"></script>
    <script src="~/Content/assets/bootstrap-rtl/js/bootstrap.min.js"></script>
    <script src="~/scripts/jquery.blockui.js"></script>
    <script src="~/scripts/scripts.js"></script>
    <script>
        jQuery(document).ready(function () {
            App.initLOCK();
        });
    </script>
    <!-- END JAVASCRIPTS -->
</body>
<!-- END BODY -->
</html>