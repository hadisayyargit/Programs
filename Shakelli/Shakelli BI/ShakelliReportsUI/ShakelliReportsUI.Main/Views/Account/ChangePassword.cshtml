@model ShakelliReportsUI.DataLayer.Models.ManageUserViewModel

@{
    ViewBag.Title = "پروفایل";
    ViewBag.activemenu_help = "active";
    ViewBag.activemenu_help_userprofile = "active";
    
 }


@section pagetitle
{
    <h3 class="page-title">
        راهنما
        <small>تغییر گذرواژه</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a><span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">راهنما</a> <span class="divider">&nbsp;</span>
        </li>
        <li><a href="#">پروفایل</a><span class="divider-last">&nbsp;</span></li>

    </ul>
}
    <div id="login" style="background-color:cadetblue">

    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)

        <div class="lock">
            <i class="icon-lock"></i>
        </div>

        <div class="control-wrap lock-identity">
            <h4 style="color:wheat">تغییر گذرواژه</h4>
            <div class="control-group">
                <div class="controls">
                    <div class="input-prepend">
                        <span class="add-on"><i class="icon-user"></i></span>
                        @Html.PasswordFor(model => model.Password, htmlAttributes: new { @id = "input-password", @type = "password", @placeholder = "رمز جدید" })

                    </div>
                </div>
            </div>
            <div class="control-group">
                <div class="controls">
                    <div class="input-prepend">
                        <span class="add-on"><i class="icon-key"></i></span>
                        @Html.TextBoxFor(m => m.ConfirmPassword, htmlAttributes: new { id = "input-confirm", type = "password", placeholder = "تکرار رمز" })


                    </div>

                </div>

            </div>

            @Html.ValidationMessageFor(model => model.Password)
            <br />
            @Html.ValidationMessageFor(model => model.ConfirmPassword)

        </div>

        @Html.HiddenFor(model => model.UserId)

        <button type="submit" class="btn btn-success" id="ChangePassword">تغییر</button>
        <button type="button" class="btn" onclick="location.href='@Url.Action("UserProfile", "Account")'">بازگشت</button>

    }


    @if (Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MessageModel] != null)
    {
        @Html.Partial("_MessagePartial", Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MessageModel])
    }




</div>



    <script>
        jQuery(document).ready(function () {
            App.initLogin();
        });
    </script>




