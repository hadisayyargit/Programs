@model ShakelliReportsUI.DataLayer.Models.ReportModel

@section pagetitle
{
    <h3 class="page-title">
        
        <small>@ViewBag.Title</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a>
            <span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">@Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MainMenuDs]</a>
            <span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">@Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_SubMenuDs]</a>
            <span class="divider-last">&nbsp;</span>
        </li>

    </ul>
}

<div>
    @Html.Partial("_DirectBrowser", Model)
</div>

<script>
    jQuery(document).ready(function () {
        App.init();
    });
</script>

