
@{
    ViewBag.Title = "تماس با ما ";
    ViewBag.activemenu_help_contactus = "active";
}


@section pagetitle
{
    <h3 class="page-title">
        راهنما
        <small>ارتباط با صنایع غذایی شکلی</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a>
            <span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">راهنما</a>
            <span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">تماس با ما</a>
            <span class="divider-last">&nbsp;</span>
        </li>

    </ul>
}


<div class="widget-body">
    @*<div id="gmap_basic" class="gmaps">

        </div>*@

    <div class="row-fluid">
        <iframe width="100%" height="250" frameborder="0" style="border:0" scrolling="no" marginheight="0" marginwidth="0" allowfullscreen src="https://www.google.com/maps/embed?pb=!1m21!1m12!1m3!1d3236.3010248036603!2d51.412775500000016!3d35.7925426!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!4m6!3e0!4m0!4m3!3m2!1d35.7921858!2d51.412003!5e0!3m2!1ses-419!2smx!4v1437563295376"></iframe>
    </div>

    <div class="space20"></div>
    <!--BEGIN CONTACT US-->
    <div class="contact-us">
        <h3>کانالهای ارتباطی</h3>
        <div class="row-fluid">
            <div class="span4">
                <h4>نشانی</h4>
                <p>
                    2014 &copy; صنایع غذایی شکلی
                    <br />
                    آدرس دفتر مرکزی:تهران ابتدای بزرگراه چمران کوچه تیر پلاک 3
                    مرکز امور مشتریان:  02122038148
                    <br />
                    <br />
                </p>
            </div>
            <div class="span4">
                <h4>تلفنی</h4>
                <p>
                    <strong>تلفن:</strong> 02122038148
                    <br>
                    <strong>مرکز امور مشتریان:</strong> 02122038148
                    <br>
                    <strong>نمابر:</strong> 02122038148
                </p>
            </div>
            <div class="span4">
                <h4>شبکه‌ای</h4>
                <p>
                    <strong>پست الکترونیک:</strong>info@shakelli.ir
                    <br>
                    <strong>پایگاه اینترنتی:</strong> www.shakelli.ir
                    <br>
                </p>
            </div>
        </div>

        <div class="space20"></div>
        <div class="row-fluid">
            <div class="feedback">
                <h3>ارتباط برخط</h3>
                <p>همین حالا برای ما پیام بفرستید:</p>
                <div class="space20"></div>

                <form class="form-inline ">
                    <div class="control-group">
                        <input type="text" id="txtName" class="span12" placeholder="نام">
                    </div>
                    <div class="control-group ">
                        <input type="text" id="txtFrom" class="span6 one-half" placeholder="پست الکترونیک">
                        <input type="text" id="txtPhone" class="span6" placeholder="تلفن">
                    </div>
                    <div class="control-group">
                        <textarea id="txtBody" rows="5" class="span12" placeholder="متن پیام" ></textarea>
                    </div>
                    <div class="text-center">
                        @*<button type="button" class="btn btn-info" onclick="location.href='@Url.Action("SendMail", "Home",Model)'">ارسال پیام</button>*@
                        <button type="button" class="btn btn-info" id="btnSendMail">ارسال پیام</button>

                    </div>

                </form>
            </div>
        </div>
    </div>
    <!--END CONTACT US-->
</div>

