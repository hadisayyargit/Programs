<script src="@Url.Content("~/Scripts/jquery-1.8.3.min.js")"></script>


<script>
    jQuery(document).ready(function () {
        App.init();
    });
</script>

<script>
    $("#btnSendMail").click(function () {
        var url = "SendMail?strBody=" + $("#txtBody").val() + "&strName=" + $("#txtName").val() + "&strFrom=" + $("#txtFrom").val() + "&strPhone=" + $("#txtPhone").val();

        window.location.replace(url);
        //alert($("#txtBody").val());
    });
</script>