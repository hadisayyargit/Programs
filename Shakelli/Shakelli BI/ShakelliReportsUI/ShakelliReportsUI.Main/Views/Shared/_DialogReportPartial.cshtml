<script type="text/javascript">

    $(function () {
        // حالت پیشفرض
        $('#datepicker0').datepicker();
        //-----------------------------------

        //-----------------------------------
        // انتخاب با کلیک بر روی عکس
        $("#datepicker6").datepicker({
            showOn: 'button',
            buttonImage: '../../Content/assets/datepicker-fa/styles/images/calendar.png',
            buttonImageOnly: true
        });

        // تنظیم حداقل بصورت پویا
        $('#datepicker12from').datepicker({
            onSelect: function (dateText, inst) {
                $('#datepicker12to').datepicker('option', 'minDate', new JalaliDate(inst['selectedYear'], inst['selectedMonth'], inst['selectedDay']));
            }
        });
        $('#datepicker12to').datepicker();

    });
</script>


<script>
    function combochange(comboname)
    {
        if(comboname=="cboBranch")
        {
            var n = $("#cboBranch").val();

            $("#cboSeller").empty();
            $("#cboSeller").append($("<option></option>").val(-1).text("فروشنده را انتخاب کنید:"));

            $("#cboCustomer").empty();
            $("#cboCustomer").append($("<option></option>").val(-1).text("مشتری را انتخاب کنید:"));

            /// روش ایجکس
            $.ajax({
                cache: false,
                type: "GET",
                url: "@(Url.Action("GetSellers", "Reports"))",
                data: { "branch": n },
                success: function (data) {
                    $.each(data, function () {
                        $("#cboSeller").append($("<option></option>").val(this.SalesmanCode).text(this.SalesmanName));
                    });

                }
            });

        }

        if(comboname=="cboSeller")
        {

            var n = $("#cboSeller").val();

            $("#cboCustomer").empty();
            $("#cboCustomer").append($("<option></option>").val(-1).text("مشتری را انتخاب کنید:"));


            /// روش ایجکس
            $.ajax({
                cache: false,
                type: "GET",
                url: "@(Url.Action("GetCustomers", "Reports"))",
                data: { "salesmancode": n },
                success: function (data) {

                    $.each(data, function () {
                        $("#cboCustomer").append($("<option></option>").val(this.LOGICALREF).text(this.CustomerName));

                    });

                }


            });

            //alert("6");

        }
    };
</script>

<script>
    //$("#cboProvince").change(function () {       // This will fire when the dropdown value will get changed
    function cboProvice_Change()
    {
        var n = $("#cboProvince").val();

        @*
        var myJsVariable = '@ViewBag.State'
        var i1=$("#cboProvince")[0].selectedIndex;

        if (i1 > 0)
            i1 = i1 - 1;


        *@

        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.City));

        //var passedTest = [];
        $("#cboCity").empty();
        $("#cboCity").append($("<option></option>").val(-1).text("شهر را انتخاب کنید:"));


        ///روش کلاینتی
        for (var i = 0; i < x.length; i++) {
            if (x[i].CTYREF == n)
            {
                //passedTest.push(x[i]);
                $("#cboCity").append($("<option></option>").val(x[i].LOGICALREF).text(x[i].NAME));
            }
        }

    }

</script>

<script>
    function cboCity_Change()
    {
        var cityid = $("#cboCity").val();

        var x =@Html.Raw(new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(@ViewBag.District));

        $("#cboDistrict").empty();
        $("#cboDistrict").append($("<option></option>").val(-1).text("منطقه را انتخاب کنید:"));


        ///روش کلاینتی
        for (var i = 0; i < x.length; i++) {
            if (x[i].TOWNNR == cityid)
            {
                $("#cboDistrict").append($("<option></option>").val(x[i].Code).text(x[i].NAME));

            }
        }
    }
</script>

<script>
    function showreport()
    {
        var reportdisplaymode=0;

        reportdisplaymode=$('#rdoGrid:checked').val()

        if(reportdisplaymode==undefined)
            reportdisplaymode=$('#rdoReportViewer:checked').val()

        //var x=$("#NonTipParameters1_Value").val();
        //alert(x);

        var url1 = "../SubmitReport?stateid=" + $("#cboProvince").val() + "&citycode=" + $("#cboCity").val() + "&branch=" + $("#cboBranch").val() + "&salesmancode=" +$('#cboSeller').val()+ "&fromdate=" + $("#datepicker12from").val() + "&todate=" + $("#datepicker12to").val() + "&supervisorcode=" + $("#cboSupervisor").val()+ "&customercode=" + $("#cboCustomer").val()+ "&reportdisplaymode=" + reportdisplaymode
            + "&anbarid=" + $("#cboAnbar").val()+ "&kalagroupcode=" + $("#cboKalaGroup").val()+ "&kalasubgroupcode=" + $("#cboKalaSubGroup").val()+ "&kalaid=" + $("#cboKala").val()+ "&kanaltozi=" + $("#cboKanal").val()+ "&classtakhfif=" + $("#cboClassTakhfif").val()+ "&districtcode=" + $("#cboDistrict").val()+ "&tradinggrp=" + $("#cboTradingGrp").val()
            + "&nontipparameters1=" + $("#NonTipParameters1_Value").val()+ "&nontipparameters2=" + $("#NonTipParameters2_Value").val()+ "&nontipparameters3=" + $("#NonTipParameters3_Value").val()+ "&nontipparameters4=" + $("#NonTipParameters4_Value").val()+ "&nontipparameters5=" + $("#NonTipParameters5_Value").val(); //Append Id To URL

        
        window.location.replace(url1);
    }

</script>


