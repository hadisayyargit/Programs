<!DOCTYPE html>

@{
    ViewBag.Title = "";
    //TempData["msg"] = "aa";
}
<html>

<head>
    <meta charset="utf-8" />
    <title>صنایع غذایی شکلی - سامانه جامع گزارشها</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />

    @*<link href="~/images/logo_shakelli.png" rel="shortcut icon" type="image/x-icon" />*@
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="@Url.Content("~/Content/assets/bootstrap-rtl/css/bootstrap-rtl.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/assets/bootstrap-rtl/css/bootstrap-responsive-rtl.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/assets/font-awesome/css/font-awesome.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/style.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/style_responsive.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/style_default.css")" rel="stylesheet" id="style_color" />

    <link href="@Url.Content("~/Content/assets/fancybox/source/jquery.fancybox.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/assets/uniform/css/uniform.default.css")" rel="stylesheet" type="text/css" />

    <link href="@Url.Content("~/Content/assets/chosen-bootstrap/chosen/chosen.css")" rel="stylesheet" />
    <link href="~/Content/assets/datepicker-fa/styles/jquery-ui-1.8.14.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/assets/fullcalendar/fullcalendar/bootstrap-fullcalendar.css")" rel="stylesheet" />

    <script src="@Url.Content("~/Scripts/jquery-1.8.3.min.js")"></script>

    <script src="@Url.Content("~/scripts/jquery.blockui.js")"></script>
    <script src="@Url.Content("~/scripts/jquery.cookie.js")"></script>

    <script src="@Url.Content("~/Content/assets/flot/jquery.flot.pie.js")"></script>
    <script src="@Url.Content("~/Content/assets/flot/jquery.flot.stack.js")"></script>
    <script src="@Url.Content("~/Content/assets/flot/jquery.flot.crosshair.js")"></script>

    <script src="@Url.Content("~/scripts/jquery.peity.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/uniform/jquery.uniform.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/assets/chosen-bootstrap/chosen/chosen.jquery.min.js")"></script>
    <script src="@Url.Content("~/scripts/scripts.js")"></script>



</head>



<body class="k-rtl fixed-top">

    @*background=" ~ />images/gallery/photo2.jpg"
        @*style="background: url('images/gallery/photo2.jpg')*@


    <header>
        <!-- BEGIN TOP NAVIGATION BAR -->
        <div id="header" class="navbar navbar-inverse navbar-fixed-top">
            <div class="navbar-inner">
                <div class="container-fluid">
                    <!-- BEGIN LOGO -->
                    <a class="brand" href="#">
                        <img src="~/images/logo_shakelli.png" alt="service management" />
                    </a>
                    <!-- END LOGO -->
                    <!-- BEGIN RESPONSIVE MENU TOGGLER -->
                    <a class="btn btn-navbar collapsed" id="main_menu_trigger" data-toggle="collapse" data-target=".nav-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="arrow"></span>
                    </a>
                    <!-- END RESPONSIVE MENU TOGGLER -->
                    <div id="top_menu" class="nav notify-row">
                        <!-- BEGIN NOTIFICATION -->
                        <ul class="nav top-menu">
                            <!-- BEGIN SETTINGS -->
                            <li class="dropdown">
                                <a class="dropdown-toggle element" data-placement="bottom" data-toggle="tooltip" href="#" data-original-title="زبان">
                                    <i class="icon-cog"></i>
                                </a>
                            </li>
                            <!-- END SETTINGS -->

                            <li class="dropdown">

                                <a class="dropdown-toggle element" data-placement="bottom" data-toggle="tooltip" href="~/" data-original-title="خانه">
                                    <i class="icon-home"></i>
                                </a>
                            </li>

                            <li class="dropdown">
                                <a class="dropdown-toggle element" data-placement="bottom" data-toggle="tooltip" href="~/Home/DownloadXpi" data-original-title="بارگیری">
                                    <i class="icon-download-alt"></i>
                                </a>
                            </li>

                        </ul>
                    </div>
                    <!-- END  NOTIFICATION -->
                    <div class="top-nav ">
                        <ul class="nav pull-left top-menu">
                            <!-- BEGIN INBOX DROPDOWN -->
                            @{
                                int n1 = 0;
                                int n2 = 0;
                                try
                                {
                                    n1 = ((List<ShakelliReportsUI.DataLayer.Models.AppNotification>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MessageList]).Count();
                                    n2 = ((List<ShakelliReportsUI.DataLayer.Models.AppNotification>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_NotificationList]).Count();
                                }
                                catch
                                {

                                }
                            }

                            <li class="dropdown" id="header_inbox_bar">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                    <i class="icon-envelope-alt"></i>
                                    @if (n1 > 0)
                                    {
                                        <span class="badge badge-important">@n1</span>
                                    }
                                </a>
                                <ul class="dropdown-menu extended inbox">


                                    <li>
                                        <p>شما @n1 پیام جدید دارید</p>
                                    </li>

                                    @if (n1 > 0)
                                    {
                                        foreach (var item in (List<ShakelliReportsUI.DataLayer.Models.AppNotification>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MessageList])
                                        {

                                            <li>

                                                <a href="~/Administration/ShowNotify?notificationid=@item.NotificationId">
                                                    <span class="photo"><img src="~/images/avatar-mini.png" alt="avatar" /></span>

                                                    <span class="subject">
                                                        <span class="from">@item.Sender</span>

                                                    </span>
                                                    <span class="message">
                                                        @item.Body

                                                    </span>
                                                    <span class="time">@item.NotificationDate</span>
                                                </a>
                                            </li>

                                        }
                                    }
                                    <li>
                                        <a href="~/Administration/appNotifications?activetab=Tab_Messages">دیدن همه پیامها</a>
                                    </li>
                                </ul>
                            </li>
                            <!-- END INBOX DROPDOWN -->
                            <!-- BEGIN NOTIFICATION DROPDOWN -->
                            <li class="dropdown" id="header_notification_bar">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">

                                    <i class="icon-bell-alt"></i>
                                    @if (n2 > 0)
                                    {
                                        <span class="badge badge-warning">@n2</span>
                                    }
                                </a>
                                <ul class="dropdown-menu extended notification">


                                    <li>
                                        <p>شما @n2 اعلان دارید</p>
                                    </li>

                                    @if (n2 > 0)
                                    {
                                        foreach (var item in (List<ShakelliReportsUI.DataLayer.Models.AppNotification>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_NotificationList])
                                        {
                                            <li>
                                                <a href="~/Administration/ShowNotify?notificationid=@item.NotificationId">
                                                    <span class="label label-important"><i class="icon-bolt"></i></span>
                                                    @item.Body
                                                    <span class="small italic">@item.NotificationDate</span>
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </li>
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">

                                    @if (HttpContext.Current.Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_PersonImagePath] == null || HttpContext.Current.Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_PersonImagePath] == "")
                                    {
                                        <img src="~/images/avatar-mini.png" alt="" height="32" width="28">
                                    }
                                    else
                                    {
                                        <img src="@Url.Content(HttpContext.Current.Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_PersonImagePath].ToString())" alt="" width="28" height="32">
                                    }

                                    <span class="username"> @HttpContext.Current.Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_CurrentPersonName]</span>
                                    <b class="caret"></b>
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a href="~/Account/UserProfile?userid=0"><i class="icon-user"></i> پروفایل من</a>
                                    </li>
                                    <li class="divider"></li>
                                    <li>
                                        <a href="~/Account/LockScreen"><i class="icon-lock"></i> قفل کردن صفحه برنامه(Lock)</a>
                                    </li>
                                    <li>
                                        <a href="~/Account/LogOff"><i class="icon-key"></i>بیرون رفتن از برنامه(Log Off)</a>
                                    </li>

                                </ul>
                            </li>
                            <!-- END USER LOGIN DROPDOWN -->
                        </ul>
                        <!-- END TOP NAVIGATION MENU -->
                    </div>
                </div>
            </div>
            <!-- END TOP NAVIGATION BAR -->
        </div>
    </header>

    <aside>

        <div id="sidebar" class="nav-collapse collapse">
            <!-- BEGIN SIDEBAR TOGGLER BUTTON -->
            <div class="sidebar-toggler hidden-phone"></div>
            <!-- BEGIN SIDEBAR TOGGLER BUTTON -->
            <!-- BEGIN RESPONSIVE QUICK SEARCH FORM -->
            <div class="navbar-inverse">
                <form class="navbar-search visible-phone">
                    <input type="text" class="search-query" placeholder="Search" />
                </form>
            </div>

            <ul class="sidebar-menu">
                <li class="@Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_ActiveMenu_Home]">
                    <a class="" href="~/Home/Index"><span class="icon-box"><i class="icon-home"></i></span> صفحه نخست</a>
                </li>

                @{
                    int lastobjectid1 = 0;
                    int lastobjectid2 = 0;
                    int lastobjectid3 = 0;

                    if (Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MenuLevel1] != null)
                    { 
                    foreach (var item1 in (List<ShakelliReportsUI.DataLayer.Models.AppGroupUserObjectView>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_MenuLevel1])
                    {
                        if (item1.ObjectId != lastobjectid1)
                        {
                            var menuLevel2List = ((List<ShakelliReportsUI.DataLayer.Models.AppGroupUserObjectView>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_AccessList]).Where(m => m.ParentObjectId == item1.ObjectId && m.CRUD.Substring(1, 1) == "1").OrderBy(m => m.ObjectId).ToList();

                            <li class="has-sub">
                                <a href="javascript:;" class="">
                                    <span class="icon-box"><i class="icon-th"></i></span> @item1.ObjectDs
                                    <span class="arrow"></span>
                                </a>


                                <ul class="sub">

                                    @foreach (var item2 in (List<ShakelliReportsUI.DataLayer.Models.AppGroupUserObjectView>)menuLevel2List)
                                    {
                                        if (item2.ObjectId != lastobjectid2)
                                        {
                                            var menuLevel3List = ((List<ShakelliReportsUI.DataLayer.Models.AppGroupUserObjectView>)Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_AccessList]).Where(m => m.ParentObjectId == item2.ObjectId && m.CRUD.Substring(1, 1) == "1").ToList();

                                            if (menuLevel3List.Count == 0)
                                            {
                                                <li class="@Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_ActiveSubMenu + @item2.ObjectName]">
                                                    @if (item2.HasDirectPath)
                                                    {
                                                        @*<a href="@Url.Content(@item2.UrlPath)" target="_blank">*@
                                                        <a href="@Url.Content(@item2.UrlPath)">
                                                            @item2.ObjectDs
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="#">
                                                            @item2.ObjectDs
                                                        </a>
                                                    }
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="dropdown-submenu @Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_ActiveSubMenu + @item2.ObjectName]">


                                                    <a href="#">
                                                        @item2.ObjectDs
                                                    </a>

                                                    @*@Html.ActionLink(@item.ObjectDs, @item.ObjectName, "Prime")*@

                                                    <ul class="dropdown-menu faq-list" style="top:-40px;position:absolute">
                                                        @{
                                                            foreach (var item3 in (List<ShakelliReportsUI.DataLayer.Models.AppGroupUserObjectView>)menuLevel3List)
                                                            {
                                                                if (item3.ObjectId != lastobjectid3)
                                                                {
                                                                    <li>

                                                                        @if (item3.HasDirectPath)
                                                                        {

                                                                            <a href="~/Reports/ReportMenu?listmenu=@item3.ObjectName&mainmenu=@item2.ObjectId&mainmenuds=@item2.ObjectDs&submenu=@item3.ObjectId&submenuds=@item3.ObjectDs&hasdirectpath=true&urlpath=@item3.UrlPath">
                                                                                <i class="icon-arrow-up" style="color: darkgoldenrod"></i>
                                                                                @item3.ObjectDs
                                                                            </a>
                                                                        }

                                                                        else if (item3.HasOwnGrid)
                                                                        {
                                                                            <a href="~/Reports/ReportMenu?listmenu=@item3.ObjectName&mainmenu=@item2.ObjectId&mainmenuds=@item2.ObjectDs&submenu=@item3.ObjectId&submenuds=@item3.ObjectDs">
                                                                                <i class="icon-table" style="color:green"></i>
                                                                                @item3.ObjectDs
                                                                            </a>
                                                                        }

                                                                        else if (item3.HasServerReport)
                                                                        {
                                                                            <a href="~/Reports/ReportMenu?listmenu=@item3.ObjectName&mainmenu=@item2.ObjectId&mainmenuds=@item2.ObjectDs&submenu=@item3.ObjectId&submenuds=@item3.ObjectDs">
                                                                                <i class="icon-dashboard" style="color: darkblue"></i>
                                                                                @item3.ObjectDs
                                                                            </a>
                                                                        }

                                                                        else
                                                                        {
                                                                            <a href="~/Reports/ReportMenu?listmenu=@item3.ObjectName&mainmenu=@item2.ObjectId&mainmenuds=@item2.ObjectDs&submenu=@item3.ObjectId&submenuds=@item3.ObjectDs">
                                                                                <i class="icon-table" style="color:#868686"></i>
                                                                                @item3.ObjectDs
                                                                            </a>

                                                                        }

                                                                    </li>

                                                                    lastobjectid3 = item3.ObjectId;

                                                                }
                                                            }


                                                        }

                                                    </ul>
                                                </li>
                                                                    }
                                                                }

                                                                lastobjectid2 = item2.ObjectId;
                                                            }
                                </ul>

                            </li>
                                                                        }

                                                                        lastobjectid1 = item1.ObjectId;
                                                                    }
                                                            }
                                                            ///1
                                                            <li class="has-sub">
                                                                <a href="javascript:;" class="">
                                                                    <span class="icon-box"><i class="icon-ambulance"></i></span>راهنما
                                                                    <span class="arrow"></span>
                                                                </a>
                                                                <ul class="sub">
                                                                    @*
                                                                        <li class="@ViewBag.activemenu_help_about">@Html.ActionLink("درباره ما", "About", "Home", new { target = "_blank" })</li>*@
                                                                    <li class="">
                                                                        <a href="~/Home/About" target="_blank">درباره ما</a>
                                                                    </li>
                                                                    <li class="">@Html.ActionLink("تماس با ما", "Contact", "Home")</li>
                                                                    <li class="">
                                                                        <a href="~/Account/UserProfile?userid=0"><i class="icon-user"></i> پروفایل </a>
                                                                    </li>

                                                                    <li>@*@Html.ActionLink("دانستنیها", "faq", "Home")*@</li>
                                                                    <li>@Html.ActionLink("دانستنیها", "Icons", "Home")</li>

                                                                    <li class="">@Html.ActionLink("گالری", "Gallery", "Home")</li>

                                                                </ul>

                                                            </li>


                                                            <li>
                                                                <a class="" href="~/Account/LogOff"><span class="icon-box"><i class="icon-off"></i></span> بیرون رفتن</a>
                                                            </li>
                }

            </ul>
            <!-- END SIDEBAR MENU -->
        </div>

    </aside>

    <div id="main-content" style="background-image: url('/images/shakelli_bg.png');  background-size: cover;">
        <!-- BEGIN PAGE CONTAINER-->
        <div class="container-fluid">
            <!-- BEGIN PAGE HEADER-->
            <div class="row-fluid">
                <div class="span12">
                    <section id="pagetitle">
                        @RenderSection("pagetitle", required: false)
                    </section>

                    <section id="breadcrumb">
                        @RenderSection("breadcrumb", required: false)

                        <div id="theme-change" class="hidden-phone">
                            <i class="icon-cogs"></i>
                            <span class="settings">
                                <span class="text">نما:</span>
                                <span class="colors">
                                    <span class="color-default" data-style="default"></span>
                                    <span class="color-gray" data-style="gray"></span>
                                    <span class="color-purple" data-style="purple"></span>
                                    <span class="color-navy-blue" data-style="navy-blue"></span>
                                    <span class="color-default1" data-style="default1"></span>
                                </span>
                            </span>
                        </div>

                    </section>

                </div>
            </div>

            @RenderBody()

        </div>

    </div>

    <footer>
        <div id="footer">
            <address>
                <p>
                    2014 &copy; صنایع غذایی شکلی
                    <br />
                    آدرس دفتر مرکزی:تهران ابتدای بزرگراه چمران کوچه تیر پلاک 3
                    مرکز امور مشتریان:  02122038148
                    <br />
                    <br />

                </p>
            </address>

            <div class="span pull-left">
                <span class="go-top"><i class="icon-arrow-up"></i></span>
            </div>
        </div>
    </footer>

    <section>

        <script src="@Url.Content("~/Content/assets/bootstrap-rtl/js/bootstrap.min.js")"></script>

        <!-- ie8 fixes -->
        @*[if lt IE 9]>*@
        @*
            <script src="~/scripts/excanvas.js"></script>
            <script src="~/scripts/respond.js"></script>*@
        @*<![endif]*@


        @*
            <div id="container" class="row-fluid">
            <div id="dialog-alert" style="display: none">
            <p>
            @TempData["msg"]!
            </p>
            </div>

            <script>

            $("#dialog-alert").dialog({
            autoOpen: false,
            resizable: false,
            height: 170,
            width: 350,
            show: { effect: 'drop', direction: "up" },
            modal: true,
            draggable: true,
            open: function (event, ui) {
            $(".ui-dialog-titlebar-close").hide();
            },
            buttons: {
            "OK": function () {
            $(this).dialog("close");

            },
            "Cancel": function () {
            $(this).dialog("close");
            }
            }
            });

            </script>*@




        <script>
            jQuery(document).ready(function () {

                if ('@TempData["msg"]' != "") {
                    alert('@TempData["msg"]')
                    //$("#dialog-alert").dialog('open');
                }

                // initiate layout and plugins
                App.setMainPage(true);
                App.init();

            });
        </script>


    </section>

</body>

</html>
