@model ShakelliReportsUI.DataLayer.Models.AppNotification

@{
    ViewBag.Title = "پیامها و اعلانات";
    Session[ShakelliReportsUI.CommonUnits.GeneralModule.m_ActiveMenu_Administration] = "active";
    ViewBag.activemenu_prime_appnotifications = "active";

}

@section pagetitle
{
    <h3 class="page-title">
        راهبری
        <small>پیامها و اعلانات</small>
    </h3>
}

@section breadcrumb
{
    <ul class="breadcrumb">
        <li>
            <a href="#"><i class="icon-home"></i></a><span class="divider">&nbsp;</span>
        </li>
        <li>
            <a href="#">راهبری </a> <span class="divider">&nbsp;</span>
        </li>
        <li><a href="#">پیامها و اعلانات</a><span class="divider-last">&nbsp;</span></li>

    </ul>
}

<div class="widget-body">
    <div class="alert alert-block alert-warning fade in">
        <button type="button" class="close" data-dismiss="alert">×</button>
        <h4 class="alert-heading">هشدار!</h4>
        <p>
            اطلاعات فعلی حذف می شود!
            آیا ادامه می دهید؟
        </p>

        <div>
            <br />
            <div class="control-group">
                <label class="control-label">شناسه </label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.NotificationId)
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">متن</label>
                <div class="controls">
                    @Html.TextBoxFor(model => model.Body, htmlAttributes: new { @class = "span6  tooltips", @id = "txtObjectDs", data_trigger = "hover", data_original_title = "نام شیئ" })
                </div>
            </div>

            <button type="button" class="btn" onclick="location.href='@Url.Action("AppNotification_delete_confirm", "Administration", new { notificationid = Model.NotificationId })'">خب</button>
            <button type="button" class="btn" onclick="location.href='@Url.Action("AppNotification_edit", "Administration", new { notificationid = Model.NotificationId })'">لغو</button>

        </div>

    </div>
</div>

<script>
    jQuery(document).ready(function () {
        // initiate layout and plugins
        App.init();
    });
</script>


