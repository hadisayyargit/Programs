<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewBag.Title</title>

    <!-- vendor css -->
    <link href="~/lib/Ionicons/css/ionicons.css" rel="stylesheet">
    <link href="~/lib/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet">

    <!-- Amanda CSS -->
    <link rel="stylesheet" href="~/Content/Cms/amanda.min.css">

    <script src="~/lib/jquery/jquery.js"></script>

</head>
<body>
    <div class="am-header">
        <div class="am-header-left">
            <a id="naviconLeft" href="" class="am-navicon d-none d-lg-flex"><i class="icon ion-navicon-round"></i></a>
            <a id="naviconLeftMobile" href="" class="am-navicon d-lg-none"><i class="icon ion-navicon-round"></i></a>
            <a href="~/" target="_blank" class="am-logo">Vistaenergie</a>
        </div><!-- am-header-left -->
    </div><!-- am-header -->

    <div class="am-sideleft">
        <ul class="nav am-sideleft-tab" style="background-color:#2D3A50">
            <li class="nav-item">
                <a href="#mainMenu" class="nav-link active"><i class="icon ion-ios-home-outline tx-24"></i></a>
            </li>
        </ul>

        <div class="tab-content">
            <div id="mainMenu" class="tab-pane active">
                <ul class="nav am-sideleft-menu">

                    <li class="nav-item">
                        <a id="dashboardID" href="/Cms/index" class="nav-link active">
                            <i class="icon ion-ios-home-outline"></i>
                            <span>Dashboard</span>
                        </a>
                    </li><!-- nav-item -->

                    <li class="nav-item">
                        <a id="sliderID" href="/Cms/UploadSliderImage" class="nav-link">
                            <i class="icon ion-ios-filing-outline"></i>
                            <span>Slider</span>
                        </a>
                    </li><!-- nav-item -->

                    <li class="nav-item">
                        <a id="pageID" href="" class="nav-link with-sub">
                            <i class="icon ion-ios-filing-outline"></i>
                            <span>Pages</span>
                        </a>
                        <ul class="nav-sub">
                            <li class="nav-item"><a id="pageNID" href="NewPage" class="nav-link">Add Page</a></li>
                            <li class="nav-item"><a id="pageEID" href="EditPage" class="nav-link">Edit Page</a></li>
                            <li class="nav-item"><a id="pageDID" href="DeletePage" class="nav-link">Delete Page</a></li>
                            <li class="nav-item"><a id="pageUploadID" href="UploadFile" class="nav-link">Upload PDF</a></li>
                            <li class="nav-item"><a id="UserProfile" href="UserProfile" class="nav-link">User Profile</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a id="newsID" href="" class="nav-link with-sub">
                            <i class="icon ion-ios-filing-outline"></i>
                            <span>News</span>
                        </a>
                        <ul class="nav-sub">
                            <li class="nav-item"><a id="newsNID" href="NewNews" class="nav-link">Add News</a></li>
                            <li class="nav-item"><a id="newsEID" href="EditNews" class="nav-link">Edit News</a></li>
                            <li class="nav-item"><a id="newsDID" href="DeleteNews" class="nav-link">Delete News</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a href="" class="nav-link with-sub" id="userID">
                            <i class="icon ion-ios-filing-outline"></i>
                            <span>Users</span>
                        </a>
                        <ul class="nav-sub">
                            <li class="nav-item"><a id="userAID" href="Useraccess" class="nav-link">User access</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a href="/Account/Logout" class="nav-link">
                            <i class="icon ion-ios-filing-outline"></i>
                            <span>Logout</span>
                        </a>
                    </li>

                </ul>
            </div><!-- #mainMenu -->
        </div><!-- tab-content -->
    </div><!-- am-sideleft -->

    <div class="am-pagetitle">
        <h5 class="am-title">@ViewBag.Title</h5>
    </div><!-- am-pagetitle -->

    <div class="am-mainpanel">

        @RenderBody()

        <div class="am-footer">
            <span>Copyright &copy;. All Rights Reserved.</span>
            <span><a href="http:\\www.configcode.com">Created by: ConfigCode.com</a></span>
        </div><!-- am-footer -->
    </div><!-- am-mainpanel -->

    <script src="~/lib/popper.js/popper.js"></script>
    <script src="~/lib/bootstrap/bootstrap.js"></script>
    <script src="~/lib/perfect-scrollbar/js/perfect-scrollbar.jquery.js"></script>

    @*hadi*@
    @*<script src="http://maps.google.com/maps/api/js?key=AIzaSyAEt_DBLTknLexNbTVwbXyq2HSf2UbRBU8"></script>*@

    <script src="~/Scripts/Cms/amanda.js"></script>


</body>
</html>
