    <footer id="footer" class="midnight-blue">
        <div class="container">
            <div class="row">
                <div class="col-sm-6">
                    <span style="color:black">Created by:<a target="_blank" style="color:cornflowerblue" href="http:\\www.configcode.com">ConfigCode.com</a></span>
                </div>
                <div class="col-sm-6">
                    <ul class="pull-right">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Home/Contact">Contact</a></li>
