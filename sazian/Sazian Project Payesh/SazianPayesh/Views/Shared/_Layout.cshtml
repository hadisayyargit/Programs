
<!DOCTYPE html>
<html>
<head>

    <title>سازیان پایش</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="~/Content/bootstrap-rtl/bootstrap-rtl.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-rtl/bootstrap-responsive-rtl.min.css" rel="stylesheet" />

    @*<link rel="stylesheet" href="~/Content/bootstrap.min.css" />*@
    <link rel="stylesheet" href="~/Content/bootstrap-glyphicons.css" />
    <link rel="stylesheet" href="~/Content/fullcalendar.css" />
    <link rel="stylesheet" href="~/Content/unicorn.main.css" class="" />
    <link rel="stylesheet" href="~/Content/unicorn.grey.css" class="skin-color" />
    

</head>


@{ 
//ViewBag.MenuHomeActive = "";
//ViewBag.MenuPrimeActive = "";
//ViewBag.MenuPrimeOpen = "";
//ViewBag.SubMenuRole = "";
//ViewBag.SubMenuDepartment = "";

//ViewBag.MenuProjectActive = "";
//ViewBag.MenuProjectOpen = "";
//ViewBag.SubMenuProject = "";
}



    
<body class="k-rtl">
    <header>

        <div id="header">
            <h1><a href="~/">کنترل پروژه سازیان </a></h1>
            <a id="menu-trigger" href="#"><i class="glyphicon glyphicon-align-justify"></i></a>
        </div>

        <div id="search">
            <input type="text" id="txtSearch" placeholder="جست‌و‌جو..." />
            <button type="button" class="tip-right" title="جست‌و‌جو" accept="accept"  onclick="searchpage()"  ><i class="glyphicon glyphicon-search"></i></button>                           
        </div>

        <div id="user-nav">
            <ul class="btn-group">
                <li class=""><a title="" href="#"><i class="glyphicon glyphicon-user"></i> <span class="text">پروفایل</span></a></li>
                <li class="dropdown" id="menu-messages">
                    <a href="#" data-toggle="dropdown" data-target="#menu-messages" class="dropdown-toggle"><i class="glyphicon glyphicon-envelope"></i> <span class="text">پیامها</span> <span class="label label-danger">۵</span> <b class="caret"></b></a>
                    <ul class="dropdown-menu">
                        <li><a class="sAdd" title="" href="#">پیام جدید</a></li>
                        <li><a class="sInbox" title="" href="#">صندوق دریافت</a></li>
                        <li><a class="sOutbox" title="" href="#">صندوق ارسال</a></li>
                    </ul>
                </li>
                <li class=""><a title="" href="#"><i class="glyphicon glyphicon-cog"></i> <span class="text">Settings</span></a></li>
                <li class=""><a title="" href="#"><i class="glyphicon glyphicon-share-alt"></i> <span class="text">خروج</span></a></li>
            </ul>
        </div>

        <div id="sidebar">
            <!--<a href="#" class="hide"><i class="glyphicon glyphicon-home"></i> Dashboard</a>-->
            <ul>
                <li class="@ViewBag.MenuHomeActive"><a href="~/Home/index"><i class="glyphicon glyphicon-home"></i> <span>خانه</span></a></li>

                @*<li class="submenu active open">*@
                <li class="submenu @ViewBag.MenuPrimeActive @ViewBag.MenuPrimeOpen">
                    <a href="#"><i class="glyphicon glyphicon-th-list"></i> <span>اطلاعات پایه</span></a>
                    <ul>
                        <li class="@ViewBag.SubMenuDepartmentActive"><a href="~/Home/Department">واحدهای سازمان</a></li>
                        <li class="@ViewBag.SubMenuRoleActive"><a href="~/Home/Role">نقشها</a></li>

                    </ul>
                </li>

                <li class="submenu @ViewBag.MenuProjectActive @ViewBag.MenuProjectOpen">
                    <a href="#"><i class="glyphicon glyphicon-file"></i> <span>پروژه</span> </a>
                    <ul>
                        <li class="@ViewBag.SubMenuProjectActive"><a href="~/project/project">پروژه</a></li>
                        <li><a href="#">عملیات</a></li>
                        <li class="@ViewBag.SubMenuActivityActive"><a href="~/project/activity">فعالیتها</a></li>

                        <li><a href="#">افراد پروژه</a></li>
                        <li><a href="#">اسناد پروژه</a></li>
                        <li><a href="#">حسابرسی/ارزیابی</a></li>
                    </ul>
                </li>
                <li class="submenu">
                    <a href="#"><i class="glyphicon glyphicon-file"></i> <span>پرسنل</span> </a>
                    <ul>

                        <li><a href="#"><i class="glyphicon glyphicon-tint"></i> <span>افراد</span></a></li>
                        <li><a href="#"><i class="glyphicon glyphicon-pencil"></i> <span>ورود و خروج</span></a></li>
                        <li><a href="#"><i class="glyphicon glyphicon-th"></i> <span>عملکرد هفتگی</span></a></li>
                    </ul>
                </li>
                <li class="submenu">
                    <a href="#"><i class="glyphicon glyphicon-file"></i> <span>گزارشات</span> </a>
                    <ul class="submenu">
                        <li>
                            <a href="#">پروژه</a>
                            <ul>
                                <li><a href="#">وضعیت پروژه</a></li>
                                <li><a href="#">عملکرد اشخاص</a></li>
                                <li><a href="#">عملکرد بخشها</a></li>

                            </ul>

                        </li>

                    </ul>
                </li>

                <li class="submenu">
                    <a href="#"><i class="glyphicon glyphicon-file"></i> <span>راهبری</span></a>
                    <ul>
                        <li><a href="#"><i class="glyphicon glyphicon-th-list"></i> <span>کاربران</span></a></li>
                        <li><a href="#">پیامها</a></li>
                    </ul>
                </li>

                <li>
                    <a href="#"><i class="glyphicon glyphicon-signal"></i> <span>راهنما</span></a>
                </li>
                <li>
                    <a href="~/"><i class="glyphicon glyphicon-inbox"></i> <span>خروج</span></a>
                </li>
            </ul>

        </div>

        <div id="style-switcher">
            <i class="glyphicon glyphicon-arrow-right"></i>
            <span>Style:</span>
            <a href="#grey" style="background-color: #555555;border-color: #aaaaaa;"></a>
            <a href="#light-blue" style="background-color: #8399b0;"></a>
            <a href="#blue" style="background-color: #2D2F57;"></a>
            <a href="#red" style="background-color: #673232;"></a>
            <a href="#red-green" style="background-image: url('assets/img/demo/red-green.png');background-repeat: no-repeat;"></a>
        </div>


    </header>

    <div id="content">

        <div id="content-header">
            <h1>Dashboard</h1>
            <div class="btn-group">
                <a class="btn"><i class="glyphicon glyphicon-file"></i></a>
                <a class="btn" title="Manage Users"><i class="glyphicon glyphicon-user"></i></a>
                <a class="btn" title="تالار گفتگو"><i class="glyphicon glyphicon-comment"></i><span class="label label-danger">۶</span></a>
                <a class="btn"><i class="glyphicon glyphicon-shopping-cart"></i></a>
            </div>
        </div>


        @RenderSection("breadcrumb", required: false)
        @RenderBody()


    </div>

    <footer>
            <div id="footer" class="col-12">
                2016 &copy; مهندسین مشاور سازیان 
                <br />
                <a href="http://www.khordadnet.ir" target="_blank">پیاده‌سازی: <img src="~/assets/Img/icons/khordadlogoTransparent.png" width="5%" height="5%" /></a>
                
            </div>
    </footer>


    <script src="~/Scripts/jquery-1.10.2.js"></script>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/scripts/bootstrap.min.js"></script>

    <script src='~/Scripts/jquery-migrate.min.js' type='text/javascript'></script>
    <script src='~/Scripts/jquery-ui.min.js' type='text/javascript'></script>
    <script src="~/scripts/jquery.jpanelmenu.min.js"></script>
    <script src="~/scripts/unicorn.js"></script>
    @*<script src="~/scripts/unicorn.dashboard.js"></script>*@

<script>
    alert("master page");
</script>
        

    <script>
        function searchpage() {

            var url = "/home/goPage?searchcode=" + $("#txtSearch").val(); 
        window.location.replace(url);
    }
    </script>

</body>

</html>
