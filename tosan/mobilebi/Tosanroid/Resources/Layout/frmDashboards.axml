<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="fill_parent"
    android:background="@drawable/bg2">
    <RelativeLayout
        android:id="@+id/RelativeLayout1"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:gravity="fill_vertical">
      <Button
          android:layout_height="wrap_content"
          android:id="@+id/btnKoli"
          android:background="@drawable/buttonface"
          android:layout_width="200dp"
          android:layout_below="@+id/btnHome"
          android:layout_alignLeft="@+id/btnHome"
          android:layout_marginLeft="31dp"
          android:layout_marginTop="17dp"
          android:clickable="true"
          android:text="@string/overall_condition" />
      <Button
        android:layout_height="wrap_content"
        android:id="@+id/btnNaghdinegi"
        android:background="@drawable/buttonface"
        android:layout_below="@+id/btnKoli"
        android:layout_alignLeft="@+id/btnKoli"
        android:layout_marginTop="19dp"
        android:layout_width="200dp"
        android:text="@string/cash_position" />
     
        <Button
            android:layout_height="wrap_content"
            android:id="@+id/btnMasaref"
            android:background="@drawable/buttonface"
            android:layout_below="@+id/btnNaghdinegi"
            android:layout_alignLeft="@+id/btnNaghdinegi"
            android:layout_marginTop="15dp"
            android:layout_width="200dp"
            android:text="@string/uses_condition"
            android:clickable="false" />
      <Button
           android:layout_height="wrap_content"
           android:id="@+id/btnManabe"
           android:layout_below="@+id/btnMasaref"
           android:layout_alignLeft="@+id/btnMasaref"
           android:layout_marginTop="14dp"
           android:background="@drawable/buttonface"
           android:layout_width="200dp"
           android:text="@string/resources_condition" />

        <Button
            android:layout_height="wrap_content"
            android:id="@+id/btnDemo"
            android:background="@drawable/buttonface"
            android:layout_below="@+id/btnManabe"
            android:layout_alignLeft="@+id/btnKoli"
            android:layout_marginTop="19dp"
            android:layout_width="200dp"
            android:text="Demo"
             />
    </RelativeLayout>
</ScrollView>