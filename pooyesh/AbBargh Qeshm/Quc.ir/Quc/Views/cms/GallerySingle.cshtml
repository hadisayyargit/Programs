

@{
    ViewBag.Menu = "";
    ViewBag.SubMenu = "";
    string imagename = ViewBag.ImageName;
}

@section featured {


    <section class="featured">
        <div id="content">
            <div class="page-title clearfix">
                نگاره
                <div class="date left">@ViewBag.JalaliDate</div>
            </div>
            <div class="skin_width">
                <div class="blog_page">
                    <div class="skin_main ">
                        <div class="pe-spacer size20"></div>
                        <div class="row-fluid">

                            <!-- start post -->
                            <div class="standard_title">

                                <span>نگاره برگزیده</span>
                            </div>

                            <img id="img1" src="~/images/gallery/@imagename" />
                            <div class="pe-spacer size20"></div>
                            @using (Html.BeginForm("UpdateGallery", "cms", FormMethod.Post, new
                            { enctype = "multipart/form-data" }))
                            {

                                <form action="#" class="form-horizontal" method="post">
                                    @if (((quc.Models.AppUser)Session[GeneralModule.m_CurrentUser]).AllowWriteImage)
                                    {
                                        <div class="form-group">

                                            <input type="file" name="UserImageUrlUpload" onchange="readURL(this);" style="color:blue;background-color:red" />
                                        </div>
                                    }

                                    <div class="pe-spacer size20"></div>

                                    <div class="span3 button7_style">
                                        @if (((quc.Models.AppUser)Session[GeneralModule.m_CurrentUser]).AllowWriteImage)
                                        {
                                            <input type="submit" class="btn btn-danger" value="بارگذاری" />
                                            <input type="button" class="btn btn-danger" value="حذف" onclick="location.href='/cms/deletegallery?imagename=@imagename'" />
                                        }
                                        <input type="button" class="btn btn-danger" value="بازگشت" onclick="location.href = '/cms/gallerylist'" />
                                        @*<span><a href="#">بروزرسانی</a></span>
                                            <div class="buttons7_left_bg"></div>*@
                                    </div>

                                </form>
                            }




                            <!-- end post -->
                        </div>


                    </div>
                </div>

            </div>

        </div>

    </section>
}

<script src="~/Scripts/jquery-1.10.2.min.js"></script>

<script>
    //$("#UserImageUrlUpload").change(function () {
    //    alert("1");
    //});

    function readURL(input) {

        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#img1').attr('src', e.target.result);
                $('#txtId').attr('value', input.files[0]);

            };
            reader.readAsDataURL(input.files[0]);
        }
        else {
        }
    }
</script>

