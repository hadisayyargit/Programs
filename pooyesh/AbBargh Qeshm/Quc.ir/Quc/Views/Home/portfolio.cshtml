@{
    ViewBag.Menu = "معرفی";
    ViewBag.SubMenu = "خط مشی";
    ViewBag.JalaliDate = Session[quc.GeneralModule.m_JalaliTodayName];
}
@section featured {
<section class="featured">
        <div id="content">
            <div class="page-title clearfix">
                فعالیتهای شرکت آب و برق و تأسیسات قشم در یک نگاه
                <div class="date left">@ViewBag.JalaliDate</div>
            </div>

            <div class="" style="font-family:'B Nazanin';direction:rtl">
                &nbsp;
                <div class="service left" style="width:30%">
                    @*<img src="~/images/projects/13.jpg" alt="" width=100 height=100" />*@
                    <img src="~/images/projects/13.jpg" alt="--" />&nbsp;
                    <img src="~/images/projects/6c.jpg" alt="--" />&nbsp;
                    <img src="~/images/projects/12.jpg" alt="--" />&nbsp;
                    <img src="~/images/projects/15.jpg" alt="--" />&nbsp;
                    <img src="~/images/projects/16.jpg" alt="--" />&nbsp;
                    
                </div>

                <div class="bp-title" style="font-family:'B Nazanin';direction:rtl">خلاصه مهمترین پروژه های انجام شده توسط شرکت از سال 1373 تاکنون</div>

                <div style="font-weight:bold; font-size:14px">
                    •	تعمیرات، نگهداری و بهره برداری از واحدهای آب‌شیرین‌کن مستقر در سایت قشم، کاوه، سلخ و باسعیدو
                    ( همچنین  اورهال و تعمیرات اساسی واحدهای آب‌شیرین‌کن تحت پوشش)
                </div>

                @*<div style="width:50%">
                    <img src="~/images/projects/12.jpg" alt="---" />
                    </div>*@

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث و راه اندازی آبگیر جهت بهبود وضعیت تامین آب مورد نیاز واحدهای تولیدی آب‌شیرین‌کن( سال 1375)

                </div>

                <div style="font-weight:bold; font-size:14px">
                    •	 طراحی و ساخت مخازن ذخیره آب شیرین شهر قشم به ظرفیت 5000×2 مترمکعب
                </div>
                ساخت دو دستگاه مخزن بتنی نیمه دفنی به ظرفیت کلی هریک 5000 مترمکعب جهت ذخیره آب شیرین تولیدی دستگاههای آب‌شیرین‌کن و افزایش میزان تامین آب مورد نیاز شهر قشم . با احداث این دو مخزن امکان ذخیره آب شیرین شهر قشم به 20000 مترمکعب افزایش یافت. (سال 1376)

                <div style="font-weight:bold; font-size:14px">
                    •	دمونتاژ و انتقال یک دستگاه از آب‌شیرین‌کنهای کروپ سایت قشم به سایت صنعتی فراچین (سال 1376)
                </div>

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث جایگاه فروش و توزیع آب به تانکرها در شهرک سام و زال (سال 1376)
                </div>

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث خط لوله آبرسانی قشم – تولا به طول حدود 10 کیلومتر
                </div>
                به منظور انتقال آب شیرین از مخازن ذخیره آب شهر قشم به مخزن ذخیره آب شهرک صنعتی تولا یک خط لوله به طول 9200 متر از جنس چدن داکتیل به قطر 350 میلیمتر از مخازن شهر به مخزن ذخیره تولا اجرا گردید. (سال 1377)


                <div style="font-weight:bold; font-size:14px">
                    •	 اجرای خط لوله شبکه توزیع آب در مسیر بلوار آزادگان
                </div>
                طراحی و اجرای خط لوله شبکه توزیع آب از مخازن شهر قشم به قسمتهای غربی شهر شامل شهرکهای مسکونی سام و زال، فرودگاه قدیم، شیلات، میدانهای حافظ، سعدی و شهرک گلستان بطول حدود 4000 متر لوله آزبست کلاس D به قطر 300 میلیمتر شامل نقشه برداری، حفاری، لوله گذاری و پر کردن مسیر لوله و احداث منهولهای مورد نیاز (سال1379)

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث مخزن ذخیره آب شیرین 2000 مترمکعبی شهرک صنعتی تولا
                </div>
                به منظور تامین آب شیرین مورد نیاز صنایع و کارخانه های مستقر در شهرک صنعتی تولا ، یک دستگاه مخزن بتنی 2000 مترمکعبی در این شهرک احداث گردید. (سال 1379)


                <div style="font-weight:bold; font-size:14px">
                    •	 احداث آب‌شیرین‌کن اسکله سلخ به ظرفیت 200×2 مترمکعب در روز
                </div>
                طراحی، تهیه، اجرا و نصب دو دستگاه آب‌شیرین‌کن به ظرفیت تولید هریک 200 مترمکعب آب شیرین در روز همراه با احداث کلیه تاسیسات جنبی شامل اتاق کنترل، مخازن سوخت، منبع ذخیره آب تولیدی، ایستگاه پمپاژ و خط انتقال آب دریا به ورودی دستگاه و ایستگاه پمپاژ  آب شیرین تولیدی جهت تامین آب شرب مورد نیاز مناطق جنوب و جنوب غرب جزیره بویژه تامین آب شیرین مورد نیاز شناورهای صیادی بندر مهم سلخ (سال 1379)

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث تصفیه خانه فاضلاب شهرک سام و زال
                </div>
                طراحی و اجرای تصفیه خانه فاضلاب شهرک سام و زال با ظرفیت 230 مترمکعب در روز جهت تصفیه فاضلاب خانگی شهرکهای سام و زال قشم (سال 1380)

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث آب‌شیرین‌کن اسکله کاوه به ظرفیت 500×2 مترمکعب در روز
                </div>
                طراحی، تهیه، اجرا و نصب دو دستگاه آب‌شیرین‌کن به ظرفیت تولید هریک 500 متر مکعب آب شیرین در روز همراه با احداث کلیه تاسیسات جنبی شامل اتاق کنترل، مخازن سوخت، ایستگاه پمپاژ و خط انتقال آب دریا به ورودی دستگاه و خط انتقال و ایستگاه پمپاژ آب شیرین تولیدی جهت تامین آب شرب مورد نیاز سایتهای صنعتی منطقه کاوه، شناورهای اسکله کاوه و مناطق شمال غرب جزیره قشم (سال 1381)

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث آب‌شیرین‌کن اسکله باسعیدو به ظرفیت 500×1 مترمکعب در روز
                </div>
                طراحی، تهیه، اجرا و نصب یکدستگاه آب‌شیرین‌کن به ظرفیت تولید 500 مترمکعب در شبانه روز همراه با احداث کلیه تاسیسات جانبی شامل اتاق کنترل، مخازن سوخت، ایستگاه پمپاژ و خط انتقال آب دریا به ورودی دستگاه و خط انتقال و ایستگاه پمپاژ آب شیرین تولیدی جهت تامین بخشی از آب شرب مورد نیاز اهالی مناطق غرب جزیره (سال 1381)

                <div style="font-weight:bold; font-size:14px">
                    •	 احداث کارخانه بسته بندی آب آشامیدنی
                </div>
                به منظور تامین آب شرب بهداشتی و بسته بندی شده در شهر قشم ، کارخانه بسته بندی آب شیرین در بطریهای PET به ظرفیت 96000 بطری 1.5 لیتری در روز شامل سالن تولید و کنترل کیفیت محصول، انبارهای مواد اولیه و محصول تولیدی و تاسیسات جنبی مورد نیاز نظیر مخازن آب و مراکز اداری و خدماتی مجموعه در زمینی به مساحت 1000 متر مربع احداث گردید. (سال 1381)

                <div style="font-weight:bold; font-size:14px">
                    •	اجرای شبکه داخلی توزیع آب شهرک ساحلی قشم
                </div>
                طراحی و اجرای شبکه داخلی توزیع آب شهرک ساحلی قشم شامل حفاری مسیر و لوله گذاری در اقطار مختلف از 110 تا 63 میلیمتر همراه با نصب انشعابات خانگی و وصل کردن کنتورها به تعداد 93 انشعاب
                (سال 1381)


                <div style="font-weight:bold; font-size:14px">
                    •	 احداث تصفیه خانه فاضلاب شهرک ساحلی و شبکه جمع آوری و انتقال فاضلاب به تصفیه خانه شهرک ساحلی
                </div>
                طراحی و اجرای تصفیه خانه فاضلاب شهرک ساحلی قشم با ظرفیت 250 متر مکعب در روز به همراه اجرای شبکه جمع آوری و انتقال فاضلاب محدوده های شهرک ساحلی، بندر بهمن و هتل بین المللی قشم بطول 2000 متر به تصفیه خانه مذکور (سال 1382)




                <div style="font-weight:bold; font-size:14px">
                    •	 طراحی و اتصال خط انتقال آب از مخازن شهر قشم به مخزن ذخیره شهرک صنعتی تولا
                </div>
                با توجه به اتمام عملیات ساختمانی مخزن بتنی 2000 مترمکعبی شهرک صنعتی تولا و نیاز به تست آن و در مدار قرار دادن مخزن مذکور، مقرر شد که آبگیری آن از طریق خط انتقال آب از شهر قشم به تولا انجام گیرد. بدین منظور نحوه اتصال و انجام کار آن در دستور کار شرکت قرار گرفت و پس از بررسیهای لازم عملیات اجرائی صورت گرفت. (سال 1382)



                <div style="font-weight:bold; font-size:14px">
                    •	 طراحی و اجرای ایستگاه پمپاژ آب دریا به خور پلاژ سیمین
                </div>
                به منظور بهره برداری از خور و تامین محل تفریح مناسب در پلاژ سیمین به درخواست شرکت توسعه سیاحتی قشم مبنی بر آبگیری خور درون محوطه پلاژ، انجام کار به شرکت واگذار شد این ایستگاه شامل یک دستگاه الکتروپمپ مخصوص آب دریا و لوله های ورودی آب دریا به داخل پمپ و لوله خروجی و انتقال آب به خور بطول 330 متر میباشد. (سال 1382)



                <div style="font-weight:bold; font-size:14px">
                    •	 طراحی و اجرای سیستم تحت فشار شبکه آب مرکز تحقیقات بیوتکنولوژی
                </div>
                هدف از اجرای این پروژه تامین آب در شبکه داخلی مرکز تحقیقات بیوتکنولوژی است.با دستور قائم مقام محترم وقت سازمان ، موضوع اصلاح نحوه تامین فشار آب شبکه داخلی در دستور کار شرکت قرار گرفت. این مشکل توسط طراحی، تهیه، ساخت و نصب و بهره برداری از ایستگاه پمپاژ تمام اتوماتیک تحت فشار مرتفع گردید. این ایستگاه شامل دو دستگاه الکتروپمپ تمام استیل مارک لووارای ایتالیا، یک مخزن تحت فشار فایبرگلاس 320 لیتری امریکائی و یکدستگاه تابلو برق هوشمند و تمام اتوماتیک است . (سال 1382)


                <div style="font-weight:bold; font-size:14px">
                    •	 طراحی و اجرای سیستم آبیاری قطره ای فضای سبز مجتمع مسکونی 22 بهمن

                </div>این پروژه با نصب یکدستگاه الکتروپمپ و مخزن ذخیره آب مناسب جهت تامین آب کشاورزی تحت فشار شبکه و انجام لوله کشی فضای سبز بطول 6000 متر به همراه کلیه متعلقات شامل شیرها، قطره چکانها، و سایر اتصالات مورد نیاز انجام گرفت. آب مورد نیاز فضای سبز از آب تصفیه شده تصفیه خانه فاضلاب شهرک سام و زال تامین میگردد. (سال 1382)



                <div style="font-weight:bold; font-size:14px">
                    •	سندبلاست ، زنگ زدائی و رنگ آمیزی مخزن آتش نشانی پالایشگاه گورزین
                </div>
                (سال 1382)

                <div style="font-weight:bold; font-size:14px">
                    •	تعمیرات اساسی یک دستگاه آب‌شیرین‌کن 2000 مترمکعبی در بندر عسلویه
                </div> (سال 1382)


                <div style="font-weight:bold; font-size:14px">
                    •	بازسازی یک دستگاه بویلر 8 تنی متعلق به شرکت کنسروسازی عمان
                </div>    عملیات اجرائی شامل : دمونتاژ کلیه قطعات مکانیکی الکتروپمپها و کلیه شیرآلات ، تعویض ورقهای فرسوده و رفع نشتی بویلر، سندبلاست و رنگ آمیزی کلیه قطعات،  اصلاح مسیر آب تغذیه بویلر و مسیر بخار خروجی، و همچنین سندبلاست و رنگ آمیزی کلیه واگنهای حمل ماهی (سال 1382)


                <div style="font-weight:bold; font-size:14px">
                    •	تعمیرات اساسی و اورهال دستگاهها و تجهیزات تأسیساتی موجود در هتل بین المللی قشم (سال 1382)
                </div>       عملیات اجرائی شامل تعمیرات اساسی و راه اندازی 16 دستگاه کمپرسور و 16 دستگاه کندانسور و الکتروپمپ مسیر سیرکوله آب چیلرها ، تابلوهای برق 20 کیلوولت ، طراحی و نصب و راه اندازی تابلوی اختصاصی 5 سلولی 1600 آمپر، محوطه سازی، ساخت انبار تأسیسات ، اتاق اپراتور و ....



                <div style="font-weight:bold; font-size:14px">
                    •	طراحی و اجرای سیستم آبیاری قطره ای محوطه اداره صنایع در سایت تولا
                    (سال 1382)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	 طراحی و اجرای ایستگاه پمپاژ فاضلاب خام شهرک زال به سام (سال 1383)
                </div>

                <div style="font-weight:bold; font-size:14px">
                    •	 تهیه طرح آبرسانی و شبکه فاضلاب نقاط مهم شهر قشم (سال 1383)
                </div>


                <div style="font-weight:bold; font-size:14px">
                    •	 اجرای شبکه انتقال پساب تصفیه شده از تصفیه خانه فاضلاب شهرک ساحلی به فضای سبز (سال 1383)
                </div>








                <div style="font-weight:bold; font-size:14px">
                    •	 اجرای ایستگاه پمپاژ پساب تولیدی تصفیه خانه شهرک ساحلی به داخل شبکه آبیاری فضای سبز شرکت (سال 1383)
                </div>

                <div style="font-weight:bold; font-size:14px">
                    •	سندبلاست و رنگ آمیزی بارج 500 تنی شرکت خدمات سازه واقع در اسکله هامون
                    (سال 1384)
                </div>



                <div style="font-weight:bold; font-size:14px">
                    •	آبرسانی به شهرک گلستان (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	تعویض 1800 متر از خط لوله انتقال آب قشم به تولا (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	احداث خط لوله دوم آبگیر آب‌شیرین‌کن سایت اسکله کاوه (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	اورهال 5 دستگاه بویلر واحدهای آب‌شیرین‌کن کروپ  سایت قشم (1385)

                </div>

                <div style="font-weight:bold; font-size:14px">
                    •	اورهال واحد 2 آب‌شیرین‌کن سایت اسکله کاوه (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	احداث علمک توزیع آب در جاده اصلی اسکله کاوه (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	تعویض کندانسورهای استیج شماره 2 آب‌شیرین‌کن سایت باسعیدو (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	تهیه و نصب فیلتر کربن اکتیو جهت آب‌شیرین‌کن سایت باسعیدو (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	تغییر لوله فلزی فرسوده ساکشن پمپ شماره 3 آبگیر آب‌شیرین‌کن سایت قشم به لوله پلی اتیلن 400 میلیمتر جهت بهینه سازی و افزایش طول عمر خط لوله (1385)
                </div>
                <div style="font-weight:bold; font-size:14px">
                    •	تکمیل و راه اندازی نرم افزار تعمیرات و نگهداری پیشگیرانه  PM  (1385)
                </div>


                <div style="font-weight:bold; font-size:14px">
                    •	احداث فاز یک شبکه آبرسانی به شهرک بوستان
                </div>
                هدف پروژه: توسعه شبکه و تأمین آب شرب موردنیاز اهالی شهرک بوستان
                <br />
                شرح پروژه: در راستای طرح آبرسانی به شهرکهای شهر قشم و با توجه به نیاز مردم به آب قابل شرب، پروژه توسعه شبکه آب شهرک بوستان بطول 8000 متر تعریف و تأمین اعتبار و توسط شرکت آب و برق و تأسیسات قشم پس از تهیه و حمل لوله و اتصالات مربوطه اجرا گردید. در این پروژه حدود 800 خانوار از نعمت آب شرب بهره مند گردید. (1386)






                <br />
                <br />
                <div style="font-weight:bold; font-size:16px">
                    پروژه: اجرای خط انتقال فاضلاب مجتمع نخل زرین به تصفیه خانه شهرک ساحلی
                </div>
                هدف پروژه: جمع آوری فاضلاب مجتمع نخل زرین و انتقال آن به تصفیه خانه فاضلاب شهرک ساحلی
                <br />
                شرح پروژه: با توجه به معضل سرریز فاضلاب سایت نخل زرین در خیابانهای اطراف، پروژه جمع آوری فاضلاب مجتمع یاد شده به طول 718 متر توسط معاونت محترم عمرانی تعریف و پس از تأمین اعتبار و ابلاغ پروژه، عملیات اجرائی آن توسط شرکت آب و برق و تأسیسات قشم آغاز گردید. (1386)




                <br />

                خلاصه مهمترین پروژه های انجام شده توسط امور برق بشرح زیر است:

                <div style="font-weight:bold; font-size:14px;direction:rtl">
