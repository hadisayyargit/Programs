                    <a href="#" class="clearfix">
                        <div class="lblog-gallery-icon right"></div>
                        <div class="lblog-title right">&nbsp آخرین اخبار جزیره </div>
                    </a>
                    <div class="clearfix">
                        @foreach (quc.Models.Blog item in qeshmBlogList)
                        {

                            <div class="lblog-date right">@item.PublishDate&nbsp;</div>
                            <div class="lblog-content right"><a href="~/cms/BlogPost?blogid=@item.BlogId"> @item.Title  </a>  </div>
                            <div class="pe-spacer size10"></div>
                        }
                        </div>

                    
                        <div class="lmore">
