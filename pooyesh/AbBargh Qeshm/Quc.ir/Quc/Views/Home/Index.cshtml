    List<quc.Models.Blog> qeshmBlogList = ViewBag.qeshmBlogList;
    quc.Models.Blog hotnews = ViewBag.HotNews;
    string galleryPath = Server.MapPath("~/images/gallery/");
    string filename = "";
}
}

