                        <div class="lblog-title right">&nbsp; آخرین اخبار شرکت</div>
                    </a>
                    <div class="clearfix">
                        @foreach (quc.Models.Blog item in qucBlogList)
                        {
                            <div class="lblog-date right">@item.PublishDate &nbsp;</div>
                            <div class="lblog-content right">@item.Body</div>
                            <div class="pe-spacer size10"></div>
                        }
                    </div>

                    <div class="lmore">
                        <a href="#">همه اخبار...</a>
                    </div>
                </div>

