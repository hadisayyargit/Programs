            <div class="row-fluid">
                <div class="span12">
                    <div class="main_content_title ">
                        <h3>گالری</h3>
                    </div>
                    <!-- start lightbox & carousel -->
                    <div class="carouFredSel_style clearafter">
                        <ul id="carouFredSel">
                            @foreach (string item in myGalleryList)
                            {
                                filename = @item.Replace(galleryPath, "");

                                <li>
                                    <a href="~/images/gallery/@filename" title=@filename class="fancybox" rel="group">
                                        <img alt="" src="~/Images/gallery/@filename" />

                                    </a>
                                </li>
                            }

                        </ul>
                        <div class="carouFredSel_nav">
                            <a id="caroul_prev" class="caroul_prev" href="#"></a>
                            <a id="caroul_next" class="caroul_next" href="#"></a>
                        </div>
