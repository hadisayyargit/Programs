  <MdxScripts>
    <MdxScript dwd:design-time-name="8092a39f-6440-415d-aeec-a67791d66c15">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].CalculatedMembe1
 AS 0, 
VISIBLE = 1  ; 
CREATE DYNAMIC SET CURRENTCUBE.[NamedSet1]
 AS null ;   
CREATE MEMBER CURRENTCUBE.[Measures].MojoodiRialiKharid
 AS Sum
(
  {null:([DimDate].[Hierarchy_Jalali].CurrentMember)}
  ,
[Measures].[Last Purchase Amount]
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Inventory';      
CREATE MEMBER CURRENTCUBE.[Measures].MojoodiRialiForoosh
 AS Sum
(
  {null:([DimDate].[Hierarchy_Jalali].CurrentMember)}
  ,
[Measures].[Last Sale Amount]
), 
FORMAT_STRING = "Standard", 
BACK_COLOR = 14155762 /*R=242, G=255, B=215*/ , 
FORE_COLOR = 0 /*Black*/ , 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Inventory';            
CREATE MEMBER CURRENTCUBE.[Measures].MojoodiTedadi
 AS Sum
(
  {null:([DimDate].[Hierarchy_Jalali].CurrentMember)}
  ,
[Measures].[Product Quantity]
), 
FORMAT_STRING = "Standard", 
BACK_COLOR = 14024693 /*R=245, G=255, B=213*/ , 
FORE_COLOR = 10485760 /*R=0, G=0, B=160*/ , 
FONT_NAME = "Microsoft Sans Serif", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Inventory';               
CREATE DYNAMIC SET CURRENTCUBE.[Named Set_top10Products_Dynamic]
 AS TopCount
(
   [DimProducts].[Product Key].members,
   10,
  [Measures].[Sale Amount]
); </Text>
        </Command>
      </Commands>
      <CalculationProperties>
        <CalculationProperty dwd:design-time-name="37c68b51-1f13-4c7c-8307-72ec1dae0b32">
          <CalculationReference>Named Set_top10Products_Dynamic</CalculationReference>
          <CalculationType>Set</CalculationType>
          <Translations>
