                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT [TransactionID]
      ,[Store]
      ,[StoreID]
      ,[transactiontime]
     ,[date]
  ,Isnull(operatorid,2139) as EmployeeId
, CustomerId as CustomerKey
      ,Isnull([Operator],N'تست') As Operator
      ,[LineItem]
      ,[ItemID]
      ,iif(TransactionType='return',1,0) as TransactionType
      ,iif(TransactionType='return',[ReturnQuantity]*-1,[SaleQuantity]) as SaleQuantity
      , UnitPrice
      ,iif(TransactionType='return',[ReturnAmount]*-1,[SaleAmount]) as SaleAmount
      ,iif(TransactionType='return',[ReturnDiscount]*-1,[SaleDiscount]) as SaleDiscount
      ,iif(TransactionType='return',[ReturnTax]*-1,[SaleTax]) as SaleTax
  FROM pyd_vw_TransactionDetail_olap
  Where [date] between ? and ?
order by TransactionTime</property>
