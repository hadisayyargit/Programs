                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select c.minoocitycode,c.provincecode as minooprovincecode,c.provincename as minooprovincename,c.cityname as minoocityname , g.GeographyKey,g.CityCode,g.CityName,'ir' as CountryCode,g.StateProvinceName ,g.minoocitycode as targetminoocitycode
