      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{a04d9df0-5c42-4274-ac5d-46d5e670811e}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="recalculate startdatetime"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::v_StartDateTime] =  ( @[User::v_MaxDateTime] &gt;= @[User::v_StartDateTime]  ) ?  DATEADD( &quot;day&quot;,1, @[User::v_MaxDateTime]) : @[User::v_StartDateTime]" />
