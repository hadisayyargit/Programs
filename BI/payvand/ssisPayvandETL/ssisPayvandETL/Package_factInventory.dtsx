                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Select     
RetailStoreId,StockID,ItemID,  
DocTypeID=(Case When DocType='Return' then 'RT' Else DocTypeID End),  
DocType,DocDate,cost,      
Sum(Isnull(QTY,0)) As QTY,
LastPurchaseAmount=Sum(Isnull(QTY,0)*Isnull(PPrice,0)),
LastSaleAmount=Sum(Isnull(QTY,0)*Isnull(SPrice,0))
From stageFactInventory_Extract
left join dimProducts on stageFactInventory_Extract.ItemId=dimProducts.ProductId
Group by      
RetailStoreId,StockID,ItemID,  
(Case When DocType='Return' then 'RT' Else DocTypeID End),  
DocType,DocDate,cost</property>
