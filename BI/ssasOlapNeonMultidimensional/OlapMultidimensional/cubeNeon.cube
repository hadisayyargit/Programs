  <Source dwd:design-time-name="64cc21f5-0524-4d66-8ad8-335ac0d5b76e">
    <DataSourceViewID>dsvNeonDW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="3c38d412-78d5-4391-8ff4-db7bef3ca0fd">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>
calculate;   

  
 
CREATE MEMBER CURRENTCUBE.[Measures].TotalSale
 AS [Measures].[Line Total Price]-[Measures].[Discount], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Orders';  

CREATE MEMBER CURRENTCUBE.[Measures].SalesToday
 AS (StrToMember('[Order Date].[DateKey].&amp;[' + FORMAT (NOW() , 'yyyyMMdd') + ']'),[Measures].[Line Total Price]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Orders';   

CREATE DYNAMIC SET CURRENTCUBE.[Top10Customers_dynamic]
 AS TopCount
(
   [DimCustomers].[Customer Key].members
  , 10
,[Measures].[Line Total Price]
) ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="79ce5582-d8dd-4ca6-8a1d-9be2d09d7efa">
      <ID>KPI</ID>
      <Name>KPI_LineTotalPrice</Name>
      <Value>[Measures].[Line Total Price]</Value>
      <Goal>30000</Goal>
      <Status>Case 
	When kpiValue("KPI_LineTotalPrice")/kpiGoal("KPI_LineTotalPrice")&gt;=.90
		Then 1
	When kpiValue("KPI_LineTotalPrice")/kpiGoal("KPI_LineTotalPrice")&lt;.90 
		AND kpiValue("KPI_LineTotalPrice")/kpiGoal("KPI_LineTotalPrice")&gt;=.80
		Then 0
	Else 
		-1
End	</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
  <Actions>
    <Action xsi:type="DrillThroughAction" dwd:design-time-name="19fb9723-b00b-4dfc-a4ee-64d5c56a0a72">
      <ID>Drillthrough Action</ID>
      <Name>Drillthrough Action</Name>
      <TargetType>Cells</TargetType>
      <Target>MeasureGroupMeasures("Fact Orders")</Target>
      <Condition>[Measures].[Fact Orders Count]&gt;30</Condition>
      <Type>DrillThrough</Type>
      <Columns>
        <Column xsi:type="CubeAttributeBinding" dwd:design-time-name="8da5f9ca-715e-4c54-9abb-c828adb83e39">
          <CubeID>cubeNeon</CubeID>
          <CubeDimensionID>DimCustomers</CubeDimensionID>
          <AttributeID>Customer Key</AttributeID>
          <Type>All</Type>
        </Column>
      </Columns>
    </Action>
    <Action xsi:type="StandardAction" dwd:design-time-name="5296cf17-9c0c-4f61-8d48-99facf3a4767">
      <ID>Action</ID>
      <Name>Action</Name>
      <TargetType>AttributeMembers</TargetType>
      <Target>[DimCustomers].[Country Code]</Target>
      <Condition>[Measures].[Fact Orders Count]&gt;30</Condition>
      <Type>Url</Type>
      <Expression>"http://www.yahoo.com"</Expression>
    </Action>
  </Actions>
</Cube>