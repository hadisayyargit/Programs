                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select e.EmployeeID,e.FirstName, e.LastName, e.FirstName+' '+e.LastName as Fullname,e.BirthDate, e.HireDate ,e.MobilePhone,e.Photo
