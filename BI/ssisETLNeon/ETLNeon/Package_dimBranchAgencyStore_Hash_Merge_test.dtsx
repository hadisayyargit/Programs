      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EC83FD05-CF2A-4C09-ABDF-E9A88D809F07}"
          SQLTask:SqlStatementSource="drop table if exists stageBranchAgency&#xA;&#xA;CREATE TABLE [dbo].[stageBranchAgency](&#xA;&#x9;[StoreId] [int] NOT NULL,&#xA;&#x9;[GeographyKey] [int] NULL,&#xA;&#x9;[StoreName] [nvarchar](50) NULL,&#xA;&#x9;[StoreForeignName] [nvarchar](50) NULL,&#xA;&#x9;[RecordHash] [varbinary](200) NULL&#xA;) ON [PRIMARY]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task_merge"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DABAECBC-4742-4956-9FEB-9455DD0D2057}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task_merge"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EC83FD05-CF2A-4C09-ABDF-E9A88D809F07}"
          SQLTask:SqlStatementSource="&#xA;MERGE dimBranchAgencyStore AS TARGET_Table&#xA;USING stageBranchAgency AS SOURCE_Table &#xA;ON (SOURCE_Table.StoreId = TARGET_Table.BranchAgencyKey)&#xA;WHEN MATCHED AND SOURCE_Table.RecordHash&lt;&gt;TARGET_Table.RecordHash THEN &#xA;&#x9;UPDATE  SET BranchAgencyKey=SOURCE_Table.StoreId&#xA;&#x9;&#x9;,BranchAgencyName = SOURCE_Table.StoreName&#xA;&#x9;  ,BranchAgencyForeignName = SOURCE_Table.StoreForeignName&#xA;      ,GeographyKey = SOURCE_Table.GeographyKey      &#xA;&#x9;&#x9;,RecordHash=SOURCE_Table.RecordHash&#xA;WHEN  NOT MATCHED BY SOURCE THEN&#xA;&#x9;DELETE&#xA;WHEN  NOT MATCHED BY TARGET THEN&#xA;&#x9;INSERT (BranchAgencyKey  ,BranchAgencyName  ,BranchAgencyForeignName, GeographyKey,RecordHash)    &#xA;&#x9;&#x9; VALUES (SOURCE_Table.StoreId  ,SOURCE_Table.StoreName ,SOURCE_Table.StoreForeignName ,SOURCE_Table.GeographyKey, SOURCE_Table.RecordHash);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
