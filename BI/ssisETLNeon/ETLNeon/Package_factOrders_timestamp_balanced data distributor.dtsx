                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select o.OrderID,o.CustomerID,o.EmployeeID,o.OrderDate,o.ShippedDate, o.ShipperId,d.ProductID, d.UnitPrice,d.Quantity,d.Discount 
,sh.ShipperName
from orders o 
left join [OrdersDetails] d on d.OrderID=o.OrderID
left join Shippers sh on sh.ShipperID=o.ShipperId 
where  (   cast(o.CurrentTimestamp as bigint) &gt;? and cast(o.CurrentTimestamp as bigint)&lt;=?)
or (cast(d.CurrentTimestamp as bigint)&gt;? and cast(d.CurrentTimestamp as bigint)&lt;=?)</property>
