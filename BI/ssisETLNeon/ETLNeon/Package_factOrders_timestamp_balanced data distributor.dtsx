        <SQLTask:SqlTaskData
          SQLTask:Connection="{9B204C49-B62D-4C9E-9BC2-5671A32A854B}"
          SQLTask:SqlStatementSource="select max(T.maxtimestamp)    from &#xA;(select cast(max(o.CurrentTimeStamp) as bigint) as maxtimestamp  from orders o&#xA;union all&#xA;select cast(max(d.CurrentTimeStamp) as bigint)  from [OrdersDetails] d) T&#xA;"
