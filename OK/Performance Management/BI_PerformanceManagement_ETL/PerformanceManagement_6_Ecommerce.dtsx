              SQLTask:SqlStatementSource="&#xA;DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL INNER JOIN&#xA;                         COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;WHERE        (d1.PersianYearMonthInt =? and overview&#xA; in ('G3','G32','G68','G70','G71','G72','G74','G75','G80','G81','G82','G84')&#xA;--  in ('G3')&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
