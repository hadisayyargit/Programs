                          refId="Package\Extract\فروش غیرحضوری\G75\G75_نسبت هزینه سفیر به فروش خالص_Transform\G75_Extract_HCMKPI1"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G75_Extract_HCMKPI1"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as (
select  d.PersianYearMonthInt, sum(h.actualvalue-h.actualvalue2) as s1
from 
OKDWH_STG.Extract.HCMKPI1 h
inner join OKDWH.COM.DIM_Date d on d.PersianInt=h.persiandate where d.PersianYearMonthInt=?
group by d.PersianYearMonthInt)
 , cte2 as (select d.PersianYearMonthInt,sum(f.NetAmountINCLTax) as sumofamount  from 
RTL.vw_Fact_SalesTrans f with(nolock)
inner join com.DIM_Item i on i.ID=f.COM_DIM_ItemRef
inner join com.DIM_InventLocation L on l.ID=f.COM_DIM_InventLocationRef
inner join com.DIM_Date d on d.id=f.COM_DIM_Date_TransRef
where i.Level1 in ('Beverages','DPH','Dry Food','Fresh Market','LHH','OPSS','Textile','Tobacco Products')
and d.PersianYearMonthInt=?
and L.TypeID  in (1,2)
--and f.RTL_DIM_SalesTypeRef  in (3,7,8,9)
and  f.RTL_DIM_SystemTypeRef=4

group by d.PersianYearMonthInt
)

, cte3 as (select cte1.PersianYearMonthInt, (cte1.s1/cte2.sumofamount) as final from cte1 inner join cte2 on cte1.PersianYearMonthInt=cte2.PersianYearMonthInt)
select * from cte3</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable"></property>
                            <property
                              dataType="System.Int32"
                              description="Specifies the column code page to use when code page information is unavailable from the data source."
                              name="DefaultCodePage">1252</property>
                            <property
