                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="G68"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select d.PersianYearMonthInt
,count(f.ID) *1.0/ count(distinct f.TransactionSerial)   as SalesTransAverage
from RTL.vw_Fact_SalesTrans f with(nolock)
inner join com.DIM_Item i with(nolock) on i.ID=f.COM_DIM_ItemRef
inner join com.DIM_InventLocation L with(nolock) on l.ID=f.COM_DIM_InventLocationRef
inner join com.DIM_Date d with(nolock) on d.id=f.COM_DIM_Date_TransRef
where i.CodeLevel1 in (1, 2, 3,5,6,7,9,11)
and d.PersianYearMonthInt=?
and L.TypeID  in (1,2)
--and f.RTL_DIM_SalesTypeRef  in (3,7,8,9)
and f.RTL_DIM_SystemTypeRef=4
group by d.PersianYearMonthInt</property>
