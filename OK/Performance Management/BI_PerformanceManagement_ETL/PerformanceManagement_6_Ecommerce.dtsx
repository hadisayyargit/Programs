                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select  d.PersianYearMonthInt,100.0 * (sum(g.ACTUALVALUE)/ sum(g.ACTUALVALUE2)) as jourchin
from 
Extract.HCMKPI1 g
inner join OKDWH.COM.DIM_Date d on d.GregorianDate=g.KPIDATE
where d.PersianYearMonthInt=?
group by d.PersianYearMonthInt</property>
