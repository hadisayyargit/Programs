                              description="The mappings between the parameters in the SQL command and variables."
                              name="ParameterMapping">"Parameter0:Input",{2B20C33D-AA1B-42A6-9E3E-EECF89B388AD};"Parameter1:Input",{2B20C33D-AA1B-42A6-9E3E-EECF89B388AD};</property>
