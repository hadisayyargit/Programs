                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="G5002"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select * from
(
SELECT	 
    YearMonth,	 
    SUM(X) OVER (PARTITION BY Year ORDER BY YearMonth ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS Cumulative_Sum_X
FROM (	 
    SELECT	 
        FORMAT(CreationDate, 'yyyyMM', 'fa') AS YearMonth,
        LEFT(FORMAT(CreationDate, 'yyyyMM', 'fa'), 4) AS Year,  -- Extract the year part
        COUNT(Path) AS X
    FROM Catalog C	 
    WHERE	 
        Type = 13	 
        AND [Path] NOT LIKE '%dashboards%'
	   and FORMAT(CreationDate, 'yyyyMM', 'fa')&gt;1402
	   and c.path like '%Monitoring and Evaluation-Customize%'
    GROUP BY FORMAT(CreationDate, 'yyyyMM', 'fa')
) AS Subquery	 

--ORDER BY YearMonth
) t
where t.YearMonth=?</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable">User::v_MDXQuery</property>
