                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">With T as (
SELECT 
       sf.[PersianYearMonthInt] YearMonth
	  ,sf.Level4
      ,Actual=sum([ActualSale])
      ,Forecast=sum([OKForecast_WeightGr])
	 ,Share = sum([ActualSale])/
	 (select  sum([ActualSale]) 
	from  [OKDM_DataAnalysis].[RTL].[SalesForecastComparison] 
	where sf.[PersianYearMonthInt]=[PersianYearMonthInt]
	  )
  FROM [OKDM_DataAnalysis].[RTL].[SalesForecastComparison] sf
  where  sf.[PersianYearMonthInt]=?
  Group by [PersianYearMonthInt],Level4

 )
,  P as(
 SELECT T.YearMonth,T.level4,sum(T.Share) Share, 
        Case when sum(T.Actual)=0 and sum(T.Forecast)=0 then 0   
		     when sum(T.Actual)=0  then 1
	         else abs(sum(T.Forecast) - sum(T.Actual))/sum(T.Actual)
		End    Deviation

 From T
 group by T.YearMonth,T.level4
 )

 select p.YearMonth
       ,100.0*sum(p.Deviation*p.share) as final
 from p
 Group by p.YearMonth</property>
                        <property
