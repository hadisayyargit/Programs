                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
      [PersianYearMonthInt]
      --,Actual=sum([ActualSale])
      --,Forecast=sum([OKForecast_WeightGr])
	  ,100.0*abs(sum([OKForecast_WeightGr])-sum([ActualSale]))/sum([ActualSale])   newactual
  FROM [OKDM_DataAnalysis].[RTL].[SalesForecastComparison]
  where  [PersianYearMonthInt]=?
  Group by [PersianYearMonthInt]
  order by PersianYearMonthInt</property>
