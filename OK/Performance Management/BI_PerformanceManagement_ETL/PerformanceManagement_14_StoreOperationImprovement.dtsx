                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">; with cte1
 as
 (
 select statusname,   sum(statuscount) as count1
 from  ( select * from [HRM].[Fact_HCMShelfLabelHistory]
 where shelfdate =
(SELECT max(ShelfDate )
  FROM [HRM].[Fact_HCMShelfLabelHistory]
  where Format(ShelfDate, 'yyyyMM','fa-IR')=?
 )  ) A
 group by statusname
 )
  , cte2 as (
 select sum(count1) as count2 from cte1 where statusname in ('No Scan','With Confilict')
 )
select 100-(select 100.0*count2 from cte2)/sum(count1) as final from cte1</property>
