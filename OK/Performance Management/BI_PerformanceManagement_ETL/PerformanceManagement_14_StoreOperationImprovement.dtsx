        <DTS:Executable
          DTS:refId="Package\Transform and Load\HRM_Fact_HCMGOAL"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{BECD1106-6FDC-42AF-A87F-4803E866B9EB}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="HRM_Fact_HCMGOAL"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Transform and Load\HRM_Fact_HCMGOAL\Extract_HCMGOAL"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Extract_HCMGOAL"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select g.*,d1.ID as startdateref, d2.ID as enddateref, d3.ID as finisheddateref
, ISNUll(k.ACTUALVALUE,0) as ACTUALVALUE,d1.PersianYearMonthInt 
, realization = iif(g.target=0 , 0 ,
(CASE KPIDirection
        WHEN 'صعودي' THEN k.ACTUALVALUE/g.target
        WHEN 'نزولي' THEN 1-((k.ACTUALVALUE-g.target)/g.target)
        WHEN 'تثبيتي' THEN iif(k.ACTUALVALUE/g.target&lt;1-((k.ACTUALVALUE-g.target)/g.target),k.ACTUALVALUE/g.target,1-((k.ACTUALVALUE-g.target)/g.target))
        END))
from Extract.HCMGOAL g
inner join OKDWH.COM.DIM_Date d1 on d1.GregorianDate=g.STARTDATE
inner join OKDWH.COM.DIM_Date d2 on d2.GregorianDate=g.ENDDATE
inner join OKDWH.COM.DIM_Date d3 on d3.GregorianDate=g.FINISHEDDATE
inner join Extract.HCMKPI k on k.goalcode=g.OVERVIEW and k.YEARMONTH=d1.PersianYearMonthInt</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
