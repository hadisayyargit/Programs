        <DTS:Executable
          DTS:refId="Package\Initialize and Prepare\Recalc YearMonth"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{8BF80E9F-49AA-4D6A-92F1-FF121FF40B1A}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Recalc YearMonth"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <ExpressionTask
              Expression="@[User::v_YearMonth1]=( @[$Project::pCurrentYearMonth]==0 )?@[User::v_YearMonth1]: (DT_WSTR, 8) @[$Project::pCurrentYearMonth]" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Initialize and Prepare\Set Bound Date"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{987A875D-56FE-4C81-A7CE-2B001B0A1022}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Set Bound Date"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADFCA076-715F-46AB-9546-C33952DB0B1F}"
              SQLTask:SqlStatementSource="select min(GregorianDate) as begindate,Max(GregorianDate) as enddate , FORMAT(min(GregorianDate),'yyyyMM01','fa-IR') as persianbegindate, FORMAT(Max(GregorianDate),'yyyyMMdd','fa-IR') as persianenddate&#xA;from com.DIM_Date d&#xA;where d.PersianYearMonthInt=?"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::v_BeginDate" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="1"
                SQLTask:DtsVariableName="User::v_EndDate" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="2"
                SQLTask:DtsVariableName="User::v_PersianBeginDate" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="3"
                SQLTask:DtsVariableName="User::v_PersianEndDate" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::v_YearMonth1"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Initialize and Prepare\set Previous YearMonth"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{560BD9C8-73A9-4A68-9114-E0045B522C3B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="set Previous YearMonth"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADFCA076-715F-46AB-9546-C33952DB0B1F}"
              SQLTask:SqlStatementSource="declare @d as int&#xA;set @d=?&#xA;&#xA;&#xA;select 100*IIF(@d%100=1,((@d-(@d%100)) /100)-1,(@d-(@d%100)) /100) +IIF( @d%100=1,12,(@d%100)-1) as previousyearmonth"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::v_PreviousYearMonth" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::v_YearMonth1"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Initialize and Prepare\Set YearMonth"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1E935E66-6CF5-4A24-84B5-916A0AA5353A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Set YearMonth"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADFCA076-715F-46AB-9546-C33952DB0B1F}"
              SQLTask:SqlStatementSource="select iif( Jmonth=1, (Jyear-1)*100+12, Jyear*100+Jmonth-1)  as PreviousYearMonth , Jyear*100+Jmonth as  CurrentYearMonth&#xA;From&#xA;(&#xA;select Format(GETDATE(), 'yyyy','fa-IR') AS Jyear&#xA;, Format(GETDATE(), 'MM','fa-IR') as Jmonth&#xA;) M&#xA;&#xA;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::v_YearMonth1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Initialize and Prepare\Truncate Table stages"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
