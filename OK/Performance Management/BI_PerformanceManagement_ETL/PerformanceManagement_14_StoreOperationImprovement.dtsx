                  DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <pipeline
                      autoAdjustBufferSize="true"
                      defaultBufferMaxRows="20000"
                      version="1">
                      <components>
                        <component
                          refId="Package\Extract\بهبود عملیات فروشگاهی\G3016_زمان رسیدگی به تخلفات\G3016_OKHR_Extract\dcVWDisciplinaryCommitteeSessionProceedings_DataShow"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="dcVWDisciplinaryCommitteeSessionProceedings_DataShow"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisComSessionProcRegionConfirmDate --'تاریخ تایید منطقه',        
  ,isnull(DDD.Date_Insert ,DDD.DisComSessionEstablishDate) as Date_Insert--[تاریخ ثبت/تشکیل کمیته]    
  ,  left(isnull(DDD.Date_Insert ,DDD.DisComSessionEstablishDate),6) as yearmonth

 FROM dcVWDisciplinaryCommitteeSessionProceedings_DataShow tdcVWDisciplinaryCommitteeSessionProceedings_DataShow WITH (NOLOCK)   
 
  INNER JOIN dcVWDisciplinaryCommitteeSession_DataShow DDD ON DDD.DisciplinaryCommitteeSessionID=tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisciplinaryCommitteeSessionID        
  LEFT JOIN dcDisComSessionSubject ON dcDisComSessionSubject.dcDisComSessionSubjectSN = DDD.dcDisComSessionSubjectSN        
  LEFT JOIN        
  (        
   SELECT SN,        
     NO,        
     DS        
   FROM dcVWDisciplinaryCommitteePenalty_DropDown        
  ) tDisciplinaryCommitteePenaltyID_Revised        
   ON tDisciplinaryCommitteePenaltyID_Revised.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisciplinaryCommitteePenaltyID_Revised        
  LEFT JOIN        
  (        
   SELECT [Personelid] AS [SN],        
     [Personelid] AS [NO],        
     [PersonelDS] AS [DS]        
   FROM mnVWPersonel        
  ) tPersonelid        
   ON tPersonelid.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.PersonelID        
  LEFT JOIN        
  (        
   SELECT SN,        
     No,        
     DS        
   FROM dcVWDisciplinaryCommitteeSessionProceedings_DataStatus        
  ) tDisComSessionProcWorkFlowStatus        
   ON tDisComSessionProcWorkFlowStatus.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisComSessionProcWorkFlowStatus        
  LEFT JOIN        
  (        
   SELECT SN,        
     NO,        
     DS        
   FROM dcVWBaseInfoLookUpTable_ValueSN_DropDown        
   WHERE BaseInfoLookUpTableParentID = 12        
  ) tViolationRepetitionNumber        
   ON tViolationRepetitionNumber.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.ViolationRepetitionNumber        
  LEFT JOIN        
  (        
   SELECT DisciplinaryCommitteePenaltyID AS SN,        
     DisciplinaryCommitteePenaltyID AS No,        
     DisComPenaltyTitle AS DS        
   FROM dbo.dcDisciplinaryCommitteePenalty        
  ) tDisciplinaryCommitteePenaltyID        
   ON tDisciplinaryCommitteePenaltyID.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisciplinaryCommitteePenaltyID        
  LEFT JOIN        
  (        
   SELECT SN,        
NO,        
     DS        
   FROM dcVWDisciplinaryCommitteeViolationItems_DropDown        
  ) tDisciplinaryCommitteeViolationItemID        
   ON tDisciplinaryCommitteeViolationItemID.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisciplinaryCommitteeViolationItemID        
  LEFT JOIN        
  (        
   SELECT SN,        
     NO,        
     DS        
   FROM dcVWDisciplinaryCommitteeViolationClass_DropDown        
  ) tDisciplinaryCommitteeViolationClassID        
   ON tDisciplinaryCommitteeViolationClassID.SN = tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisciplinaryCommitteeViolationClassID        
  LEFT JOIN [OKMasterData].[dbo].[mdVWStore]   ON [mdVWStore].[mdStoreSN] = [DDD].[StoreId]        
  LEFT JOIN [OKMasterData].[dbo].[mdRegion]    ON [mdRegion].[mdRegionSN] = [DDD].[RegionID]
  

 WHERE ((tdcVWDisciplinaryCommitteeSessionProceedings_DataShow.DisComSessionProcWorkFlowStatus &gt;= 1))              
and left(isnull(DDD.Date_Insert ,DDD.DisComSessionEstablishDate),6) =?</property>
                            <property
                              dataType="System.String"
