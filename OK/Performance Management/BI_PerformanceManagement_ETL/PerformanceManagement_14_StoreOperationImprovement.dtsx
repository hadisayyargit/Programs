              SQLTask:SqlStatementSource="&#xA;DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL INNER JOIN&#xA;                         COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;WHERE        (d1.PersianYearMonthInt =? and overview&#xA; in   ('G26','G3003','G3009','G3016')&#xA;-- in  ('G3016')&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
