                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">; with cte1 as 
(

  select GOALCODE,YEARMONTH,PersianDate as RegDate,PersianDate2 as EstablishDate
  from OKDWH_STG.Extract.hcmkpi1 k1
   union all

    select  GOALCODE,YEARMONTH,PersianDate as RegDate,InvoicePersianDate as EstablishDate 
 from OKDWH_STG.Extract.hcmkpi2 
 )

 select  t.YEARMONTH, t.GOALCODE, AVG(t.duration1) as final
 from 
 (select  cte1.*
 , DATEDIFF(day, d1.GregorianDate, d2.GregorianDate) as duration1
  from cte1
  inner join OKDWH.COM.DIM_Date d1 on d1.PersianInt=cte1.RegDate 
  inner join OKDWH.COM.DIM_Date d2 on d2.PersianInt=cte1.EstablishDate
  ) t
  group by t.YEARMONTH, t.GOALCODE</property>
