                        <component
                          refId="Package\Extract\عملیات زنجیره تامین\G58_درصد پرداخت مرتبط با ارزیابی عملکرد\G58_درصد پرداخت مرتبط با ارزیابی عملکرد_Extract1\G58"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G58"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
           CONCAT(LEFT([date], 4), SUBSTRING([date], 6, 2)) AS PersianYearMonth,
           sum(D.Value)/60 AS Karkard
    FROM [Framework].[Att].[DailyResult] D WITH (nolock)
    INNER JOIN [Framework].[Prs].[Person] P WITH (nolock) ON P.ID = D.personelid 
    INNER JOIN [Framework].[dbo].[GolrangAllPerson] G WITH (nolock) ON G.PersonelID = P.CodeMask
	 inner JOIN [Framework].[Att].[Code] C ON d.code = C.CodeID
    WHERE p.companyid = 14 
      AND CONCAT(LEFT([date], 4), SUBSTRING([date], 6, 2), RIGHT([date], 2)) &gt;= '14030101'
	  AND codeid in (14381) and G.semat IN ('راننده',
'راننده ليفتراك','رئيس انبار','سرپرست انبار','سرپرست پخش','سرپرست داخلي انبار',
'سرپرست2 انبار','كارگر انبار','کاردان پخش','کاردان فني تعميرات','کارشناس کاردکس',
'کارشناس کاردکس','کارگرجورچين','کنترل چي','مهماندار')

and CONCAT(LEFT([date], 4), SUBSTRING([date], 6, 2)) =?
group by CONCAT(LEFT([date], 4), SUBSTRING([date], 6, 2))</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDX_57</property>
                            <property
                              dataType="System.Int32"
                              description="Specifies the column code page to use when code page information is unavailable from the data source."
                              name="DefaultCodePage">1252</property>
                            <property
                              dataType="System.Boolean"
