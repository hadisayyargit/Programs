              SQLTask:SqlStatementSource="&#xA;DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL INNER JOIN&#xA;                         COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;WHERE        (d1.PersianYearMonthInt =? and overview&#xA;-- in ('G16','G54','G55','G56','G57','G58','G59','G60','G61','G62','G63','G64','G65','G1301','G1777')&#xA; in  ('G1777')&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
