                          description="The mappings between the parameters in the SQL command and variables."
                          name="ParameterMapping">"Parameter0:Input",{9F9C5301-A2A5-4AEA-A551-478ABB97ADF5};"Parameter1:Input",{9F9C5301-A2A5-4AEA-A551-478ABB97ADF5};"Parameter2:Input",{9F9C5301-A2A5-4AEA-A551-478ABB97ADF5};</property>
