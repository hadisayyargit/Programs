                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Declare @YM AS int = ?
SELECT count(KaregarRoozMozdCodeMeliSN)*6.33 as count1
FROM OKDM_DataAnalysis.HR.KaregarRoozmozdDarkhast AS Fact
left join OKDM_DataAnalysis.HR.KaregarRoozMozdDarkhast_DataState Dim on dim.SN = fact.KaregarRoozmozdDarkhastStatus
left join [OKDM_DataAnalysis].[HR].[MdvwDep] Dep on dep.mdDepSN = Fact.mdDepSN
where dim.SN = 200 and [MdDepActivityTypeDS] IN( N'انبار',N'امور انبارها') and LEFT(Fact.KaregarRoozmozdDarkhastDate,6) = @YM</property>
