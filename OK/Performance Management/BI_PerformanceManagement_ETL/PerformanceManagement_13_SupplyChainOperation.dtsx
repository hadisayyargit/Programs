                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">declare @YM AS INT = ?
;With Main_Cte as (
SELECT LoadID,2.8-sum(GrossWeight) as Grossweight
  FROM [OKDWH].[SCM].[Fact_wareHouseTransportationCost] Costs
  LEFT JOIN COM.DIM_Date Dates on Dates.ID = Costs.COM_DIM_Date_LoadShipConfirmUtcDate_Ref
  where LOADDIRECTION = 2 and Dates.PersianYearMonthInt = @YM
  group by 
  LoadID
  )
  select sum(Grossweight)/count(*) as Gw
  from Main_Cte
  where Grossweight&gt;0</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDX_59_65</property>
