                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">declare @YM as int = ?
select SUM(W.GrossWeight)/1000000 as sumGrossWeight 
FROM [OKDWH].[SCM].[Fact_WarehouseInputOutput] W
INNER JOIN [COM].[DIM_Date] D ON W.COM_DIM_Date_LoadShipconfirmUTCdateRef = D.ID
INNER JOIN [COM].[DIM_InventLocation] L ON W.COM_DIM_InventLocationFromRef = L.ID
inner join com.DIM_Item I ON I.ID = W.COM_DIM_ItemRef
WHERE  d.PersianYearMonthInt  = @YM AND L.TypeID IN (5,6,7) AND I.CodeLevel1 IN(1,2,3,4,6,7,8,9,11)</property>
