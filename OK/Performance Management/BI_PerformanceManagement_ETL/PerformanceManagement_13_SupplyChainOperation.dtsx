                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
    b.PersianYearMonth,
    sum(B.[NafarSaat(6/7)]) AS Budget
FROM 
    Report.[WarehouseProductivityBudget] B
CROSS JOIN 
    [dbo].[DimDate] d
WHERE 
    LEFT( PersianYearMonthInt, 6) = CAST(b.PersianYearMonth AS NVARCHAR(6))  and b.PersianYearMonth=?
	group by b.PersianYearMonth</property>
