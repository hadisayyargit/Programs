                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select sum(f.GrossWeight) as sumGrossWeight from [SCM].[Fact_WarehouseInputOutput] f
 inner join com.dim_date d1  on d1.id=f.COM_DIM_Date_LoadShipconfirmUTCdateRef
 --inner join com.DIM_Item i on i.ID=f.COM_DIM_ItemRef
inner join com.DIM_InventLocation L on l.ID=f.COM_DIM_InventLocationFromRef
where 
d1.PersianYearMonthInt=?
and f.LOADDIRECTION=2
and L.TypeID  in (5,6,7)</property>
