                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
      left(D.[KaregarRoozmozdDarkhastDate],6) as persianyearmonth
		,count(*)*6.33 as CountPersonel
  FROM [OKMali].[dbo].[maKaregarRoozmozdDarkhast] D
  LEFT JOIN [OKMali].[dbo].[maVWKaregarRoozMozdDarkhast_DataState] S ON D.KaregarRoozmozdDarkhastStatus = S.SN
WHERE KaregarRoozmozdDarkhastDate &gt;= 14030101 and s.DS = N'پرداخت موفق به بانک'
and left(D.[KaregarRoozmozdDarkhastDate],6)=?
group by left(D.[KaregarRoozmozdDarkhastDate],6)</property>
