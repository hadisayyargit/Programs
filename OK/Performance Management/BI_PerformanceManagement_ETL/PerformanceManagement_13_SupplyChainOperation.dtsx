                      Expression="@[User::v_MDX_1301_1] =&quot; SELECT { [Measures].[Net Amount], [Measures].[Tax] } ON COLUMNS&#xA; ,  { ([ReceiveDate].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } ON ROWS &#xA; FROM ( SELECT ( { [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [PurchStatus].[PurchStatus].&amp;[Received], [PurchStatus].[PurchStatus].&amp;[Invoiced] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [ReceiveDate].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA; FROM [VendorServiceLevel]))) &#xA; WHERE ( [PurchStatus].[PurchStatus].CurrentMember, [Item].[Level1].CurrentMember ) &quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
