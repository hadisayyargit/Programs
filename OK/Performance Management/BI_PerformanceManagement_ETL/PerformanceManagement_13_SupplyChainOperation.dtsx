                        </component>
                        <component
                          refId="Package\Extract\عملیات زنجیره تامین\G57_درصد بهبود نمره بازرسی\G57_درصد بهبود نمره بازرسی_Extract_20250215\G57"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G57"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT Com_DIM_DATE_BazresiDateRef,storeid_source,storeName_source,qdsc,Point,NomrehPoint,QuestionHaVal
FROM [FIN].[Fact_Inspection_Capsul] C
inner join com.DIM_Date d1 with(nolock) on d1.id=c.Com_DIM_DATE_BazresiDateRef 
WHERE Com_DIM_DATE_BazresiDateRef &gt;= 20250215 and ( d1.PersianYearMonthInt=?)
  AND (MOTAVALIDS = N'واحد امور انبارها' OR MOTAVALIDS like N'%واحد حراست انبارها%')
  AND (
    BazresiTypeDS = N'بازرسي هفتگي حضوري از انبار سرد' 
    OR BazresiTypeDS = N'بازرسي جدید انبار کندگردش'
	or BazresiTypeDS = N'بازرسي جدید انبارهای سرد'
	or BazresiTypeDS = N'بازرسي هفتگي حضوري از انبار خشک'
	or BazresiTypeDS = N'بازرسی جدید انبارهای خشک'
  ) AND Point IN (0,1,2,3,4,5) AND QuestionHaVal IN (0,1,2,3,4,5)
AND (qdsc IN( 
N'آيا از تردد افراد متفرقه در سوله های نگهداری کالای انبار جلوگيري مي شود؟'
,N'آيا دوربين هاي انبار کيفيت، زاويه ديد مناسب و پوشش کافي دارند؟'
,N'بررسي پلمپ انبار در اتمام شيفت کاري توسط نگهباني انجام مي شود؟'
,N'آيا از تجهیزات حمل و نقل کالا در انبار ( ليفتراک ، ریچتراک ، پالت تراک و اوردر پیکر ) بصورت استاندارد استفاده مي شود ؟'
,N'آيا زیر ساخت های بصری و شرایط سکو های تخلیه و بارگیری مناسب میباشد؟'
,N'آيا شرایط فضای دپوی انبار مطابق استاندارد میباشد ؟'
,N'آیا درصد شورت پیک شده انبار نسبت به ارسالی انبار مطابق استاندارد می باشد؟'
,N'آیا درصد حواله پست شده انبار نسبت به ارسالی انبار مطابق استاندارد می باشد؟'
,N'آیا براساس کنترل موجودی هفته جاری ، مازاد یا عدم رسید درخواست های تامین کنندگان توسط کاردکس مشاهده می گردد؟'
,N'آیا فرآیند تحویل بار از تامین کنندگان توسط کنترلچی به صورت استاندارد و به وسیله pda انجام میگردد ؟'
,N'آیا فرآیند تحویل بار از تامین کنندگان توسط کنترلچی به صورت استاندارد انجام میگردد ؟'
,N'آيا  کالاها با ظاهری سالم به انبارها ارسال مي شود؟'
,N'آيا  کالاها با ظاهری سالم به فروشگاه ها ارسال مي شود؟'
,N'آيا چيدمان استاندارد کالا در پالت چرخدار و سالم بودن ترالی های ارسالی به فروشگاه رعايت شده است ؟'
,N'آيا چيدمان استاندارد کالا در زمان بارگیری (کامیونت) در زمان ارسال بار به سایر انبارها رعايت شده است ؟'
,N'ایا میزان ضایعات ایجاد شده ناشی از عملیات انبارها مطابق استاندارد می باشد؟'
,N'آیا برای کالاهایی که در معرض ضایعات از جنس شکستن شیشه ، ریزش و پارگی قرار دارند اقدامات پیشگیرانه مانند تسمه کشی ، چسب پنج سانتی و سلفون انجام میگردد ؟'
,N'آیا پس از اتمام عملیات  کالاهایی که به صورت پالتی وارد انبار شده و نیاز به دپو ندارند، در لاین ها چیدمان میگردند ؟'
,N'آیا جانمایی کالاها در لاین های انبار و همچنین موقعیت لاین ها به صورت دوره ای بازنگری و اصلاح میگردد؟'
,N'آيا فرآیند امحاء ضایعات مطابق دستورالعمل سازمانی به صورت ماهانه انجام میگردد ؟'
,N'آيا فرآیند امحاء ضایعات مطابق دستورالعمل سازمانی به صورت هفتگی انجام میگردد ؟'
,N'آیا اتاق ضایعات انبار مطابق با شرایط استاندارد میباشد ؟'
,N'آیا اطلاعات ضروری بر روی کالاهای ورودی به منظور کنترل FIFO و شناخت رسوب درج میگردد؟'
,N'آيا بر اساس کنترل موجودي انجام شده توسط تیم بهبود عملیات زنجیره تامین در دو هفته گذشته، مغايرت هاي کسری و سرک موجود در طی هفته بررسی و برطرف گردیده است ؟'
,N'آيا بررسي و تعین تکلیف شورت پیک هاي انبار به صورت منظم در طي هفته توسط انبار انجام مي شود؟'
,N'آيا بررسی و تعیین تکلیف دو لوکیشنه و مغایرت وضعیت لوکیشنهای انبارها (بعد از فرآیند تخلیه و در حین عملیات ) به صورت منظم در طی هفته توسط انبار بررسی و رفع میگردد ؟'
,N'آیا مرجوعی انبارها از وضعیت و لوکیشن صحیح خود ثبت می گردند؟'
,N'آیا مطابق با برنامه اعلامی واحد بهبود عملیات زنجیره تامین ، کنترل موجودی هفتگی طبق استاندارد انجام شده است ؟'
,N'آيا در انبار مشکل و نیازمندی ديگری مشاهده مي گردد؟'
,N'آیا دستورالعمل حواله های موقت در مرحله ارجاع به داوری توسط انبار مطابق استاندارد سازمانی رعایت میگردد ؟'
,N'آيا تمامي بار ارسالي تامين کنندگان توسط کارگران انبار تخليه مي شود؟'
,N'آيا فرآیند نوبت دهی و ورود و خروج تامین کنندگان توسط سامانه گارد انجام میشود؟'
,N'آیا عودت مرجوعی های انبار به تامین کنندگان مطابق دستورالعمل و استاندارد سازمانی انجام میگیرد ؟'
,N'آيا پس از پایان عملیات انبار، کالاهاي ضايعاتي و مرجوعي از سطح لاین ها جمع آوری میگردد ؟'
,N'آیا انبار دارای کالاهای فاسد و منقضی شده بیش از یک ماه بلاتکلیف در اتاق ضایعات نمی باشد؟'))</property>
