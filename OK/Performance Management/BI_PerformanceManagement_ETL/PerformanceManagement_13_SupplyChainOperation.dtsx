          DTS:ObjectName="HCMCommandment_احکام">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Extract\HCMCommandment_احکام\Exec Task Temptable"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{cf9f6d1a-e48f-407d-b896-2fac35087ffd}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Exec Task Temptable"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{F45CB100-B321-43A2-A1F4-79B85292715A}"
                  SQLTask:SqlStatementSource="&#xA;DECLARE @Dore INT = ?&#xA;&#xA;---------------- Personel In Dore ------------------------------&#xA;&#xA;  DROP TABLE IF EXISTS #CorrectDateInUnactiveTable, #EndDateRowsToColumn, #HireEndHistory, #Ahkam , #NumberOfHireInMonth, #NumberOfLeftInMonth, ##Ahkam2&#xA;SELECT personelid&#xA;      ,AlatTark&#xA;      ,CONCAT(IIF(left(TarkDate,2)&lt;=40,14,13),TarkDate) AS StartDate&#xA;   ,FlagStatus&#xA; INTO #CorrectDateInUnactiveTable&#xA; FROM [Personnel].[dbo].[UnActive] with(nolock)&#xA;&#xA;SELECT personelid&#xA;   ,StartDate&#xA;   ,IIF(LEAD(flagStatus, 1) OVER (PARTITION BY personelid ORDER BY personelid, StartDate)=0,LEAD(StartDate, 1) OVER (PARTITION BY personelid ORDER BY personelid, StartDate),NULL) AS EndDate&#xA;   ,ISNULL(LEAD(AlatTark, 1) OVER (PARTITION BY personelid ORDER BY personelid, StartDate),'') AS EndType&#xA;   ,flagStatus&#xA;   ,ROW_NUMBER() OVER(PARTITION BY personelid ORDER BY StartDate) AS RowNumber&#xA;INTO #EndDateRowsToColumn&#xA;FROM #CorrectDateInUnactiveTable&#xA;Drop TABLE #CorrectDateInUnactiveTable&#xA;&#xA;SELECT personelid&#xA;   ,StartDate&#xA;   ,EndDate&#xA;   ,EndType&#xA;INTO #HireEndHistory&#xA;FROM #EndDateRowsToColumn&#xA;WHERE (EndType &lt;&gt; 0 OR (EndDate IS NULL AND flagStatus= 1)) AND RowNumber % 2 &lt;&gt;0&#xA;AND &#xA;LEFT(StartDate,6)/1 &lt;= @Dore AND (LEFT(EndDate,6)/1 &gt;= @Dore OR EndDate IS NULL)&#xA;Drop TABLE #EndDateRowsToColumn;&#xA;&#xA;--------------- Olap And Last Hokm ------------------------------------&#xA;&#xA;SELECT [Personelid]&#xA;      ,CONCAT(IIF(left(DateStart,2)&lt;=40,14,13),DateStart) AS [DateStart]&#xA;   ,ROW_NUMBER() OVER (PARTITION BY A.[Personelid] ORDER BY [AhkamId] DESC) AS RowNumber&#xA;   ,A.DepId&#xA;      ,A.[jobid]&#xA;      ,[stekhdamid]&#xA;   , s.radeid&#xA;   , s.titelRade&#xA;  INTO #Ahkam&#xA;  FROM [Personnel].[dbo].[Ahkam] A with(nolock)&#xA;   INNER JOIN [Personnel].[dbo].[Departeman]      Dep with(nolock) ON A.DepId = Dep.DepId&#xA;      INNER JOIN [Personnel].[dbo].[Jobs]            J   with(nolock) ON A.jobid = J.jobid&#xA;   inner join Sath_E_Sazemani s on s.radeid= j.radeid&#xA;&#xA;  WHERE [IsPersonel] = 0 AND CONCAT(IIF(left(DateStart,2)&lt;=40,14,13),DateStart)/100 &lt;= @Dore&#xA;  and stekhdamid&lt;&gt;28&#xA;&#xA;SELECT &#xA;       H.Personelid &#xA;   ,H.StartDate &#xA;   ,H.EndDate &#xA;   ,H.EndType &#xA;   ,T.jobid&#xA;   ,T.DepId&#xA;   , t.radeid&#xA;   , t.titelRade&#xA; , t.stekhdamid&#xA; INTO ##Ahkam2&#xA;FROM #Ahkam T&#xA;INNER JOIN #HireEndHistory H  ON T.Personelid = H.personelid&#xA;WHERE RowNumber = 1 &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::v_YearMonth1"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="3"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
