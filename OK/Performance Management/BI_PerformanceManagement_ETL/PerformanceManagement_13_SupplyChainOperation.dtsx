                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select k1.GOALCODE, k1.YEARMONTH,(k1.NetAmountINCLTaxAverage-k1.Tax) / (k2.CountingPurchasePriceAmountSurplus+k2.CountingPurchasePriceAmountShortage+k2.AdjustmentPurchasePriceAmountShortage+k2.AdjustmentPurchasePriceAmountSurplus) as actualvalue
