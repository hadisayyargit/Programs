                    <ExpressionTask
                      Expression="@[User::v_MDX_1301_2] =&quot; SELECT { [Measures].[Counting Purchase Price Amount Surplus], [Measures].[Counting Purchase Price Amount Shortage], [Measures].[Adjustment Purchase Price Amount Shortage], [Measures].[Adjustment Purchase Price Amount Surplus] } ON COLUMNS&#xA; , { ([COM DIM Date From Ref].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS * [COM DIM Date To Ref].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } ON ROWS &#xA; FROM ( SELECT ( { [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[Available], [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[Isolated], [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[Scrapped], [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[ShortPick] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [COM DIM Date To Ref].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [COM DIM Date From Ref].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA; FROM [OKDWH_Counting]))) &#xA; WHERE ( [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].CurrentMember )  &quot;" />
