                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT  tc.TrolleyExit, tc.ExitDate
  FROM [OKGuardNew].[Guard].[TruckCheckers] tc
  join [OKGuardNew].[Guard].Stockrooms s
  on tc.StockroomId = s.Id
  join [OKGuardNew].[Guard].Drivers d
  on tc.DriverId = d.Id
  join [OKGuardNew].[Guard].Trucks t
  on tc.TruckId = t.Id
  where TrafficType = 1
  and Status = 5
  and tc.IsRemoved = 0
  and tc.ExitDate between ? and ?
  --and tc.TrolleyExit&lt;8
  order by tc.InsertTime desc</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDX_59_65</property>
