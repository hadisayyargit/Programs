                        <component
                          refId="Package\Extract\عملیات زنجیره تامین\G1777_شورت پیک و مرجوعی\G1777\HCMKPI1"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="HCMKPI1"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">with Return_Weight  as(
select d.persianyearmonthint,sum(abs(f.ReturnQTY)*f.GrossWeight) as Return_Weight 
 from scm.Fact_Picking f
 inner join com.DIM_InventLocation inv on inv.ID=f.COM_DIM_InventLocationRef
 inner join com.DIM_Item itm on itm.ID=f.COM_DIM_ItemRef
 inner join com.DIM_Date d on d.ID=f.COM_DIM_LoadDateRef
 where inv.BKInventLocationId &lt;&gt;'OKS00000'
 AND F.Posted=1
 and itm.Level1 not in ('Commercial Costs', 'EQ', 'Marketing Costs')
 and itm.Level3 not in ('گوشت گاو و گوساله','گوشت گوسفند')
 and itm.Level4 not in ('شیر نایلونی', 'مرغ کامل منجمد', 'مغز ران مرغ منجمد', 'مرغ منجمد وعده ای','دوغ بدون گاز نایلونی')
 and d.PersianYearMonthInt=?
  group by d.persianyearmonthint
 )
 ,
 Picked as (
 SELECT d.persianyearmonthint, sum(f.PickedQTY_Checker*f.GrossWeight) as PickedChecker_Weight
 , sum((abs(f.WorkQTY)-abs(f.PickedQTY_Checker))*f.GrossWeight) as ShortPick_Weight
 from scm.Fact_Picking f
 inner join com.DIM_InventLocation inv on inv.ID=f.COM_DIM_InventLocationRef
 inner join com.DIM_Item itm on itm.ID=f.COM_DIM_ItemRef
 inner join com.DIM_Date d on d.ID=f.COM_DIM_LoadDateRef
 where inv.BKInventLocationId &lt;&gt;'OKS00000'
 and itm.Level1 not in ('Commercial Costs', 'EQ', 'Marketing Costs')
 and itm.Level3 not in ('گوشت گاو و گوساله','گوشت گوسفند')
 and itm.Level4 not in ('شیر نایلونی', 'مرغ کامل منجمد', 'مغز ران مرغ منجمد', 'مرغ منجمد وعده ای','دوغ بدون گاز نایلونی')
 and d.PersianYearMonthInt=?
 group by d.persianyearmonthint
 )
 selecT ((Return_Weight + ShortPick_Weight)/PickedChecker_Weight)*100.0 as final
 from Return_Weight RW
 inneR join  Picked P ON P.persianyearmonthinT = RW.persianyearmonthinT</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDX_59_65</property>
                            <property
                              dataType="System.Int32"
