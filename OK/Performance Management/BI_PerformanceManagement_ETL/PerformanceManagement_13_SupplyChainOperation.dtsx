                        <component
                          refId="Package\Extract\عملیات زنجیره تامین\G57_درصد بهبود نمره بازرسی\G57_درصد بهبود نمره بازرسی_Extract_before 20250215\G57"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G57"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT Com_DIM_DATE_BazresiDateRef,storeid_source,storeName_source,qdsc,Point,NomrehPoint,QuestionHaVal
FROM [FIN].[Fact_Inspection_Capsul] C with(nolock)
inner join com.DIM_Date d1 with(nolock) on d1.id=c.Com_DIM_DATE_BazresiDateRef
WHERE (Com_DIM_DATE_BazresiDateRef between 20230321 and 20250214) and ( d1.PersianYearMonthInt=?)
  AND MOTAVALIDS = N'واحد امور انبارها' 
  AND (
    BazresiTypeDS = N'بازرسي هفتگي حضوري از انبار خشک' 
    OR BazresiTypeDS = N'بازرسي هفتگي حضوري از انبار سرد'
  ) AND Point IN (1,2,3) AND QuestionHaVal IN (0,1,2,3)
AND (qdsc IN( N'آيا  کالاهاي ارسالي به فروشگاه ها داراي شکل ظاهري سالم مي باشند ؟'
 ,N'آيا اطلاعات نيروهاي روزمزد ثبت شده در سيستم با نيروي روز مزد حاضر در انبار مطابقت دارد؟'
 ,N'آيا افراد حاضر در انبار با شيفت بندي ثبت شده در کسرا تطابق دارند؟'
 ,N'آيا افراد فاقد گواهينامه از ليفتراک استفاده مي کنند؟'
 ,N'آيا افراد مطابق با شيفت مشخص شده در سيستم در انبار حضور دارند؟'
 ,N'آيا انبار ضايعات نظافت مناسب دارد ؟'
 ,N'آيا باکس پالت هاي انبار داراي برچسب شناسنامه مي باشند؟'
 ,N'آيا براي کالايي مثل زعفران و ساير کالاهاي گران قيمت محل مناسبي تعبيه شده است ؟(بطور مثال نزديک بخش اداري)'
 ,N'آيا بررسي Short pick سالن هاي انبار در پايان شيفت کاري توسط مسيول سالن انجام مي شود؟'
 ,N'آيا پرسنل انبار داراي لباس فرم مي باشند؟'
 ,N'آيا تاييد مرجوعي هاي فروشگاه بر اساس استاندارد صورت مي گيرد؟'
 ,N'آيا چيدمان استاندارد کالا در پالت چرخدار رعايت شده است؟'
 ,N'آيا چيدمان استاندارد کالا(FIFO) در زمان جورچيني در انبار رعايت شده است؟'
 ,N'آيا خطاي جورچيني در ارسال بار مشاهده مي شود؟'
 ,N'آيا خطاي عملکرد کنترل چي در ارسال مشاهده مي شود؟'
 ,N'آيا خطاي عملکرد کنترل چي در تحويل بار مشاهده مي شود؟'
 ,N'آيا خطاي عملکرد کنترل چي در تحويل بار مشاهده مي شود؟
نام فرد ذکر گردد.'
,N'آيا در انبار سرد نوع محموله با نوع سيستم سرمايشي خودرو  همخواني دارد؟'
,N'آيا در انبار موضوع ديگر قابل مطرح شدن مشاهده مي گردد؟ (توضيحات بازرسي انبار)'
,N'آيا در حين انجام عمليات انبار کالايي ضايعات شده است يا خير؟'
,N'آيا در دپو کالا فايفو رعايت شده است؟'
,N'آيا در کليه عمليات انبار از PDA استفاده مي شود؟'
,N'آيا در لاين هاي انبار تابلوهاي راهنما نصب شده است؟'
,N'آيا در محوطه انبار استعمال دخانيات مشاهده مي شود؟'
,N'آيا دماسنج در سردخانه وجود دارد و ثبت دماي يخچال و فريزر در جدول انجام شده است؟'
,N'آيا رانندگي ليفتراک از تخصص و مهارت کافي برخوردار مي باشند؟'
,N'آيا سالم بودن شکل ظاهري کالاهاي ارسالي از انبار به فروشگاه کنترل مي شود؟'
,N'آيا سيستم برودتي خودرو پخش انبار سرد عملکرد مطلوب دارد؟'
,N'آيا ضربه گير لاستيکي در محل سکوي انبار نصب شده است؟'
,N'آيا عمليات کنترل سالن در طول شيفت توسط مسيول سالن انجام مي شود؟'
,N'آيا فضاي آشپزخانه و غذا خوري و رختکن پرسنل وجود دارد؟'
,N'آيا کارکنان انبار از لباس کار، دستکش ايمني کفش کار استفاده نموده اند؟'
,N'آيا کالاها در شرايط غيراستاندارد (زيرنورآفتاب ) نگهداري مي شوند؟'
,N'آيا کالاي ضايعاتي و مرجوعي در سطح انبار نگه داري مي‌شود؟'
,N'آيا کالايي با تاريخ منقضي در باکس پالت هاي انبار مشاهده شده است؟'
,N'آيا کالايي به علت عدم شارژ توسط ليفتراک short pick شده است؟'
,N'آيا کپسول هاي گاز ليفتراک در محل مناسب و بدون خطر نگهداري مي شود؟'
,N'آيا مستندات کارت سلامت معتبر رانندگان  موجود است؟
نام فرد ذکر گردد.'
,N'آيا نظافت انبار در پايان هر شيفت کاري انجام مي شود؟'))</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDX_57</property>
