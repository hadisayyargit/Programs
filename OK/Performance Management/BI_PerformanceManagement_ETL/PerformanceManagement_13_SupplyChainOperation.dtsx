                      refId="Package\Extract\عملیات زنجیره تامین\G62_نسبت اجاره انبار به فروش\G62"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="G62"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as
(
select d.PersianYearMonthInt,sum(amount) as sumofAmount from fin.Fact_ProfitLoss f with(nolock)
inner join com.DIM_Date d with(nolock) on d.id=f.COM_DIM_DateRef
inner join [FIN].[Dim_PLMainAccountGroups] g with(nolock) on g.id=f.FIN_DIM_MainAccountGroupRef
inner join OKDWH_STG.Extract.HCMProfitLossMainAccount m with(nolock) on m.ID=f.FIN_DIM_MainAccountRef
inner join [FIN].[DIM_CostCenter] c on c.ID=f.FIN_DIM_CostCenterRef
where d.PersianYearMonthInt=?
and g.ProfitLossGroupDS=N'هزينه هاي ثابت'
and g.MainAccountGroupDS in (N'هزينه رهن واجاره')
and m.BKMAINACCOUNTID in ('82113201','7214','7208','821132')
and c.mdCostCenterTypeDS='انبار'
group by d.PersianYearMonthInt
)

, cte2 as 
(
select d1.PersianYearMonthInt,sum(s.NetAmount) as sumnetamount from [RTL].[Fact_SalesTrans] s
inner join COM.DIM_Date d1 on d1.ID=s.COM_DIM_Date_TransRef
where d1.PersianYearMonthInt=?
group by d1.PersianYearMonthInt

)


select  cte1.PersianYearMonthInt,Abs(cte1.sumofAmount*100.0/cte2.sumnetamount) as final from 
cte1
inner join cte2 on cte2.PersianYearMonthInt=cte1.PersianYearMonthInt</property>
                        <property
