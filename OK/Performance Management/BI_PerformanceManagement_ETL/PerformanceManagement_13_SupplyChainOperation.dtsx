                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="HCMKPI1"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @Ym AS INT = ?
;WITH ALL_cte AS (
    SELECT   
        D.Value,
		P.CodeMask
    FROM Att.DailyResult D WITH (NOLOCK)
    INNER JOIN Prs.Person P WITH (NOLOCK) ON P.ID = D.personelid 
    INNER JOIN [GolrangAllPerson] G WITH (NOLOCK) ON G.PersonelID = P.CodeMask
    INNER JOIN Att.Code C ON D.Code = C.CodeID
    WHERE P.companyid = 14 
      AND CONCAT(LEFT([date], 4), SUBSTRING([date], 6, 2)) = @Ym
      AND D.Code IN (11101,10103)
      AND  G.semat IN (
        'راننده','راننده ليفتراك','رئيس انبار','سرپرست انبار','سرپرست پخش','سرپرست داخلي انبار',
        'سرپرست2 انبار','كارگر انبار','کاردان پخش','کاردان فني تعميرات','کارشناس کاردکس',
        'کارگرجورچين','کنترل چي','مهماندار'
      )
),
Final_CTE AS (
    SELECT 
        all_cte.CodeMask,
        IIF(SUM(all_cte.value)/60 - 30 &lt; 0, 0, SUM(all_cte.value)/60 - 30) AS Value
    FROM ALL_cte
    GROUP BY all_cte.CodeMask
)

SELECT SUM(Value)/count(*) AS TotalValue
FROM Final_CTE;</property>
