      DTS:Namespace="User"
      DTS:ObjectName="v_MDX_1301_1">
      <DTS:VariableValue
        DTS:DataType="8">SELECT { [Measures].[Net Amount], [Measures].[Tax] } ON COLUMNS  ,  { ([ReceiveDate].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } ON ROWS   FROM ( SELECT ( { [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS   FROM ( SELECT ( { [PurchStatus].[PurchStatus].&amp;[Received], [PurchStatus].[PurchStatus].&amp;[Invoiced] } ) ON COLUMNS   FROM ( SELECT ( { [ReceiveDate].[Persian Year Month Int].&amp;[140303] } ) ON COLUMNS   FROM [VendorServiceLevel])))   WHERE ( [PurchStatus].[PurchStatus].CurrentMember, [Item].[Level1].CurrentMember )</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{797521DF-255F-41C0-82F0-F303BF47DB2D}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX_1301_2">
      <DTS:VariableValue
        DTS:DataType="8">SELECT { [Measures].[Counting Purchase Price Amount Surplus], [Measures].[Counting Purchase Price Amount Shortage], [Measures].[Adjustment Purchase Price Amount Shortage], [Measures].[Adjustment Purchase Price Amount Surplus] } ON COLUMNS  , { ([COM DIM Date From Ref].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS * [COM DIM Date To Ref].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } ON ROWS   FROM ( SELECT ( { [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[Available], [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[Isolated], [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[Scrapped], [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].&amp;[ShortPick] } ) ON COLUMNS   FROM ( SELECT ( { [COM DIM Date To Ref].[Persian Year Month Int].&amp;[140303] } ) ON COLUMNS   FROM ( SELECT ( { [COM DIM Date From Ref].[Persian Year Month Int].&amp;[140303] } ) ON COLUMNS   FROM [OKDWH_Counting])))   WHERE ( [SCM DIM Invent Status Adjustment Ref].[BK Invent Status Id].CurrentMember )</DTS:VariableValue>
    </DTS:Variable>
