                    <component
                      refId="Package\مالی\مدیریت\G47_مجموع هزينه های متغیر\G22_G29_G39_G42_G3'"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="G22_G29_G39_G42_G3'"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with 
	cte1 as (select k.YEARMONTH, sum(0.1* k.ACTUALVALUE) as ACTUALVALUE from OKDWH_STG.Extract.HCMKPI k 
	    where GOALCODE  in ('g22','g29','g39','g42','g3') and k.YEARMONTH=? group by  k.YEARMONTH)
   , cte2 as (select d.PersianYearMonthInt,sum(amount) / -1000000.0  as sumofAmount
from fin.Fact_ProfitLoss f with(nolock)
inner join com.DIM_Date d with(nolock) on d.id=f.COM_DIM_DateRef
inner join [FIN].[Dim_PLMainAccountGroups] g with(nolock) on g.id=f.FIN_DIM_MainAccountGroupRef
inner join OKDWH_STG.Extract.HCMProfitLossMainAccount m with(nolock) on m.ID=f.FIN_DIM_MainAccountRef
where d.PersianYearMonthInt=?
and 
(
        (MainAccountGroupDS='حقوق و دستمزد' and ProfitLossGroupDS='هزينه هاي ثابت' and m.NAME in ( N'هزینه پاداش پرسنل فرانچایز' , N'بهره وری 2')  ) 
    or  (MainAccountGroupDS='تبليغات عادي'  and ProfitLossGroupDS='هزينه هاي متغير')
    or  (MainAccountGroupDS='کارمزد فروش'   and ProfitLossGroupDS='هزينه هاي متغير')
	or  (MainAccountGroupDS='باربري'         and ProfitLossGroupDS='هزينه هاي متغير' and m.NAME in ( N'توزیع و پخش' , N'هزینه بارنامه و حمل به داخل', N'حمل و نقل اثاثه و تجهیزات'))
	or  (MainAccountGroupDS='سفيران'         and ProfitLossGroupDS='هزينه هاي متغير' and m.NAME in ( N'فروش اینترنتی-میاره' , N'هزینه سفیر'))
	or  (MainAccountGroupDS='کسري وضايعات'         and ProfitLossGroupDS='هزينه هاي متغير')
)
group by d.PersianYearMonthInt
)
select cte1.YEARMONTH, (cte1.ACTUALVALUE+ cte2.sumofAmount) as actualvalue from cte1 inner join cte2 on cte2.PersianYearMonthInt=cte1.YEARMONTH</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable">User::v_MDXQuery</property>
                        <property
                          dataType="System.Int32"
                          description="Specifies the column code page to use when code page information is unavailable from the data source."
                          name="DefaultCodePage">1252</property>
                        <property
                          dataType="System.Boolean"
                          description="Forces the use of the DefaultCodePage property value when describing character data."
                          name="AlwaysUseDefaultCodePage">false</property>
                        <property
                          dataType="System.Int32"
                          description="Specifies the mode used to access the database."
                          name="AccessMode"
                          typeConverter="AccessMode">2</property>
                        <property
                          dataType="System.String"
                          description="The mappings between the parameters in the SQL command and variables."
                          name="ParameterMapping">"Parameter0:Input",{88B527E9-E00C-4528-A9DE-04FB5B905E46};"Parameter1:Input",{88B527E9-E00C-4528-A9DE-04FB5B905E46};</property>
                      </properties>
