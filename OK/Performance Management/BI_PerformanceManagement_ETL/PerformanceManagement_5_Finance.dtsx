                      refId="Package\مالی\G1615_سایر درآمدها و هزینه های غیرعملیاتی روند وجوه\G1615.Outputs[OLE DB Source Output]"
                      name="OLE DB Source Output">
                      <outputColumns>
                        <outputColumn
                          refId="Package\مالی\G1615_سایر درآمدها و هزینه های غیرعملیاتی روند وجوه\G1615.Outputs[OLE DB Source Output].Columns[PersianYearMonthInt]"
