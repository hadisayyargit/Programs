                      name="AccessMode"
                      typeConverter="AccessMode">2</property>
                    <property
                      dataType="System.String"
                      description="The mappings between the parameters in the SQL command and variables."
                      name="ParameterMapping">"Parameter0:Input",{659E7512-E4AC-4985-936A-4379EEB3753B};"Parameter1:Input",{659E7512-E4AC-4985-936A-4379EEB3753B};</property>
