              DTS:ObjectName="G1607_Set MDX Query"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <ExpressionTask
                  Expression="@[User::v_MDX] =&quot; SELECT NON EMPTY { [Measures].[Avg_DaysPayableOutstanding] } ON COLUMNS&#xA; , NON EMPTY { ([PaymentDate].[PersianYearMonthInt].[PersianYearMonthInt].ALLMEMBERS ) } ON ROWS &#xA; FROM ( SELECT ( { [Payment].[PaymentStatus].&amp;[Paid] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [Payment].[VENDGROUP].&amp;[GIGCompany], [Payment].[VENDGROUP].&amp;[Domestic] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [PaymentDate].[PersianYearMonthInt].&amp;[&quot;+ @[User::v_YearMonth1]+&quot;] } ) ON COLUMNS &#xA; FROM [Perspective]))) &#xA; WHERE ( [Payment].[VENDGROUP].CurrentMember, [Payment].[PaymentStatus].&amp;[Paid] )&#xA;&quot;" />
              </DTS:ObjectData>
            </DTS:Executable>
