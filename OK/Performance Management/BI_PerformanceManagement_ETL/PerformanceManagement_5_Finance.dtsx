                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select d.PersianYearMonthInt,sum(amount) as sumofAmount 
from fin.Fact_ProfitLoss f with(nolock)
inner join com.DIM_Date d on d.id=f.COM_DIM_DateRef
inner join [FIN].[Dim_PLMainAccountGroups] g on g.id=f.FIN_DIM_MainAccountGroupRef
inner join OKDWH_STG.Extract.HCMProfitLossMainAccount m on m.ID=f.FIN_DIM_MainAccountRef
where d.PersianYearMonthInt=?
and m.BKMAINACCOUNTID not in('7207','7211')
and g.MainAccountGroupDS in (N'هزينه توسعه واستهلاک')
and g.ProfitLossGroupDS=N'هزينه هاي ثابت'
group by d.PersianYearMonthInt</property>
