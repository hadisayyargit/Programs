                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select d.PersianYearMonthInt,sum(t.NetAmount) as totalNetAmount  from 
  RTL.Fact_SalesTrans AS t with(nolock)
  inner join com.DIM_Date d with(nolock) on d.ID=t.COM_DIM_Date_TransRef
  inner join com.DIM_Item i with(nolock)  on i.ID=t.COM_DIM_ItemRef
 where 
   i.CodeLevel1 in (1, 2, 3,5,6,7,9,11)
   and d.PersianYearMonthInt=?
   group by d.PersianYearMonthInt</property>
