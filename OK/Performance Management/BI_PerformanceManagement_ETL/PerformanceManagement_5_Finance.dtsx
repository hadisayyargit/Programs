      DTS:Namespace="User"
      DTS:ObjectName="v_MDX">
      <DTS:VariableValue
        DTS:DataType="8">SELECT NON EMPTY { [Measures].[Avg_DaysPayableOutstanding] } ON COLUMNS  , NON EMPTY { ([PaymentDate].[PersianYearMonthInt].[PersianYearMonthInt].ALLMEMBERS ) } ON ROWS   FROM ( SELECT ( { [Payment].[PaymentStatus].&amp;[Paid] } ) ON COLUMNS   FROM ( SELECT ( { [Payment].[VENDGROUP].&amp;[GIGCompany], [Payment].[VENDGROUP].&amp;[Domestic] } ) ON COLUMNS   FROM ( SELECT ( { [PaymentDate].[PersianYearMonthInt].&amp;[140309] } ) ON COLUMNS   FROM [Perspective])))   WHERE ( [Payment].[VENDGROUP].CurrentMember, [Payment].[PaymentStatus].&amp;[Paid] )</DTS:VariableValue>
    </DTS:Variable>
