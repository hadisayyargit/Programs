                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @myDate date
SET @myDate =?;
--'2024-11-20';
--'2024-10-20';
--'2024-10-20';
WITH lasthokm as
(
SELECT distinct 
  Ahkamid,
  DistrictID,
  [HozeID],
  DepID
  FROM [HR].[vw_PersonelDoreWithLastHokm]
)
,TasviyeData as
(
SELECT 
[DarkhastID],
DATEDIFF(day,[EndDateMiladi],IIf([PardakhtDateMiladi]&gt;@myDate,@myDate,isnull([PardakhtDateMiladi],@myDate))) as Duration 
  FROM [Hr].[TasviyeDarkhast] t
  left join lasthokm h on h.Ahkamid=t.LastHokmID
where IsPaused=0 and IsTasviyeSeystem=1
AND h.DepID&lt;&gt;'6707' AND T.SabegheDay IS NOT NULL
AND DarkhastDate IS NOT NULL
AND H.HozeID=1--پرسنل فروشگاهی

)
select avg(Duration) as AVGDuration
from TasviyeData</property>
