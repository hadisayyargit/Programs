                            <component
                              refId="Package\Extract\منابع انسانی\نرخ خروج پرسنل\نرخ خروج زیر ۶ماهـ غیرفعال\G1724_نرخ خروج زیر ۶ماه پرسنل فروشگاه_Extract_HCMKPI\HCMKPI1"
                              componentClassID="Microsoft.OLEDBSource"
                              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                              description="OLE DB Source"
                              name="HCMKPI1"
                              usesDispositions="true"
                              version="7">
                              <properties>
                                <property
                                  dataType="System.Int32"
                                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                                  name="CommandTimeout">0</property>
                                <property
                                  dataType="System.String"
                                  description="Specifies the name of the database object used to open a rowset."
                                  name="OpenRowset"></property>
                                <property
                                  dataType="System.String"
                                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                                  name="OpenRowsetVariable"></property>
                                <property
                                  dataType="System.String"
                                  description="The SQL command to be executed."
                                  name="SqlCommand"
                                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as
(
select k1.* , dep.DepartmentName , dep.DepActivityTypeSN, dep.HRM_DIM_DistrictRef, dep.DepTypeSN, dep.RegionSubSN
,datediff(month,d1.GregorianDate,d2.GregorianDate) as hireddurationmonth
 from (  select startDate As PersianHireDate, EndDate As PersianEndDate, PersonnelId,UnactivityType as EndType,DepId , Left(startdate,6) as HireYearMonth
 , IIF(enddate is null,150001, Left(enddate,6)) As EndYearMonth, PersianYearMonth
 from OKDWH_STG.Extract.HCMCommandment) k1
 left join OKDWH.hrm.DIM_Department dep on dep.ID=k1.DepId
 left join OKDWH.COM.DIM_Date d1 on d1.PersianInt=k1.PersianHireDate
 left join OKDWH.COM.DIM_Date d2 on d2.PersianInt=k1.PersianEndDate
  where 
	          dep.DepTypeSN=2    --and DepTypeDS='فروشگاه' 
         and dep.DepActivityTypeSN in (3)   -- فروشگاه عادي

  )
  , cte2 as

  (select count(PersonnelId) as count1
  , ( select count(PersonnelId)  from cte1 where cte1.EndType=0 ) as activecount
  , ( select count(PersonnelId)  from cte1 where cte1.EndType&lt;&gt;0 and cte1.EndYearMonth=?)  as unactivecount
  , ( select count(PersonnelId)  from cte1 where cte1.EndType not in (0,3,5,6,9,10) and cte1.EndYearMonth=?) as unactivecount2  --cte1.UnActiveDSC &lt;&gt; 'انتقال'
   , ( select count(PersonnelId)  from cte1 where cte1.HireYearMonth=? ) as hirecount
   , ( select count(PersonnelId)  from cte1 where cte1.EndType not in (0,5,10) and cte1.EndYearMonth=? and hireddurationmonth&lt;=6 ) as unactivecount3
  from cte1 )


  select iif((count1-unactivecount)*2+unactivecount-hirecount=0,0, (100.0*unactivecount3)/(((count1-unactivecount)*2+unactivecount-hirecount)*0.5)) as actualvalue from cte2</property>
