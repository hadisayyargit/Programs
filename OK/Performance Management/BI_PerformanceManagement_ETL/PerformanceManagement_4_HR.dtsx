                                  dataType="System.String"
                                  description="The SQL command to be executed."
                                  name="SqlCommand"
                                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select LEFT(replace(WP.EDate,'/',''), 6) YM ,T1.WPID,T1.Used,T2.Remained,T1.Quota,T1.Used*100.0/(T2.Remained + T1.Quota) AS PercentOfVacationTimeUsed
from ##TempResults T1 LEFT JOIN ##TempResults2 T2 on T1.WPID = T2.WPID
                     LEFT JOIN [Att].[WorkPeriod] WP on T1.WPID = WP.WorkPeriodID
					 where LEFT(replace(WP.EDate,'/',''), 6)=?</property>
