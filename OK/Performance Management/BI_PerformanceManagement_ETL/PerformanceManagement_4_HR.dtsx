                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX_1714] =&quot; SELECT NON EMPTY { [Measures].[تعداد نفر پیشنهادی], [Measures].[تعداد پرسنل واقعی]} ON COLUMNS , NON EMPTY { ([Fact_HRContradiction].[YearMonth].[YearMonth].ALLMEMBERS  ) } ON ROWS &#xA;FROM ( SELECT ( { [DIM_InventLocation].[TypeID].&amp;[1] } ) ON COLUMNS  FROM ( SELECT ( { [Fact_HRContradiction].[YearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS  FROM [Model]))  &quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
