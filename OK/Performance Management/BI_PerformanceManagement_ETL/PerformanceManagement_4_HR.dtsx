                      SQLTask:SqlStatementSource="declare @BeginDate date,@EndDate date&#xA;set @EndDate=?&#xA;set @BeginDate=DATEADD(MONTH, -1, @EndDate)&#xA;select FORMAT(@BeginDate,'yyyy/MM/21','fa-IR') as persianbegindate, FORMAT(@EndDate,'yyyy/MM/20','fa-IR') as persianenddate"
