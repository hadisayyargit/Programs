                      DTS:refId="Package\Extract\منابع انسانی\مرخصی استفاده شده\G1705_مرخصی استفاده شده\Framework_temp"
                      DTS:CreationName="Microsoft.ExecuteSQLTask"
                      DTS:Description="Execute SQL Task"
                      DTS:DTSID="{5bacc17a-f009-440d-9010-8827ec7f97f6}"
                      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                      DTS:LocaleID="-1"
                      DTS:ObjectName="Framework_temp"
                      DTS:ThreadHint="0">
                      <DTS:Variables />
                      <DTS:ObjectData>
                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{8321CC4A-FC58-48F1-9ECA-ACD52769010A}"
                          SQLTask:SqlStatementSource="drop table if exists ##TempResults&#xA;CREATE TABLE ##TempResults (WPID INT,Quota FLOAT,Used FLOAT);  &#xA;&#xA;WITH CTE_Sums AS (  &#xA;SELECT   &#xA;&#x9;left(wp.EDate,4) as Year, WPID,  &#xA;&#x9;SUM(CASE WHEN Code = 12601 THEN Value ELSE 0 END) AS Sum_12601,  &#xA;&#x9;SUM(CASE WHEN Code = 14157 THEN Value ELSE 0 END) AS Sum_14157  &#xA;FROM [Framework].[Att].[WPResult] W1 LEFT JOIN [Att].[WorkPeriod] WP ON WP.WorkPeriodID = W1.WPID&#x9;&#xA;where w1.WPID &gt;= 61  &#xA;GROUP BY left(wp.EDate,4), WPID),  &#xA;CTE_Cumulative AS (  &#xA;SELECT  &#xA;&#x9;WPID,  &#xA;&#x9;SUM(Sum_12601) OVER (PARTITION BY Year ORDER BY WPID) AS Quota,  &#xA;&#x9;SUM(Sum_14157) OVER (PARTITION BY Year ORDER BY WPID) AS Used  &#xA;FROM CTE_Sums  &#xA;)  &#xA;--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.&#xA;INSERT INTO ##TempResults (WPID, Quota, Used)  &#xA;SELECT WPID,Quota,Used   &#xA;FROM CTE_Cumulative;  &#xA;--SELECT * FROM ##TempResults; &#xA;--------------------------------------------------------------------------------&#xA;drop table if exists ##TempResults2&#xA;CREATE TABLE ##TempResults2 (WPID INT,Remained FLOAT); &#xA; &#xA;with FirstTable AS (&#xA;select LEFT(WP.EDate, 4) Year,W.WPID, sum(Value) Remained&#xA;FROM [Framework].[Att].[WPResult] W LEFT JOIN [Att].[WorkPeriod] WP ON WP.WorkPeriodID = W.WPID and code = 12605 &#xA;where LEFT(WP.EDate, 4) &gt;= 1401&#xA;group by LEFT(WP.EDate, 4), W.WPID&#xA;),&#xA;SecondTable AS (&#xA;select T1.Year ,T1.WPID ,(select MAX(WPID) from FirstTable T2 where T1.Year - 1 = T2.Year) PreviousWPID&#xA;from FirstTable T1),&#xA;ThirdTable AS(&#xA;select S.WPID,T.Remained&#xA;from FirstTable T left join SecondTable S on T.WPID = S.PreviousWPID --and S.PreviousWPID is not null&#xA;where S.PreviousWPID is not null and S.WPID &gt;= 61)&#xA;--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.--.&#xA;INSERT INTO ##TempResults2 (WPID, Remained)  &#xA;SELECT WPID, Remained  &#xA;FROM ThirdTable;  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                          <SQLTask:ParameterBinding
                            SQLTask:ParameterName="0"
                            SQLTask:DtsVariableName="User::v_YearMonth1"
                            SQLTask:ParameterDirection="Input"
                            SQLTask:DataType="3"
                            SQLTask:ParameterSize="-1" />
                        </SQLTask:SqlTaskData>
                      </DTS:ObjectData>
