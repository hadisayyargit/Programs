                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select w1.PersonelId,w1.WPID, cast(w1.Code as nvarchar(5)) as code,w1.Value, w1.WpResultID, G.PersonelID as GIGPersonnelId
