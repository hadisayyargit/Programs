                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select GOALCODE, YEARMONTH,sum(a.actualvalue)/10000000000.0 as final  from 
 (select k1.GOALCODE, k1.YEARMONTH, k1.ACTUALVALUE  from Extract.hcmkpi1 k1
 inner join  OKDWH_STG.Extract.HCMCommandment c on c.PersonnelId=k1.PersonnelId
 where 
 c.jobid in (2370,363,2476,4084,787,786,3620,3727,362,3766,359,357,362,3767) 
 ) A
 Group by GOALCODE, YEARMONTH</property>
