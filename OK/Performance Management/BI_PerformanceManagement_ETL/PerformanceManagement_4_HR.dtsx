                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as
 (
select k1.GOALCODE, k1.PersianDateStr1, k1.YEARMONTH, k1.ACTUALVALUE, k1.PersonnelId, k1.kind_code, k1.DepId
, c.JobId 
from extract.hcmkpi1 k1
inner join  Extract.HCMCommandment c on c.PersonnelId=k1.PersonnelId
inner join OKDWH.hrm.DIM_Department dep on dep.ID=c.DepId
 where 
 k1.kind_code in  ('10103','11101') 
and dep.HRM_DIM_DistrictRef=4   --DistrictName='ستاد مرکزي'  
        and  dep.DepTypeSN=1    --and DepTypeDS='ستاد' 
		) 
 ,cte2 as
 (
select k1.PersonnelId from extract.hcmkpi1 k1
inner join  Extract.HCMCommandment c on c.PersonnelId=k1.PersonnelId
inner join OKDWH.hrm.DIM_Department dep on dep.ID=c.DepId
 where 
dep.HRM_DIM_DistrictRef=4   --DistrictName='ستاد مرکزي'  
        and  dep.DepTypeSN=1    --and DepTypeDS='ستاد' 
 ) 

 select   sum(ACTUALVALUE) / (60*(select count(distinct PersonnelId) from cte2 ))  as final 
 from cte1</property>
