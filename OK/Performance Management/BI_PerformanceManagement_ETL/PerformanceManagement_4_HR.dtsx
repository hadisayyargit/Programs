          DTS:DTSID="{c73df125-f60d-4e61-bbba-f69c62538ed7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Delete hrm_Fact_HR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADFCA076-715F-46AB-9546-C33952DB0B1F}"
              SQLTask:SqlStatementSource="DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL &#xA;INNER JOIN     COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;INNER JOIN     COM.DIM_Date AS d2 ON d2.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_EndDateRef &#xA;WHERE       &#xA;-- overview  in   ('G10','G21','G27','G28','G51','G1701','G1702','G1703','G1704','G1705','G1714','G1715','G1716','G1717','G1718','G1719','G1720','G1721','G1722','G1723','G1724','G1730','G1731','G1732','G1733','G1734','G1735','G1740','G1741','G1742','G1743','G1744','G1748','G1749','G1750','G1751','G1778','G1779')&#xA;  overview in ('G1780','G1781')&#xA; and d1.PersianYearMonthInt&lt;=? and d2.PersianYearMonthInt&gt;=?" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::v_YearMonth1"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::v_YearMonth1"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
