                <DTS:Executable
                  DTS:refId="Package\Extract\منابع انسانی\درصد رعایت آف هفتگی فروشگاهـانبار\Framework_temp"
                  DTS:CreationName="Microsoft.ExecuteSQLTask"
                  DTS:Description="Execute SQL Task"
                  DTS:DisableEventHandlers="True"
                  DTS:DTSID="{7fae3c71-2023-429f-9b65-aac723df049a}"
                  DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="Framework_temp"
                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{8321CC4A-FC58-48F1-9ECA-ACD52769010A}"
                      SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #temp1&#xA;DROP TABLE IF EXISTS #temp2&#xA;DROP TABLE IF EXISTS ##tempDailyResult2&#xA;declare @doreh varchar(10)=?&#xA;&#xA;&#xA;&#xA;select r.personelid as kasraPersonnelId,cast( r.date as nvarchar(10))  as date, r.value, r.code,  left(REPLACE(r.date, '/',''),6)  as yearmonth&#xA;,  p.CodeMask as personnelid,concat(date, CodeMask) as datecodemask&#xA;into #temp1&#xA;  from att.DailyResult r with(nolock)&#xA;  inner join prs.Person p on p.ID=r.personelid&#xA;WHERE  &#xA;  left(REPLACE(r.date, '/',''),6) = @doreh&#xA;and r.Code in ( '14021')&#xA;&#xA;&#xA;SELECT concat(date, CodeMask) AS PersonelIDDate&#xA;into #temp2&#xA;FROM  [Att].[PairedAttendnce]  A with(nolock)&#xA;INNER JOIN [Framework].[Prs].[Person] PE ON PE.ID = A.PersonelID&#xA;where left(REPLACE(a.date, '/',''),6) =@doreh&#xA;--WHERE CodeMask = 7046&#xA;UNION&#xA;SELECT concat(date, CodeMask) AS PersonelIDDate&#xA;FROM [Att].[DailyResult] A with(nolock)&#xA;INNER JOIN [Framework].[Prs].[Person] PE ON PE.ID = A.PersonelID&#xA;where left(REPLACE(a.date, '/',''),6) = @doreh&#xA;AND A.CODE IN (11032, 11031,11021, 11022, 20451) &#xA;&#xA;&#xA;&#xA;&#xA;select #temp1.* &#xA;Into ##tempDailyResult2&#xA;from #temp1&#xA;left join #temp2 on #temp2.PersonelIDDate=#temp1.datecodemask&#xA;where #temp2.PersonelIDDate is not null&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                      <SQLTask:ParameterBinding
                        SQLTask:ParameterName="0"
                        SQLTask:DtsVariableName="User::v_YearMonth1"
                        SQLTask:ParameterDirection="Input"
                        SQLTask:DataType="3"
                        SQLTask:ParameterSize="-1" />
                    </SQLTask:SqlTaskData>
                  </DTS:ObjectData>
                </DTS:Executable>
