                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as
(
 select k1.YEARMONTH, k1.PersianDateStr1, k1.ACTUALVALUE, k1.PersonnelId, k1.kind_code , c.JobId as c_jobid, p.HRM_DIM_PostJobRef
 from OKDWH_STG.Extract.hcmkpi1 k1
 right join   OKDWH.hrm.DIM_Personnel  p on p.ID= k1.PersonnelId and p.HRM_DIM_PostJobRef in (357,359,362,3766,3767 )
 inner join Extract.HCMCommandment   c on c.PersonnelId=k1.PersonnelId and  c.JobId in (357,359,362,3766,3767 )
 --inner join OKDWH.hrm.hcmjob j on j.jobid=p.HRM_DIM_PostJobRef
 where  
 
  (Isnull(c.EndDate/100, 150001)&lt;&gt;140309) or  c.EndDate is null 
 
  )
  , cte2 as 
  (
  select  count(distinct c.personnelid) as countofAll from Extract.HCMCommandment  c where  c.JobId in (357,359,362,3766,3767 )
  )

  select 100.0-(100.0*count(distinct cte1.personnelid) / (select countofAll from cte2)) as ratio
  from cte1</property>
