                        <component
                          refId="Package\Extract\منابع انسانی\مرخصی استفاده شده\G1745_مرخصی استفاده شده_ستاد مناطق\Extract_HCMWPResult"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="Extract_HCMWPResult"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with CTE_WPRESULT_SETAD AS 
(
select  w.*, c.StartDate,c.EndDate from   Extract.HCMWPResult w
inner join Extract.HCMCommandment c on c.PersonnelId=w.GIGPersonnelId
 inner join OKDWH.hrm.DIM_Department dep on dep.ID=c.DepId
where (  dep.HRM_DIM_DistrictRef&lt;&gt;4    and  dep.DepTypeSN=1   ) OR (  dep.HRM_DIM_DistrictRef=37    and  dep.DepTypeSN=3  and  dep.RegionSubSN=3 ) 
--ستاد مناطق
)

, CTE_Sums AS (  
SELECT   
	left(wp.EDate,4) as Year, WPID,  
	SUM(CASE WHEN WpCode = 12601 THEN WpValue ELSE 0 END) AS Sum_12601,  
	SUM(CASE WHEN WpCode = 14157 THEN WpValue ELSE 0 END) AS Sum_14157  
FROM CTE_WPRESULT_SETAD W1 
LEFT JOIN Extract.HCMWorkPeriod WP ON WP.WorkPeriodID = W1.WPID	
where w1.WPID &gt;= 61  
GROUP BY left(wp.EDate,4), WPID)  
,CTE_Cumulative AS (  
SELECT  
	WPID,  
	SUM(Sum_12601) OVER (PARTITION BY Year ORDER BY WPID) AS Quota,  
	SUM(Sum_14157) OVER (PARTITION BY Year ORDER BY WPID) AS Used  
FROM CTE_Sums  
)  

, FirstTable AS (
select LEFT(WP.EDate, 4) Year,W.WPID, sum(WpValue) Remained
FROM CTE_WPRESULT_SETAD W 
LEFT JOIN Extract.HCMWorkPeriod WP ON WP.WorkPeriodID = W.WPID and WpCode = 12605 
where LEFT(WP.EDate, 4) &gt;= 1401
group by LEFT(WP.EDate, 4), W.WPID
)

,SecondTable AS (
select T1.Year ,T1.WPID ,(select MAX(WPID) from FirstTable T2 where T1.Year - 1 = T2.Year) PreviousWPID
from FirstTable T1)

,ThirdTable AS(
select S.WPID,T.Remained
from FirstTable T left join SecondTable S on T.WPID = S.PreviousWPID --and S.PreviousWPID is not null
where S.PreviousWPID is not null and S.WPID &gt;= 61)



select LEFT(replace(WP.EDate,'/',''), 6) YM ,T1.WPID,T1.Used,T2.Remained,T1.Quota,T1.Used*100.0/(T2.Remained + T1.Quota) AS PercentOfVacationTimeUsed
from CTE_Cumulative T1 
LEFT JOIN ThirdTable T2 on T1.WPID = T2.WPID
LEFT JOIN Extract.HCMWorkPeriod  WP on T1.WPID = WP.WorkPeriodID
					 where LEFT(replace(WP.EDate,'/',''), 6)=?</property>
