                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
      [personelid]
      ,[SHdate]
,  concat('14',SHdate) as yearmonth 
	 -- ,FORMAT(CONVERT(DECIMAL(10,0),MazRiyalMah)*IIF(M.IsMazaya=0,-1,1),'#,#') AS MazRiyalMahE
	  ,CONVERT(DECIMAL(10,0),MazRiyalMah)*IIF(M.IsMazaya=0,-1,1) AS MazRiyalMahE
FROM [Personnel].[dbo].[StoreHoghogh] H INNER JOIN [Personnel].[dbo].[Mazaya] M ON H.Mazayaid = M.Mazayaid
where   concat('14',SHdate) =? and M.Mazayaid = 17</property>
