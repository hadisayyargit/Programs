                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX_1704] =&quot; SELECT { [Measures].[سرانه حضور واقعی] } ON COLUMNS&#xA;, NON EMPTY { ([Fact_HRContradiction].[YearMonth].[YearMonth].ALLMEMBERS * [DIM_InventLocation].[BKInventLocationId].[BKInventLocationId].ALLMEMBERS ) } ON ROWS &#xA;FROM ( SELECT ( { [DIM_InventLocation].[TypeID].&amp;[1] } ) ON COLUMNS &#xA;&#xA;FROM ( SELECT ( { [Fact_HRContradiction].[YearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS FROM [Model])) &quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
