                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as
(
 select k1.YEARMONTH, k1.PersianDateStr1, k1.ACTUALVALUE, k1.PersonnelId, k1.kind_code , dep.DepTypeSN
 from OKDWH_STG.Extract.hcmkpi1 k1
  inner join Extract.HCMCommandment   c on c.PersonnelId=k1.PersonnelId 
 inner join OKDWH.HRM.DIM_Department dep on dep.ID=c.DepId 
 right join   OKDWH.hrm.DIM_Personnel  p on p.ID= k1.PersonnelId 

 where  
 
  (Isnull(c.EndDate/100, 150001)&lt;&gt;140309) or  c.EndDate is null 
 
  )
  , cte2 as 
  (
  select  count(distinct c.personnelid) as countofAll from Extract.HCMCommandment  c 
   inner join OKDWH.HRM.DIM_Department dep on dep.ID=c.DepId 
   
  )

  select 100.0-(100.0*count(distinct cte1.personnelid) / (select countofAll from cte2)) as ratio
  from cte1</property>
