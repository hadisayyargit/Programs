                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select KPINAME ,u.startdate, u.Actualvalue, FORMAT(cast(u.startdate as date),'yyyyMM','fa-IR') as yearmonth, g.OVERVIEW
from Extract.HCMKPIICT t
CROSS APPLY(VALUES( N'2025-01-11',MONTH1)
                  ,(N'2025-02-11',month2)
                  ,(N'2025-03-11',month3)
				  ,(N'2025-04-11',MONTH4)
				  ,(N'2025-05-11',MONTH5)
				  ,(N'2025-06-11',MONTH6)
				  ,(N'2025-07-11',month7)
				  ,(N'2025-08-11',month8)
				  ,(N'2025-09-11',month9)
				  ,(N'2025-10-11',MONTH10)
				  ,(N'2024-11-11',MONTH11)
				  ,(N'2024-12-11',MONTH12)
							  ) u(startdate,Actualvalue)
inner join ( select distinct OVERVIEW, DESCRIPTION
from OKDWH.hrm.Fact_HCMGOAL  with(nolock))  g on g.DESCRIPTION =t.KPINAME</property>
