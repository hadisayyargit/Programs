              SQLTask:SqlStatementSource="&#xA;DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL INNER JOIN&#xA;                         COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;WHERE        (d1.PersianYearMonthInt =? and overview&#xA; in  ('G1101','G1102','G1103','G1104','G1106','G1107','G1108','G1110','G1111','G1114','G1115','G1116','G1117','G1118','G1119')&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
