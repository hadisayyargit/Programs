                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX20012006] =&quot;   SELECT NON EMPTY { [Measures].[Budget Weight V1], [Measures].[Budget QTY V1], [Measures].[Budget QTY Vendor], [Measures].[Budget Weight Vendor] } ON COLUMNS&#xA;   , NON EMPTY { ([Item].[ItemId].[ItemId].ALLMEMBERS ) }  ON ROWS &#xA;   FROM ( SELECT ( -{ [Item].[Level1].&amp;[OPSS] } ) ON COLUMNS &#xA;   FROM ( SELECT ( -{ [Item].[Level4].&amp;[برنج پاکستانی], [Item].[Level4].&amp;[برنج تایلندی], [Item].[Level4].&amp;[برنج هندی], [Item].[Level4].&amp;[شکر], [Item].[Level4].&amp;[قند], [Item].[Level4].&amp;[سیگارت سایز باریک], [Item].[Level4].&amp;[سیگارت سایز بسیار باریک], [Item].[Level4].&amp;[سیگارت سایز پایه کوتاه], [Item].[Level4].&amp;[سیگارت سایز فشرده], [Item].[Level4].&amp;[سیگارت سایز متوسط], [Item].[Level4].&amp;[سیگارت سایز معمولی] } ) ON COLUMNS &#xA;   &#xA;   FROM [OKDWH]))&#xA;   WHERE ( [Budget].[HasBudget].&amp;[1], [Date].[Gregorian Date].&amp;[&quot;+ @[User::v_BeginDate] +&quot;T00:00:00] )  &quot;" />
                  </DTS:ObjectData>
