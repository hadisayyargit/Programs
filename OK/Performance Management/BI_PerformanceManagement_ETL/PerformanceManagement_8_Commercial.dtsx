                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select count(distinct i.name) as final 
from SCM.Fact_ItemCoverage_Archive c with(nolock)
inner join com.DIM_Date d with(nolock) on d.id=c.COM_DIM_DateRef_ModifiedDateKey
inner join com.DIM_Item i with(nolock) on i.id=c.COM_DIM_ItemRef
inner join COM.DIM_InventLocation l with(nolock) on l.id=c.COM_DIM_InventLocationRef
inner join [SCM].[DIM_ItemCoverageGroup] cg with(nolock) on cg.ID=c.SCM_DIM_ItemCoverageGroupRef

where d.PersianYearMonthInt=?
and i.CodeLevel1 in (1, 2, 3,5,6,7,9,11)
and l.TypeName in ('انبار فریزری','انبار خشک','انبار سرد','انبار ترانزیت','انبار نامشخص')
and cg.name in ('spot','spotd')
and c.CovRule=0</property>
                        <property
