                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as (
select YEARMONTH,Barcode,BudgetQTYV1,BudgetWeightV1, BudgetQTYVendor, BudgetWeightVendor
from OKDWH_STG.Extract.HCMKPI1 where BudgetWeightV1&gt;=0 and BudgetWeightVendor&gt;=0)
, cte2 as (select YEARMONTH,Barcode,BudgetQTYV1,BudgetWeightV1, BudgetQTYVendor, BudgetWeightVendor
from cte1 where BudgetWeightV1*0.95&lt;=BudgetWeightVendor
)
,cte3 as (
select YEARMONTH,count(barcode) as count1, (select count(barcode)  from cte2) as count2
from cte1 group by YEARMONTH
)
select YEARMONTH,cast ('G2001' as nvarchar(6)) as goalcode,count2*100.0/count1 as countRatio from cte3</property>
