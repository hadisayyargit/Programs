              SQLTask:SqlStatementSource="&#xA;DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL INNER JOIN&#xA;                         COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;WHERE        (d1.PersianYearMonthInt =? and overview&#xA; in  ('G6','G37','G18','G34','G35','G2000','G2001','G2002','G2003','G2004','G2005','G2006','G2007','G2008','G2009','G2010', 'G2011','G2012','G2013','G2014','G2015','G2016','G2017', 'G2019')&#xA;--   in ('G18','G34','G35','G2010',  'G2011','G2012','G2013','G2014','G2015','G2019')&#xA;&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
