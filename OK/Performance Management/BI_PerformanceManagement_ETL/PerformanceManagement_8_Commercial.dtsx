                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX2002]=&quot;SELECT { [Measures].[Item Total Amount] } ON COLUMNS&#xA; ,  { ([Tab_Rebate].[Rebate_Status].[Rebate_Status].ALLMEMBERS * [Tab_Rebate].[YearMonth].[YearMonth].ALLMEMBERS ) } ON ROWS &#xA; FROM ( SELECT ( { [Tab_Rebate].[YearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA; FROM [Model]) &quot;" />
                  </DTS:ObjectData>
