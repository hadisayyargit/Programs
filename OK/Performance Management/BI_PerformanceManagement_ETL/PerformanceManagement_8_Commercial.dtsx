                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as (
select GOALCODE,YEARMONTH,level4, CumulativePOWeight, CumulativeReceivedWeight, CumulativeBudgetWeightV1
,iif(CumulativeBudgetWeightV1&lt;CumulativePOWeight,CumulativeBudgetWeightV1,CumulativePOWeight) as c1
from OKDWH_STG.Extract.HCMKPI1 where CumulativeBudgetWeightV1&gt;0
)
, cte2 as (select *,100*CumulativeReceivedWeight/ c1 as c2,iif(100*CumulativeReceivedWeight/ c1&gt;=90,1,0) as c3 from cte1 where c1&gt;0 )
, cte3 as (select goalcode,yearmonth,sum(c3) as c4 from cte2  group by  goalcode,yearmonth)
select cte3.GOALCODE, cte3.YEARMONTH,100.0* cte3.c4/ (select count(*) from cte1) as final from cte3</property>
