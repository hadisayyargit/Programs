    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{15516216-D6EF-4CE3-9AE6-496A7A98CA11}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX20012006">
      <DTS:VariableValue
        DTS:DataType="8">SELECT NON EMPTY { [Measures].[Budget Weight V1], [Measures].[Budget QTY V1], [Measures].[Budget QTY Vendor], [Measures].[Budget Weight Vendor] } ON COLUMNS   , NON EMPTY { ([Item].[ItemId].[ItemId].ALLMEMBERS ) } ON ROWS    FROM ( SELECT ( -{ [Item].[Level1].&amp;[OPSS] } ) ON COLUMNS    FROM ( SELECT ( -{ [Item].[Level4].&amp;[برنج پاکستانی], [Item].[Level4].&amp;[برنج تایلندی], [Item].[Level4].&amp;[برنج هندی], [Item].[Level4].&amp;[شکر], [Item].[Level4].&amp;[قند], [Item].[Level4].&amp;[سیگارت سایز باریک], [Item].[Level4].&amp;[سیگارت سایز بسیار باریک], [Item].[Level4].&amp;[سیگارت سایز پایه کوتاه], [Item].[Level4].&amp;[سیگارت سایز فشرده], [Item].[Level4].&amp;[سیگارت سایز متوسط], [Item].[Level4].&amp;[سیگارت سایز معمولی] } ) ON COLUMNS      FROM [OKDWH]))   WHERE ( [Budget].[HasBudget].&amp;[1], [Date].[PersianYearMonth].&amp;[140309], [Date].[Last Day].&amp;[True] )</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{4402455A-587E-4C0D-B7A3-4C425790336B}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX2002">
      <DTS:VariableValue
        DTS:DataType="8">SELECT { [Measures].[Item Total Amount] } ON COLUMNS , { ([Tab_Rebate].[Rebate_Status].[Rebate_Status].ALLMEMBERS * [Tab_Rebate].[YearMonth].[YearMonth].ALLMEMBERS ) } ON ROWS FROM ( SELECT ( { [Tab_Rebate].[YearMonth].&amp;[140303] } ) ON COLUMNS  FROM [Model])</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D24AECC2-7FC6-4B92-9106-5A7800F79DC1}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX2005">
      <DTS:VariableValue
        DTS:DataType="8">SELECT { [Measures].[Cumulative PO Weight], [Measures].[Cumulative Received Weight], [Measures].[Budget Weight V1] } ON COLUMNS  , { ([Date].[PersianYearMonth].[PersianYearMonth].ALLMEMBERS * [Item].[Level4].[Level4].ALLMEMBERS ) } ON ROWS    FROM ( SELECT ( { [Date].[PersianYearMonth].&amp;[140303] } ) ON COLUMNS   FROM [OKDWH])  WHERE ( [Date].[PersianInt].&amp;[14030331] )</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
