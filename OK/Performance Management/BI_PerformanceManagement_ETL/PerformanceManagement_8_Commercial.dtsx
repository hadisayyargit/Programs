                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX2005]=&quot;SELECT { [Measures].[Cumulative PO Weight], [Measures].[Cumulative Received Weight], [Measures].[Budget Weight V1] } ON COLUMNS&#xA; , { ([Date].[PersianYearMonth].[PersianYearMonth].ALLMEMBERS * [Item].[Level4].[Level4].ALLMEMBERS ) } ON ROWS &#xA;  FROM ( SELECT ( { [Date].[PersianYearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA; FROM [OKDWH])&#xA; WHERE ( [Date].[PersianInt].&amp;[&quot;+ (DT_WSTR, 8) @[User::v_PersianEndDate] +&quot;] ) &quot;" />
                  </DTS:ObjectData>
