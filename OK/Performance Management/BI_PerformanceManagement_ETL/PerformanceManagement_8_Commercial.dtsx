                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select d.PersianYearMonthInt, 100*(sum(t.MarginAmount)/sum(t.Grossamount)+ sum(t.[DiscAmount])/sum(t.Grossamount) ) as netmargin
from 
  RTL.vw_Fact_SalesTrans AS t with(nolock)
  inner join com.DIM_Date d with(nolock) on d.ID=t.COM_DIM_Date_TransRef
  inner join com.DIM_Item i with(nolock) on i.ID=t.COM_DIM_ItemRef
 where 
   i.CodeLevel1 in (1, 2, 3,5,6,7,9,11)
   and d.PersianYearMonthInt=?
   group by d.PersianYearMonthInt</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable">User::v_MDX2004</property>
