                  refId="Package\Extract\HRM_Fact_HCMShelfLabelHistory\CMR_Fact_ShelfLableControl_New"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="CMR_Fact_ShelfLableControl_New"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @mydate date
set @mydate= getdate()-1
SELECT
InventLocationId,
isnull([StatusName_lastDate],'No Scan') as StatusName,
count(distinct LocationItem) As ShelfCount
,@mydate as Shelfdate
FROM [OKDWH].[CMR].[Fact_ShelfLableControl_New] sh with(nolock)
INNER join [OKDWH].[COM].[DIM_Item] i with(nolock) on sh.ItemId=i.BKItemId and i.CodeLevel1 not in (13,4,12)
inner join [OKDWH].[COM].[DIM_InventLocation] l with(nolock) on l.BKInventLocationId=sh.InventLocationId and l.DistrictCode IS NOT NULL and  l.DistrictCode not in (-1,37,4,42)
  where
  AvailablePhysical=1
  and
  InventLocationName NOT LIKE '%دارک استور%' and InventLocationName NOT LIKE '%امار%'
  and 
  PersianDate_EndLocation in ( '1478/10/11')
  and
  PersianDate_StartLocation not in ( '1478/10/11')
group by InventLocationId,isnull([StatusName_lastDate],'No Scan')</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
