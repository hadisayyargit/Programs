                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select d.PersianYearMonthInt,sum(amount) as sumofAmount from fin.Fact_ProfitLoss f with(nolock)
inner join com.DIM_Date d on d.id=f.COM_DIM_DateRef
inner join [FIN].[Dim_PLMainAccountGroups] g on g.id=f.FIN_DIM_MainAccountGroupRef
inner join OKDWH_STG.Extract.HCMProfitLossMainAccount m on m.ID=f.FIN_DIM_MainAccountRef
where d.PersianYearMonthInt=?
and g.ProfitLossGroupDS='هزينه هاي ثابت' 
and g.MainAccountGroupDS='ساير هزينه هاي ثابت' 
and m.NAME in(N'هزینه بازخرید خدمت')
group by d.PersianYearMonthInt</property>
