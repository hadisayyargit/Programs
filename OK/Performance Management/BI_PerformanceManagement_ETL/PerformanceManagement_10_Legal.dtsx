        <DTS:Executable
          DTS:refId="Package\Transform and Load\HRM_Fact_HCMGOAL"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{002B444B-8CE5-46AB-826C-CACDEECF97BF}"
          DTS:ExecutableType="Microsoft.Pipeline"
