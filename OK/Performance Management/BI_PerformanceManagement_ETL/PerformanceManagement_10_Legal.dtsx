                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select distinct h.*			, k.vision as vision1 , k.visionid, k.strategyid
			from Extract.hcmgoalheading h
			inner join Extract.HCMGOAL1 g on g.GOALHEADING=h.RECID
