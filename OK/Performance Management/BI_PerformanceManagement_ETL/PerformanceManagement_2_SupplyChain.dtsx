                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select m.GOALCODE,m.YEARMONTH,sum(a1)/sum(a2) as durabilityAmount
 from(
 select k1.GOALCODE,k1.DateInt, k1.YEARMONTH,k1.ACTUALVALUE as a1, k2.ACTUALVALUE as a2
 from OKDWH_STG.Extract.HCMKPI1 k1
 inner join OKDWH.com.DIM_Date d on d.ID=k1.DateInt
 inner join OKDWH_STG.Extract.HCMKPI2 k2  on k2.KPIDATE=d.GregorianDate
 where k1.GOALCODE='G7' and k1.ACTUALVALUE is not null
   and k2.GOALCODE='G7' and k2.ACTUALVALUE is not null
   ) M

   group by m.GOALCODE, m.YEARMONTH</property>
