                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT NON EMPTY {[Measures].[کفایت موجودی لحظه ای] } ON COLUMNS, NON EMPTY { ([Date].[YearMonth].[YearMonth].ALLMEMBERS ) }  ON ROWS 
FROM ( SELECT ( { [Date].[YearMonth].&amp;[140303] } ) ON COLUMNS 
FROM ( SELECT ( { [InventLocation].[IsActive].&amp;[1] } ) ON COLUMNS 
FROM ( SELECT ( { [EquipmentStatus].[Equipment Status].&amp;[فعال] } ) ON COLUMNS 
FROM ( SELECT ( { [CountingStatus].[Counting Status].&amp;[فعال] } ) ON COLUMNS 
FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS 
FROM [SLAStores])))) )
WHERE ( [Item].[Level1].CurrentMember, [CountingStatus].[Counting Status].&amp;[فعال], [EquipmentStatus].[Equipment Status].&amp;[فعال], [InventLocation].[IsActive].&amp;[1] )</property>
                            <property
