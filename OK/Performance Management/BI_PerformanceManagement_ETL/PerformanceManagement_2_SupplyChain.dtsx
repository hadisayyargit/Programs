                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX66]=&quot; SELECT { [Measures].[Cumulative PO Weight], [Measures].[Cumulative Budget Weight V2], [Measures].[Cumulative Received Weight] } ON COLUMNS, &#xA; { ([Date].[PersianYearMonth].[PersianYearMonth].ALLMEMBERS * [Item].[Level4].[Level4].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS &#xA; FROM ( SELECT ( -{ [Item].[Level3].&amp;[برنج خارجی], [Item].[Level3].&amp;[روغن جامد و نیمه جامد], [Item].[Level3].&amp;[روغن مایع], [Item].[Level3].&amp;[قند و شکر] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food],  [Item].[Level1].&amp;[LHH],  [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS &#xA; FROM ( SELECT ( { [Date].[PersianYearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA; FROM [OKDWH] )))  &#xA; WHERE ( [Item].[Level1].CurrentMember, [Budget].[HasBudget].&amp;[1] , [PO].[HasPO].&amp;[1], [Date].[Last Day].&amp;[True])  &quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
