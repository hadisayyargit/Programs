          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{FC3564CE-9429-49F9-8F10-4AF86F7C5D57}"
              SQLTask:SqlStatementSource="truncate table Extract.HCMGOAL&#xA;truncate table Extract.HCMGOAL1&#xA;truncate table Extract.HCMGOALHEADING&#xA;truncate table Extract.HCMMEASUREMENT&#xA;truncate table Extract.HCMKPI&#xA;truncate table Extract.HCMKPI1&#xA;truncate table Extract.HCMKPI2&#xA;truncate table Extract.HCMProfitLossMainAccount&#xA;truncate table Extract.HCMForecastdetails&#xA;truncate table Extract.HCMATP&#xA;truncate table Extract.HCMKPIINFO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
