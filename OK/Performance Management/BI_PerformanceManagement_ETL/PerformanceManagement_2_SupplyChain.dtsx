                <DTS:Executable
                  DTS:refId="Package\Extract\شاخصهای زنجیره تامین\Sequence Container\G1_Set Query"
                  DTS:CreationName="Microsoft.ExpressionTask"
                  DTS:Description="Expression Task"
                  DTS:DTSID="{41E6C27E-4ED5-45CC-BED2-95B15C698180}"
                  DTS:ExecutableType="Microsoft.ExpressionTask"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="G1_Set Query"
                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX1]=&quot; SELECT  { [Measures].[کیفیت موجودی] } ON COLUMNS,  { ([Date].[YearMonth].[YearMonth].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS FROM ( SELECT ( { [InventLocation].[IsDisabled].&amp;[False] } ) ON COLUMNS FROM ( SELECT ( { [InventLocation].[IsActive].&amp;[1] } ) ON COLUMNS FROM ( SELECT ( { [EquipmentStatus].[Equipment Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [CountingStatus].[Counting Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [Date].[YearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS FROM [SLAStores])))))) WHERE ( [CountingStatus].[Counting Status].&amp;[فعال], [EquipmentStatus].[Equipment Status].&amp;[فعال], [InventLocation].[IsActive].&amp;[1], [InventLocation].[IsDisabled].&amp;[False], [Item].[Level1].CurrentMember ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS&quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
                <DTS:Executable
                  DTS:refId="Package\Extract\شاخصهای زنجیره تامین\Sequence Container\G2_Set Query"
                  DTS:CreationName="Microsoft.ExpressionTask"
                  DTS:Description="Expression Task"
                  DTS:DTSID="{225006A3-9842-4B78-8589-310C7697BD21}"
                  DTS:ExecutableType="Microsoft.ExpressionTask"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="G2_Set Query"
                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX2]=&quot;SELECT  {[Measures].[کفایت موجودی لحظه ای] } as actual ON COLUMNS,  { ([Date].[YearMonth].[YearMonth].ALLMEMBERS ) }  ON ROWS FROM ( SELECT ( { [Date].[YearMonth].&amp;[&quot;+ @[User::v_YearMonth1]   +&quot;] } ) ON COLUMNS FROM ( SELECT ( { [InventLocation].[IsActive].&amp;[1] } ) ON COLUMNS FROM ( SELECT ( { [EquipmentStatus].[Equipment Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [CountingStatus].[Counting Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS FROM [SLAStores]))))) WHERE ( [Item].[Level1].CurrentMember, [CountingStatus].[Counting Status].&amp;[فعال], [EquipmentStatus].[Equipment Status].&amp;[فعال], [InventLocation].[IsActive].&amp;[1] ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS&quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
