                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX24]=&quot;SELECT  {[Measures].[تنوع کالاهای فعال] } ON COLUMNS,  { ([Date].[YearMonth].[YearMonth].ALLMEMBERS ) }  ON ROWS &#xA;FROM ( SELECT ( { [Date].[YearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS&#xA;FROM ( SELECT ( { [InventLocation].[IsActive].&amp;[1] } ) ON COLUMNS FROM ( SELECT ( { [EquipmentStatus].[Equipment Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [CountingStatus].[Counting Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS FROM [SLAStores]))))) WHERE ( [Item].[Level1].CurrentMember, [CountingStatus].[Counting Status].&amp;[فعال], [EquipmentStatus].[Equipment Status].&amp;[فعال], [InventLocation].[IsActive].&amp;[1] )&quot;" />
                  </DTS:ObjectData>
