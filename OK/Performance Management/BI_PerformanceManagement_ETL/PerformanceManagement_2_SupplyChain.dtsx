          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Extract\شاخصهای زنجیره تامین\G11_Set Query 1"
              DTS:CreationName="Microsoft.ExpressionTask"
              DTS:Description="Expression Task"
              DTS:DTSID="{18FCBAD9-30E6-4FA5-B684-2258A9E1B50E}"
              DTS:ExecutableType="Microsoft.ExpressionTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="G11_Set Query 1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <ExpressionTask
                  Expression="@[User::v_MDX11_1] =&quot;SELECT   {[Measures].[Item Location Count]  }   ON COLUMNS,  { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS &#xA;FROM ( SELECT ( { [Dim Coverage Code].[CoverageCode].&amp;[Period] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [DIM Invent Location].[Type Name].&amp;[انبار خشک] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [Dim Low Service Level].[Low Service Level].&amp;[0] } ) ON COLUMNS FROM ( SELECT ( { [Spot].[Spot].&amp;[0] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [DIM Item].[Level1].&amp;[Beverages], [DIM Item].[Level1].&amp;[DPH], [DIM Item].[Level1].&amp;[Dry Food], [DIM Item].[Level1].&amp;[Fresh Market], [DIM Item].[Level1].&amp;[LHH], [DIM Item].[Level1].&amp;[OPSS], [DIM Item].[Level1].&amp;[Textile], [DIM Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [DOI Status].[Status].&amp;[0] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA;FROM [DoiRobot])))))) )&#xA;WHERE ( [DOI Status].[Status].&amp;[0], [DIM Item].[Level1].CurrentMember, [Spot].[Spot].&amp;[0], [Dim Low Service Level].[Low Service Level].&amp;[0], [DIM Invent Location].[Type Name].&amp;[انبار خشک], [Dim Coverage Code].[CoverageCode].&amp;[Period] ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS&quot;" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Extract\شاخصهای زنجیره تامین\G11_Set Query 2"
              DTS:CreationName="Microsoft.ExpressionTask"
              DTS:Description="Expression Task"
              DTS:DTSID="{AEA82377-2142-4499-9A77-E7CF3BC1EBCD}"
              DTS:ExecutableType="Microsoft.ExpressionTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="G11_Set Query 2"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <ExpressionTask
                  Expression="@[User::v_MDX11_2]=&quot;SELECT  { [Measures].[Item Location Count] } ON COLUMNS,  { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [Dim Coverage Code].[CoverageCode].&amp;[Period] } ) ON COLUMNS FROM ( SELECT ( { [DIM Invent Location].[Type Name].&amp;[انبار خشک] } ) ON COLUMNS FROM ( SELECT ( { [Dim Low Service Level].[Low Service Level].&amp;[0] } ) ON COLUMNS FROM ( SELECT ( { [Spot].[Spot].&amp;[0] } ) ON COLUMNS FROM ( SELECT ( { [DIM Item].[Level1].&amp;[Beverages], [DIM Item].[Level1].&amp;[DPH], [DIM Item].[Level1].&amp;[Dry Food], [DIM Item].[Level1].&amp;[Fresh Market], [DIM Item].[Level1].&amp;[LHH], [DIM Item].[Level1].&amp;[OPSS], [DIM Item].[Level1].&amp;[Textile], [DIM Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [DOI Status].[Status].&amp;[1] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS &#xA;FROM [DoiRobot])))))) )&#xA;WHERE ( [DOI Status].[Status].&amp;[1], [DIM Item].[Level1].CurrentMember, [Spot].[Spot].&amp;[0], [Dim Low Service Level].[Low Service Level].&amp;[0], [DIM Invent Location].[Type Name].&amp;[انبار خشک], [Dim Coverage Code].[CoverageCode].&amp;[Period] ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS&quot;" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Extract\شاخصهای زنجیره تامین\G14_Set Query"
              DTS:CreationName="Microsoft.ExpressionTask"
              DTS:Description="Expression Task"
              DTS:DTSID="{73B606DE-AF97-4C3A-9E43-159E3DA5E832}"
              DTS:ExecutableType="Microsoft.ExpressionTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="G14_Set Query"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <ExpressionTask
                  Expression="@[User::v_MDX14]=&quot;SELECT  { [Measures].[نسبت موجودی اقلام راکد به موجودی فروشگاه] } ON COLUMNS,  { ([Date].[PersianYearMonth].[PersianYearMonth].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS &#xA;FROM ( SELECT ( { [Date].[PersianYearMonth].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS&#xA;FROM ( SELECT ( -{ [Date].[PersianDate].&amp;[14040224], [Date].[PersianDate].&amp;[14040116], [Date].[PersianDate].&amp;[14040107], [Date].[PersianDate].&amp;[14040108], [Date].[PersianDate].&amp;[14040109], [Date].[PersianDate].&amp;[14040110], [Date].[PersianDate].&amp;[14040111], [Date].[PersianDate].&amp;[14040112], [Date].[PersianDate].&amp;[14040113], [Date].[PersianDate].&amp;[14040114], [Date].[PersianDate].&amp;[14040115] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS &#xA;FROM ( SELECT ( { [Flag60].[Falg ID].&amp;[1] } ) ON COLUMNS FROM [OKDWH])))) &#xA;WHERE ( [Flag60].[Falg ID].&amp;[1], [Item].[Level1].CurrentMember )&quot;" />
              </DTS:ObjectData>
            </DTS:Executable>
