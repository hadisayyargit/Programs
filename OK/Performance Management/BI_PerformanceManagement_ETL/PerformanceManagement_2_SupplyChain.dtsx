                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX7_2] =&quot; SELECT { [Measures].[Weight QTY] } ON COLUMNS,  { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS * [DIM Date].[Gregorian Str].[Gregorian Str].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [DIM Item].[Code Level1].&amp;[1], [DIM Item].[Code Level1].&amp;[2], [DIM Item].[Code Level1].&amp;[11], [DIM Item].[Code Level1].&amp;[3], [DIM Item].[Code Level1].&amp;[5], [DIM Item].[Code Level1].&amp;[6], [DIM Item].[Code Level1].&amp;[7], [DIM Item].[Code Level1].&amp;[9] } ) ON COLUMNS FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS FROM [OKDWH_Retail_SalesTrans])) WHERE ( [DIM Item].[Code Level1].CurrentMember ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS&quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
