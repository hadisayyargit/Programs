FROM ( SELECT ( { [DOI Status].[Status].&amp;[0] } ) ON COLUMNS 
FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[140303] } ) ON COLUMNS 
FROM [DoiRobot])))))) )
WHERE ( [DOI Status].[Status].&amp;[0], [DIM Item].[Level1].CurrentMember, [Spot].[Spot].&amp;[0], [Dim Low Service Level].[Low Service Level].&amp;[0], [DIM Invent Location].[Type Name].&amp;[انبار خشک], [Dim Coverage Code].[CoverageCode].&amp;[Period] ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</property>
