                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as (
select *,iif(iif(CumulativePOWeight&lt;CumulativeBudgetWeightV2,CumulativePOWeight,CumulativeBudgetWeightV2)-CumulativeReceivedWeight&gt;0, iif(CumulativePOWeight&lt;CumulativeBudgetWeightV2,CumulativePOWeight,CumulativeBudgetWeightV2)-CumulativeReceivedWeight,0) as A
, iif(CumulativeReceivedWeight-CumulativeBudgetWeightV2&gt;0,CumulativeReceivedWeight-CumulativeBudgetWeightV2,0) as B
, iif(CumulativeBudgetWeightV2-CumulativePOWeight&gt;0,CumulativeBudgetWeightV2-CumulativePOWeight,0) as C

from OKDWH_STG.Extract.HCMKPI1
)
, cte2 as (select *,iif(C+B-A&gt;0,C+B-A,0) As D from cte1)
, cte3 as (select goalcode,yearmonth, (1-(sum(d)/sum(CumulativeBudgetWeightV2)))*100 as final from cte2 group by goalcode,yearmonth)


select * from cte3</property>
