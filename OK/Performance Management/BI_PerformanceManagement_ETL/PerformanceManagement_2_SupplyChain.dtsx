      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX11_1">
      <DTS:VariableValue
        DTS:DataType="8">SELECT  {[Measures].[Item Location Count]  }   ON COLUMNS, { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS  FROM ( SELECT ( { [Dim Coverage Code].[CoverageCode].&amp;[Period] } ) ON COLUMNS  FROM ( SELECT ( { [DIM Invent Location].[Type Name].&amp;[انبار خشک] } ) ON COLUMNS  FROM ( SELECT ( { [Dim Low Service Level].[Low Service Level].&amp;[0] } ) ON COLUMNS FROM ( SELECT ( { [Spot].[Spot].&amp;[0] } ) ON COLUMNS  FROM ( SELECT ( { [DIM Item].[Level1].&amp;[Beverages], [DIM Item].[Level1].&amp;[DPH], [DIM Item].[Level1].&amp;[Dry Food], [DIM Item].[Level1].&amp;[Fresh Market], [DIM Item].[Level1].&amp;[LHH], [DIM Item].[Level1].&amp;[OPSS], [DIM Item].[Level1].&amp;[Textile], [DIM Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS  FROM ( SELECT ( { [DOI Status].[Status].&amp;[0] } ) ON COLUMNS  FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[140303] } ) ON COLUMNS  FROM [DoiRobot])))))) ) WHERE ( [DOI Status].[Status].&amp;[0], [DIM Item].[Level1].CurrentMember, [Spot].[Spot].&amp;[0], [Dim Low Service Level].[Low Service Level].&amp;[0], [DIM Invent Location].[Type Name].&amp;[انبار خشک], [Dim Coverage Code].[CoverageCode].&amp;[Period] ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</DTS:VariableValue>
