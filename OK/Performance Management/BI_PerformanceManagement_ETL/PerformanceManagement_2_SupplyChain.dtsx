                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT NON EMPTY   {[Measures].[Item Location Count]  }   ON COLUMNS, NON EMPTY { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS 
FROM ( SELECT ( { [Dim Coverage Code].[CoverageCode].&amp;[Period] } ) ON COLUMNS 
FROM ( SELECT ( { [DIM Invent Location].[Type Name].&amp;[انبار خشک] } ) ON COLUMNS 
FROM ( SELECT ( { [Dim Low Service Level].[Low Service Level].&amp;[0] } ) ON COLUMNS FROM ( SELECT ( { [Spot].[Spot].&amp;[0] } ) ON COLUMNS 
