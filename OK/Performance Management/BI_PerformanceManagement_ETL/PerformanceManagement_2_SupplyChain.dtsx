      DTS:ObjectName="v_MDX1">
      <DTS:VariableValue
        DTS:DataType="8">SELECT  { [Measures].[کیفیت موجودی] } ON COLUMNS,  { ([Date].[YearMonth].[YearMonth].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food], [Item].[Level1].&amp;[Fresh Market], [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[OPSS], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS FROM ( SELECT ( { [InventLocation].[IsDisabled].&amp;[False] } ) ON COLUMNS FROM ( SELECT ( { [InventLocation].[IsActive].&amp;[1] } ) ON COLUMNS FROM ( SELECT ( { [EquipmentStatus].[Equipment Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [CountingStatus].[Counting Status].&amp;[فعال] } ) ON COLUMNS FROM ( SELECT ( { [Date].[YearMonth].&amp;[140301] } ) ON COLUMNS FROM [SLAStores])))))) WHERE ( [CountingStatus].[Counting Status].&amp;[فعال], [EquipmentStatus].[Equipment Status].&amp;[فعال], [InventLocation].[IsActive].&amp;[1], [InventLocation].[IsDisabled].&amp;[False], [Item].[Level1].CurrentMember ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
