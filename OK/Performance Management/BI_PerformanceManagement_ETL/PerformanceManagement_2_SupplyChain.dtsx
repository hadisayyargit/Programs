        <DTS:Executable
          DTS:refId="Package\HRM_Fact_HCMGOAL\HRM_Fact_HCMGOAL"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{27C0D7AB-6CF8-43D1-AC59-9E0A3A39597D}"
