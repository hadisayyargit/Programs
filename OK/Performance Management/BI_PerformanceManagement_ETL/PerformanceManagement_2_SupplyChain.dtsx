                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX7_1] =&quot;SELECT { [Measures].[Available Weight] } ON COLUMNS , { ([DIM Date].[Gregorian Date].[Gregorian Date].ALLMEMBERS * [DIM Date].[Year Month].[Year Month].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS  FROM ( SELECT ( { [DIM Date].[Year Month].&amp;[&quot;+@[User::v_YearMonth1]+&quot;] } ) ON COLUMNS FROM ( SELECT ( { [DIM Item].[Code Level1].&amp;[1], [DIM Item].[Code Level1].&amp;[2], [DIM Item].[Code Level1].&amp;[3], [DIM Item].[Code Level1].&amp;[5], [DIM Item].[Code Level1].&amp;[6], [DIM Item].[Code Level1].&amp;[7], [DIM Item].[Code Level1].&amp;[9], [DIM Item].[Code Level1].&amp;[11] } ) ON COLUMNS  FROM [OKDWH_InventTrend])) WHERE ([DIM Invent Status].[ID].&amp;[1], [DIM Item].[Code Level1].CurrentMember )&quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
