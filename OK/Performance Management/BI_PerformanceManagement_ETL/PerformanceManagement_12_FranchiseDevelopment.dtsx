                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">; with cte3 as
(
select * from Extract.HCMKPI3 
)
, cte4 as
(
select count(distinct cte3.COM_DIM_InventLocationRef )as countofActive ,(select  count(distinct cte3.COM_DIM_InventLocationRef) from cte3 where  cte3.InventLocationStatus='Inactive' and cte3.ClosureYearMonth=?) as countofInActive 
from cte3
where cte3.InventLocationStatus='Active'
and cte3.OpeningYearMonth=?
)
select cte4.countofActive-cte4.countofInActive as newactual from cte4</property>
