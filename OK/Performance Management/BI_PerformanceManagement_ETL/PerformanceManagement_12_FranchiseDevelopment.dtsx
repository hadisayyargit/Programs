                  <DTS:Variables />
                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX7001_Retail]  =&quot;SELECT  { [Measures].[Net Amount] } ON COLUMNS, { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS * [DIM Invent Location].[BK Invent Location Id].[BK Invent Location Id].ALLMEMBERS ) } ON ROWS  FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;]} ) ON COLUMNS FROM [OKDWH_Retail_SalesTrans]) &quot;" />
                  </DTS:ObjectData>
