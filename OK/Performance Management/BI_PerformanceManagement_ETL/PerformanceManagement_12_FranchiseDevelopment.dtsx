                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">; with cte3 as
(
select * from Extract.HCMKPI3 
where COM_DIM_DATE_OpeningRef&lt;=?
)
, 
cte1 as (select * from  Extract.HCMKPI1)
, cte4 as
(
select count(cte3.COM_DIM_InventLocationRef )as countofActive ,(select  count(cte3.COM_DIM_InventLocationRef) from cte3) as countoftotal from cte3
inner join cte1 on cte1.COM_DIM_InventLocationRef=cte3.COM_DIM_InventLocationRef
where cte3.InventLocationStatus='Active'
)
select iif(cte4.countoftotal=0,0,cte4.countofActive*100.0/cte4.countoftotal) as newactual from cte4</property>
