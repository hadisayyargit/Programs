                      name="Extract_HCMKPI_G7006"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as 
  (
  select a1.YEARMONTH, a1.GOALCODE, a1.COM_DIM_InventLocationRef,a1.ACTUALVALUE as profitAfterTax, a2.ACTUALVALUE as netamount,abs( a1.ACTUALVALUE*100.0 / a2.ACTUALVALUE) as profitlossratio
  from OKDWH_STG.Extract.HCMKPI1 a1 with(nolock)
  inner join  OKDWH_STG.Extract.HCMKPI2 a2 with(nolock) on a2.GOALCODE=a1.GOALCODE and a2.YEARMONTH=a1.YEARMONTH and a2.COM_DIM_InventLocationRef=a1.COM_DIM_InventLocationRef
  where --a1.BKInventLocationId='OKS00079'   and  
  abs(isnull(a1.ACTUALVALUE,0))&gt;0 and abs(isnull(a2.ACTUALVALUE,0))&gt;0 
  )
  select cte1.YEARMONTH,count(cte1.COM_DIM_InventLocationRef) as CountofStores from cte1
  where  cte1.profitlossratio&lt;=1
  group by YEARMONTH</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable">User::v_MDXQuery</property>
