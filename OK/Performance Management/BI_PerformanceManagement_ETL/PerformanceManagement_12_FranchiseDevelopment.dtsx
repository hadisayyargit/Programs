      <DTS:VariableValue
        DTS:DataType="8">SELECT  { [Measures].[Net Amount] } ON COLUMNS , { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS * [DIM Invent Location].[BK Invent Location Id].[BK Invent Location Id].ALLMEMBERS ) } ON ROWS  FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[140302] } ) ON COLUMNS  FROM [OKDWH_Retail_SalesTrans])</DTS:VariableValue>
