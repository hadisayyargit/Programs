                        <component
                          refId="Package\Extract\بازاریابی\G1014_هزینه مارکتینگ ستاد\G1014_هزینه مارکتینگ ستاد_Extract\G1014"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G1014"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select  PersianYearMonthInt,SUM(amount) Amount
from [OKDWH].[FIN].[Fact_ProfitLoss] f with(nolock)
inner join [OKDWH].[COM].[DIM_Date] d with(nolock) on d.id=f.COM_DIM_DateRef
inner join [OKDWH].[FIN].[DIM_MainAccount] m with(nolock) on m.ID=f.FIN_DIM_MainAccountRef
inner join [OKDWH].[FIN].[Dim_PLMainAccountGroups] g with(nolock) on g.id=f.FIN_DIM_MainAccountGroupRef
inner join [OKDWH].[FIN].[DIM_CostCenter] c with(nolock) on c.ID=f.FIN_DIM_CostCenterRef
inner join [OKDWH].[FIN].[Dim_BusinessUnit] u with(nolock) on u.id=f.FIN_DIM_BusinessUnitRef
where d.PersianYearMonthInt = ?
and c.mdCostCenterTypeDS in (N'ستاد',N'فروشگاه عادی') and c.districtcode=4
and f.FIN_DIM_MainAccountRef in (698,806,807,808,809,810,811,812,819) 
