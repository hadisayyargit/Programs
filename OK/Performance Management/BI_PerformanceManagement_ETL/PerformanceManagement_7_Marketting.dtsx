                    <component
                      refId="Package\Extract\بازاریابی\G1009_کیفیت فضای فروشگاه\G1009"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="G1009"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select  iif(total=0, 0,point1*1.0/total) as actualvalue  from 
(
select  count(b.participant) as total
,((select count(a.participant)* 5 from OKDWH_STG.Transform.HCMSurvey a  inner join com.DIM_Date d on d.PersianDate=a.RegDatePersian  where d.PersianYearMonthInt=? and  a.answercode='a1504' and a.QuestionCode in ('Q36','Q37','Q38','Q39')) 
+ (select count(a.participant)* 4 from OKDWH_STG.Transform.HCMSurvey a  inner join com.DIM_Date d on d.PersianDate=a.RegDatePersian  where d.PersianYearMonthInt=? and  a.answercode='a1503' and a.QuestionCode in ('Q36','Q37','Q38','Q39')) 
+ (select count(a.participant)* 3 from OKDWH_STG.Transform.HCMSurvey a  inner join com.DIM_Date d on d.PersianDate=a.RegDatePersian  where d.PersianYearMonthInt=? and  a.answercode='a1502' and a.QuestionCode in ('Q36','Q37','Q38','Q39')) 
+ (select count(a.participant)* 2 from OKDWH_STG.Transform.HCMSurvey a  inner join com.DIM_Date d on d.PersianDate=a.RegDatePersian  where d.PersianYearMonthInt=? and  a.answercode='a1501' and a.QuestionCode in ('Q36','Q37','Q38','Q39')) 
+ (select count(a.participant)* 1 from OKDWH_STG.Transform.HCMSurvey a  inner join com.DIM_Date d on d.PersianDate=a.RegDatePersian  where d.PersianYearMonthInt=? and  a.answercode='a1500' and a.QuestionCode in ('Q36','Q37','Q38','Q39')) 
) as point1
from OKDWH_STG.Transform.HCMSurvey b
inner join com.DIM_Date d on d.PersianDate=b.RegDatePersian  where d.PersianYearMonthInt=? and QuestionCode in ('Q36','Q37','Q38','Q39')
) C</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable">User::v_MDXQuery</property>
                        <property
                          dataType="System.Int32"
                          description="Specifies the column code page to use when code page information is unavailable from the data source."
                          name="DefaultCodePage">1252</property>
                        <property
                          dataType="System.Boolean"
                          description="Forces the use of the DefaultCodePage property value when describing character data."
                          name="AlwaysUseDefaultCodePage">false</property>
                        <property
                          dataType="System.Int32"
                          description="Specifies the mode used to access the database."
                          name="AccessMode"
                          typeConverter="AccessMode">2</property>
                        <property
                          dataType="System.String"
