      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX1010">
      <DTS:VariableValue
        DTS:DataType="8">SELECT NON EMPTY { [Measures].[SalesTrans Average], [Measures].[SalesTrans Count Average], [Measures].[Net Amount], [Measures].[Qty], [Measures].[Transaction Serial Distinct Count] } ON COLUMNS   , NON EMPTY { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } ON ROWS    FROM ( SELECT ( { [DIM Item].[Code Level1].&amp;[6], [DIM Item].[Code Level1].&amp;[11], [DIM Item].[Code Level1].&amp;[1], [DIM Item].[Code Level1].&amp;[2], [DIM Item].[Code Level1].&amp;[3], [DIM Item].[Code Level1].&amp;[7], [DIM Item].[Code Level1].&amp;[9] } ) ON COLUMNS    FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[140307] } ) ON COLUMNS    FROM [OKDWH_Retail_SalesTrans]))    WHERE ( [DIM Item].[Code Level1].CurrentMember )</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{DE51B941-0A75-4353-A43F-52D44E2127D6}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_MDX1014">
      <DTS:VariableValue
        DTS:DataType="8">SELECT NON EMPTY { [Measures].[Amount] } ON COLUMNS  , NON EMPTY { ([DIM Cost Center].[Cost Center NAME].[Cost Center NAME].ALLMEMBERS ) } ON ROWS   FROM ( SELECT ( { [DIM Cost Center].[Cost Center Type].&amp;[دارک استور], [DIM Cost Center].[Cost Center Type].&amp;[ستاد], [DIM Cost Center].[Cost Center Type].&amp;[فروشگاه عادی] } ) ON COLUMNS   FROM ( SELECT ( { [DIM Main Account].[MainAccountCode].&amp;[821136], [DIM Main Account].[MainAccountCode].&amp;[82111504], [DIM Main Account].[MainAccountCode].&amp;[82111505], [DIM Main Account].[MainAccountCode].&amp;[82111506], [DIM Main Account].[MainAccountCode].&amp;[82111501], [DIM Main Account].[MainAccountCode].&amp;[82111502], [DIM Main Account].[MainAccountCode].&amp;[82111503], [DIM Main Account].[MainAccountCode].&amp;[82111507], [DIM Main Account].[MainAccountCode].&amp;[82111509] } ) ON COLUMNS    FROM [ProfitLoss]))  WHERE ( [DIM Date].[Year Month].&amp;[140307], [DIM Main Account].[MainAccountCode].CurrentMember, [Dim Business Unit].[business Unit Name].&amp;[دفتر مرکزی], [Dim PL Main Account Groups].[Profit Loss Group DS].&amp;[سود (زيان) خالص], [DIM Cost Center].[Cost Center Type].CurrentMember )</DTS:VariableValue>
    </DTS:Variable>
