                  <DTS:ObjectData>
                    <ExpressionTask
                      Expression="@[User::v_MDX1010] =&quot;SELECT NON EMPTY { [Measures].[SalesTrans Average], [Measures].[SalesTrans Count Average], [Measures].[Net Amount], [Measures].[Qty], [Measures].[Transaction Serial Distinct Count] } ON COLUMNS   &#xA;, NON EMPTY { ([DIM Date].[Persian Year Month Int].[Persian Year Month Int].ALLMEMBERS ) } ON ROWS    &#xA;FROM ( SELECT ( {[DIM Item].[Code Level1].&amp;[6], [DIM Item].[Code Level1].&amp;[11], [DIM Item].[Code Level1].&amp;[1], [DIM Item].[Code Level1].&amp;[2], [DIM Item].[Code Level1].&amp;[3], [DIM Item].[Code Level1].&amp;[5], [DIM Item].[Code Level1].&amp;[7], [DIM Item].[Code Level1].&amp;[9] } ) ON COLUMNS    &#xA;FROM ( SELECT ( { [DIM Date].[Persian Year Month Int].&amp;[&quot;+ @[User::v_YearMonth1] +&quot;] } ) ON COLUMNS    &#xA;FROM [OKDWH_Retail_SalesTrans]))    &#xA;WHERE ( [DIM Item].[Code Level1].CurrentMember )&quot;" />
                  </DTS:ObjectData>
                </DTS:Executable>
