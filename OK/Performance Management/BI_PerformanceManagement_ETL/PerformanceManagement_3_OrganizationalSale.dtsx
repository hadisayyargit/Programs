                              version="7">
                              <properties>
                                <property
                                  dataType="System.Int32"
                                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                                  name="CommandTimeout">0</property>
                                <property
                                  dataType="System.String"
                                  description="Specifies the name of the database object used to open a rowset."
                                  name="OpenRowset"></property>
                                <property
                                  dataType="System.String"
                                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                                  name="OpenRowsetVariable"></property>
                                <property
                                  dataType="System.String"
                                  description="The SQL command to be executed."
                                  name="SqlCommand"
                                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT ST.SALESID,ST.SalesName,ST.CustAccount,ST.CustGroup,CAST(ST.CREATEDDATETIME AS DATE) CREATEDDATETIME, CAST(St.DeliveryDate AS DATE) DeliveryDate
,    CASE WHEN ST.SALESSTATUS =1 THEN 'OPEN ORDER'      
		  WHEN ST.SALESSTATUS =2 THEN 'DELIVERED'      
		  WHEN ST.SALESSTATUS =3 THEN 'INVOICED'      
		  WHEN ST.SALESSTATUS =4 THEN 'CANCELED'   
		  ELSE 'NONE' 
		  END AS SALESSTATUS    
		  ,ST.INVENTLOCATIONID,SL.ITEMID,SL.SALESQTY,SL.SALESPRICE,SL.LINEAMOUNT   ,SL.linePercent, SL.lineDisc 
From SalesTable ST (NoLock) 
INNER JOIN SalesLine SL (NoLock) ON ST.SalesID=SL.SalesId AND ST.PARTITION=SL.PARTITION AND ST.DATAAREAID=SL.DATAAREAID 
WHERE  ST.INVENTLOCATIONID NOT LIKE '%OKS%'   AND ST.CUSTGROUP!='Franchise'   
--AND ST.CREATEDDATETIME &gt;= ? AND ST.CREATEDDATETIME &lt;? 
AND CAST(St.DeliveryDate AS DATE) &gt;= ? AND CAST(St.DeliveryDate AS DATE) &lt;? 
AND ST.SALESSTATUS =3</property>
