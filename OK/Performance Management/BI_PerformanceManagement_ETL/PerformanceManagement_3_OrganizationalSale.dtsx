                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{FC3564CE-9429-49F9-8F10-4AF86F7C5D57}"
                          SQLTask:SqlStatementSource="if  ?&gt;'140307'&#xA;begin&#xA;delete from OKDWH_STG.Extract.hcmkpi1 &#xA;where  (SALESID not like'OSW%') &#xA;&#xA;update Extract.hcmkpi1 &#xA;set ACTUALVALUE =-1* ACTUALVALUE&#xA;where (SALESID  like'OSW2%') &#xA;end&#xA;else&#xA;&#xA;delete from OKDWH_STG.Extract.hcmkpi1 &#xA;where (CustAccount='WH_0000000027')&#xA;&#x9;&#x9;OR  (SALESID like'AK%')  or (SALESID like'GIG%')   or (SALESID like'SO%')  &#xA;&#x9;&#x9;OR (CustAccount='WH_0000000024' and SALESID not like'ARM%' and SALESID not like'OMD%')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                          <SQLTask:ParameterBinding
                            SQLTask:ParameterName="0"
                            SQLTask:DtsVariableName="User::v_YearMonth1"
                            SQLTask:ParameterDirection="Input"
                            SQLTask:DataType="3"
                            SQLTask:ParameterSize="-1" />
                        </SQLTask:SqlTaskData>
