              autoAdjustBufferSize="true"
              version="1">
              <components>
                <component
                  refId="Package\Transfotm\Transform_HRM_Fact_PersonnelFunction\Extract_HRM_Fact_PersonnelFunction"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Extract_HRM_Fact_PersonnelFunction"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select A.*
	, dep.mdDistrictSN
	,dstrct.DistrictDS
	, dep.mddepds as Location
	,deptyp.mdDepActivityTypeSN
	,deptyp.mdDepActivityTypeDS
	, A.PersianYearMonth * 100 + dep.mdDistrictSN  as PersianYearMonthDistrictId
	,cast( A.PersianYearMonth * 100 + dep.mdDistrictSN as bigint)  * 10000  + A.DepartmentId  as PersianYearMonthDistrictIdDepartmentId	
	--, L.Location_ID
 from [Extract].[HRM_mdDISTRICT] dstrct 
 left join [Extract].[HRM_mdDepartment] dep  on dep.mdDistrictSN=dstrct.DistrictId
 inner join [Extract].[HRM_mdDepActivityType] deptyp on deptyp.mdDepActivityTypeSN=dep.mdDepActivityTypeSN 
 inner join [Extract].[HRM_Fact_PersonnelFunction] A on a.DepartmentId =dep.mddepsn
-- left join (select distinct  storeid,Location_ID, LocationDS from OKDWH_STG.Extract.HRM_Fact_InventLocation) L on L.StoreID=A.storeid</property>
