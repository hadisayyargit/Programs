                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select * from 
(
select distinct dstrct.mdDistrictSN,dstrct.mdDistrictDS, d.mdStoreLatitude,d.mdStoreLongitude  
,d.mdDepDS, d.mdDepTypeSN,d.mdDepActivityTypeSN
, ROW_NUMBER() over(partition by dstrct.mdDistrictSN order by d.mdStoreLatitude ) as rownumber
from 
	OKMasterData.dbo.mddistrict dstrct 
	left join okmasterdata.dbo.mdDep d  on d.mdDistrictSN=dstrct.mdDistrictSN
	 where 
	 1=1 
	 and IIF( dstrct.mdDistrictSN=4,0, d.mdStoreLatitude) is not null 
	  and dstrct.mdDistrictSN not in (38,39,40,41,42,43,44,45)	 
	 --and d.mdDepTypeSN=2
	 --and d.mdDepActivityTypeSN=3
	 and mdDepActive=1
) A
where   rownumber=1</property>
