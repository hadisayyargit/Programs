          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              autoAdjustBufferSize="true"
              version="1">
              <components>
                <component
                  refId="Package\Extract\Extract_HRM_DIM_Personnel\centralwh1_OKHR__hrPersonel"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="centralwh1_OKHR__hrPersonel"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select p.hrPersonelSN,hrPersonelCode,p.hrPersonelCodeMelli,p.hrPersonelName, p.hrPersonelFamily, p.hrPersonelFatherName,p.hrPersonelBirthDate,p.hrPersonelShenasnameShomare,p.hrPersonelShenasnameSerial
, p.hrPersonelBimehNo ,p.hrPersonelShenasnameSerial1 ,p.hrPersonelShenasnameSerial2 ,p.hrPersonelShenasnameSerial6 ,p.TimeStamp ,p.mdCitySNBirth ,p.mdReligionSN , p.mdVazeaitTaaholSN, p.hrPersonelIsActive,p.mdJensiatSN 
, dep.mdDistrictSN,p.mdCitySNSodoor,p.mdVazeaitKhedmatSN,p.mdDalilVazeaitKhedmatSN
,m.HireDate, m.JobId, m.JobDS,m.SectionId, m.SectionDS,  m.Redeh as radeh,m.depId, m.dep, m.ModirdepId,m.NoeEstekhdamid,m.NoeEstekhadam, m.Semat, m.Tahsilatid ,m.TahsilatDS,m.hrPersonelTarkDate, m.hrUnActiveTypeSN, m.hrUnActiveTypeDS

, p.hrPersonelBimehID,p.hrPersonelBody, p.hrPersonelBoorsCode, p.hrPersonelEjareh,p.hrPersonelEntranceDate,p.hrPersonelIsJanbaz, try_cast(p.hrPersonelVagheiBirthDate as int) hrPersonelVagheiBirthDate, p.hrPersonelSejamCode,p.hrPersonelRahn
, p.hrPersonelSokonatType, p.mdCitySNSokonat, try_cast(p.hrPersonelWeddingDate as int) hrPersonelWeddingDate, bl.mdBloodDS,p.mdTafsiliSN,p.hrPersonelKartId
, m.AccountNo
--, m.mdBankDS
--,b.BankName as mdBankDS
--, m.mdDaneshgahDS,m.mdDaneshgahTypeDS, m.mdGerayeshDS,m.mdReshteTahsiliDS
, m.Mobile
, t.hrPersonelTamasAddress,t.hrPersonelTelZaroori,t.hrPersonelTamasTelNum,t.hrPersonelAddressZaroori, t.hrPersonelTamasPostCode

from [hrPersonel] p
inner join OKMasterData.dbo.mdPersonel m on m.Personelid=p.hrPersonelCode
inner join OKMasterData.dbo.mdBlood bl on bl.mdBloodSN=p.mdBloodSN
left join OKMasterData.dbo.mdDep dep on dep.mdDepSN=m.depId
--left join  [OKMasterData].[dbo].[mdBankMainAccount] b on b.hrPersonelAccountNO=m.AccountNo
inner join (
select t1.*, ROW_NUMBER() over(partition by hrPersonelSN  order by hrPersonelTamasSN desc ) as rownumber
from hrPersonelTamas  t1
) t on t.hrPersonelSN=p.hrPersonelSN 
where  t.rownumber=1</property>
