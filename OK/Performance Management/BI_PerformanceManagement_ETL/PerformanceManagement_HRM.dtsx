                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[Transform].[HRM_Fact_PersonnelFunction]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select A.*
, dep.mdDistrictSN
,dstrct.DistrictDS
, dep.mddepds as Location
,deptyp.mdDepActivityTypeSN
,deptyp.mdDepActivityTypeDS

 from [Extract].[HRM_mdDISTRICT] dstrct 
 left join [Extract].[HRM_mdDepartment] dep  on dep.mdDistrictSN=dstrct.DistrictId
 left join [Extract].[HRM_mdDepActivityType] deptyp on deptyp.mdDepActivityTypeSN=dep.mdDepActivityTypeSN 
 left join [Extract].[HRM_Karkard] A on a.DepartmentId =dep.mddepsn</property>
                    <property
