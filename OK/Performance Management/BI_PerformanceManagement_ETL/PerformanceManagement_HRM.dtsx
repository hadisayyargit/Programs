                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select h.*
  , d1.id as startdateref , d2.id as enddateref, left(h.hrPersonelHokmStartDate,6) as PersianStartYearMonth,left(h.hrPersonelHokmEndDate,6) as PersianEndYearMonth
  from Extract.HRM_DIM_PersonnelHokm h
  inner join OKDWH.COM.DIM_Date d1 on d1.PersianInt=h.hrPersonelHokmStartDate
  left join OKDWH.COM.DIM_Date d2 on d2.PersianInt=h.hrPersonelHokmEndDate</property>
