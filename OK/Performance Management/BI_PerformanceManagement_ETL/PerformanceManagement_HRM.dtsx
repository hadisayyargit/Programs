                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[Extract].[HRM_mdPersonnel]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select  distinct p.*, d1.ID as bithdate, d2.ID hiredate, d3.ID as LeaveDate
 , ~p.mdJensiatSN as modifiedGender, h.LastHokmStartDate,h.LastHokmEndDate,h.LastHokmEntesabDate,h.LastHokmErteghaDate
from Extract.HRM_mdPersonnel p			   
left join OKDWH.com.DIM_Date d1 on d1.PersianInt=p.hrPersonelBirthDate
left join OKDWH.com.DIM_Date d2 on d2.PersianInt=p.hrPersonelEstekhdamDate
left join OKDWH.com.DIM_Date d3 on d3.PersianInt=p.hrPersonelTarkDate
left join Extract.HRM_DIM_PersonnelHokm h on h.hrPersonelSN=p.hrPersonelSN</property>
