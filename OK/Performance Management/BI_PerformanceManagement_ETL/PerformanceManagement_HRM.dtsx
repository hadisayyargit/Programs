                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select mdDepSN, mdDepNO, mdDepDS
,case mdDistrictSN
	when 38 then 36
	when 39 then 34
	when 40 then 31
	when 41 then 27
	when 42 then 23
	when 43 then 21
	when 44 then 19
	when 45 then 17
	else mdDistrictSN
end mdDistrictSN
,mdDepActivityTypeSN , mdDep.mdRegionSN, mddep.mdRegionSubSN, mdDep.mdDepTypeSN
from mdDep</property>
