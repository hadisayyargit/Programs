                <DTS:Executable
                  DTS:refId="Package\Extract\تجهیزات\G4011_وزن آخال به فروش\Set MDX BI_WareHouseInputOutPut_GrossWeight"
                  DTS:CreationName="Microsoft.ExpressionTask"
                  DTS:Description="Expression Task"
                  DTS:DisableEventHandlers="True"
                  DTS:DTSID="{26c37d7d-afbd-4852-83de-c0509ee1ae6f}"
