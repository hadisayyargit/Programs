select LEFT([روز],6) as YearMonth ,sum(cast( [وزن] as float)) as weight1
from [report].[Akhal] a
where LEFT([روز] ,6)=?
group by LEFT([روز],6)
)
select YearMonth,weight1 from cte1</property>
