                      Expression="@[User::v_MDX4012]=&quot; SELECT { [Measures].[Available Weight] } ON COLUMNS,  { ([DIM Date].[Year Month].[Year Month].ALLMEMBERS ) } ON ROWS &#xA; FROM [OKDWH_InventTrend] &#xA; WHERE ( [DIM Invent Location].[BK Invent Location Id].&amp;[000901], [DIM Item].[Code Level1].&amp;[4], [DIM Invent Status].[BK Invent Status Id].&amp;[Available]&#xA; , [DIM Date].[Date].&amp;[&quot;+ (DT_WSTR,10) @[User::v_PersianEndDate] +&quot;] ) &quot;" />
