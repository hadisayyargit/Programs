                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G4005"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH Months AS (
select PersianYearMonthInt YearMonth, MIN(PersianInt) StartDate, MAX(PersianInt) EndDate
from [dbo].[DimDate]
where PersianYearMonthInt = ? and cast(GregorianDate as date) &lt; cast(GETDATE() as date)
group by PersianYearMonthInt
)
SELECT 
    m.YearMonth,
    COUNT(*) AS CountOfStores
FROM Months m
JOIN [OKDWH_Evaluation].[HR].[DimDep] d
    ON d.OpenningDate &lt;= m.EndDate
   AND (d.ClosingDate &gt;= m.StartDate OR d.ClosingDate IS NULL)
WHERE d.DepActivityTypeSN = 3
  AND d.LocationID IS NOT NULL
  AND d.DepName NOT LIKE N'%تکرار%'
  AND d.OpenningDate IS NOT NULL
GROUP BY m.YearMonth
ORDER BY m.YearMonth</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDXQuery</property>
                            <property
