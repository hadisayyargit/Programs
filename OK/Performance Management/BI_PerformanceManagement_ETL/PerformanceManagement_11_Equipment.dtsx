                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as 
(
select LEFT([روز],6) as YearMonth ,sum(cast( [مبلغ فاکتور] as bigint)) as amount1
from [report].[Akhal] a
where LEFT([روز] ,6)=?
group by LEFT([روز],6)
)
, cte2 as(

select  left([date (P)],6) as YearMonth,sum(cast(amount as bigint))  as amount2
from [report].Vendors
where LEFT([date (P)] ,6)=?
group by  LEFT([date (P)] ,6)
)

select cte1.YearMonth,cte1.amount1, cte2.amount2,cte1.amount1+ cte2.amount2 as total
from cte1
inner join cte2 on cte2.YearMonth=cte1.YearMonth</property>
