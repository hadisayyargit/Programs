                        <component
                          refId="Package\Extract\تجهیزات\G4014_میزان موجودی انبارهای فنی\G4014_Extract\G4014_InventTrend"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="G4014_InventTrend"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">declare @mydate int
 select @mydate=max(t.COM_DIM_Date_PhysicalRef)
  from [SCM].[Fact_InventTrend] t with(nolock)
  inner join com.DIM_Date d on d.ID=t.COM_DIM_Date_PhysicalRef
  where  d.PersianYearMonthInt=?


  ; with cte1 as
  (
 select i.BKItemId,t.AvailablePhysicalMultipleQty
  from [SCM].[Fact_InventTrend] t
  inner join com.DIM_Date d on d.ID=t.COM_DIM_Date_PhysicalRef
  inner join com.DIM_Item i on i.id=t.COM_DIM_ItemRef 
  inner join com.DIM_InventLocation l on l.ID=t.COM_DIM_InventLocationRef
  
  where 
  t.COM_DIM_Date_PhysicalRef=@mydate
  and i.CodeLevel1=4
  and l.BKInventLocationId='000901'
  and t.SCM_DIM_InventStatusRef=1
and i.BKItemId not in(
'9799648765999',
'9799648765899',
'9799648703599',
'9799648703699',
'9799648919099',
'9799648776199',
'9799648778199',
'9799648263099',
'9799648771599',
'9799648779299',
'9799648778099',
'9799648771699',
'9799648843699'

  )
  )
   , cte2 as (
  select price, i.BKItemId
from [SCM].[Fact_TradeAgreement] t2
inner join com.DIM_Item i on i.id=t2.itemrelation
where  t2.Relation=4
and t2.ACCOUNTRELATION='Base'
and t2.RNumber=1
and t2.FROMDATE&lt;=@mydate and t2.TODATE&gt;=@mydate
)
, cte3 as
(
select cte1.BKItemId , cte1.AvailablePhysicalMultipleQty, cte2.Price, cte1.AvailablePhysicalMultipleQty*cte2.Price as LineAmount
from cte1
inner join cte2 on cte2.BKItemId=cte1.BKItemId
)
select sum(LineAmount) as final from cte3</property>
