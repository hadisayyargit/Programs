          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{40cf842f-7cf1-4b34-808d-071217b33e07}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Delete hrm_Fact_HCMGOAL_Equipment"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADFCA076-715F-46AB-9546-C33952DB0B1F}"
              SQLTask:SqlStatementSource="&#xA;DELETE FROM HRM.Fact_HCMGOAL&#xA;FROM            HRM.Fact_HCMGOAL INNER JOIN&#xA;                         COM.DIM_Date AS d1 ON d1.ID = HRM.Fact_HCMGOAL.COM_DIM_DATE_StartDateRef&#xA;WHERE        (d1.PersianYearMonthInt =? &#xA;--  and overview in  ('G4','G4004','G4005','G4007','G4008','G4009','G4010','G4011','G4014')&#xA;  and overview in  ('G4005')&#xA;&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
