                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT NON EMPTY { [Measures].[Cumulative PO Weight], [Measures].[Cumulative Budget Weight V2], [Measures].[Cumulative Received Weight] } ON COLUMNS, NON EMPTY { ([Date].[PersianYearMonth].[PersianYearMonth].ALLMEMBERS * [Item].[Level4].[Level4].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( -{ [Item].[Level3].&amp;[برنج خارجی], [Item].[Level3].&amp;[روغن جامد و نیمه جامد], [Item].[Level3].&amp;[روغن مایع], [Item].[Level3].&amp;[قند و شکر] } ) ON COLUMNS FROM ( SELECT ( { [Item].[Level1].&amp;[Beverages], [Item].[Level1].&amp;[DPH], [Item].[Level1].&amp;[Dry Food],  [Item].[Level1].&amp;[LHH], [Item].[Level1].&amp;[Textile], [Item].[Level1].&amp;[Tobacco Products] } ) ON COLUMNS FROM ( SELECT ( { [Budget].[HasBudget].&amp;[1] } ) ON COLUMNS FROM ( SELECT ( { [Date].[Last Day].&amp;[True] } ) ON COLUMNS FROM ( SELECT ( { [PO].[HasPO].&amp;[1] } ) ON COLUMNS FROM [OKDWH]))))) WHERE ( [PO].[HasPO].&amp;[1], [Date].[Last Day].&amp;[True], [Budget].[HasBudget].&amp;[1], [Item].[Level1].CurrentMember ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</property>
