                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with cte1 as
  (
  select k1.YEARMONTH, k1.ACTUALVALUE as akhalweight, k2.ACTUALVALUE as grossweight
  from Extract.HCMKPI1 k1
  inner join Extract.HCMKPI2 k2 on k2.YEARMONTH=k1.YEARMONTH 
  )
  select cte1.YEARMONTH,iif(cte1.grossweight=0,0, 100000*akhalweight/grossweight) as final from cte1</property>
