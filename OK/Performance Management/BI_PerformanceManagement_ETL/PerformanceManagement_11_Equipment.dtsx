                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT D.PersianYearMonthInt
      ,ABS(SUM([Amount])) Amount
FROM [OKDWH].[FIN].[Fact_ProfitLoss] p 
inner join [OKDWH].[FIN].[Dim_PLMainAccountGroups] PL on p.[FIN_DIM_MainAccountGroupRef] = PL.ID
inner join [OKDWH].[COM].[DIM_Date] D on P.COM_DIM_DateRef = D.ID
inner join [OKDWH].[FIN].[DIM_CostCenter] C on C.ID = P.FIN_DIM_CostCenterRef
where PL.ID in (122,123,124,125,126,127,128) 
AND D.PersianYearMonthInt = ?
AND C.mdCostCenterTypeDS like '%عاد%'
Group by D.PersianYearMonthInt</property>
