                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;with k1 as
 (select yearmonth,sum(GrossWeight) as A1 from Extract.HCMKPI1 group by YEARMONTH)
 ,k2 as 
 (select *  from Extract.hcmkpi2 )
 ,d as (select * from OKDWH.COM.DIM_Date d where d.PersianYearMonthInt=?)
 , cte1 as
 (select k2.GOALCODE, k2.YEARMONTH, k2.ACTUALVALUE  from k2 inner join  d on d.GregorianDate=k2.KPIDATE)
 , cte2 as
 (select YEARMONTH,sum(cte1.Actualvalue) sum1,(select count(*) from d ) as daycount from cte1 group by YEARMONTH)
  select k1.YEARMONTH, iif(cte2.sum1=0,0,k1.A1*cte2.daycount/cte2.sum1) as final  from k1 inner join cte2 on cte2.YEARMONTH=k1.YEARMONTH</property>
                            <property
                              dataType="System.String"
                              description="The variable that contains the SQL command to be executed."
                              name="SqlCommandVariable">User::v_MDXQuery</property>
                            <property
                              dataType="System.Int32"
                              description="Specifies the column code page to use when code page information is unavailable from the data source."
                              name="DefaultCodePage">1252</property>
                            <property
