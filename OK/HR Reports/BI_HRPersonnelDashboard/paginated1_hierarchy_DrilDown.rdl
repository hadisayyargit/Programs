          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE SUMMARIZECOLUMNS('vw_Fact_PersonnelFunction'[avgovertime], 'vw_Fact_PersonnelFunction'[locationcount], 'vw_Fact_PersonnelFunction'[PersianYearMonth], 'Fact_PersonnelFunction'[DistrictDS], 'Fact_PersonnelFunction'[DepartmentName], 'Fact_PersonnelFunction'[PersonnelFullName], 'Fact_PersonnelFunction'[OverTime]
, FILTER(VALUES('vw_Fact_PersonnelFunction'[PersianYearMonth]), ('vw_Fact_PersonnelFunction'[PersianYearMonth] = VALUE(@pPersianYearMonth)))
, FILTER(VALUES('vw_Fact_PersonnelFunction'[DistrictId]), ('vw_Fact_PersonnelFunction'[DistrictId] = VALUE(@pDistrictId)))
, FILTER(VALUES('Fact_PersonnelFunction'[DepActivityTypeId]), ('Fact_PersonnelFunction'[DepActivityTypeId] = 3))
, "SumofPersonnel", [SumofPersonnel])

</CommandText>
